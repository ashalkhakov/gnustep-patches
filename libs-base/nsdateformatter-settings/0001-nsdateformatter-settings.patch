+
+static BOOL
+same(NSDate *d, double expected)
+{
+  if (isnan(expected))
+    {
+      return d == nil;
+    }
+  return d != nil && [d timeIntervalSince1970] == expected;
+}
+
+int main()
+{
+  NSAutoreleasePool	*arp = [NSAutoreleasePool new];
+  NSLocale		*posix;
+  NSUInteger		i;
+
+  posix = [[[NSLocale alloc] initWithLocaleIdentifier: @"en_US_POSIX"]
+    autorelease];
+  for (i = 0; i < sizeof(cases) / sizeof(cases[0]); i++)
+    {
+      int	lenient;
+
+      for (lenient = 0; lenient < 2; lenient++)
+	{
+	  NSDateFormatter	*f = [[NSDateFormatter new] autorelease];
+	  NSString		*s = cases[i].string;
+	  double		whole;
+	  double		partial;
+	  NSUInteger		length;
+	  NSRange		r = NSMakeRange(0, [s length]);
+	  id			v = nil;
+	  BOOL			ok;
+
+	  [f setLocale: posix];
+	  [f setTimeZone: [NSTimeZone timeZoneForSecondsFromGMT: 0]];
+	  [f setDateFormat: cases[i].format];
+	  [f setLenient: lenient ? YES : NO];
+	  whole = lenient ? cases[i].lenient : cases[i].strict;
+	  partial = lenient ? cases[i].lenientPartial : cases[i].strictPartial;
+	  length = lenient ? cases[i].lenientLength : cases[i].strictLength;
+	  ok = [f getObjectValue: &v forString: s range: &r error: NULL];
+	  PASS(same([f dateFromString: s], whole)
+	    && ok == !isnan(partial) && same(v, partial)
+	    && (!ok || r.length == length),
+	    "%s \"%s\" with \"%s\" is as on macOS",
+	    lenient ? "lenient" : "strict", [s UTF8String],
+	    [cases[i].format UTF8String])
+	}
+    }
+  [arp release];
+  return 0;
+}
