+/* The separators a field takes in place of another, as ICU's
+ * SimpleDateFormatStaticSets: 1 for a date field, 2 for a time field, 3 for
+ * any other field and 0 for the end of the pattern.
+ */
+static int
+separatorKind(UChar field)
+{
+  if (field == 0 || field >= 128
+    || strchr("GyMdkHmsSEDFwWahKzYeugAZvcLQqVUOXxrbB", field) == NULL)
+    return 0;
+  if (strchr("yMdcL", field) != NULL)
+    return 1;
+  if (strchr("kHmshK", field) != NULL)
+    return 2;
+  return 3;
+}
+
+static BOOL
+isSeparator(int kind, UChar c)
+{
+  if (kind == 0)
+    return NO;
+  if (u_isUWhiteSpace(c))
+    return YES;
+  if (kind == 1)
+    return c == '-' || c == ',' || c == '.' || c == '/';
+  if (kind == 2)
+    return c == '-' || c == '.' || c == ':';
+  return NO;
+}
+
+static BOOL
+isPatternWhiteSpace(UChar c)
+{
+  return (c >= 0x09 && c <= 0x0d) || c == 0x20 || c == 0x85
+    || c == 0x200e || c == 0x200f || c == 0x2028 || c == 0x2029;
+}
+
+/* Where in text a literal of the pattern that starts at t ends, matched as
+ * a strict parse on macOS matches it, or -1 when it does not match.
+ */
+static int32_t
+matchLiteral(const UChar *lit, int32_t litLength, int kind,
+  const UChar *text, int32_t length, int32_t t)
+{
+  int32_t	start = t;
+  int32_t	p = 0;
+
+  while (p < litLength && t < length)
+    {
+      if (isPatternWhiteSpace(lit[p]))
+	{
+	  BOOL	found = NO;
+
+	  while (p < litLength && isPatternWhiteSpace(lit[p]))
+	    p++;
+	  while (t < length
+	    && (u_isUWhiteSpace(text[t]) || isPatternWhiteSpace(text[t])))
+	    {
+	      found = YES;
+	      t++;
+	    }
+	  if (!found)
+	    return -1;
+	  if (p >= litLength)
+	    break;
+	}
+      if (t >= length || lit[p] != text[t])
+	{
+	  if (t < length && isSeparator(kind, lit[p])
+	    && (isSeparator(kind, text[t]) || u_isalpha(text[t])))
+	    break;
+	  return -1;
+	}
+      p++;
+      t++;
+    }
+  if (p == 0)
+    {
+      for (t = start; t < length && isSeparator(kind, text[t]); t++)
+	;
+    }
+  return t;
+}
+
+/* Parses text from base, strictly or not as the formatter is set.  Answers
+ * the milliseconds and sets *pos to where the parse ended, or answers NO
+ * and sets *pos to where it failed.
+ */
+static BOOL
+parseText(UDateFormat *df, UDate base, const UChar *text, int32_t length,
+  int32_t *pos, UDate *date)
+{
+  UErrorCode	err = U_ZERO_ERROR;
+  UCalendar	*cal;
+
+  *pos = 0;
+  cal = ucal_clone (udat_getCalendar (df), &err);
+  ucal_setMillis (cal, base, &err);
+  udat_parseCalendar (df, cal, text, length, pos, &err);
+  *date = ucal_getMillis (cal, &err);
+  ucal_close (cal);
+  return U_SUCCESS(err) ? YES : NO;
+}
+
+/* A strict parse that failed at a literal of the pattern is given that
+ * literal as macOS would match it there, and tried again.  Answers NO when
+ * there is no literal to give.
+ */
+static BOOL
+replaceLiteral(UDateFormat *df, UDate base, UChar **text, int32_t *length,
+  int32_t failed)
+{
+  UErrorCode	err = U_ZERO_ERROR;
+  UChar		pattern[BUFFER_SIZE];
+  int32_t	patternLength;
+  int32_t	i = 0;
+
+  patternLength = udat_toPattern (df, 0, pattern, BUFFER_SIZE, &err);
+  if (U_FAILURE(err))
+    return NO;
+  while (i < patternLength)
+    {
+      UChar	lit[BUFFER_SIZE];
+      int32_t	litLength = 0;
+      int32_t	start = i;
+      BOOL	quoted = NO;
+      int32_t	end;
+      int32_t	pos;
+      UDate	date;
+      UChar	*replaced;
+      int32_t	newLength;
+
+      while (i < patternLength && pattern[i] < 128
+	&& isalpha(pattern[i]) && pattern[i] == pattern[start])
+	i++;
+      if (i > start)
+	continue;
+      while (i < patternLength
+	&& (quoted || !(pattern[i] < 128 && isalpha(pattern[i]))))
+	{
+	  if (pattern[i] == '\'')
+	    {
+	      if (i + 1 < patternLength && pattern[i + 1] == '\'')
+		{
+		  lit[litLength++] = pattern[i];
+		  i += 2;
+		}
+	      else
+		{
+		  quoted = !quoted;
+		  i++;
+		}
+	      continue;
+	    }
+	  lit[litLength++] = pattern[i++];
+	}
+      if (litLength == 0)
+	continue;
+      if (start > 0)
+	{
+	  UDateFormat	*prefix = udat_clone (df, &err);
+	  BOOL		ok;
+
+	  if (U_FAILURE(err))
+	    return NO;
+	  udat_applyPattern (prefix, false, pattern, start);
+	  ok = parseText(prefix, base, *text, failed, &pos, &date);
+	  udat_close (prefix);
+	  if (!ok || pos != failed)
+	    continue;
+	}
+      else if (failed != 0)
+	{
+	  continue;
+	}
+
+      end = matchLiteral(lit, litLength,
+	separatorKind(i < patternLength ? pattern[i] : 0),
+	*text, *length, failed);
+      if (end < 0)
+	return NO;
+      if (end - failed == litLength
+	&& memcmp(*text + failed, lit, litLength * sizeof(UChar)) == 0)
+	return NO;
+      newLength = *length - (end - failed) + litLength;
+      replaced = malloc(sizeof(UChar) * (newLength + 1));
+      if (replaced == NULL)
+	return NO;
+      memcpy(replaced, *text, failed * sizeof(UChar));
+      memcpy(replaced + failed, lit, litLength * sizeof(UChar));
+      memcpy(replaced + failed + litLength, *text + end,
+	(*length - end) * sizeof(UChar));
+      free(*text);
+      *text = replaced;
+      *length = newLength;
+      return YES;
+    }
+  return NO;
+}
