diff --git a/Tests/base/NSDateFormatter/settings.m b/Tests/base/NSDateFormatter/settings.m
new file mode 100644
index 0000000..e0ca01e
--- /dev/null
+++ b/Tests/base/NSDateFormatter/settings.m
@@ -0,0 +1,227 @@
+#import <Foundation/Foundation.h>
+#import "Testing.h"
+
+/* Each expected value is what macOS 15 gives for the same calls. */
+
+static NSDateFormatter *
+formatter(NSString *locale, NSString *format)
+{
+  NSDateFormatter	*f = [[NSDateFormatter new] autorelease];
+
+  [f setLocale: [[[NSLocale alloc] initWithLocaleIdentifier: locale]
+    autorelease]];
+  [f setTimeZone: [NSTimeZone timeZoneWithName: @"UTC"]];
+  [f setDateFormat: format];
+  return f;
+}
+
+static NSDate *
+date(NSTimeInterval t)
+{
+  return [NSDate dateWithTimeIntervalSinceReferenceDate: t];
+}
+
+static NSTimeInterval
+when(NSDate *d)
+{
+  return [d timeIntervalSinceReferenceDate];
+}
+
+/* Reads back the settings a date formatter wrote. */
+@interface	WrittenDateFormatter : NSObject
+{
+@public
+  NSDictionary	*attributes;
+}
+@end
+
+@implementation	WrittenDateFormatter
+- (void) dealloc
+{
+  [attributes release];
+  [super dealloc];
+}
+- (id) initWithCoder: (NSCoder*)coder
+{
+  attributes = [[coder decodeObjectForKey: @"NS.attributes"] retain];
+  return self;
+}
+@end
+
+static NSDictionary *
+written(NSDateFormatter *f)
+{
+  NSKeyedUnarchiver	*unarchiver;
+  WrittenDateFormatter	*w;
+
+  unarchiver = [[NSKeyedUnarchiver alloc] initForReadingWithData:
+    [NSKeyedArchiver archivedDataWithRootObject: f]];
+  [unarchiver setClass: [WrittenDateFormatter class]
+	  forClassName: @"NSDateFormatter"];
+  w = [[[unarchiver decodeObjectForKey: @"root"] retain] autorelease];
+  [unarchiver release];
+  return w->attributes;
+}
+
+static id
+roundTrip(id o)
+{
+  return [NSKeyedUnarchiver unarchiveObjectWithData:
+    [NSKeyedArchiver archivedDataWithRootObject: o]];
+}
+
+int main()
+{
+  NSAutoreleasePool	*arp = [NSAutoreleasePool new];
+  NSDateFormatter	*f;
+  NSDateFormatter	*back;
+  NSArray		*symbols;
+  NSDictionary		*attributes;
+
+  START_SET("NSDateFormatter settings")
+
+    f = [[NSDateFormatter new] autorelease];
+    PASS([f isLenient] == NO, "a formatter is not lenient")
+    PASS(when([f twoDigitStartDate]) == -1609459200.0,
+      "two digit years start in 1950")
+    PASS(when([f gregorianStartDate]) == -13197600000.0,
+      "the gregorian calendar starts in October 1582")
+    PASS([f defaultDate] == nil, "there is no default date")
+    PASS([f generatesCalendarDates] == NO, "dates are not calendar dates")
+    PASS([f formattingContext] == NSFormattingContextUnknown,
+      "the formatting context is unknown")
+
+    f = formatter(@"en_US", @"HH:mm");
+    PASS(when([f dateFromString: @"10:30"]) == -31584600.0,
+      "what the string does not give comes from the start of 2000")
+    [f setDefaultDate: date(86400 * 400)];
+    PASS(when([f dateFromString: @"10:30"]) == 34597800.0,
+      "or from the default date")
+    [f setGeneratesCalendarDates: YES];
+    PASS([[f dateFromString: @"10:30"] isKindOfClass: [NSCalendarDate class]],
+      "a calendar date is made when asked for")
+    {
+      NSRange	r = NSMakeRange(0, 10);
+      id	v = nil;
+      BOOL	ok;
+
+      ok = [f getObjectValue: &v forString: @"10:30 junk" range: &r error: NULL];
+      PASS(ok && when(v) == 34597800.0 && r.length == 5,
+	"a range is read as far as it is a date")
+    }
+    [f setLenient: YES];
+    [f setDateFormat: @"yyyy"];
+    PASS([f isLenient], "leniency survives a change of format")
+    f = [[[NSDateFormatter alloc] initWithDateFormat: @"%Y"
+				allowNaturalLanguage: YES] autorelease];
+    PASS([f isLenient], "a 10.0 formatter allowing natural language is lenient")
+
+    f = formatter(@"en_US", @"yy");
+    PASS(when([f dateFromString: @"49"]) == 1514764800.0, "49 is 2049")
+    PASS(when([f dateFromString: @"51"]) == -1577923200.0, "51 is 1951")
+    [f setTwoDigitStartDate: date(86400 * 365)];
+    PASS(when([f dateFromString: @"01"]) == 3155673600.0,
+      "01 is 2101 when two digit years start in 2002")
+    [f setTimeZone: [NSTimeZone timeZoneForSecondsFromGMT: 3600]];
+    PASS(when([f twoDigitStartDate]) == 86400 * 365,
+      "the start survives a change of time zone")
+
+    f = formatter(@"en_US", @"yyyy-MM-dd");
+    PASS_EQUAL([f stringFromDate: date(-1.4e10)], @"1557-05-01",
+      "a date before 1582 is julian")
+    [f setGregorianStartDate: date(-1.5e10)];
+    PASS_EQUAL([f stringFromDate: date(-1.4e10)], @"1557-05-11",
+      "or gregorian when the gregorian calendar starts earlier")
+    PASS(when([f gregorianStartDate]) == -1.5e10,
+      "the gregorian start date is kept")
+
+    f = formatter(@"en_US", @"h a EEE EEEEE");
+    [f setAMSymbol: @"morning"];
+    [f setPMSymbol: @"evening"];
+    symbols = [NSArray arrayWithObjects:
+      @"s0", @"s1", @"s2", @"s3", @"s4", @"s5", @"s6", nil];
+    [f setShortWeekdaySymbols: symbols];
+    symbols = [NSArray arrayWithObjects:
+      @"v0", @"v1", @"v2", @"v3", @"v4", @"v5", @"v6", nil];
+    [f setVeryShortWeekdaySymbols: symbols];
+    PASS_EQUAL([f stringFromDate: date(15 * 3600)], @"3 evening s1 v1",
+      "AM, PM and weekday symbols are used, Sunday first")
+    [f setTimeZone: [NSTimeZone timeZoneForSecondsFromGMT: 3600]];
+    PASS_EQUAL([f stringFromDate: date(15 * 3600)], @"4 evening s1 v1",
+      "the symbols survive a change of time zone")
+    PASS_EQUAL([f AMSymbol], @"morning", "the AM symbol is kept")
+    PASS_EQUAL([f veryShortWeekdaySymbols], symbols,
+      "the very short weekday symbols are their own")
+
+    f = formatter(@"fr_FR", @"MMMM");
+    PASS_EQUAL([f stringFromDate: date(0)], @"janvier",
+      "a month is in lower case in French")
+    [f setFormattingContext: NSFormattingContextBeginningOfSentence];
+    PASS_EQUAL([f stringFromDate: date(0)], @"Janvier",
+      "and capitalized at the beginning of a sentence")
+    [f setFormattingContext: NSFormattingContextStandalone];
+    PASS_EQUAL([f stringFromDate: date(0)], @"Janvier",
+      "and standing alone")
+    [f setFormattingContext: NSFormattingContextMiddleOfSentence];
+    PASS_EQUAL([f stringFromDate: date(0)], @"janvier",
+      "but not in the middle of a sentence")
+
+    f = [[NSDateFormatter new] autorelease];
+    [f setLocale: [[[NSLocale alloc] initWithLocaleIdentifier: @"en_US"]
+      autorelease]];
+    [f setDateStyle: NSDateFormatterMediumStyle];
+    [f setDoesRelativeDateFormatting: YES];
+    PASS_EQUAL([f stringFromDate: [NSDate date]], @"Today",
+      "relative formatting says Today")
+    PASS([f formattingContext] == NSFormattingContextListItem,
+      "relative formatting is for a list item")
+
+    /* All of them survive a keyed archive, as macOS writes them. */
+    f = formatter(@"en_US", @"h a EEE yy");
+    [f setAMSymbol: @"morning"];
+    [f setShortWeekdaySymbols: [NSArray arrayWithObjects:
+      @"s0", @"s1", @"s2", @"s3", @"s4", @"s5", @"s6", nil]];
+    [f setTwoDigitStartDate: date(86400 * 365)];
+    [f setGregorianStartDate: date(-1.5e10)];
+    [f setDefaultDate: date(86400 * 400)];
+    [f setGeneratesCalendarDates: YES];
+    [f setLenient: YES];
+    [f setFormattingContext: NSFormattingContextBeginningOfSentence];
+    [f setCalendar: [[[NSCalendar alloc]
+      initWithCalendarIdentifier: NSCalendarIdentifierBuddhist] autorelease]];
+    attributes = written(f);
+    PASS_EQUAL([attributes objectForKey: @"formattingContext"],
+      [NSNumber numberWithInt: 258],
+      "the formatting context is written as ICU's display context")
+    PASS_EQUAL([[attributes objectForKey: @"locale"] localeIdentifier], @"en_US",
+      "the locale is written without the calendar")
+    PASS_EQUAL([[attributes objectForKey: @"calendar"] calendarIdentifier],
+      NSCalendarIdentifierBuddhist, "the calendar is written on its own")
+    PASS([attributes objectForKey: @"timeStyle"] == nil
+      && [attributes objectForKey: @"PMSymbol"] == nil,
+      "what was not set is not written")
+    back = roundTrip(f);
+    PASS_EQUAL([back AMSymbol], @"morning", "the AM symbol survives")
+    PASS_EQUAL([[back shortWeekdaySymbols] objectAtIndex: 1], @"s1",
+      "the weekday symbols survive")
+    PASS(when([back twoDigitStartDate]) == 86400 * 365,
+      "the two digit start date survives")
+    PASS(when([back gregorianStartDate]) == -1.5e10,
+      "the gregorian start date survives")
+    PASS(when([back defaultDate]) == 86400 * 400,
+      "the default date survives")
+    PASS([back generatesCalendarDates] && [back isLenient],
+      "calendar dates and leniency survive")
+    PASS([back formattingContext] == NSFormattingContextBeginningOfSentence,
+      "the formatting context survives")
+    PASS_EQUAL([[back calendar] calendarIdentifier],
+      NSCalendarIdentifierBuddhist, "the calendar survives")
+    PASS_EQUAL([back stringFromDate: date(15 * 3600)],
+      [f stringFromDate: date(15 * 3600)],
+      "the formatter read back formats as the one written")
+
+  END_SET("NSDateFormatter settings")
+
+  [arp release];
+  return 0;
+}
