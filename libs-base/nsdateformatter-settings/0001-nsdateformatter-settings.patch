-- (NSDate*) dateFromString: (NSString*) string
+/* A keyed archive keeps the context as ICU's display context. */
+static NSInteger
+ICUContextFromFormattingContext(NSFormattingContext context)
+{
+  switch (context)
+    {
+      case NSFormattingContextDynamic:			return -1;
+      case NSFormattingContextStandalone:		return 260;
+      case NSFormattingContextListItem:			return 259;
+      case NSFormattingContextBeginningOfSentence:	return 258;
+      case NSFormattingContextMiddleOfSentence:		return 257;
+      default:						return 256;
+    }
+}
+
+static NSFormattingContext
+formattingContextFromICUContext(NSInteger context)
+{
+  switch (context)
+    {
+      case -1:	return NSFormattingContextDynamic;
+      case 260:	return NSFormattingContextStandalone;
+      case 259:	return NSFormattingContextListItem;
+      case 258:	return NSFormattingContextBeginningOfSentence;
+      case 257:	return NSFormattingContextMiddleOfSentence;
+      default:	return NSFormattingContextUnknown;
+    }
+}
+
