diff --git a/Tests/base/NSFileHandle/Helpers/stdinread.m b/Tests/base/NSFileHandle/Helpers/stdinread.m
new file mode 100644
index 0000000..a6b0842
--- /dev/null
+++ b/Tests/base/NSFileHandle/Helpers/stdinread.m
@@ -0,0 +1,50 @@
+/* Reads its standard input in the background, as a program that serves
+ * requests on it does, and writes what it read to its standard output: 0
+ * when something was read, 1 when nothing came within five seconds.
+ */
+#import <Foundation/Foundation.h>
+#include <stdio.h>
+
+@interface	Reader : NSObject
+{
+@public
+  NSData	*got;
+  BOOL		done;
+}
+- (void) read: (NSNotification *)n;
+@end
+
+@implementation	Reader
+- (void) read: (NSNotification *)n
+{
+  got = RETAIN([[n userInfo] objectForKey: NSFileHandleNotificationDataItem]);
+  done = YES;
+}
+@end
+
+int
+main(int argc, char **argv)
+{
+  NSAutoreleasePool	*arp = [NSAutoreleasePool new];
+  NSFileHandle		*input = [NSFileHandle fileHandleWithStandardInput];
+  Reader		*reader = AUTORELEASE([Reader new]);
+  NSDate		*limit = [NSDate dateWithTimeIntervalSinceNow: 5.0];
+
+  [[NSNotificationCenter defaultCenter] addObserver: reader
+    selector: @selector(read:)
+    name: NSFileHandleReadCompletionNotification
+    object: input];
+  [input readInBackgroundAndNotify];
+  while (reader->done == NO && [limit timeIntervalSinceNow] > 0)
+    {
+      [[NSRunLoop currentRunLoop] runMode: NSDefaultRunLoopMode
+        beforeDate: [NSDate dateWithTimeIntervalSinceNow: 0.1]];
+    }
+  if ([reader->got length] > 0)
+    {
+      fwrite([reader->got bytes], 1, [reader->got length], stdout);
+      fflush(stdout);
+    }
+  [arp release];
+  return [reader->got length] > 0 ? 0 : 1;
+}
diff --git a/Tests/base/NSFileHandle/stdinPipe.m b/Tests/base/NSFileHandle/stdinPipe.m
new file mode 100644
index 0000000..6f6232e
--- /dev/null
+++ b/Tests/base/NSFileHandle/stdinPipe.m
@@ -0,0 +1,54 @@
+/* A program whose standard input is a pipe (a server a parent talks to over
+ * one) reads it in the background as any other.  On Windows the standard
+ * input was taken to be a console's whatever it was, and a pipe's could not
+ * be read: peeking at it as a console failed, again and again.
+ */
+#import <Foundation/NSTask.h>
+#import <Foundation/NSFileHandle.h>
+#import <Foundation/NSFileManager.h>
+#import <Foundation/NSData.h>
+#import <Foundation/NSString.h>
+#import <Foundation/NSAutoreleasePool.h>
+#import "ObjectTesting.h"
+
+int main()
+{
+  NSAutoreleasePool	*arp = [NSAutoreleasePool new];
+  NSString		*path;
+  NSTask		*task;
+  NSPipe		*input;
+  NSPipe		*output;
+  NSData		*data;
+  NSString		*read;
+
+  START_SET("NSFileHandle standard input from a pipe")
+
+  path = [[[[NSFileManager defaultManager] currentDirectoryPath]
+    stringByAppendingPathComponent: @"Helpers"]
+    stringByAppendingPathComponent: @"obj"];
+  path = [path stringByAppendingPathComponent: @"stdinread"];
+#if defined(_WIN32)
+  path = [path stringByAppendingPathExtension: @"exe"];
+#endif
+  task = AUTORELEASE([[NSTask alloc] init]);
+  input = [NSPipe pipe];
+  output = [NSPipe pipe];
+  [task setLaunchPath: path];
+  [task setStandardInput: input];
+  [task setStandardOutput: output];
+  [task launch];
+  [[input fileHandleForWriting] writeData:
+    [@"hello" dataUsingEncoding: NSASCIIStringEncoding]];
+  [[input fileHandleForWriting] closeFile];
+  data = [[output fileHandleForReading] readDataToEndOfFile];
+  [task waitUntilExit];
+  read = AUTORELEASE([[NSString alloc] initWithData: data
+    encoding: NSASCIIStringEncoding]);
+
+  PASS_EQUAL(read, @"hello", "what was written to its pipe is read")
+  PASS([task terminationStatus] == 0, "and it ends as having read it")
+
+  END_SET("NSFileHandle standard input from a pipe")
+  [arp release];
+  return 0;
+}
