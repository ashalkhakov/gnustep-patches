From eae73a94d9d14b18c0d2dbe930e50e6bcb47124b Mon Sep 17 00:00:00 2001
From: Artyom Shalkhakov <artyom.shalkhakov@gmail.com>
Date: Tue, 27 Oct 2026 19:33:10 +0500
Subject: [PATCH] win32: a standard stream is a console's only when it is a
 console

-initWithStandardInput (and Output, Error) marked the handle a standard
stream whatever it was, and reading a standard input in the background
peeked at it with PeekConsoleInput.  A program whose standard input is a
pipe (a language server or a debug adapter that a parent talks to over
one, or anything run as `a | b`) could not read it: the peek failed with
ERROR_INVALID_HANDLE, and as the failure did not end the read the run
loop asked again at once, logging "Standard input peek problem: 6" tens
of thousands of times a second and reading nothing.

A standard stream is now a console's only when GetFileType says it is a
character device; a pipe or a file is read and written as any other.
And a failed console peek ends the read with its error instead of
leaving it pending.

Tests/base/NSFileHandle/stdinPipe.m runs a helper (Helpers/stdinread)
that reads its standard input in the background, with that input a pipe:
on Windows (MSYS2 CLANG64) both checks fail without the change and pass
with it, and the NSFileHandle tests all pass (41).

Patch done with help of AI.
---
 Source/win32/GSFileHandle.m                  | 19 +++++--
 Tests/base/NSFileHandle/GNUmakefile.preamble |  4 ++
 Tests/base/NSFileHandle/Helpers/GNUmakefile  | 12 +++++
 Tests/base/NSFileHandle/Helpers/stdinread.m  | 50 ++++++++++++++++++
 Tests/base/NSFileHandle/stdinPipe.m          | 54 ++++++++++++++++++++
 5 files changed, 136 insertions(+), 3 deletions(-)
 create mode 100644 Tests/base/NSFileHandle/GNUmakefile.preamble
 create mode 100644 Tests/base/NSFileHandle/Helpers/GNUmakefile
 create mode 100644 Tests/base/NSFileHandle/Helpers/stdinread.m
 create mode 100644 Tests/base/NSFileHandle/stdinPipe.m

diff --git a/Source/win32/GSFileHandle.m b/Source/win32/GSFileHandle.m
index 08c914e..5e43173 100644
--- a/Source/win32/GSFileHandle.m
+++ b/Source/win32/GSFileHandle.m
@@ -1070,6 +1070,18 @@ - (id) initForUpdatingAtPath: (NSString*)path
     }
 }
 
+/* A standard stream that is a console's (a character device): one that is
+ * a pipe or a file (redirected, or a child's that a parent gave it) is
+ * read and written as any other.
+ */
+static BOOL
+isConsole(int descriptor)
+{
+  HANDLE	h = (HANDLE)_get_osfhandle(descriptor);
+
+  return h != INVALID_HANDLE_VALUE && GetFileType(h) == FILE_TYPE_CHAR;
+}
+
 - (id) initWithStandardError
 {
   if (fh_stderr != nil)
@@ -1083,7 +1095,7 @@ - (id) initWithStandardError
       if (self)
         {
           readOK = NO;
-          isStandardStream = YES;
+          isStandardStream = isConsole(2);
         }
     }
   return self;
@@ -1102,7 +1114,7 @@ - (id) initWithStandardInput
       if (self)
         {
           writeOK = NO;
-          isStandardStream = YES;
+          isStandardStream = isConsole(0);
           isStandardInput = YES;
         }
     }
@@ -1122,7 +1134,7 @@ - (id) initWithStandardOutput
       if (self)
         {
           readOK = NO;
-          isStandardStream = YES;
+          isStandardStream = isConsole(1);
         }
     }
   return self;
@@ -2243,6 +2255,7 @@ - (void) receivedEventRead
               [readInfo setObject: s forKey: GSFileHandleNotificationError];
 
               NSLog(@"%@", s);
+              [self postReadNotification];
               return;
             }
           else if (bytes == 0)
