From 2dd90086534ba315dcddee003c2b833893025752 Mon Sep 17 00:00:00 2001
From: Artyom Shalkhakov <artyom.shalkhakov@gmail.com>
Date: Sun, 11 Oct 2026 14:16:56 +0500
Subject: [PATCH] Reuse a placeholder namespace in scope when adding an
 attribute

An attribute named with a prefix that is not declared yet gets a
placeholder namespace, one with no href.  A second such attribute with
the same prefix, added to the same element, should use the placeholder
the first one left there, so that both are resolved together when the
element joins a tree that declares the prefix: the second case of
Tests/base/NSXMLElement/prefixedDescendants.m (#821).

With libxml2 2.9.14 that is what happens, inside xmlDOMWrapAdoptNode().
With 2.15.4, as in Debian testing, adoption finds no declaration in
scope for a namespace without an href and declares the placeholder
again under a made-up prefix, so the second attribute prints as
b_1:two and is in no namespace once the tree is built; the case was
marked hopeful for that.  xmlSearchNs() passes over namespaces without
an href in both versions, so it could not find the placeholder either.

-addAttribute: now looks for a placeholder in scope itself, and keeps
one it found out of the adoption, restoring it afterwards.

The case is no longer hopeful.  With libxml2 2.15.4 it fails without
the change and passes with it; with 2.9.14 it passes either way.  The
NSXMLElement, NSXMLNode and NSXMLDocument tests pass with both.
---
 Source/NSXMLElement.m                         | 37 +++++++++++++++++++
 Tests/base/NSXMLElement/prefixedDescendants.m |  2 -
 2 files changed, 37 insertions(+), 2 deletions(-)

diff --git a/Source/NSXMLElement.m b/Source/NSXMLElement.m
index 4926a7c6d..3498592b0 100644
--- a/Source/NSXMLElement.m
+++ b/Source/NSXMLElement.m
@@ -31,6 +31,27 @@
 #import "GSInternal.h"
 GS_PRIVATE_INTERNAL(NSXMLElement)
 
+/* The placeholder for prefix declared at node or an ancestor: a namespace
+ * with that prefix and no href, which xmlSearchNs() passes over.
+ */
+static xmlNsPtr
+searchPlaceholderNs(xmlNodePtr node, const xmlChar *prefix)
+{
+  for (; node != NULL && node->type == XML_ELEMENT_NODE; node = node->parent)
+    {
+      xmlNsPtr	cur;
+
+      for (cur = node->nsDef; cur != NULL; cur = cur->next)
+	{
+	  if (NULL == cur->href && xmlStrEqual(cur->prefix, prefix))
+	    {
+	      return cur;
+	    }
+	}
+    }
+  return NULL;
+}
+
 @implementation NSXMLElement
 
 - (void) dealloc
@@ -284,6 +305,10 @@ - (void) addAttribute: (NSXMLNode*)attribute
         {
           xmlNsPtr newNs = xmlSearchNs(theNode->doc, theNode, ns->prefix);
           
+          if (NULL == newNs)
+            {
+              newNs = searchPlaceholderNs(theNode, ns->prefix);
+            }
           if (newNs != NULL)
             {
               ns = newNs;
@@ -345,6 +370,14 @@ - (void) addAttribute: (NSXMLNode*)attribute
         }
 
 #if LIBXML_VERSION >= 20620
+      /* Adoption finds a namespace by its href, so it would declare a
+       * placeholder that is already in scope again, under a made-up
+       * prefix.  Such a one is kept out of the adoption.
+       */
+      if (resolved && NULL == ns->href)
+        {
+          attr->ns = NULL;
+        }
       if (xmlDOMWrapAdoptNode(NULL, attr->doc, (xmlNodePtr)attr,
         theNode->doc, theNode, 0) != 0)
         {
@@ -352,6 +385,10 @@ - (void) addAttribute: (NSXMLNode*)attribute
           attr->doc = tmp;
           xmlSetTreeDoc((xmlNodePtr)attr, theNode->doc);
         }
+      if (resolved && NULL == ns->href)
+        {
+          attr->ns = ns;
+        }
 #else
       xmlSetTreeDoc((xmlNodePtr)attr, theNode->doc);
 #endif
diff --git a/Tests/base/NSXMLElement/prefixedDescendants.m b/Tests/base/NSXMLElement/prefixedDescendants.m
index 7089bf929..986ec84de 100644
--- a/Tests/base/NSXMLElement/prefixedDescendants.m
+++ b/Tests/base/NSXMLElement/prefixedDescendants.m
@@ -41,8 +41,6 @@ int main()
   PASS_EQUAL([child URI], @"urn:a", "the grandchild is in the root's namespace")
   [doc release];
 
-testHopeful = YES;
-
   /* Two attributes with the same prefix on a grandchild. */
   r = root();
   parent = [NSXMLNode elementWithName: @"a:parent"];
