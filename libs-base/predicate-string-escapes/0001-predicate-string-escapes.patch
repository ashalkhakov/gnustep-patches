diff --git a/Tests/base/NSPredicate/stringEscapes.m b/Tests/base/NSPredicate/stringEscapes.m
new file mode 100644
index 0000000..37aa257
--- /dev/null
+++ b/Tests/base/NSPredicate/stringEscapes.m
@@ -0,0 +1,65 @@
+/* A quoted string in a format reads its backslash escapes as macOS does,
+   so that the format a predicate describes itself with, which escapes a
+   backslash and a quote, parses back to the same string.
+*/
+#import <Foundation/NSAutoreleasePool.h>
+#import <Foundation/NSComparisonPredicate.h>
+#import <Foundation/NSExpression.h>
+#import <Foundation/NSPredicate.h>
+#import <Foundation/NSString.h>
+#import "ObjectTesting.h"
+
+static NSString *
+constantOf(NSString *format)
+{
+  NSComparisonPredicate *p;
+
+  p = (NSComparisonPredicate *)[NSPredicate predicateWithFormat: format];
+  return [[p rightExpression] constantValue];
+}
+
+int
+main(int argc, char **argv)
+{
+  NSAutoreleasePool *arp = [NSAutoreleasePool new];
+  NSPredicate *p;
+
+  PASS_EQUAL(constantOf(@"SELF == \"a\\\\b\""), @"a\\b",
+             "a backslash escaped is one backslash");
+  PASS_EQUAL(constantOf(@"SELF == \"a\\\"b\""), @"a\"b",
+             "an escaped double quote does not end the string");
+  PASS_EQUAL(constantOf(@"SELF == 'a\\'b'"), @"a'b",
+             "an escaped single quote does not end the string");
+  PASS_EQUAL(constantOf(@"SELF == 'a\"b'"), @"a\"b",
+             "a double quote in single quotes is itself");
+  PASS_EQUAL(constantOf(@"SELF == \"a\\nb\\tc\\rd\""), @"a\nb\tc\rd",
+             "newline, tab and carriage return");
+  PASS_EQUAL(constantOf(@"SELF == \"a\\u0041b\""), @"aAb",
+             "a \\u escape is the character it names");
+  PASS_EQUAL(constantOf(@"SELF == \"a\\x41b\""), @"aAb",
+             "a \\x escape is the character it names");
+  PASS_EQUAL(constantOf(@"SELF == \"a\\101b\""), @"aAb",
+             "an octal escape is the character it names");
+  PASS_EQUAL(constantOf(@"SELF == \"a\\(b\""), @"a(b",
+             "any other escaped character is itself");
+
+  /* What a predicate describes itself with is read back the same. */
+  p = [NSPredicate predicateWithFormat: @"SELF MATCHES %@",
+    @"^(?:L|gal \\(US\\))$"];
+  PASS_EQUAL(constantOf([p predicateFormat]), @"^(?:L|gal \\(US\\))$",
+             "a pattern with escapes survives its description");
+  PASS([[NSPredicate predicateWithFormat: [p predicateFormat]]
+         evaluateWithObject: @"gal (US)"],
+       "and still matches what it matched");
+  p = [NSPredicate predicateWithFormat: @"SELF == %@", @"say \"hi\""];
+  PASS_EQUAL(constantOf([p predicateFormat]), @"say \"hi\"",
+             "a string with quotes survives its description");
+
+  /* A quote escaped inside a literal does not hide the arguments after it. */
+  p = [NSPredicate predicateWithFormat: @"SELF == \"a\\\"b\" OR SELF == %@",
+    @"c"];
+  PASS([p evaluateWithObject: @"c"], "an argument after an escaped quote");
+
+  [arp release];
+  return 0;
+}
