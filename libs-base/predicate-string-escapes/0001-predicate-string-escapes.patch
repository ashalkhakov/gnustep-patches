+/* Up to n digits of the base given, as one character. */
+static unichar
+scanDigits(NSString *string, NSUInteger *location, unsigned n, unsigned base)
+{
+  NSUInteger	length = [string length];
+  unichar	value = 0;
+
+  while (n-- > 0 && *location < length)
+    {
+      unichar	c = [string characterAtIndex: *location];
+      unsigned	digit;
+
+      if (c >= '0' && c <= '9')
+	digit = c - '0';
+      else if (c >= 'a' && c <= 'f')
+	digit = c - 'a' + 10;
+      else if (c >= 'A' && c <= 'F')
+	digit = c - 'A' + 10;
+      else
+	break;
+      if (digit >= base)
+	break;
+      value = value * base + digit;
+      (*location)++;
+    }
+  return value;
+}
+
+- (NSString *) parseQuotedLiteral: (unichar)quote
+{
+  NSString		*string = [self string];
+  NSUInteger		length = [string length];
+  NSUInteger		start = [self scanLocation];
+  NSUInteger		location = start;
+  NSMutableString	*result = [NSMutableString string];
+
+  while (location < length)
+    {
+      unichar	c = [string characterAtIndex: location++];
+
+      if (c == quote)
+	{
+	  [self setScanLocation: location];
+	  return result;
+	}
+      if (c == '\\' && location < length)
+	{
+	  c = [string characterAtIndex: location++];
+	  switch (c)
+	    {
+	      case 'n': c = '\n'; break;
+	      case 't': c = '\t'; break;
+	      case 'r': c = '\r'; break;
+	      case 'u':
+	      case 'U': c = scanDigits(string, &location, 4, 16); break;
+	      case 'x': c = scanDigits(string, &location, 2, 16); break;
+	      default:
+		if (c >= '0' && c <= '7')
+		  {
+		    location--;
+		    c = scanDigits(string, &location, 3, 8);
+		  }
+		break;
+	    }
+	}
+      [result appendString: [NSString stringWithCharacters: &c length: 1]];
+    }
+  [NSException raise: NSInvalidArgumentException
+	      format: @"Unterminated %s quoted literal at %lu",
+    quote == '"' ? "double" : "single", (unsigned long)start];
+  return nil;
+}
