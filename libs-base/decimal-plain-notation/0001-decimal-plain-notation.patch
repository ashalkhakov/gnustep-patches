From f24a8089ee6a44c4357deebf6a1fca515f17d9e6 Mon Sep 17 00:00:00 2001
From: Artyom Shalkhakov <artyom.shalkhakov@gmail.com>
Date: Tue, 29 Sep 2026 18:53:04 +0000
Subject: [PATCH] Write decimals in plain notation, and zero as 0

NSDecimalString() -- and so -[NSDecimalNumber description],
-descriptionWithLocale: and -stringValue -- wrote a number of more than
six digits, or a fraction with more than two zeros after the point, in
scientific notation, and zero as 0.0:

    1234567     1.234567E6
    1E7         1E7
    0.0001234   1.234E-4
    0           0.0

Apple's Foundation writes every decimal out in full and zero as 0
(1234567, 10000000, 0.0001234, 0), which is also what code that prints
a number for another parser to read -- an expression language, JSON --
needs: most of them have no exponent syntax, or a different one.

Write the digits positionally at any size, with the separator where the
exponent puts it, and zero as 0. The two tests in decimal_functions.m
that expected zero as 0.0 now expect 0, and plainNotation.m covers large
and small numbers.
---
 Source/NSDecimal.m                            | 62 +++++--------------
 .../base/NSDecimalNumber/decimal_functions.m  |  4 +-
 Tests/base/NSDecimalNumber/plainNotation.m    | 35 +++++++++++
 3 files changed, 53 insertions(+), 48 deletions(-)
 create mode 100644 Tests/base/NSDecimalNumber/plainNotation.m

diff --git a/Source/NSDecimal.m b/Source/NSDecimal.m
index 898592f2d..7ec756571 100644
--- a/Source/NSDecimal.m
+++ b/Source/NSDecimal.m
@@ -870,65 +870,35 @@ GSDecimalString(const GSDecimal *number, NSDictionary *locale)
 
   if (!number->length)
     {
-      [string appendString: @"0"];
-      [string appendString: sep];
-      [string appendString: @"0"];
-      return string;
+      return @"0";
     }
 
   if (number->isNegative)
     [string appendString: @"-"];
 
   size = number->length + number->exponent;
-  if ((number->length <= 6) && (0 < size) && (size < 7))
-    {
-      // For small numbers use the normal format
-      for (i = 0; i < number->length; i++)
-        {
-	  if (size == i)
-	    [string appendString: sep];
-	  d = number->cMantissa[i];
-	  s = [NSString stringWithFormat: @"%d", d];
-	  [string appendString: s];
-	}
-      for (i = 0; i < number->exponent; i++)
-        {
-	  [string appendString: @"0"];
-	}
-    }
-  else if ((number->length <= 6) && (0 >= size) && (size > -3))
+  if (size <= 0)
     {
-      // For small numbers use the normal format
       [string appendString: @"0"];
       [string appendString: sep];
-
-      for (i = 0; i > size; i--)
-        {
-	  [string appendString: @"0"];
-	}
-      for (i = 0; i < number->length; i++)
+      for (i = size; i < 0; i++)
         {
-	  d = number->cMantissa[i];
-	  s = [NSString stringWithFormat: @"%d", d];
-	  [string appendString: s];
-	}
+          [string appendString: @"0"];
+        }
     }
-  else
+  for (i = 0; i < number->length; i++)
     {
-      // Scientific format
-      for (i = 0; i < number->length; i++)
-        {
-	  if (1 == i)
-	    [string appendString: sep];
-	  d = number->cMantissa[i];
-	  s = [NSString stringWithFormat: @"%d", d];
-	  [string appendString: s];
-	}
-      if (size != 1)
+      if (i == size && i > 0)
         {
-	  s = [NSString stringWithFormat: @"E%d", size-1];
-	  [string appendString: s];
-	}
+          [string appendString: sep];
+        }
+      d = number->cMantissa[i];
+      s = [NSString stringWithFormat: @"%d", d];
+      [string appendString: s];
+    }
+  for (i = number->length; i < size; i++)
+    {
+      [string appendString: @"0"];
     }
 
   return string;
diff --git a/Tests/base/NSDecimalNumber/decimal_functions.m b/Tests/base/NSDecimalNumber/decimal_functions.m
index 78e2b27ad..bd4287653 100644
--- a/Tests/base/NSDecimalNumber/decimal_functions.m
+++ b/Tests/base/NSDecimalNumber/decimal_functions.m
@@ -37,7 +37,7 @@ int main(void)
   START_SET("NSDecimalFromString and NSDecimalString")
     PASS_EQUAL(dstr(dfs("1.5")), @"1.5",
       "a fractional value round-trips through string conversion");
-    PASS_EQUAL(dstr(dfs("0")), @"0.0", "zero formats as 0.0");
+    PASS_EQUAL(dstr(dfs("0")), @"0", "zero formats as 0");
     PASS_EQUAL(dstr(dfs("-42.25")), @"-42.25", "a negative value keeps its sign");
     PASS_EQUAL(dstr(dfs("100")), @"100", "an integer value has no fraction");
     PASS_EQUAL(dstr(dfs("0.015")), @"0.015", "a small value keeps leading zeros");
@@ -118,7 +118,7 @@ int main(void)
 
     a = dfs("0"); b = dfs("5");
     NSDecimalDivide(&r, &a, &b, NSRoundPlain);
-    PASS_EQUAL(dstr(r), @"0.0", "0 / 5 == 0");
+    PASS_EQUAL(dstr(r), @"0", "0 / 5 == 0");
 
     a = dfs("1"); b = dfs("3");
     e = NSDecimalDivide(&r, &a, &b, NSRoundPlain);
diff --git a/Tests/base/NSDecimalNumber/plainNotation.m b/Tests/base/NSDecimalNumber/plainNotation.m
new file mode 100644
index 000000000..db1783119
--- /dev/null
+++ b/Tests/base/NSDecimalNumber/plainNotation.m
@@ -0,0 +1,35 @@
+#import "Testing.h"
+#import <Foundation/NSAutoreleasePool.h>
+#import <Foundation/NSDecimalNumber.h>
+#import <Foundation/NSDictionary.h>
+
+static NSString *
+text(NSString *s)
+{
+  NSDictionary  *locale = [NSDictionary dictionaryWithObject: @"."
+                                                      forKey: NSDecimalSeparator];
+
+  return [[NSDecimalNumber decimalNumberWithString: s locale: locale]
+    descriptionWithLocale: locale];
+}
+
+int main()
+{
+  NSAutoreleasePool     *arp = [NSAutoreleasePool new];
+
+  START_SET("NSDecimalNumber plain notation")
+  PASS_EQUAL(text(@"0"), @"0", "zero is 0");
+  PASS_EQUAL(text(@"0.00"), @"0", "zero with a scale is 0");
+  PASS_EQUAL(text(@"-0.5"), @"-0.5", "a negative fraction");
+  PASS_EQUAL(text(@"1234567"), @"1234567", "seven digits are written out");
+  PASS_EQUAL(text(@"100000000000000000000"), @"100000000000000000000",
+    "a large number is written out");
+  PASS_EQUAL(text(@"1E7"), @"10000000", "a number read with an exponent is written out");
+  PASS_EQUAL(text(@"0.0001234"), @"0.0001234", "a small fraction is written out");
+  PASS_EQUAL(text(@"1.5E-8"), @"0.000000015", "a tiny fraction is written out");
+  PASS_EQUAL(text(@"1234567.891"), @"1234567.891", "a large number with a fraction");
+  END_SET("NSDecimalNumber plain notation")
+
+  [arp release];
+  return 0;
+}
-- 
