+    setup(@"America/Sao_Paulo", @"pt_BR");
+    start = nil;
+    length = 0;
+    ok = [cal rangeOfUnit: NSCalendarUnitDay startDate: &start
+      interval: &length forDate: D(1541332800.0)];
+    PASS(ok && is(start, 1541300400.0) && length == 82800.0,
+      "a day without midnight is 23 hours from its first moment");
+    ok = [cal rangeOfUnit: NSCalendarUnitDay startDate: &start
+      interval: &length forDate: D(1518868800.0)];
