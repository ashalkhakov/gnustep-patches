+- (BOOL) rangeOfUnit: (NSCalendarUnit) unit
+           startDate: (NSDate **) datep
+            interval: (NSTimeInterval*)tip
+             forDate: (NSDate*)date
+{
+#if GS_USE_ICU == 1
+  UErrorCode	err = U_ZERO_ERROR;
+  UDate		udate, start, end;
+  GSDay		d;
+  int32_t	first, next;
+
+  udate = _udate(date);
+  switch (unit)
+    {
+      case NSCalendarUnitHour:
+      case NSCalendarUnitMinute:
+      case NSCalendarUnitSecond:
+        ucal_setMillis(my->cal, udate, &err);
+        start = udate - ucal_get(my->cal, UCAL_MILLISECOND, &err);
+        end = start + 1000.0;
+        if (unit != NSCalendarUnitSecond)
+          {
+            start -= ucal_get(my->cal, UCAL_SECOND, &err) * 1000.0;
+            end = start + 60000.0;
+          }
+        if (unit == NSCalendarUnitHour)
+          {
+            start -= ucal_get(my->cal, UCAL_MINUTE, &err) * 60000.0;
+            end = start + 3600000.0;
+          }
+        break;
+      default:
+        _day(my->cal, _julianDay(my->cal, udate), &d);
+        if (!_unitDays(my->cal, unit, &d, (int32_t)my->firstWeekday,
+          &first, &next))
+          {
+            return NO;	// Era and any composite units are not handled.
+          }
+        start = _startOfDay(my->cal, first);
+        end = _startOfDay(my->cal, next);
+        break;
+    }
+  if (U_FAILURE(err))
+    {
+      return NO;
+    }
+
+  if (datep != NULL)
+    {
+      *datep = [NSDate dateWithTimeIntervalSince1970: start / 1000.0];
+    }
+  if (tip != NULL)
+    {
+      *tip = (end - start) / 1000.0;
+    }
+  return YES;
+#else
+  return NO;
+#endif
+}
