+- (NSComparisonResult) compareDate: (NSDate*)date1
+                            toDate: (NSDate*)date2
+                 toUnitGranularity: (NSCalendarUnit)unit
+{
+  NSComparisonResult	order = [date1 compare: date2];
+  NSDate		*start1 = nil;
+  NSDate		*start2 = nil;
+  NSDateComponents	*c1;
+  NSDateComponents	*c2;
+  NSCalendarUnit	units;
+  NSCalendarUnit	u;
+
+  switch (unit)
+    {
+      case NSCalendarUnitNanosecond:
+        return order;
+      case NSCalendarUnitSecond:
+      case NSCalendarUnitMinute:
+      case NSCalendarUnitHour:
+        if ([self rangeOfUnit: unit startDate: &start1 interval: NULL
+                      forDate: date1]
+          && [self rangeOfUnit: unit startDate: &start2 interval: NULL
+                       forDate: date2]
+          && [start1 isEqualToDate: start2])
+          {
+            return NSOrderedSame;
+          }
+        return order;
+      case NSCalendarUnitEra:
+        units = NSCalendarUnitEra;
+        break;
+      case NSCalendarUnitYear:
+        units = NSCalendarUnitEra | NSCalendarUnitYear;
+        break;
+      case NSCalendarUnitYearForWeekOfYear:
+        units = NSCalendarUnitEra | NSCalendarUnitYearForWeekOfYear;
+        break;
+      case NSCalendarUnitQuarter:
+        units = NSCalendarUnitEra | NSCalendarUnitYear | NSCalendarUnitQuarter;
+        break;
+      case NSCalendarUnitMonth:
+        units = NSCalendarUnitEra | NSCalendarUnitYear | NSCalendarUnitMonth;
+        break;
+      case NSCalendarUnitWeekOfYear:
+        units = NSCalendarUnitEra | NSCalendarUnitYearForWeekOfYear
+          | NSCalendarUnitWeekOfYear;
+        break;
+      case NSCalendarUnitWeekOfMonth:
+      case NSCalendarUnitWeekdayOrdinal:
+        units = NSCalendarUnitEra | NSCalendarUnitYear
+          | NSCalendarUnitMonth | unit;
+        break;
+      case NSCalendarUnitDay:
+      case NSCalendarUnitWeekday:
+        units = NSCalendarUnitEra | NSCalendarUnitYear
+          | NSCalendarUnitMonth | NSCalendarUnitDay;
+        break;
+      default:
+        [NSException raise: NSInvalidArgumentException
+                    format: @"%@ unit %lu is not supported",
+          NSStringFromSelector(_cmd), (unsigned long)unit];
+        return NSOrderedSame;
+    }
+  c1 = [self components: units fromDate: date1];
+  c2 = [self components: units fromDate: date2];
+  for (u = 1; u <= units; u <<= 1)
+    {
+      if ((units & u) && [c1 valueForComponent: u] != [c2 valueForComponent: u])
+        {
+          return order;
+        }
+    }
+  if ([c1 leapMonth] != [c2 leapMonth])
+    {
+      return order;
+    }
+  return NSOrderedSame;
+}
