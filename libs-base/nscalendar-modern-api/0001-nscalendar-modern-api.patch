+- (NSUInteger) ordinalityOfUnit: (NSCalendarUnit) smaller
+                         inUnit: (NSCalendarUnit) larger
+                        forDate: (NSDate*) date
+{
+#if GS_USE_ICU == 1
+  UErrorCode	err = U_ZERO_ERROR;
+  UDate		udate = _udate(date);
+  GSDay		d;
+  GSDay		s;
+  int32_t	first;
+  int32_t	next;
+  int32_t	days = 0;
+  int32_t	hour;
+  int32_t	minute;
+  int32_t	second;
+
+  _day(my->cal, _julianDay(my->cal, udate), &d);
+  ucal_setMillis(my->cal, udate, &err);
+  hour = ucal_get(my->cal, UCAL_HOUR_OF_DAY, &err);
+  minute = ucal_get(my->cal, UCAL_MINUTE, &err);
+  second = ucal_get(my->cal, UCAL_SECOND, &err);
+  if (U_FAILURE(err))
+    {
+      return NSNotFound;
+    }
+
+  switch (smaller)
+    {
+      case NSCalendarUnitYear:
+        return (larger == NSCalendarUnitEra) ? d.year : NSNotFound;
+      case NSCalendarUnitQuarter:
+        return (larger == NSCalendarUnitYear) ? (d.month + 2) / 3 : NSNotFound;
+      case NSCalendarUnitMonth:
+        if (larger == NSCalendarUnitYear)
+          return d.month;
+        if (larger == NSCalendarUnitQuarter)
+          return (d.month - 1) % 3 + 1;
+        return NSNotFound;
+      case NSCalendarUnitWeekdayOrdinal:
+        return (larger == NSCalendarUnitMonth)
+          ? (d.day - 1) / 7 + 1 : NSNotFound;
+      case NSCalendarUnitWeekOfYear:
+      case NSCalendarUnitWeekOfMonth:
+        if (larger != ((smaller == NSCalendarUnitWeekOfYear)
+          ? NSCalendarUnitYear : NSCalendarUnitMonth))
+          return NSNotFound;
+        _unitDays(my->cal, larger, &d, (int32_t)my->firstWeekday,
+          &first, &next);
+        _day(my->cal, first, &s);
+        return (d.jd - first + (s.weekday - (int32_t)my->firstWeekday + 7) % 7)
+          / 7 + 1;
+      case NSCalendarUnitDay:
+      case NSCalendarUnitWeekday:
+      case NSCalendarUnitHour:
+      case NSCalendarUnitMinute:
+      case NSCalendarUnitSecond:
+        if (larger == NSCalendarUnitMinute)
+          return (smaller == NSCalendarUnitSecond) ? second + 1 : NSNotFound;
+        if (larger == NSCalendarUnitHour)
+          {
+            if (smaller == NSCalendarUnitMinute)
+              return minute + 1;
+            if (smaller == NSCalendarUnitSecond)
+              return minute * 60 + second + 1;
+            return NSNotFound;
+          }
+        if (larger == NSCalendarUnitDay || larger == NSCalendarUnitWeekday)
+          {
+            if (smaller == NSCalendarUnitDay || smaller == NSCalendarUnitWeekday)
+              return NSNotFound;
+          }
+        else if (_unitDays(my->cal, larger, &d, (int32_t)my->firstWeekday,
+          &first, &next))
+          {
+            days = d.jd - first;
+          }
+        else
+          {
+            return NSNotFound;
+          }
+        switch (smaller)
+          {
+            case NSCalendarUnitDay:
+              return days + 1;
+            case NSCalendarUnitWeekday:
+              if (larger == NSCalendarUnitWeekOfYear
+                || larger == NSCalendarUnitWeekOfMonth)
+                return days + 1;
+              return days / 7 + 1;
+            case NSCalendarUnitHour:
+              return days * 24 + hour + 1;
+            case NSCalendarUnitMinute:
+              return (days * 24 + hour) * 60 + minute + 1;
+            default:
+              return ((days * 24 + hour) * 60 + minute) * 60 + second + 1;
+          }
+      default:
+        return NSNotFound;
+    }
+#else
+  return NSNotFound;
+#endif
+}
