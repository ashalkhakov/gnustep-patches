+/*
+ * nextDate.m - the 10.9 searches of NSCalendar: nextDateAfterDate:...,
+ * enumerateDatesStartingAfterDate:..., dateBySettingUnit:...,
+ * dateBySettingHour:... and date:matchesComponents:.
+ *
+ * Every expected date is what macOS 15 returns for the same call, with the
+ * same calendar (Gregorian, first weekday Sunday, one day in the first
+ * week) and time zone.  New York has a daylight saving gap on 2024-03-10
+ * (02:00-03:00 missing) and a repeated hour on 2024-11-03 (01:00-02:00
+ * twice); Sao Paulo's clocks skipped midnight on 2018-11-04 and repeated
+ * 23:00 on 2018-02-17.
+ */
+#import <Foundation/Foundation.h>
+#import "Testing.h"
+
+#if	defined(GS_USE_ICU)
+#define	NSCALENDAR_SUPPORTED	GS_USE_ICU
+#else
+#define	NSCALENDAR_SUPPORTED	1 /* Assume Apple support */
+#endif
+
+#define	X	NSDateComponentUndefined
+#define	NONE	(-1.0e300)
+
+static NSCalendar	*cal = nil;
+
+static void
+setup(NSString *zone)
+{
+  RELEASE(cal);
+  cal = [[NSCalendar alloc]
+    initWithCalendarIdentifier: NSCalendarIdentifierGregorian];
+  [cal setLocale: AUTORELEASE([[NSLocale alloc]
+    initWithLocaleIdentifier: @"en_US"])];
+  [cal setTimeZone: [NSTimeZone timeZoneWithName: zone]];
+  [cal setFirstWeekday: 1];
+  [cal setMinimumDaysInFirstWeek: 1];
+}
+
+static NSDate *
+D(NSTimeInterval t)
+{
+  return [NSDate dateWithTimeIntervalSince1970: t];
+}
+
+static BOOL
+is(NSDate *date, NSTimeInterval t)
+{
+  if (t == NONE)
+    {
+      return date == nil;
+    }
+  return date != nil && [date timeIntervalSince1970] == t;
+}
+
+/* era, year, month, day, hour, minute, second, nanosecond, weekday,
+ * weekdayOrdinal, weekOfMonth, weekOfYear, yearForWeekOfYear, quarter */
+static NSDateComponents *
+C(const NSInteger *f)
+{
+  NSDateComponents	*c = AUTORELEASE([NSDateComponents new]);
+
+  [c setEra: f[0]];
+  [c setYear: f[1]];
+  [c setMonth: f[2]];
+  [c setDay: f[3]];
+  [c setHour: f[4]];
+  [c setMinute: f[5]];
+  [c setSecond: f[6]];
+  [c setNanosecond: f[7]];
+  [c setWeekday: f[8]];
+  [c setWeekdayOrdinal: f[9]];
+  [c setWeekOfMonth: f[10]];
+  [c setWeekOfYear: f[11]];
+  [c setYearForWeekOfYear: f[12]];
+  [c setQuarter: f[13]];
+  return c;
+}
+
+static NSDateComponents *
+HMS(NSInteger d, NSInteger h, NSInteger m, NSInteger s)
+{
+  NSInteger	f[14] = { X, X, X, d, h, m, s, X, X, X, X, X, X, X };
+
+  return C(f);
+}
