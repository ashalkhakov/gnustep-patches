+      {
+	setup([NSString stringWithUTF8String: starts[i].zone], @"en_US");
+	PASS(is([cal startOfDayForDate: D(starts[i].date)], starts[i].start),
+	  "-startOfDayForDate: %.1f in %s", starts[i].date, starts[i].zone);
