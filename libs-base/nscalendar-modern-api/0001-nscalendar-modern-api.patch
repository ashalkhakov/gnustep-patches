+typedef struct {
+  double	date;
+  BOOL		exact;
+} Found;
+
+/* Collects the first count dates an enumeration finds. */
+static BOOL
+enumerated(double after, NSDateComponents *comps, NSUInteger options,
+  const Found *expected, int count)
+{
+  __block int	n = 0;
+  __block BOOL	ok = YES;
+
+  [cal enumerateDatesStartingAfterDate: D(after)
+		    matchingComponents: comps
+			       options: options
+			    usingBlock: ^(NSDate *date, BOOL exact, BOOL *stop)
+    {
+      if (n >= count || !is(date, expected[n].date)
+	|| exact != expected[n].exact)
+	{
+	  ok = NO;
+	}
+      if (++n >= count)
+	{
+	  *stop = YES;
+	}
+    }];
+  return ok && n == count;
+}
