+- (BOOL) isDateInToday: (NSDate *)date;
+
+/** Returns YES when date falls on the day before the current day.
+ */
+- (BOOL) isDateInYesterday: (NSDate *)date;
+
+/** Returns YES when date falls on the day after the current day.
+ */
+- (BOOL) isDateInTomorrow: (NSDate *)date;
+
+/** Returns YES when date falls within a weekend of the receiver's locale.
+ */
+- (BOOL) isDateInWeekend: (NSDate *)date;
+
+/** Returns by reference the start and length of the weekend containing
+ * date, or NO when date is not in a weekend.
+ */
+- (BOOL) rangeOfWeekendStartDate: (NSDate **)datep
+                        interval: (NSTimeInterval *)tip
+                  containingDate: (NSDate *)date;
+
+/** Returns by reference the start and length of the next weekend after
+ * date (or the one before it with NSCalendarSearchBackwards).  A weekend
+ * containing date is not returned.
+ */
+- (BOOL) nextWeekendStartDate: (NSDate **)datep
+                     interval: (NSTimeInterval *)tip
+                      options: (NSCalendarOptions)options
+                    afterDate: (NSDate *)date;
+
+/** Returns the difference between the dates the two sets of components
+ * describe, in the given units.
+ */
+- (NSDateComponents *) components: (NSCalendarUnit)unitFlags
+               fromDateComponents: (NSDateComponents *)startingDateComp
+                 toDateComponents: (NSDateComponents *)resultDateComp
+                          options: (NSCalendarOptions)options;
+
+/** Returns date with value added to the given unit.
+ */
+- (NSDate *) dateByAddingUnit: (NSCalendarUnit)unit
+                        value: (NSInteger)value
+                       toDate: (NSDate *)date
+                      options: (NSCalendarOptions)options;
+
+/** Calls block with each date after start (or before it, with
+ * NSCalendarSearchBackwards) which matches comps, until the block sets
+ * its last argument to YES.  The options choose what is returned where
+ * no date matches exactly: see -nextDateAfterDate:matchingComponents:options:
+ */
+- (void) enumerateDatesStartingAfterDate: (NSDate *)start
+                      matchingComponents: (NSDateComponents *)comps
+                                 options: (NSCalendarOptions)opts
+                              usingBlock: (GSCalendarEnumerationBlock)block;
+
+/** Returns the first date after date (or before it, with
+ * NSCalendarSearchBackwards) which matches comps.  Units smaller than the
+ * largest one set in comps and not set themselves take their smallest
+ * value.<br />
+ * With NSCalendarMatchStrictly the search goes on until an exact match.
+ * Otherwise, where the match does not exist (a day of the month the month
+ * does not have, a time skipped by a daylight saving change), the result
+ * is the next moment which exists (NSCalendarMatchNextTime), or the next
+ * or previous existing value of the missing unit with the smaller units
+ * kept (NSCalendarMatchNextTimePreservingSmallerUnits,
+ * NSCalendarMatchPreviousTimePreservingSmallerUnits).  Of two matching
+ * times, the first is returned, or the last with NSCalendarMatchLast.
+ */
+- (NSDate *) nextDateAfterDate: (NSDate *)date
+            matchingComponents: (NSDateComponents *)comps
+                       options: (NSCalendarOptions)options;
+
+/** Returns the first date after date matching a single unit's value.
+ */
+- (NSDate *) nextDateAfterDate: (NSDate *)date
+                  matchingUnit: (NSCalendarUnit)unit
+                         value: (NSInteger)value
+                       options: (NSCalendarOptions)options;
+
+/** Returns the first date after date with the given time of day;
+ * NSDateComponentUndefined leaves a value unset.
+ */
+- (NSDate *) nextDateAfterDate: (NSDate *)date
+                  matchingHour: (NSInteger)hourValue
+                        minute: (NSInteger)minuteValue
+                        second: (NSInteger)secondValue
+                       options: (NSCalendarOptions)options;
+
+/** Returns date with the given unit set to v: date itself when the unit
+ * already has that value, otherwise the next date which has it.
+ */
+- (NSDate *) dateBySettingUnit: (NSCalendarUnit)unit
+                         value: (NSInteger)v
+                        ofDate: (NSDate *)date
+                       options: (NSCalendarOptions)opts;
+
+/** Returns the moment on the day of date with the given time of day, or
+ * the next one which exists.
+ */
+- (NSDate *) dateBySettingHour: (NSInteger)h
+                        minute: (NSInteger)m
+                        second: (NSInteger)s
+                        ofDate: (NSDate *)date
+                       options: (NSCalendarOptions)opts;
+
+/** Returns YES when every component set in components has the same value
+ * in date.
+ */
+- (BOOL) date: (NSDate *)date matchesComponents: (NSDateComponents *)components;
 #endif
 
 @end
diff --git a/Source/NSCalendar.m b/Source/NSCalendar.m
index 6c3d6bea4..a6be693c0 100644
--- a/Source/NSCalendar.m
+++ b/Source/NSCalendar.m
@@ -22,6 +22,7 @@
 */
 
 #import "common.h"
+#import "Foundation/NSAutoreleasePool.h"
 #import "Foundation/NSCalendar.h"
 #import "Foundation/NSCoder.h"
 #import "Foundation/NSDate.h"
@@ -30,6 +31,7 @@
 #import "Foundation/NSLocale.h"
 #import "Foundation/NSLock.h"
 #import "Foundation/NSNotification.h"
+#import "Foundation/NSSet.h"
 #import "Foundation/NSString.h"
 #import "Foundation/NSTimeZone.h"
 #import "Foundation/NSUserDefaults.h"
@@ -150,11 +152,643 @@ - (void) _setLocaleIdentifier: (NSString*)identifier;
 
 static NSCalendar *autoupdatingCalendar = nil;
 static NSRecursiveLock *classLock = nil;
+static NSSet *knownIdentifiers = nil;
 
 #define TZ_NAME_LENGTH 1024
 #define SECOND_TO_MILLI 1000.0
 #define MILLI_TO_NANO 1000000
 
+#if GS_USE_ICU == 1
+#define	UNDEF	NSDateComponentUndefined
+
+static inline UDate
+_udate(NSDate *date)
+{
+  return (UDate)floor([date timeIntervalSince1970] * SECOND_TO_MILLI);
+}
+
+static NSInteger
+_nanosecond(NSDate *date)
+{
+  NSTimeInterval	t = [date timeIntervalSinceReferenceDate];
+
+  return (NSInteger)((t - floor(t)) * 1000000000.0);
+}
+
+static NSDateComponents *
+_components(UCalendar *cal, NSUInteger unitFlags, NSDate *date,
+  NSCalendar *calendar, NSTimeZone *tz)
+{
+  NSDateComponents *comps;
+  UErrorCode err = U_ZERO_ERROR;
+
+  ucal_setMillis(cal, _udate(date), &err);
+  if (U_FAILURE(err))
+    {
+      return nil;
+    }
+
+  comps = [[NSDateComponents alloc] init];
+  if (unitFlags & NSCalendarUnitEra)
+    {
+      [comps setEra: ucal_get(cal, UCAL_ERA, &err)];
+    }
+  if (unitFlags & NSCalendarUnitYear)
+    {
+      [comps setYear: ucal_get(cal, UCAL_YEAR, &err)];
+    }
+  if (unitFlags & NSCalendarUnitMonth)
+    {
+      [comps setMonth: ucal_get(cal, UCAL_MONTH, &err) + 1];
+      [comps setLeapMonth: ucal_get(cal, UCAL_IS_LEAP_MONTH, &err) != 0];
+    }
+  if (unitFlags & NSCalendarUnitDay)
+    {
+      [comps setDay: ucal_get(cal, UCAL_DAY_OF_MONTH, &err)];
+    }
+  if (unitFlags & NSCalendarUnitHour)
+    {
+      [comps setHour: ucal_get(cal, UCAL_HOUR_OF_DAY, &err)];
+    }
+  if (unitFlags & NSCalendarUnitMinute)
+    {
+      [comps setMinute: ucal_get(cal, UCAL_MINUTE, &err)];
+    }
+  if (unitFlags & NSCalendarUnitSecond)
+    {
+      [comps setSecond: ucal_get(cal, UCAL_SECOND, &err)];
+    }
+  if (unitFlags & (NSWeekCalendarUnit | NSCalendarUnitWeekOfYear))
+    {
+      [comps setWeek: ucal_get(cal, UCAL_WEEK_OF_YEAR, &err)];
+    }
+  if (unitFlags & NSCalendarUnitWeekday)
+    {
+      [comps setWeekday: ucal_get(cal, UCAL_DAY_OF_WEEK, &err)];
+    }
+  if (unitFlags & NSCalendarUnitWeekdayOrdinal)
+    {
+      [comps setWeekdayOrdinal:
+               ucal_get(cal, UCAL_DAY_OF_WEEK_IN_MONTH, &err)];
+    }
+  if (unitFlags & NSCalendarUnitQuarter)
+    {
+      [comps setQuarter: (ucal_get(cal, UCAL_MONTH, &err) + 3) / 3];
+    }
+  if (unitFlags & NSCalendarUnitWeekOfMonth)
+    {
+      [comps setWeekOfMonth: ucal_get(cal, UCAL_WEEK_OF_MONTH, &err)];
+    }
+  if (unitFlags & NSCalendarUnitYearForWeekOfYear)
+    {
+      [comps setYearForWeekOfYear: ucal_get(cal, UCAL_YEAR_WOY, &err)];
+    }
+  if (unitFlags & NSCalendarUnitNanosecond)
+    {
+      [comps setNanosecond: _nanosecond(date)];
+    }
+  if (unitFlags & NSCalendarUnitCalendar)
+    {
+      [comps setCalendar: calendar];
+    }
+  if (unitFlags & NSCalendarUnitTimeZone)
+    {
+      [comps setTimeZone: tz];
+    }
+  if (U_FAILURE(err))
+    {
+      RELEASE(comps);
+      return nil;
+    }
+  return AUTORELEASE(comps);
+}
+
+/* The fields of one day, for the searches over days. */
+typedef struct {
+  int32_t	jd;
+  int32_t	era;
+  int32_t	year;
+  int32_t	month;		/* 1-based */
+  int32_t	day;
+  int32_t	weekday;
+  int32_t	weekdayOrdinal;
+  int32_t	weekOfMonth;
+  int32_t	weekOfYear;
+  int32_t	yearForWeekOfYear;
+  int32_t	dayOfYear;
+  int32_t	monthLength;
+  int32_t	yearLength;
+} GSDay;
+
+static void
+_day(UCalendar *cal, int32_t jd, GSDay *d)
+{
+  UErrorCode err = U_ZERO_ERROR;
+
+  ucal_clear(cal);
+  ucal_set(cal, UCAL_JULIAN_DAY, jd);
+  d->jd = jd;
+  d->era = ucal_get(cal, UCAL_ERA, &err);
+  d->year = ucal_get(cal, UCAL_YEAR, &err);
+  d->month = ucal_get(cal, UCAL_MONTH, &err) + 1;
+  d->day = ucal_get(cal, UCAL_DAY_OF_MONTH, &err);
+  d->weekday = ucal_get(cal, UCAL_DAY_OF_WEEK, &err);
+  d->weekdayOrdinal = ucal_get(cal, UCAL_DAY_OF_WEEK_IN_MONTH, &err);
+  d->weekOfMonth = ucal_get(cal, UCAL_WEEK_OF_MONTH, &err);
+  d->weekOfYear = ucal_get(cal, UCAL_WEEK_OF_YEAR, &err);
+  d->yearForWeekOfYear = ucal_get(cal, UCAL_YEAR_WOY, &err);
+  d->dayOfYear = ucal_get(cal, UCAL_DAY_OF_YEAR, &err);
+  d->monthLength = ucal_getLimit(cal, UCAL_DAY_OF_MONTH,
+    UCAL_ACTUAL_MAXIMUM, &err);
+  d->yearLength = ucal_getLimit(cal, UCAL_DAY_OF_YEAR,
+    UCAL_ACTUAL_MAXIMUM, &err);
+}
+
+/* The local day containing a moment, as a Julian day number. */
+static int32_t
+_julianDay(UCalendar *cal, UDate udate)
+{
+  UErrorCode err = U_ZERO_ERROR;
+
+  ucal_setMillis(cal, udate, &err);
+  return ucal_get(cal, UCAL_JULIAN_DAY, &err);
+}
+
+/* The wall time h:m:s on day jd; *exists says whether the clock shows it. */
+static UDate
+_wallTime(UCalendar *cal, int32_t jd, int32_t h, int32_t m, int32_t s,
+  UCalendarWallTimeOption skipped, UCalendarWallTimeOption repeated,
+  BOOL *exists)
+{
+  UErrorCode	err = U_ZERO_ERROR;
+  UDate		udate;
+
+  ucal_setAttribute(cal, UCAL_SKIPPED_WALL_TIME, skipped);
+  ucal_setAttribute(cal, UCAL_REPEATED_WALL_TIME, repeated);
+  ucal_clear(cal);
+  ucal_set(cal, UCAL_JULIAN_DAY, jd);
+  ucal_set(cal, UCAL_HOUR_OF_DAY, h);
+  ucal_set(cal, UCAL_MINUTE, m);
+  ucal_set(cal, UCAL_SECOND, s);
+  udate = ucal_getMillis(cal, &err);
+  ucal_setAttribute(cal, UCAL_SKIPPED_WALL_TIME, UCAL_WALLTIME_LAST);
+  ucal_setAttribute(cal, UCAL_REPEATED_WALL_TIME, UCAL_WALLTIME_FIRST);
+  if (exists != NULL)
+    {
+      ucal_setMillis(cal, udate, &err);
+      *exists = (ucal_get(cal, UCAL_JULIAN_DAY, &err) == jd
+        && ucal_get(cal, UCAL_HOUR_OF_DAY, &err) == h
+        && ucal_get(cal, UCAL_MINUTE, &err) == m
+        && ucal_get(cal, UCAL_SECOND, &err) == s);
+    }
+  return udate;
+}
+
+/* The first moment of day jd, which need not be midnight. */
+static UDate
+_startOfDay(UCalendar *cal, int32_t jd)
+{
+  return _wallTime(cal, jd, 0, 0, 0,
+    UCAL_WALLTIME_LAST, UCAL_WALLTIME_FIRST, NULL);
+}
+
+/* What a search for a date matching components looks for. */
+typedef struct {
+  NSInteger	era;
+  NSInteger	year;
+  NSInteger	quarter;
+  NSInteger	month;
+  NSInteger	day;
+  NSInteger	weekday;
+  NSInteger	weekdayOrdinal;
+  NSInteger	weekOfMonth;
+  NSInteger	weekOfYear;
+  NSInteger	yearForWeekOfYear;
+  NSInteger	hour;
+  NSInteger	minute;
+  NSInteger	second;
+  NSInteger	nanosecond;
+  BOOL		hasDay;
+  BOOL		hasTime;
+  BOOL		backwards;
+  BOOL		last;
+  enum { GSMatchStrictly, GSMatchNextTime, GSMatchNextPreserving,
+    GSMatchPreviousPreserving } policy;
+  int32_t	firstWeekday;
+  int32_t	keepHour;
+  int32_t	keepMinute;
+  int32_t	keepSecond;
+} GSMatch;
+
+static BOOL
+_inRange(NSInteger v, NSInteger lo, NSInteger hi)
+{
+  return v == UNDEF || (v >= lo && v <= hi);
+}
+
+static BOOL
+_setUpMatch(GSMatch *m, NSDateComponents *comps, NSCalendarOptions opts)
+{
+  m->era = [comps era];
+  m->year = [comps year];
+  m->quarter = [comps quarter];
+  m->month = [comps month];
+  m->day = [comps day];
+  m->weekday = [comps weekday];
+  m->weekdayOrdinal = [comps weekdayOrdinal];
+  m->weekOfMonth = [comps weekOfMonth];
+  m->weekOfYear = [comps weekOfYear];
+  m->yearForWeekOfYear = [comps yearForWeekOfYear];
+  m->hour = [comps hour];
+  m->minute = [comps minute];
+  m->second = [comps second];
+  m->nanosecond = [comps nanosecond];
+  m->hasDay = (m->era != UNDEF || m->year != UNDEF || m->quarter != UNDEF
+    || m->month != UNDEF || m->day != UNDEF || m->weekday != UNDEF
+    || m->weekdayOrdinal != UNDEF || m->weekOfMonth != UNDEF
+    || m->weekOfYear != UNDEF || m->yearForWeekOfYear != UNDEF);
+  m->hasTime = (m->hour != UNDEF || m->minute != UNDEF
+    || m->second != UNDEF || m->nanosecond != UNDEF);
+
+  if (opts & NSCalendarMatchStrictly)
+    m->policy = GSMatchStrictly;
+  else if (opts & NSCalendarMatchNextTimePreservingSmallerUnits)
+    m->policy = GSMatchNextPreserving;
+  else if (opts & NSCalendarMatchPreviousTimePreservingSmallerUnits)
+    m->policy = GSMatchPreviousPreserving;
+  else
+    m->policy = GSMatchNextTime;
+  m->backwards = (opts & NSCalendarSearchBackwards) ? YES : NO;
+  /* Searching backwards, the first of two matches met is the later. */
+  m->last = ((opts & NSCalendarMatchLast) ? YES : NO) != m->backwards;
+
+  return (m->hasDay || m->hasTime)
+    && _inRange(m->quarter, 1, 4) && _inRange(m->month, 1, 13)
+    && _inRange(m->day, 1, 31) && _inRange(m->weekday, 1, 7)
+    && _inRange(m->weekdayOrdinal, -6, 6) && _inRange(m->weekOfMonth, 0, 6)
+    && _inRange(m->weekOfYear, 1, 53) && _inRange(m->hour, 0, 23)
+    && _inRange(m->minute, 0, 59) && _inRange(m->second, 0, 59)
+    && _inRange(m->nanosecond, 0, 999999999);
+}
+
+#define	MISMATCH(f, v)	(m->f != UNDEF && m->f != (v))
+
+static BOOL
+_monthMatches(const GSMatch *m, const GSDay *d)
+{
+  return !MISMATCH(era, d->era) && !MISMATCH(year, d->year)
+    && !MISMATCH(month, d->month)
+    && !MISMATCH(quarter, (d->month + 2) / 3);
+}
+
+static BOOL
+_dayMatches(const GSMatch *m, const GSDay *d)
+{
+  return _monthMatches(m, d) && !MISMATCH(day, d->day)
+    && !MISMATCH(weekday, d->weekday)
+    && !MISMATCH(weekdayOrdinal, d->weekdayOrdinal)
+    && !MISMATCH(weekOfMonth, d->weekOfMonth)
+    && !MISMATCH(weekOfYear, d->weekOfYear)
+    && !MISMATCH(yearForWeekOfYear, d->yearForWeekOfYear);
+}
+
+/* The next day worth trying after d, which does not match. */
+static int32_t
+_skip(const GSMatch *m, const GSDay *d)
+{
+  int32_t	jd = d->jd;
+  int32_t	toWeek;
+
+  if (m->backwards)
+    {
+      if (MISMATCH(era, d->era) || MISMATCH(weekday, d->weekday)
+        || MISMATCH(weekdayOrdinal, d->weekdayOrdinal))
+        return jd - 1;
+      if (MISMATCH(year, d->year))
+        return jd - d->dayOfYear;
+      if (MISMATCH(month, d->month) || MISMATCH(quarter, (d->month + 2) / 3))
+        return jd - d->day;
+      if (MISMATCH(day, d->day))
+        return (d->day > m->day) ? jd - (d->day - m->day) : jd - d->day;
+      toWeek = (d->weekday - m->firstWeekday + 7) % 7 + 1;
+      if (MISMATCH(weekOfMonth, d->weekOfMonth))
+        return jd - ((toWeek < d->day) ? toWeek : d->day);
+      return jd - toWeek;
+    }
+  if (MISMATCH(era, d->era) || MISMATCH(weekday, d->weekday)
+    || MISMATCH(weekdayOrdinal, d->weekdayOrdinal))
+    return jd + 1;
+  if (MISMATCH(year, d->year))
+    return jd + d->yearLength - d->dayOfYear + 1;
+  if (MISMATCH(month, d->month) || MISMATCH(quarter, (d->month + 2) / 3))
+    return jd + d->monthLength - d->day + 1;
+  if (MISMATCH(day, d->day))
+    return (d->day < m->day && m->day <= d->monthLength)
+      ? jd + (m->day - d->day) : jd + d->monthLength - d->day + 1;
+  toWeek = (m->firstWeekday - d->weekday + 6) % 7 + 1;
+  if (MISMATCH(weekOfMonth, d->weekOfMonth)
+    && d->monthLength - d->day + 1 < toWeek)
+    return jd + d->monthLength - d->day + 1;
+  return jd + toWeek;
+}
+
+/* Whether t is on the searched side of the start. */
+static inline BOOL
+_beyond(const GSMatch *m, UDate t, UDate start)
+{
+  return m->backwards ? (t < start) : (t > start);
+}
+
+/* The match on day jd beyond start, if there is one. */
+static BOOL
+_matchOnDay(UCalendar *cal, const GSMatch *m, int32_t jd, UDate start,
+  UDate *result, BOOL *exact)
+{
+  double	ns = (m->nanosecond == UNDEF) ? 0.0 : m->nanosecond / 1.0e6;
+  UDate		udate;
+
+  if (m->hasDay || m->hour != UNDEF)
+    {
+      BOOL	exists = YES;
+
+      if (!m->hasTime)
+        {
+          udate = _startOfDay(cal, jd);
+        }
+      else
+        {
+          UCalendarWallTimeOption skipped;
+
+          switch (m->policy)
+            {
+              case GSMatchNextTime:
+                skipped = UCAL_WALLTIME_NEXT_VALID;
+                break;
+              case GSMatchPreviousPreserving:
+                skipped = UCAL_WALLTIME_FIRST;
+                break;
+              default:
+                skipped = UCAL_WALLTIME_LAST;
+                break;
+            }
+          udate = _wallTime(cal, jd,
+            (m->hour == UNDEF) ? 0 : m->hour,
+            (m->minute == UNDEF) ? 0 : m->minute,
+            (m->second == UNDEF) ? 0 : m->second, skipped,
+            m->last ? UCAL_WALLTIME_LAST : UCAL_WALLTIME_FIRST, &exists);
+          if (exists)
+            {
+              udate += ns;
+            }
+          else if (m->policy == GSMatchStrictly)
+            {
+              return NO;
+            }
+        }
+      if (!_beyond(m, udate, start))
+        {
+          return NO;
+        }
+      *result = udate;
+      *exact = exists;
+      return YES;
+    }
+  else
+    {
+      UErrorCode	err = U_ZERO_ERROR;
+      UDate		base = _startOfDay(cal, jd);
+      UDate		end = _startOfDay(cal, jd + 1);
+      double		step;
+      double		offset;
+      double		k;
+
+      if (m->minute != UNDEF)
+        {
+          step = 3600000.0;
+          offset = m->minute * 60000.0
+            + ((m->second == UNDEF) ? 0 : m->second * 1000.0) + ns;
+        }
+      else if (m->second != UNDEF)
+        {
+          step = 60000.0;
+          offset = m->second * 1000.0 + ns;
+        }
+      else
+        {
+          step = 1000.0;
+          offset = ns;
+        }
+      k = floor(((m->backwards ? ((start < end) ? start : end) : start)
+        - base - offset) / step);
+      if (k < 0)
+        {
+          k = m->backwards ? -1 : 0;
+        }
+      while (k >= 0)
+        {
+          udate = base + k * step + offset;
+          if (udate >= end)
+            {
+              if (!m->backwards)
+                {
+                  break;
+                }
+            }
+          else if (_beyond(m, udate, start))
+            {
+              ucal_setMillis(cal, floor(udate), &err);
+              if ((m->minute == UNDEF
+                || ucal_get(cal, UCAL_MINUTE, &err) == m->minute)
+                && (m->second == UNDEF
+                || ucal_get(cal, UCAL_SECOND, &err) == m->second))
+                {
+                  *result = udate;
+                  *exact = YES;
+                  return YES;
+                }
+            }
+          k += m->backwards ? -1 : 1;
+        }
+      return NO;
+    }
+}
+
+/* What stands in for a day of the month which month d has not got. */
+static UDate
+_missingDay(UCalendar *cal, const GSMatch *m, const GSDay *d)
+{
+  int32_t	jd;
+
+  if (m->policy == GSMatchNextTime)
+    {
+      return _startOfDay(cal, d->jd - d->day + d->monthLength + 1);
+    }
+  jd = d->jd - d->day + d->monthLength;
+  if (m->policy == GSMatchNextPreserving)
+    {
+      jd++;
+    }
+  return _wallTime(cal, jd,
+    (m->hour == UNDEF) ? m->keepHour : m->hour,
+    (m->minute == UNDEF) ? m->keepMinute : m->minute,
+    (m->second == UNDEF) ? m->keepSecond : m->second,
+    UCAL_WALLTIME_LAST, UCAL_WALLTIME_FIRST, NULL)
+    + ((m->nanosecond == UNDEF) ? 0.0 : m->nanosecond / 1.0e6);
+}
+
+#define	GS_SEARCH_LIMIT	20000
+
+/* The first date after (or before) start which matches m. */
+static BOOL
+_search(UCalendar *cal, const GSMatch *m, UDate start, UDate *result,
+  BOOL *exact)
+{
+  BOOL		mayMiss;
+  BOOL		pinned;
+  int32_t	jd;
+  int32_t	monthChecked = 0;
+  int32_t	eraMax;
+  UErrorCode	err = U_ZERO_ERROR;
+  GSDay		d;
+  GSDay		prev;
+  int		n;
+
+  mayMiss = (m->policy != GSMatchStrictly && m->day != UNDEF
+    && m->weekday == UNDEF && m->weekdayOrdinal == UNDEF
+    && m->weekOfMonth == UNDEF && m->weekOfYear == UNDEF
+    && m->yearForWeekOfYear == UNDEF);
+  pinned = (m->day != UNDEF || m->weekday != UNDEF);
+  eraMax = ucal_getLimit(cal, UCAL_ERA, UCAL_MAXIMUM, &err);
+  jd = _julianDay(cal, start);
+  for (n = 0; n < GS_SEARCH_LIMIT; n++)
+    {
+      if (!m->hasDay)
+        {
+          if (_matchOnDay(cal, m, jd, start, result, exact))
+            {
+              return YES;
+            }
+          jd += m->backwards ? -1 : 1;
+          continue;
+        }
+
+      _day(cal, jd, &d);
+      if (mayMiss && d.jd - d.day != monthChecked)
+        {
+          monthChecked = d.jd - d.day;
+          if (m->day > d.monthLength && _monthMatches(m, &d))
+            {
+              UDate	udate = _missingDay(cal, m, &d);
+
+              if (_beyond(m, udate, start))
+                {
+                  *result = udate;
+                  *exact = NO;
+                  return YES;
+                }
+            }
+        }
+      if (!_dayMatches(m, &d))
+        {
+          /* Years only go one way in a calendar of one era. */
+          if (m->year != UNDEF && eraMax <= 1 && d.era == 1
+            && !MISMATCH(era, 1)
+            && (m->backwards ? d.year < m->year : d.year > m->year))
+            {
+              return NO;
+            }
+          jd = _skip(m, &d);
+          continue;
+        }
+      if (!pinned)
+        {
+          _day(cal, jd - 1, &prev);
+          if (_dayMatches(m, &prev))
+            {
+              jd += m->backwards ? -1 : 1;
+              continue;
+            }
+        }
+      if (_matchOnDay(cal, m, jd, start, result, exact))
+        {
+          return YES;
+        }
+      jd += m->backwards ? -1 : 1;
+    }
+  return NO;
+}
+
+/* Whether the day jd is (at least partly) in a weekend. */
+static BOOL
+_isWeekendDay(UCalendar *cal, int32_t jd)
+{
+  UErrorCode	err = U_ZERO_ERROR;
+  GSDay		d;
+
+  _day(cal, jd, &d);
+  return ucal_getDayOfWeekType(cal, d.weekday, &err) != UCAL_WEEKDAY
+    && U_SUCCESS(err);
+}
+
+/* The first day of the unit containing d, and the first day after it. */
+static BOOL
+_unitDays(UCalendar *cal, NSCalendarUnit unit, const GSDay *d,
+  int32_t firstWeekday, int32_t *first, int32_t *next)
+{
+  GSDay		o;
+  int		i;
+
+  switch (unit)
+    {
+      case NSCalendarUnitDay:
+      case NSCalendarUnitWeekday:
+      case NSCalendarUnitWeekdayOrdinal:
+        *first = d->jd;
+        *next = d->jd + 1;
+        return YES;
+      case NSCalendarUnitWeekOfYear:
+      case NSCalendarUnitWeekOfMonth:
+        *first = d->jd - (d->weekday - firstWeekday + 7) % 7;
+        *next = *first + 7;
+        return YES;
+      case NSCalendarUnitMonth:
+        *first = d->jd - d->day + 1;
+        *next = *first + d->monthLength;
+        return YES;
+      case NSCalendarUnitQuarter:
+        *first = d->jd - d->day + 1;
+        for (i = (d->month - 1) % 3; i > 0; i--)
+          {
+            _day(cal, *first - 1, &o);
+            *first -= o.monthLength;
+          }
+        *next = *first;
+        for (i = 0; i < 3; i++)
+          {
+            _day(cal, *next, &o);
+            *next += o.monthLength;
+          }
+        return YES;
+      case NSCalendarUnitYear:
+        *first = d->jd - d->dayOfYear + 1;
+        *next = *first + d->yearLength;
+        return YES;
+      case NSCalendarUnitYearForWeekOfYear:
+        *first = d->jd - (d->weekday - firstWeekday + 7) % 7
+          - 7 * (d->weekOfYear - 1);
+        *next = *first + 7 * 52;
+        _day(cal, *next, &o);
+        if (o.yearForWeekOfYear == d->yearForWeekOfYear)
+          {
+            *next += 7;
+          }
+        return YES;
+      default:
+        return NO;
+    }
+}
