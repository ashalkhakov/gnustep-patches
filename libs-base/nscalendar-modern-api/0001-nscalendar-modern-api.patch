+/*
+ * features-10-9.m - the 10.9 additions to NSCalendar and NSDateComponents
+ * other than the searches (which are in nextDate.m).
+ *
+ * Every expected value is what macOS 15 returns for the same call, with the
+ * same calendar (Gregorian, first weekday Sunday, one day in the first
+ * week) and time zone.  Sao Paulo's clocks skipped midnight on 2017-10-15
+ * and 2018-11-04 and repeated 23:00 on 2018-02-17; Havana's repeated
+ * midnight on 2023-11-05; Apia skipped 2011-12-30 altogether; New York
+ * skipped 02:00-03:00 on 2024-03-10 and repeated 01:00-02:00 on 2024-11-03.
+ */
+#import <Foundation/Foundation.h>
+#import "Testing.h"
+
+#if	defined(GS_USE_ICU)
+#define	NSCALENDAR_SUPPORTED	GS_USE_ICU
+#else
+#define	NSCALENDAR_SUPPORTED	1 /* Assume Apple support */
+#endif
+
+#define	X	NSDateComponentUndefined
+#define	NONE	(-1.0e300)
+
+static NSCalendar	*cal = nil;
+
+static void
+setup(NSString *zone, NSString *locale)
+{
+  RELEASE(cal);
+  cal = [[NSCalendar alloc]
+    initWithCalendarIdentifier: NSCalendarIdentifierGregorian];
+  [cal setLocale: AUTORELEASE([[NSLocale alloc]
+    initWithLocaleIdentifier: locale])];
+  [cal setTimeZone: [NSTimeZone timeZoneWithName: zone]];
+  [cal setFirstWeekday: 1];
+  [cal setMinimumDaysInFirstWeek: 1];
+}
+
+static NSDate *
+D(NSTimeInterval t)
+{
+  return [NSDate dateWithTimeIntervalSince1970: t];
+}
+
+static BOOL
+is(NSDate *date, NSTimeInterval t)
+{
+  if (t == NONE)
+    {
+      return date == nil;
+    }
+  return date != nil && [date timeIntervalSince1970] == t;
+}
+
+static NSDateComponents *
+YMD(NSInteger y, NSInteger mo, NSInteger d, NSInteger h, NSInteger mi,
+  NSInteger s)
+{
+  NSDateComponents	*c = AUTORELEASE([NSDateComponents new]);
+
+  [c setYear: y];
+  [c setMonth: mo];
+  [c setDay: d];
+  [c setHour: h];
+  [c setMinute: mi];
+  [c setSecond: s];
+  return c;
+}
+
+/* Whether c has exactly the values given for units, and no others. */
+static BOOL
+has(NSDateComponents *c, NSCalendarUnit units, const NSInteger *values)
+{
+  NSCalendarUnit	u;
+  int			i = 0;
+
+  if (c == nil)
+    {
+      return NO;
+    }
+  for (u = NSCalendarUnitEra; u <= NSCalendarUnitNanosecond; u <<= 1)
+    {
+      if (u == NSWeekCalendarUnit)
+	{
+	  continue;
+	}
+      if (units & u)
+	{
+	  if ([c valueForComponent: u] != values[i++])
+	    {
+	      return NO;
+	    }
+	}
+      else if ([c valueForComponent: u] != X)
+	{
+	  return NO;
+	}
+    }
+  return YES;
+}
