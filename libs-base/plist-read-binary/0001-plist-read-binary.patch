From 681a3f07bb54319356c19b5ab65bd75f9337c533 Mon Sep 17 00:00:00 2001
From: Artyom Shalkhakov <artyom.shalkhakov@gmail.com>
Date: Thu, 8 Oct 2026 15:46:32 +0000
Subject: [PATCH] NSDictionary, NSArray: read a binary property list from a
 file or URL

-initWithContentsOfFile: and -initWithContentsOfURL: of NSDictionary and
NSArray read the file as an NSString and parsed it with -propertyList,
which knows the text formats only: a binary property list, as Apple's
Foundation and NSPropertyListSerialization write by default, was "not
string data using Unicode (UTF-8)" and gave nil, so
+dictionaryWithContentsOfFile: could not read back a file this same
library had written.  They read the data and parse it with
NSPropertyListSerialization now, which recognises binary, XML and
OpenStep alike; an array is still returned mutable.

Tests/base/NSPropertyList/binaryPropertyLists.m fails five of its ten
tests without the change and passes with it; NSDictionary (143),
NSArray (139), NSMutableDictionary (68), NSPropertyList (29),
PropertyLists (133) and NSUserDefaults (94) pass with every libs-base
patch applied.
---
 Source/NSArray.m                              | 49 ++++++------
 Source/NSDictionary.m                         | 49 ++++++------
 .../base/NSPropertyList/binaryPropertyLists.m | 79 +++++++++++++++++++
 3 files changed, 133 insertions(+), 44 deletions(-)
 create mode 100644 Tests/base/NSPropertyList/binaryPropertyLists.m

diff --git a/Source/NSArray.m b/Source/NSArray.m
index 142e0e5..2dbd779 100644
--- a/Source/NSArray.m
+++ b/Source/NSArray.m
@@ -34,6 +34,7 @@
 #import "Foundation/NSEnumerator.h"
 #import "Foundation/NSCoder.h"
 #import "Foundation/NSData.h"
+#import "Foundation/NSPropertyList.h"
 #import "Foundation/NSRange.h"
 #import "Foundation/NSException.h"
 #import "Foundation/NSAutoreleasePool.h"
@@ -798,24 +799,23 @@ static SEL	rlSel;
  * <p>Initialises the array with the contents of the specified file,
  * which must contain an array in property-list format.
  * </p>
- * <p>In GNUstep, the property-list format may be either the OpenStep
- * format (ASCII data), or the MacOS-X format (UTF-8 XML data) ... this
- * method will recognise which it is.
+ * <p>The property list may be in any format NSPropertyListSerialization
+ * reads: binary, XML or OpenStep ... this method recognises which it is.
  * </p>
  * <p>If there is a failure to load the file for any reason, the receiver
  * will be released, the method will return nil, and a warning may be logged.
  * </p>
- * <p>Works by invoking [NSString-initWithContentsOfFile:] and
- * [NSString-propertyList] then checking that the result is an array.
+ * <p>Works by reading the data and parsing it with
+ * [NSPropertyListSerialization+propertyListWithData:options:format:error:]
+ * then checking that the result is an array.
  * </p>
  */
 - (id) initWithContentsOfFile: (NSString*)file
 {
-  NSString 	*myString;
+  NSData	*data;
 
-  myString = [[NSString allocWithZone: NSDefaultMallocZone()]
-    initWithContentsOfFile: file];
-  if (myString == nil)
+  data = [NSData dataWithContentsOfFile: file];
+  if (data == nil)
     {
       DESTROY(self);
     }
@@ -823,16 +823,19 @@ static SEL	rlSel;
     {
       id result;
 
+      /* Any format: the data says which (binary, XML or OpenStep). */
       NS_DURING
 	{
-	  result = [myString propertyList];
+	  result = [NSPropertyListSerialization propertyListWithData: data
+	    options: NSPropertyListMutableContainers
+	    format: NULL
+	    error: NULL];
 	}
       NS_HANDLER
 	{
           result = nil;
 	}
       NS_ENDHANDLER
-      RELEASE(myString);
       if ([result isKindOfClass: NSArrayClass])
 	{
 	  //self = [self initWithArray: result];
@@ -855,24 +858,23 @@ static SEL	rlSel;
  * <p>Initialises the array with the contents of the specified URL,
  * which must contain an array in property-list format.
  * </p>
- * <p>In GNUstep, the property-list format may be either the OpenStep
- * format (ASCII data), or the MacOS-X format (UTF8 XML data) ... this
- * method will recognise which it is.
+ * <p>The property list may be in any format NSPropertyListSerialization
+ * reads: binary, XML or OpenStep ... this method recognises which it is.
  * </p>
  * <p>If there is a failure to load the URL for any reason, the receiver
  * will be released, the method will return nil, and a warning may be logged.
  * </p>
- * <p>Works by invoking [NSString-initWithContentsOfURL:] and
- * [NSString-propertyList] then checking that the result is an array.
+ * <p>Works by reading the data and parsing it with
+ * [NSPropertyListSerialization+propertyListWithData:options:format:error:]
+ * then checking that the result is an array.
  * </p>
  */
 - (id) initWithContentsOfURL: (NSURL*)aURL
 {
-  NSString 	*myString;
+  NSData	*data;
 
-  myString = [[NSString allocWithZone: NSDefaultMallocZone()]
-    initWithContentsOfURL: aURL];
-  if (myString == nil)
+  data = [NSData dataWithContentsOfURL: aURL];
+  if (data == nil)
     {
       DESTROY(self);
     }
@@ -880,16 +882,19 @@ static SEL	rlSel;
     {
       id result;
 
+      /* Any format: the data says which (binary, XML or OpenStep). */
       NS_DURING
 	{
-	  result = [myString propertyList];
+	  result = [NSPropertyListSerialization propertyListWithData: data
+	    options: NSPropertyListMutableContainers
+	    format: NULL
+	    error: NULL];
 	}
       NS_HANDLER
 	{
           result = nil;
 	}
       NS_ENDHANDLER
-      RELEASE(myString);
       if ([result isKindOfClass: NSArrayClass])
 	{
 	  self = [self initWithArray: result];
