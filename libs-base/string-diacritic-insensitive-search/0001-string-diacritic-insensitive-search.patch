From 782b650615ec9c38c317e7c259dbafcc441976e4 Mon Sep 17 00:00:00 2001
From: Artyom Shalkhakov <artyom.shalkhakov@gmail.com>
Date: Sun, 27 Sep 2026 11:55:36 +0000
Subject: [PATCH] Make diacritic insensitive search and comparison work
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

-[NSString rangeOfString:options:] with NSDiacriticInsensitiveSearch
finds nothing, not even the string itself in another case:

    [@"Green TEA" rangeOfString: @"tea"
      options: NSCaseInsensitiveSearch | NSDiacriticInsensitiveSearch]

is {NSNotFound, 0}, and so is [@"Cafe" rangeOfString: @"café" ...]. The
same goes for -compare:options:, and for NSPredicate's [d] and [cd],
which are how Core Data and others ask for it.

Three things combine:

  1. Without a locale, search and comparison use GNUstep's own
     routines unless NSNumericSearch is asked for, and those do not
     implement diacritic insensitivity. Send NSDiacriticInsensitiveSearch
     to ICU as NSNumericSearch is sent.

  2. There they use the system locale, which since ICU 64 is
     en_US_POSIX. ICU's POSIX collation orders upper and lower case
     apart at the primary level, so no case or diacritic insensitive
     collator built on it ever matches across case. The system locale
     (no locale at all) now opens the root collation, which is what
     Apple's Foundation compares by.

  3. The collator for the options set primary strength whenever either
     of NSCaseInsensitiveSearch and NSDiacriticInsensitiveSearch was
     given, so its case-insensitive-only branch (secondary strength,
     accents kept) could not be reached. Primary strength is now for
     both together.

And NSPredicate turned [d] into "not NSLiteralSearch" rather than
NSDiacriticInsensitiveSearch, so the flag never reached the string.

One difference from Apple remains: a diacritic insensitive search that
is not also case insensitive ignores case too, since ICU's string search
does not honour the collator's case level.

Tests/base/NSString/diacriticSearch.m fails 7 of its 10 tests without
this and passes all with it; Tests/base/NSString, NSPredicate, NSLocale
and NSArray pass.
---
 Source/NSPredicate.m                  |  6 +++-
 Source/NSString.m                     | 14 ++++++--
 Tests/base/NSString/diacriticSearch.m | 47 +++++++++++++++++++++++++++
 3 files changed, 63 insertions(+), 4 deletions(-)
 create mode 100644 Tests/base/NSString/diacriticSearch.m

diff --git a/Source/NSPredicate.m b/Source/NSPredicate.m
index dabf91d1c..b2925d931 100644
--- a/Source/NSPredicate.m
+++ b/Source/NSPredicate.m
@@ -1434,7 +1434,11 @@ GSICUStringMatchesRegex(NSString *string, NSString *regex, NSStringCompareOption
     }
 
   // Change predicate options into string options.
-  if (!(_options & NSDiacriticInsensitivePredicateOption))
+  if (_options & NSDiacriticInsensitivePredicateOption)
+    {
+      compareOptions |= NSDiacriticInsensitiveSearch;
+    }
+  else
     {
       compareOptions |= NSLiteralSearch;
     }
diff --git a/Source/NSString.m b/Source/NSString.m
index fe765f940..1aa09f3dc 100644
--- a/Source/NSString.m
+++ b/Source/NSString.m
@@ -571,11 +571,17 @@ _GSICUCollatorCreate(NSStringCompareOptions mask, const char *localeCString)
   UErrorCode status = U_ZERO_ERROR;
   UCollator *coll;
 
+  /* The system locale: the root collation, as with no locale at all. */
+  if (localeCString == NULL || strcmp(localeCString, "en_US_POSIX") == 0)
+    {
+      localeCString = "";
+    }
   coll = ucol_open(localeCString, &status);
 
   if (U_SUCCESS(status))
     {
-      if (mask & (NSCaseInsensitiveSearch | NSDiacriticInsensitiveSearch))
+      if ((mask & NSCaseInsensitiveSearch)
+        && (mask & NSDiacriticInsensitiveSearch))
 	{
 	  ucol_setStrength(coll, UCOL_PRIMARY);
 	}
@@ -3339,7 +3345,8 @@ register_printf_atsign ()
       return result;
     }
 
-  if (locale == nil && (mask & NSNumericSearch) == 0)
+  if (locale == nil
+    && (mask & (NSNumericSearch | NSDiacriticInsensitiveSearch)) == 0)
   {
     return strRangeNsNs(self, aString, mask, searchRange);
   }
@@ -6385,7 +6392,8 @@ static NSFileManager *fm = nil;
    * comparison.) - so return NULL to indicate that the GNUstep
    * comparison code should be used.
    */
-  if (locale == nil && (mask & NSNumericSearch) == 0)
+  if (locale == nil
+    && (mask & (NSNumericSearch | NSDiacriticInsensitiveSearch)) == 0)
     {
       return strCompNsNs(self, string, mask, compareRange);
     }
diff --git a/Tests/base/NSString/diacriticSearch.m b/Tests/base/NSString/diacriticSearch.m
new file mode 100644
index 000000000..c0c931c3a
--- /dev/null
+++ b/Tests/base/NSString/diacriticSearch.m
@@ -0,0 +1,47 @@
+#import "Testing.h"
+#import <Foundation/NSAutoreleasePool.h>
+#import <Foundation/NSString.h>
+#import <Foundation/NSPredicate.h>
+#import "GNUstepBase/GSConfig.h"
+
+static BOOL
+found(NSString *s, NSString *t, NSUInteger mask)
+{
+  return [s rangeOfString: t options: mask].location != NSNotFound;
+}
+
+int main()
+{
+  START_SET("NSString diacritic insensitive search")
+#if !(GS_USE_ICU == 1)
+    SKIP("library built without ICU")
+#else
+  NSAutoreleasePool     *arp = [NSAutoreleasePool new];
+  NSUInteger            cd = NSCaseInsensitiveSearch | NSDiacriticInsensitiveSearch;
+
+  PASS(found(@"Green TEA", @"tea", cd),
+    "case and diacritic insensitive: a different case is found");
+  PASS(found(@"Cafe au lait", @"café", cd),
+    "case and diacritic insensitive: a different accent is found");
+  PASS(found(@"CAFÉ", @"cafe", cd),
+    "case and diacritic insensitive: both at once");
+  PASS(!found(@"Tea", @"coffee", cd),
+    "case and diacritic insensitive: another word is not found");
+  PASS(found(@"Cafe au lait", @"café", NSDiacriticInsensitiveSearch),
+    "diacritic insensitive: a different accent is found");
+  PASS(found(@"Crème brûlée", @"brulee", NSDiacriticInsensitiveSearch),
+    "diacritic insensitive: several accents");
+  PASS(([[NSPredicate predicateWithFormat: @"SELF CONTAINS[cd] %@", @"chaï"]
+    evaluateWithObject: @"Chai"]), "CONTAINS[cd] finds it");
+  PASS([@"café" compare: @"CAFE" options: cd] == NSOrderedSame,
+    "compare: case and diacritic insensitive");
+  PASS([@"café" compare: @"cafe" options: NSCaseInsensitiveSearch] != NSOrderedSame,
+    "compare: case insensitive keeps the accent");
+  PASS([@"café" compare: @"CAFÉ" options: NSCaseInsensitiveSearch] == NSOrderedSame,
+    "compare: case insensitive ignores case");
+
+  [arp release];
+#endif
+  END_SET("NSString diacritic insensitive search")
+  return 0;
+}
-- 
