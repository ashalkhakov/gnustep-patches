+#ifndef __GSArc4Random_h_GNUSTEP_BASE_INCLUDE
+#define __GSArc4Random_h_GNUSTEP_BASE_INCLUDE
+
+#include <stdint.h>
+#include <stdlib.h>
+#include <GNUstepBase/GSVersionMacros.h>
+
+/* glibc has had arc4random(), arc4random_uniform() and arc4random_buf()
+ * only since 2.36, and Windows' C runtime has none of them; code written
+ * for Apple's or a BSD's C library calls them freely.  Where they are
+ * missing, the base library provides them.
+ */
+#if (defined(__GLIBC__) \
+  && (__GLIBC__ < 2 || (__GLIBC__ == 2 && __GLIBC_MINOR__ < 36))) \
+  || defined(_WIN32)
+#define GS_PROVIDES_ARC4RANDOM 1
+
+#if defined(__cplusplus)
+extern "C" {
+#endif
+
+GS_EXPORT uint32_t arc4random(void);
+GS_EXPORT uint32_t arc4random_uniform(uint32_t upper_bound);
+GS_EXPORT void arc4random_buf(void *buf, size_t nbytes);
+
+#if defined(__cplusplus)
+}
+#endif
+
+#endif /* glibc before 2.36, or Windows */
+
+#endif /* __GSArc4Random_h_GNUSTEP_BASE_INCLUDE */
