--- a/Source/GNUmakefile
+++ b/Source/GNUmakefile
@@ -121,6 +121,7 @@ libgnustep-base.def
 
 GNUSTEPBASE_HEADERS = \
 GCObject.h \
+GSArc4Random.h \
 GSBoxWeak.h \
