diff --git a/Tests/base/Functions/arc4random.m b/Tests/base/Functions/arc4random.m
new file mode 100644
index 0000000..0f11137
--- /dev/null
+++ b/Tests/base/Functions/arc4random.m
@@ -0,0 +1,67 @@
+#import <Foundation/Foundation.h>
+#import "Testing.h"
+
+/* arc4random(), arc4random_uniform() and arc4random_buf(), which code
+ * written for Apple's C library calls freely: declared and present with
+ * Foundation on every C library, the base library providing them where it
+ * has none (glibc before 2.36).
+ */
+int main(void)
+{
+  START_SET("arc4random")
+    unsigned	i;
+    BOOL	inRange = YES;
+    BOOL	allZero = YES;
+    BOOL	varies = NO;
+    uint32_t	first = arc4random();
+    unsigned char	buf[64];
+    unsigned	seen[6] = {0};
+    BOOL	everyValue = YES;
+
+    for (i = 0; i < 100; i++)
+      {
+	if (arc4random() != first)
+	  {
+	    varies = YES;
+	  }
+      }
+    PASS(varies, "arc4random() gives different values");
+
+    for (i = 0; i < 6000; i++)
+      {
+	uint32_t	v = arc4random_uniform(6);
+
+	if (v >= 6)
+	  {
+	    inRange = NO;
+	  }
+	else
+	  {
+	    seen[v]++;
+	  }
+      }
+    PASS(inRange, "arc4random_uniform(6) is always below 6");
+    for (i = 0; i < 6; i++)
+      {
+	if (seen[i] < 700)
+	  {
+	    everyValue = NO;
+	  }
+      }
+    PASS(everyValue, "arc4random_uniform(6) gives every value about as often");
+    PASS(arc4random_uniform(0) == 0 && arc4random_uniform(1) == 0,
+      "arc4random_uniform(0) and (1) are 0");
+
+    memset(buf, 0, sizeof(buf));
+    arc4random_buf(buf, sizeof(buf));
+    for (i = 0; i < sizeof(buf); i++)
+      {
+	if (buf[i] != 0)
+	  {
+	    allZero = NO;
+	  }
+      }
+    PASS(!allZero, "arc4random_buf() fills the buffer");
+  END_SET("arc4random")
+  return 0;
+}
