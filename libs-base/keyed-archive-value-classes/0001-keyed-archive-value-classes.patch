diff --git a/Source/NSDecimalNumber.m b/Source/NSDecimalNumber.m
index d840232..00e2777 100644
--- a/Source/NSDecimalNumber.m
+++ b/Source/NSDecimalNumber.m
@@ -51,6 +51,101 @@
 // shared default behavior for NSDecimalNumber class
 static NSDecimalNumberHandler *handler;
 
+/* A keyed archive keeps the mantissa as a 128 bit integer, in eight 16 bit
+ * words with the least significant first.
+ */
+static NSString *
+wordsString(const uint16_t *source)
+{
+  uint16_t	words[8];
+  char		digits[48];
+  int		n = sizeof(digits) - 1;
+  BOOL		zero;
+  int		i;
+
+  memcpy(words, source, sizeof(words));
+  digits[n] = '\0';
+  do
+    {
+      uint32_t	remainder = 0;
+
+      zero = YES;
+      for (i = 7; i >= 0; i--)
+	{
+	  uint32_t	value = (remainder << 16) | words[i];
+
+	  words[i] = value / 10;
+	  remainder = value % 10;
+	  if (words[i] != 0)
+	    {
+	      zero = NO;
+	    }
+	}
+      digits[--n] = '0' + remainder;
+    }
+  while (NO == zero && n > 0);
+  return [NSString stringWithUTF8String: digits + n];
+}
+
+static void
+decimalWords(NSString *s, uint16_t *words, int *exponent, BOOL *negative)
+{
+  const char	*p = [s UTF8String];
+  char		digits[64];
+  int		count = 0;
+  BOOL		point = NO;
+  int		i;
+  int		j;
+
+  *exponent = 0;
+  *negative = NO;
+  if (*p == '-')
+    {
+      *negative = YES;
+      p++;
+    }
+  for (; *p != '\0'; p++)
+    {
+      if (*p == '.')
+	{
+	  point = YES;
+	}
+      else if (*p >= '0' && *p <= '9')
+	{
+	  if (point)
+	    {
+	      (*exponent)--;
+	    }
+	  if ((count > 0 || *p != '0') && count < (int)sizeof(digits))
+	    {
+	      digits[count++] = *p;
+	    }
+	}
+      else if (*p == 'E' || *p == 'e')
+	{
+	  *exponent += atoi(p + 1);
+	  break;
+	}
+    }
+  while (count > 0 && digits[count - 1] == '0')
+    {
+      count--;
+      (*exponent)++;
+    }
+  for (j = 0; j < count; j++)
+    {
+      uint32_t	carry = digits[j] - '0';
+
+      for (i = 0; i < 8; i++)
+	{
+	  uint32_t	value = words[i] * 10 + carry;
+
+	  words[i] = value & 0xffff;
+	  carry = value >> 16;
+	}
+    }
+}
+
 @implementation NSDecimalNumberHandler
 
 + (id) defaultDecimalNumberHandler
@@ -150,6 +245,79 @@ static NSDecimalNumberHandler *handler;
   return _scale;
 }
 
+- (void) encodeWithCoder: (NSCoder*)coder
+{
+  if ([coder allowsKeyedCoding])
+    {
+      [coder encodeInt: _roundingMode forKey: @"NS.roundingmode"];
+      if (_scale != NSDecimalNoScale)
+	{
+	  [coder encodeInt: _scale forKey: @"NS.scale"];
+	}
+      if (_raiseOnExactness)
+	{
+	  [coder encodeBool: YES forKey: @"NS.raise.exactness"];
+	}
+      if (_raiseOnOverflow)
+	{
+	  [coder encodeBool: YES forKey: @"NS.raise.overflow"];
+	}
+      if (_raiseOnUnderflow)
+	{
+	  [coder encodeBool: YES forKey: @"NS.raise.underflow"];
+	}
+      if (_raiseOnDivideByZero)
+	{
+	  [coder encodeBool: YES forKey: @"NS.raise.dividebyzero"];
+	}
+    }
+  else
+    {
+      int	mode = _roundingMode;
+
+      [coder encodeValueOfObjCType: @encode(int) at: &mode];
+      [coder encodeValueOfObjCType: @encode(short) at: &_scale];
+      [coder encodeValueOfObjCType: @encode(BOOL) at: &_raiseOnExactness];
+      [coder encodeValueOfObjCType: @encode(BOOL) at: &_raiseOnOverflow];
+      [coder encodeValueOfObjCType: @encode(BOOL) at: &_raiseOnUnderflow];
+      [coder encodeValueOfObjCType: @encode(BOOL) at: &_raiseOnDivideByZero];
+    }
+}
+
+- (id) initWithCoder: (NSCoder*)coder
+{
+  if ([coder allowsKeyedCoding])
+    {
+      _roundingMode = [coder decodeIntForKey: @"NS.roundingmode"];
+      if ([coder containsValueForKey: @"NS.scale"])
+	{
+	  _scale = [coder decodeIntForKey: @"NS.scale"];
+	}
+      else
+	{
+	  _scale = NSDecimalNoScale;
+	}
+      _raiseOnExactness = [coder decodeBoolForKey: @"NS.raise.exactness"];
+      _raiseOnOverflow = [coder decodeBoolForKey: @"NS.raise.overflow"];
+      _raiseOnUnderflow = [coder decodeBoolForKey: @"NS.raise.underflow"];
+      _raiseOnDivideByZero
+	= [coder decodeBoolForKey: @"NS.raise.dividebyzero"];
+    }
+  else
+    {
+      int	mode;
+
+      [coder decodeValueOfObjCType: @encode(int) at: &mode];
+      _roundingMode = mode;
+      [coder decodeValueOfObjCType: @encode(short) at: &_scale];
+      [coder decodeValueOfObjCType: @encode(BOOL) at: &_raiseOnExactness];
+      [coder decodeValueOfObjCType: @encode(BOOL) at: &_raiseOnOverflow];
+      [coder decodeValueOfObjCType: @encode(BOOL) at: &_raiseOnUnderflow];
+      [coder decodeValueOfObjCType: @encode(BOOL) at: &_raiseOnDivideByZero];
+    }
+  return self;
+}
+
 @end
 
 
@@ -983,13 +1151,82 @@ static NSDecimalNumber *one;
 {
   NSString	*s = [self descriptionWithLocale: nil];
 
+  if ([coder allowsKeyedCoding])
+    {
+      uint16_t	words[8];
+      uint8_t	bytes[16];
+      int	exponent = 0;
+      int	length = 0;
+      BOOL	negative = NO;
+      BOOL	nan = NSDecimalIsNotANumber(&data);
+      int	i;
+
+      memset(words, 0, sizeof(words));
+      if (NO == nan)
+	{
+	  decimalWords(s, words, &exponent, &negative);
+	  for (i = 0; i < 8; i++)
+	    {
+	      if (words[i] != 0)
+		{
+		  length = i + 1;
+		}
+	    }
+	}
+      for (i = 0; i < 8; i++)
+	{
+	  bytes[2 * i] = words[i] & 0xff;
+	  bytes[2 * i + 1] = words[i] >> 8;
+	}
+      [coder encodeInt: exponent forKey: @"NS.exponent"];
+      [coder encodeInt: length forKey: @"NS.length"];
+      [coder encodeBool: (nan || negative) forKey: @"NS.negative"];
+      [coder encodeBool: (length > 0) forKey: @"NS.compact"];
+      [coder encodeInt: 1 forKey: @"NS.mantissa.bo"];
+      [coder encodeBytes: bytes length: 16 forKey: @"NS.mantissa"];
+      return;
+    }
   [coder encodeObject: s];
 }
 
 - (id) initWithCoder: (NSCoder*)coder
 {
-  NSString	*s = [coder decodeObject];
+  NSString	*s;
 
+  if ([coder allowsKeyedCoding]
+    && [coder containsValueForKey: @"NS.mantissa"])
+    {
+      const uint8_t	*bytes;
+      NSUInteger	count = 0;
+      uint16_t		words[8];
+      int		length = [coder decodeIntForKey: @"NS.length"];
+      int		order = [coder decodeIntForKey: @"NS.mantissa.bo"];
+      int		i;
+
+      bytes = [coder decodeBytesForKey: @"NS.mantissa" returnedLength: &count];
+      memset(words, 0, sizeof(words));
+      for (i = 0; i < 8 && i < length && 2 * i + 1 < count; i++)
+	{
+	  if (order == 1)
+	    {
+	      words[i] = bytes[2 * i] | (bytes[2 * i + 1] << 8);
+	    }
+	  else
+	    {
+	      words[i] = (bytes[2 * i] << 8) | bytes[2 * i + 1];
+	    }
+	}
+      if (0 == length && [coder decodeBoolForKey: @"NS.negative"])
+	{
+	  DESTROY(self);
+	  return RETAIN([NSDecimalNumber notANumber]);
+	}
+      s = [NSString stringWithFormat: @"%@%@E%d",
+	[coder decodeBoolForKey: @"NS.negative"] ? @"-" : @"",
+	wordsString(words), [coder decodeIntForKey: @"NS.exponent"]];
+      return [self initWithString: s locale: nil];
+    }
+  s = [coder decodeObject];
   return [self initWithString: s locale: nil];
 }
 
