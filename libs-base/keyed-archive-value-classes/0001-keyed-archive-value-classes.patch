diff --git a/Tests/base/NSNumberFormatter/macosArchive.m b/Tests/base/NSNumberFormatter/macosArchive.m
new file mode 100644
index 0000000..6b72204
--- /dev/null
+++ b/Tests/base/NSNumberFormatter/macosArchive.m
@@ -0,0 +1,43 @@
+#import <Foundation/Foundation.h>
+#import "Testing.h"
+
+#if	defined(GS_USE_ICU)
+#define	NSLOCALE_SUPPORTED	GS_USE_ICU
+#else
+#define	NSLOCALE_SUPPORTED	1 /* Assume Apple support */
+#endif
+
+/* macos-numberformatter.plist was written by NSKeyedArchiver on macOS 15,
+ * from a decimal formatter for de_DE with two fraction digits, a minimum
+ * of 0.5 and generatesDecimalNumbers set.
+ */
+int main()
+{
+  NSAutoreleasePool	*arp = [NSAutoreleasePool new];
+  NSNumberFormatter	*fmt;
+  NSData		*data;
+
+  START_SET("NSNumberFormatter archived on macOS")
+    if (!NSLOCALE_SUPPORTED)
+      SKIP("NSLocale not supported\nThe ICU library was not available when GNUstep-base was built")
+
+    data = [NSData dataWithContentsOfFile: @"macos-numberformatter.plist"];
+    fmt = [NSKeyedUnarchiver unarchiveObjectWithData: data];
+    PASS([fmt isKindOfClass: [NSNumberFormatter class]],
+      "a number formatter archived on macOS is read")
+    PASS_EQUAL([[fmt locale] localeIdentifier], @"de_DE",
+      "its locale is read")
+    PASS([fmt numberStyle] == NSNumberFormatterDecimalStyle
+      && [fmt maximumFractionDigits] == 2 && [fmt generatesDecimalNumbers],
+      "its settings are read")
+    PASS_EQUAL([fmt minimum], [NSDecimalNumber decimalNumberWithString: @"0.5"],
+      "its minimum is read")
+    PASS_EQUAL([fmt decimalSeparator], @",",
+      "its decimal separator is the locale's")
+    PASS_EQUAL([fmt stringFromNumber: [NSNumber numberWithDouble: 1234.5678]],
+      @"1.234,57", "it formats as on macOS")
+  END_SET("NSNumberFormatter archived on macOS")
+
+  [arp release];
+  return 0;
+}
