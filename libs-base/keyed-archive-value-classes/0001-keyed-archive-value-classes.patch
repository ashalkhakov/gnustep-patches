diff --git a/Tests/base/NSDateFormatter/macosArchive.m b/Tests/base/NSDateFormatter/macosArchive.m
new file mode 100644
index 0000000..80e3174
--- /dev/null
+++ b/Tests/base/NSDateFormatter/macosArchive.m
@@ -0,0 +1,36 @@
+#import <Foundation/Foundation.h>
+#import "Testing.h"
+
+/* macos-dateformatter.plist was written by NSKeyedArchiver on macOS 15,
+ * from a formatter for fr_FR in Europe/Paris, with the gregorian calendar,
+ * the long date style and the short time style.
+ */
+int main()
+{
+  NSAutoreleasePool	*arp = [NSAutoreleasePool new];
+  NSDateFormatter	*fmt;
+  NSData		*data;
+
+  START_SET("NSDateFormatter archived on macOS")
+
+    data = [NSData dataWithContentsOfFile: @"macos-dateformatter.plist"];
+    fmt = [NSKeyedUnarchiver unarchiveObjectWithData: data];
+    PASS([fmt isKindOfClass: [NSDateFormatter class]],
+      "a date formatter archived on macOS is read")
+    PASS_EQUAL([[fmt locale] objectForKey: NSLocaleLanguageCode], @"fr",
+      "its locale is read")
+    PASS_EQUAL([[fmt timeZone] name], @"Europe/Paris",
+      "its time zone is read")
+    PASS_EQUAL([[fmt calendar] calendarIdentifier],
+      NSCalendarIdentifierGregorian, "its calendar is read")
+    PASS([fmt dateStyle] == NSDateFormatterLongStyle
+      && [fmt timeStyle] == NSDateFormatterShortStyle,
+      "its styles are read")
+    PASS_EQUAL([fmt stringFromDate:
+      [NSDate dateWithTimeIntervalSinceReferenceDate: 15 * 3600]],
+      @"1 janvier 2001 à 16:00", "it formats as on macOS")
+  END_SET("NSDateFormatter archived on macOS")
+
+  [arp release];
+  return 0;
+}
