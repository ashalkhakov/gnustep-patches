diff --git a/Tests/base/NSKeyedArchiver/macosValueClasses.m b/Tests/base/NSKeyedArchiver/macosValueClasses.m
new file mode 100644
index 0000000..fb691ea
--- /dev/null
+++ b/Tests/base/NSKeyedArchiver/macosValueClasses.m
@@ -0,0 +1,147 @@
+#import <Foundation/Foundation.h>
+#import "Testing.h"
+
+/* The macos-*.plist archives were written by NSKeyedArchiver on macOS 15. */
+static id
+macosArchive(NSString *name)
+{
+  NSString	*path;
+  NSData	*data;
+
+  path = [NSString stringWithFormat: @"macos-%@.plist", name];
+  data = [NSData dataWithContentsOfFile: path];
+  return [NSKeyedUnarchiver unarchiveObjectWithData: data];
+}
+
+/* The keys an object was archived with. */
+static NSDictionary *
+archivedKeys(id object)
+{
+  NSData	*data = [NSKeyedArchiver archivedDataWithRootObject: object];
+  NSDictionary	*plist;
+
+  plist = [NSPropertyListSerialization propertyListWithData: data
+    options: NSPropertyListImmutable format: NULL error: NULL];
+  /* The root object is the first one archived, after $null. */
+  return [[plist objectForKey: @"$objects"] objectAtIndex: 1];
+}
+
+int main()
+{
+  NSAutoreleasePool	*arp = [NSAutoreleasePool new];
+  NSArray		*decimals;
+  NSDecimalNumberHandler	*handler;
+  NSCalendar		*calendar;
+  NSTimeZone		*zone;
+  NSLocale		*locale;
+  id			o;
+
+  START_SET("keyed archives of value classes from macOS")
+
+    locale = macosArchive(@"locale");
+    PASS([locale isKindOfClass: [NSLocale class]]
+      && [[locale localeIdentifier] isEqual: @"fr_FR"],
+      "a locale archived on macOS is read")
+
+    zone = macosArchive(@"timezone");
+    PASS([zone isKindOfClass: [NSTimeZone class]]
+      && [[zone name] isEqual: @"Europe/Paris"],
+      "a time zone archived on macOS is read")
+
+    calendar = macosArchive(@"calendar");
+    PASS([calendar isKindOfClass: [NSCalendar class]]
+      && [[calendar calendarIdentifier] isEqual: NSCalendarIdentifierGregorian],
+      "a calendar archived on macOS is read")
+    PASS_EQUAL([[calendar locale] objectForKey: NSLocaleLanguageCode], @"de",
+      "the calendar's locale is read")
+    PASS_EQUAL([[calendar timeZone] name], @"Asia/Tokyo",
+      "the calendar's time zone is read")
+    PASS([calendar firstWeekday] == 2 && [calendar minimumDaysInFirstWeek] == 4,
+      "the calendar's week settings are read")
+
+    decimals = macosArchive(@"decimals");
+    PASS([decimals count] == 5, "decimal numbers archived on macOS are read")
+    PASS_EQUAL([decimals objectAtIndex: 0],
+      [NSDecimalNumber decimalNumberWithString: @"-12345.678"],
+      "a negative fraction is read")
+    PASS_EQUAL([decimals objectAtIndex: 1],
+      [NSDecimalNumber decimalNumberWithString:
+	@"123456789012345678901234567890123456"],
+      "a number with all eight words of mantissa is read")
+    PASS_EQUAL([decimals objectAtIndex: 2], [NSDecimalNumber zero],
+      "zero is read")
+    PASS([[decimals objectAtIndex: 3] isEqual: [NSDecimalNumber notANumber]],
+      "NaN is read")
+    PASS_EQUAL([decimals objectAtIndex: 4],
+      [NSDecimalNumber decimalNumberWithString: @"1.5E20"],
+      "a number with an exponent is read")
+
+    handler = macosArchive(@"handler");
+    PASS([handler isKindOfClass: [NSDecimalNumberHandler class]]
+      && [handler roundingMode] == NSRoundBankers && [handler scale] == 2,
+      "a decimal number handler archived on macOS is read")
+
+  END_SET("keyed archives of value classes from macOS")
+
+  START_SET("keyed archives of value classes as macOS writes them")
+
+    locale = [[[NSLocale alloc] initWithLocaleIdentifier: @"fr_FR"]
+      autorelease];
+    PASS([archivedKeys(locale) objectForKey: @"NS.identifier"] != nil,
+      "a locale is archived under NS.identifier")
+    o = [NSKeyedUnarchiver unarchiveObjectWithData:
+      [NSKeyedArchiver archivedDataWithRootObject: locale]];
+    PASS_EQUAL([o localeIdentifier], @"fr_FR", "a locale survives")
+
+    zone = [NSTimeZone timeZoneWithName: @"Europe/Paris"];
+    PASS([archivedKeys(zone) objectForKey: @"NS.name"] != nil,
+      "a time zone is archived under NS.name")
+    o = [NSKeyedUnarchiver unarchiveObjectWithData:
+      [NSKeyedArchiver archivedDataWithRootObject: zone]];
+    PASS_EQUAL([o name], @"Europe/Paris", "a time zone survives")
+
+    calendar = [[[NSCalendar alloc]
+      initWithCalendarIdentifier: NSCalendarIdentifierGregorian] autorelease];
+    [calendar setFirstWeekday: 2];
+    [calendar setTimeZone: zone];
+    o = archivedKeys(calendar);
+    PASS([o objectForKey: @"NS.identifier"] != nil
+      && [o objectForKey: @"NS.timezone"] != nil
+      && [o objectForKey: @"NS.firstwkdy"] != nil,
+      "a calendar is archived under macOS's keys")
+    o = [NSKeyedUnarchiver unarchiveObjectWithData:
+      [NSKeyedArchiver archivedDataWithRootObject: calendar]];
+    PASS([[o calendarIdentifier] isEqual: NSCalendarIdentifierGregorian]
+      && [o firstWeekday] == 2 && [[[o timeZone] name] isEqual: @"Europe/Paris"],
+      "a calendar survives")
+
+    o = [NSDecimalNumber decimalNumberWithString: @"-12345.678"];
+    PASS([archivedKeys(o) objectForKey: @"NS.mantissa"] != nil,
+      "a decimal number is archived as its mantissa and exponent")
+    PASS_EQUAL([NSKeyedUnarchiver unarchiveObjectWithData:
+      [NSKeyedArchiver archivedDataWithRootObject: o]], o,
+      "a decimal number survives")
+    o = [NSDecimalNumber decimalNumberWithString:
+      @"123456789012345678901234567890123456"];
+    PASS_EQUAL([NSKeyedUnarchiver unarchiveObjectWithData:
+      [NSKeyedArchiver archivedDataWithRootObject: o]], o,
+      "a long decimal number survives")
+    o = [NSKeyedUnarchiver unarchiveObjectWithData:
+      [NSKeyedArchiver archivedDataWithRootObject: [NSDecimalNumber notANumber]]];
+    PASS([o isEqual: [NSDecimalNumber notANumber]], "NaN survives")
+
+    handler = [NSDecimalNumberHandler decimalNumberHandlerWithRoundingMode:
+      NSRoundDown scale: 3 raiseOnExactness: NO raiseOnOverflow: YES
+      raiseOnUnderflow: NO raiseOnDivideByZero: NO];
+    PASS([archivedKeys(handler) objectForKey: @"NS.roundingmode"] != nil,
+      "a decimal number handler is archived under macOS's keys")
+    o = [NSKeyedUnarchiver unarchiveObjectWithData:
+      [NSKeyedArchiver archivedDataWithRootObject: handler]];
+    PASS([o roundingMode] == NSRoundDown && [o scale] == 3,
+      "a decimal number handler survives")
+
+  END_SET("keyed archives of value classes as macOS writes them")
+
+  [arp release];
+  return 0;
+}
