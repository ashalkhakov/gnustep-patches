From 2842482f42fe0f0c4e2d68aa7009d18529a8564d Mon Sep 17 00:00:00 2001
From: Artyom Shalkhakov <artyom.shalkhakov@gmail.com>
Date: Wed, 7 Oct 2026 17:57:46 +0000
Subject: [PATCH] NSPredicate: a nil constant prints as nil

A constant expression whose value is nil or NSNull printed as "(null)"
or "<null>", which no predicate parser reads back: "title != nil" came
out as "title != <null>", so writing a predicate out and reading it
again failed - a Core Data model saved on GNUstep, with a fetch request
or a partial index comparing with nil, could not be compiled again.
Apple's Foundation prints a nil constant as nil.  This one parses nil
to NSNull, so an NSNull constant is printed as nil too, and reads back
to what it was.

Tests/base/NSPredicate/nilConstant.m fails three of its six tests
without the change, and its set stops where the format does not parse
back; it passes with it.
---
 Source/NSPredicate.m                 |  4 ++++
 Tests/base/NSPredicate/nilConstant.m | 36 ++++++++++++++++++++++++++++
 2 files changed, 40 insertions(+)
 create mode 100644 Tests/base/NSPredicate/nilConstant.m

diff --git a/Source/NSPredicate.m b/Source/NSPredicate.m
index d027cea1d..81a1249c8 100644
--- a/Source/NSPredicate.m
+++ b/Source/NSPredicate.m
@@ -2369,6 +2369,10 @@ - (NSUInteger) hash
 
 - (NSString *) description
 {
+  if (nil == _obj || [_obj isKindOfClass: [NSNull class]])
+    {
+      return @"nil";
+    }
   if ([_obj isKindOfClass: [NSString class]])
     {
       NSMutableString	*result = nil;
diff --git a/Tests/base/NSPredicate/nilConstant.m b/Tests/base/NSPredicate/nilConstant.m
new file mode 100644
index 000000000..b71a104e8
--- /dev/null
+++ b/Tests/base/NSPredicate/nilConstant.m
@@ -0,0 +1,36 @@
+#import "ObjectTesting.h"
+#import <Foundation/Foundation.h>
+
+int main()
+{
+  START_SET("a nil constant reads back as nil")
+  NSDictionary          *named;
+  NSDictionary          *unnamed;
+  NSPredicate           *p;
+  NSPredicate           *again;
+
+  named = [NSDictionary dictionaryWithObject: @"ada" forKey: @"title"];
+  unnamed = [NSDictionary dictionary];
+
+  PASS_EQUAL([[NSExpression expressionForConstantValue: nil] description],
+    @"nil", "a nil constant prints as nil")
+  PASS_EQUAL([[NSExpression expressionForConstantValue: [NSNull null]]
+    description], @"nil", "and so does a null one")
+
+  p = [NSPredicate predicateWithFormat: @"title != nil"];
+  PASS_EQUAL([p predicateFormat], @"title != nil",
+    "a predicate comparing with nil prints it so")
+
+  again = [NSPredicate predicateWithFormat: [p predicateFormat]];
+  PASS(again != nil, "and the format parses back")
+  PASS([again evaluateWithObject: named]
+    && ![again evaluateWithObject: unnamed],
+    "to a predicate that means the same")
+
+  p = [NSPredicate predicateWithFormat: @"title == NULL"];
+  PASS([[p predicateFormat] hasSuffix: @" nil"],
+    "NULL is printed as nil too")
+
+  END_SET("a nil constant reads back as nil")
+  return 0;
+}
