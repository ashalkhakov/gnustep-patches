diff --git a/Tests/base/NSPredicate/secureCoding.m b/Tests/base/NSPredicate/secureCoding.m
new file mode 100644
index 000000000..34d866653
--- /dev/null
+++ b/Tests/base/NSPredicate/secureCoding.m
@@ -0,0 +1,210 @@
+/* A predicate and an expression can be archived and read back with secure
+   coding, as on OS X since 10.13, and one read that way does not evaluate
+   until -allowEvaluation is sent to it.  The expectations are what Apple's
+   Foundation does with the same calls.
+*/
+#import <Foundation/NSArray.h>
+#import <Foundation/NSAutoreleasePool.h>
+#import <Foundation/NSComparisonPredicate.h>
+#import <Foundation/NSCompoundPredicate.h>
+#import <Foundation/NSData.h>
+#import <Foundation/NSDate.h>
+#import <Foundation/NSDictionary.h>
+#import <Foundation/NSException.h>
+#import <Foundation/NSExpression.h>
+#import <Foundation/NSKeyedArchiver.h>
+#import <Foundation/NSPredicate.h>
+#import <Foundation/NSSet.h>
+#import <Foundation/NSString.h>
+#import <Foundation/NSValue.h>
+#import "ObjectTesting.h"
+
+@interface Thing : NSObject <NSSecureCoding>
+@end
+
+@implementation Thing
++ (BOOL) supportsSecureCoding
+{
+  return YES;
+}
+- (void) encodeWithCoder: (NSCoder *)coder
+{
+}
+- (id) initWithCoder: (NSCoder *)coder
+{
+  return [super init];
+}
+- (BOOL) isEqual: (id)other
+{
+  return [other isKindOfClass: [Thing class]];
+}
+- (NSUInteger) hash
+{
+  return 1;
+}
+@end
+
+static NSData *
+secureArchive(id object)
+{
+  return [NSKeyedArchiver archivedDataWithRootObject: object
+			       requiringSecureCoding: YES
+					       error: NULL];
+}
+
+static id
+secureRead(NSData *data, NSSet *classes)
+{
+  id	object = nil;
+
+  NS_DURING
+    {
+      object = [NSKeyedUnarchiver unarchivedObjectOfClasses: classes
+						    fromData: data
+						       error: NULL];
+    }
+  NS_HANDLER
+    {
+      object = nil;
+    }
+  NS_ENDHANDLER
+  return object;
+}
+
+static NSPredicate *
+securePredicate(NSPredicate *predicate)
+{
+  return secureRead(secureArchive(predicate),
+    [NSSet setWithObject: [NSPredicate class]]);
+}
+
+int main(void)
+{
+  NSAutoreleasePool	*arp = [NSAutoreleasePool new];
+  NSDictionary		*ann;
+  NSPredicate		*p;
+  NSPredicate		*back;
+  NSPredicate		*sub;
+  NSPredicate		*copy;
+  NSExpression		*e;
+  NSArray		*formats;
+  NSUInteger		i;
+
+  ann = [NSDictionary dictionaryWithObjectsAndKeys:
+    [NSNumber numberWithInt: 50], @"age", @"Ann", @"name", nil];
+
+  START_SET("NSPredicate secure coding conformance")
+  PASS([NSPredicate conformsToProtocol: @protocol(NSSecureCoding)]
+    && [NSPredicate supportsSecureCoding],
+    "NSPredicate supports secure coding")
+  PASS([NSExpression conformsToProtocol: @protocol(NSSecureCoding)]
+    && [NSExpression supportsSecureCoding],
+    "NSExpression supports secure coding")
+  PASS([NSComparisonPredicate supportsSecureCoding]
+    && [NSCompoundPredicate supportsSecureCoding],
+    "NSComparisonPredicate and NSCompoundPredicate support secure coding")
+  PASS([[NSPredicate predicateWithValue: YES]
+    respondsToSelector: @selector(allowEvaluation)],
+    "a predicate responds to -allowEvaluation")
+  PASS([[NSExpression expressionForKeyPath: @"age"]
+    respondsToSelector: @selector(allowEvaluation)],
+    "an expression responds to -allowEvaluation")
+  END_SET("NSPredicate secure coding conformance")
+
+  START_SET("NSPredicate secure coding round trip")
+  formats = [NSArray arrayWithObjects:
+    @"name == 'x' AND age > 3",
+    @"age IN {1, 2}",
+    @"name == nil",
+    @"uppercase:(name) == 'X'",
+    @"age > $limit",
+    @"SELF == 'x'",
+    @"NOT (a == 1 OR b == 2)",
+    @"SUBQUERY(kids, $k, $k.age > 3).@count > 0",
+    @"ANY kids.age > 3",
+    @"$x.age > 3",
+    @"TRUEPREDICATE",
+    nil];
+  for (i = 0; i < [formats count]; i++)
+    {
+      NSString	*f = [formats objectAtIndex: i];
+
+      p = [NSPredicate predicateWithFormat: f];
+      back = securePredicate(p);
+      PASS_EQUAL([back predicateFormat], [p predicateFormat],
+	"%s is read back allowing only NSPredicate", [f UTF8String])
+    }
+  p = [NSPredicate predicateWithFormat: @"born < %@",
+    [NSDate dateWithTimeIntervalSinceReferenceDate: 0]];
+  PASS_EQUAL(securePredicate(p), p, "a date constant is read back")
+  p = [NSPredicate predicateWithFormat: @"age IN %@",
+    [NSSet setWithObject: [NSNumber numberWithInt: 1]]];
+  PASS_EQUAL(securePredicate(p), p, "a set constant is read back")
+  END_SET("NSPredicate secure coding round trip")
+
+  START_SET("NSPredicate secure coding evaluation")
+  p = [NSPredicate predicateWithFormat: @"age > 40 AND name BEGINSWITH 'A'"];
+  back = securePredicate(p);
+  PASS(back != nil, "a compound predicate is read back")
+  sub = [[(NSCompoundPredicate *)back subpredicates] objectAtIndex: 0];
+  e = [(NSComparisonPredicate *)sub leftExpression];
+  copy = AUTORELEASE([sub copy]);
+
+  PASS_EQUAL([back predicateFormat], [p predicateFormat],
+    "its format can be read before -allowEvaluation")
+  PASS_EXCEPTION([back evaluateWithObject: ann],
+    NSInternalInconsistencyException,
+    "it does not evaluate before -allowEvaluation")
+  PASS_EXCEPTION([back evaluateWithObject: ann substitutionVariables: nil],
+    NSInternalInconsistencyException,
+    "nor with substitution variables")
+  PASS_EXCEPTION([sub evaluateWithObject: ann],
+    NSInternalInconsistencyException,
+    "nor does a subpredicate")
+  PASS_EXCEPTION([e expressionValueWithObject: ann context: nil],
+    NSInternalInconsistencyException,
+    "nor does an expression in it")
+  PASS([copy evaluateWithObject: ann], "but a copy does")
+
+  [back allowEvaluation];
+  PASS([back evaluateWithObject: ann], "it evaluates after -allowEvaluation")
+  PASS([sub evaluateWithObject: ann], "and so do its subpredicates")
+  PASS_EQUAL([e expressionValueWithObject: ann context: nil],
+    [NSNumber numberWithInt: 50], "and its expressions")
+
+  back = [NSKeyedUnarchiver unarchiveObjectWithData:
+    [NSKeyedArchiver archivedDataWithRootObject: p]];
+  PASS([back evaluateWithObject: ann],
+    "a predicate read without secure coding evaluates at once")
+
+  back = securePredicate([NSPredicate predicateWithFormat: @"SELF == 'x'"]);
+  PASS([[NSPredicate predicateWithFormat: @"SELF == 'x'"]
+    evaluateWithObject: @"x"],
+    "reading SELF securely leaves other predicates using SELF alone")
+  END_SET("NSPredicate secure coding evaluation")
+
+  START_SET("NSExpression secure coding")
+  e = secureRead(secureArchive([NSExpression expressionWithFormat: @"age + 1"]),
+    [NSSet setWithObject: [NSExpression class]]);
+  PASS(e != nil, "an expression is read back on its own")
+  PASS_EXCEPTION([e expressionValueWithObject: ann context: nil],
+    NSInternalInconsistencyException,
+    "it does not evaluate before -allowEvaluation")
+  [e allowEvaluation];
+  PASS_EQUAL([e expressionValueWithObject: ann context: nil],
+    [NSNumber numberWithInt: 51], "it evaluates after -allowEvaluation")
+  END_SET("NSExpression secure coding")
+
+  START_SET("NSPredicate secure coding of other classes")
+  p = [NSPredicate predicateWithFormat: @"x == %@", AUTORELEASE([Thing new])];
+  PASS(secureRead(secureArchive(p),
+    [NSSet setWithObject: [NSPredicate class]]) == nil,
+    "a constant of a class that was not allowed is not read")
+  PASS_EQUAL(secureRead(secureArchive(p),
+    [NSSet setWithObjects: [NSPredicate class], [Thing class], nil]), p,
+    "it is read when its class is allowed too")
+  END_SET("NSPredicate secure coding of other classes")
+
+  [arp release];
+  return 0;
+}
