 static NSExpression	*evaluatedObjectExpression = nil;
 
+/* Predicates and expressions read with secure coding, which do not evaluate
+ * until -allowEvaluation is sent to them.  They are held here rather than
+ * flagged in an instance variable so that the public classes keep their
+ * layout; the count lets evaluation skip the lock when there are none.
+ */
+static gs_mutex_t	evaluationLock = GS_MUTEX_INIT_STATIC;
+static NSHashTable	*evaluationDisabled = 0;
+static NSUInteger	evaluationDisabledCount = 0;
+
+static void
+disableEvaluation(id object)
+{
+  GS_MUTEX_LOCK(evaluationLock);
+  if (0 == evaluationDisabled)
+    {
+      evaluationDisabled
+	= NSCreateHashTable(NSNonOwnedPointerHashCallBacks, 0);
+    }
+  NSHashInsertIfAbsent(evaluationDisabled, object);
+  evaluationDisabledCount = NSCountHashTable(evaluationDisabled);
+  GS_MUTEX_UNLOCK(evaluationLock);
+}
+
+static void
+enableEvaluation(id object)
+{
+  if (evaluationDisabledCount > 0)
+    {
+      GS_MUTEX_LOCK(evaluationLock);
+      NSHashRemove(evaluationDisabled, object);
+      evaluationDisabledCount = NSCountHashTable(evaluationDisabled);
+      GS_MUTEX_UNLOCK(evaluationLock);
+    }
+}
+
+static void
+checkEvaluation(id object, NSString *kind)
+{
+  if (evaluationDisabledCount > 0)
+    {
+      BOOL	disabled;
+
+      GS_MUTEX_LOCK(evaluationLock);
+      disabled = (NSHashGet(evaluationDisabled, object) != 0);
+      GS_MUTEX_UNLOCK(evaluationLock);
+      if (disabled)
+	{
+	  [NSException raise: NSInternalInconsistencyException
+		      format: @"This %@ has evaluation disabled", kind];
+	}
+    }
+}
+
+/* Decodes the object for key, which may be a kind of one of classes, or of
+ * a class the caller of the unarchiver allowed.
+ */
+static id
+decodeAllowing(NSCoder *coder, NSString *key, NSSet *classes)
+{
+  NSSet	*allowed;
+
+  if (NO == [coder requiresSecureCoding])
+    {
+      return [coder decodeObjectForKey: key];
+    }
+  allowed = [coder allowedClasses];
+  if (allowed != nil)
+    {
+      classes = [classes setByAddingObjectsFromSet: allowed];
+    }
+  return [coder decodeObjectOfClasses: classes forKey: key];
+}
+
+#define	ALLOW(...)	[NSSet setWithObjects: __VA_ARGS__, nil]
+
