From 1e3ac91220c03d9ca898ae0b5a9bff71981ed78b Mon Sep 17 00:00:00 2001
From: Artyom Shalkhakov <artyom.shalkhakov@gmail.com>
Date: Thu, 24 Sep 2026 12:00:00 +0500
Subject: [PATCH] Use the 10.4 behaviour in NSDateFormatter's NSFormatter
 methods

-[NSDateFormatter stringForObjectValue:] - the NSFormatter entry point
every NSCell calls, and so the way a date reaches the screen from a text
field or a bound table column - always formats with the 10.0 calendar-
format code, even when the formatter was explicitly set to
NSDateFormatterBehavior10_4. The modern ICU machinery lives only in
-stringFromDate:.

An ICU pattern such as yyyy-MM-dd has no %-escapes, so a date column
shows the literal pattern instead of a date.
-getObjectValue:forString:errorDescription: mis-parses for the same
reason.

Delegate both entry points to -stringFromDate: / -dateFromString: when
the instance's behaviour is NSDateFormatterBehavior10_4, and leave the
10.0 path untouched for everyone who has not asked for the modern
behaviour.

The test added here fails on an unpatched library, where
-stringForObjectValue: answers the pattern rather than the date.
---
 Source/NSDateFormatter.m                      | 36 +++++++++++++++
 .../base/NSDateFormatter/formatterBehavior.m  | 46 +++++++++++++++++++
 2 files changed, 82 insertions(+)
 create mode 100644 Tests/base/NSDateFormatter/formatterBehavior.m

diff --git a/Source/NSDateFormatter.m b/Source/NSDateFormatter.m
index 51fdd545e..e338aab47 100644
--- a/Source/NSDateFormatter.m
+++ b/Source/NSDateFormatter.m
@@ -222,6 +222,29 @@ static NSDateFormatterBehavior _defaultBehavior = 0;
 {
   NSCalendarDate	*d;
 
+  /* In the modern behavior the format string is an ICU pattern, which
+   * only -dateFromString: understands; the 10.0 code below reads it as
+   * a calendar format and mis-parses.  (The 10.0 path is untouched, so
+   * existing users of %-escape formats keep what they have.) */
+  if (internal->_behavior == NSDateFormatterBehavior10_4)
+    {
+      NSDate	*parsed = [self dateFromString: string];
+
+      if (parsed == nil && [string length] > 0)
+	{
+	  if (error)
+	    {
+	      *error = @"Couldn't convert to date";
+	    }
+	  return NO;
+	}
+      if (anObject)
+	{
+	  *anObject = parsed;
+	}
+      return YES;
+    }
+
   if ([string length] == 0)
     {
       d = nil;
@@ -294,6 +317,19 @@ static NSDateFormatterBehavior _defaultBehavior = 0;
     {
       return nil;
     }
+
+  /* This is what an NSCell with a formatter calls, so it is how a date
+   * reaches the screen from a text field or a table column.  The
+   * modern (10.4, ICU) machinery lives in -stringFromDate:; without
+   * this, a formatter explicitly set to the modern behavior still
+   * formatted with the 10.0 calendar-format code, which treats an ICU
+   * pattern like yyyy-MM-dd as literal text - every bound table column
+   * showed the pattern itself instead of the date. */
+  if (internal->_behavior == NSDateFormatterBehavior10_4)
+    {
+      return [self stringFromDate: anObject];
+    }
+
   return [anObject descriptionWithCalendarFormat: _dateFormat
 					timeZone: [NSTimeZone defaultTimeZone]
 					  locale: nil];
diff --git a/Tests/base/NSDateFormatter/formatterBehavior.m b/Tests/base/NSDateFormatter/formatterBehavior.m
new file mode 100644
index 000000000..0ef8b320c
--- /dev/null
+++ b/Tests/base/NSDateFormatter/formatterBehavior.m
@@ -0,0 +1,46 @@
+#import "ObjectTesting.h"
+#import "Foundation/NSAutoreleasePool.h"
+#import "Foundation/NSDate.h"
+#import "Foundation/NSDateFormatter.h"
+#import "Foundation/NSString.h"
+#import "Foundation/NSTimeZone.h"
+
+/* -stringForObjectValue: and -getObjectValue:forString:errorDescription:
+ * are the NSFormatter entry points every cell goes through.  With the 10.4
+ * behaviour they must use the ICU pattern, as -stringFromDate: does; they
+ * used to format with the 10.0 calendar-format code whatever the behaviour
+ * was, so a cell showed the pattern itself instead of a date.
+ */
+int main(void)
+{
+  NSAutoreleasePool	*arp = [NSAutoreleasePool new];
+  NSDateFormatter	*formatter;
+  NSDate		*date;
+  NSString		*formatted;
+  id			parsed = nil;
+  NSString		*error = nil;
+
+  formatter = [[NSDateFormatter alloc] init];
+  [formatter setFormatterBehavior: NSDateFormatterBehavior10_4];
+  [formatter setDateFormat: @"yyyy-MM-dd"];
+  [formatter setTimeZone: [NSTimeZone timeZoneWithName: @"UTC"]];
+
+  date = [NSDate dateWithTimeIntervalSinceReferenceDate: 0.0];
+
+  formatted = [formatter stringForObjectValue: date];
+  PASS_EQUAL(formatted, [formatter stringFromDate: date],
+    "-stringForObjectValue: agrees with -stringFromDate: in the 10.4 behaviour");
+  PASS_EQUAL(formatted, @"2001-01-01",
+    "-stringForObjectValue: formats with the pattern, not with it as text");
+
+  PASS([formatter getObjectValue: &parsed
+		       forString: @"2001-01-01"
+		errorDescription: &error],
+    "-getObjectValue:forString:errorDescription: reads the pattern back");
+  PASS_EQUAL([formatter stringFromDate: parsed], @"2001-01-01",
+    "the date it read back is the date that was written");
+
+  [formatter release];
+  [arp release];
+  return 0;
+}
-- 
