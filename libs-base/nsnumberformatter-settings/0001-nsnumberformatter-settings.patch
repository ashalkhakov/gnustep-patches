+static NSError *
+formattingError(NSString *description)
+{
+  return [NSError errorWithDomain: NSCocoaErrorDomain
+    code: 2048 // NSFormattingError
+    userInfo: [NSDictionary dictionaryWithObject: description
+					  forKey: NSLocalizedDescriptionKey]];
+}
+
+static NSError *
+invalidValue(NSString *string)
+{
+  return formattingError([NSString stringWithFormat:
+    @"The value \u201C%@\u201D is invalid.", string]);
+}
+
+/* A multiplier ICU can apply itself, as it takes a whole number. */
+static BOOL
+integralMultiplier(NSNumber *multiplier, int32_t *value)
+{
+  double	d = [multiplier doubleValue];
+
+  if (d == floor(d) && fabs(d) < 2147483647.0 && d != 0.0)
+    {
+      *value = (int32_t)d;
+      return YES;
+    }
+  return NO;
+}
