+/* The attributes of a string such as the one for nil. */
+static NSDictionary *
+attributesOf(NSAttributedString *s)
+{
+  NSDictionary	*attributes = nil;
+
+  if ([s length] > 0)
+    {
+      attributes = [s attributesAtIndex: 0 effectiveRange: NULL];
+    }
+  return [attributes count] > 0 ? attributes : nil;
+}
+
+static NSAttributedString *
+attributedString(NSString *s, NSDictionary *attributes)
+{
+  if (nil == s)
+    {
+      return nil;
+    }
+  return AUTORELEASE([[NSAttributedString alloc] initWithString: s
+						     attributes: attributes]);
+}
