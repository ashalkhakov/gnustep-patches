+    [f setNegativeInfinitySymbol: @"NI"];
+    [f setTextAttributesForZero: one(@"zero")];
+    [f setTextAttributesForPositiveInfinity: one(@"pinf")];
+    [f setRoundingIncrement: [NSNumber numberWithDouble: 0.25]];
+    [f setMultiplier: [NSNumber numberWithInt: 10]];
+    [f setPartialStringValidationEnabled: YES];
+    [f setPositiveFormat: @"0.00 'u'"];
+    back = roundTrip(f);
+    PASS_EQUAL([back nilSymbol], @"none", "the nil symbol survives")
+    PASS_EQUAL([back zeroSymbol], @"zip", "the zero symbol survives")
+    PASS_EQUAL([back notANumberSymbol], @"nn", "the NaN symbol survives")
+    PASS_EQUAL([back positiveInfinitySymbol], @"PI",
+      "the positive infinity symbol survives")
+    PASS_EQUAL([back negativeInfinitySymbol], @"NI",
+      "the negative infinity symbol survives")
+    PASS_EQUAL([back textAttributesForZero], one(@"zero"),
+      "the attributes for zero survive")
+    PASS_EQUAL([back textAttributesForPositiveInfinity], one(@"pinf"),
+      "the attributes for infinity survive")
+    PASS_EQUAL([back roundingIncrement], [NSNumber numberWithDouble: 0.25],
+      "the rounding increment survives")
+    PASS_EQUAL([back multiplier], [NSNumber numberWithInt: 10],
+      "the multiplier survives")
+    PASS([back isPartialStringValidationEnabled],
+      "partial string validation survives")
+    PASS_EQUAL([back positiveFormat], @"0.00 'u'", "the format survives")
