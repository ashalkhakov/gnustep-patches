@@ -0,0 +1,278 @@
+#import <Foundation/Foundation.h>
+#import "Testing.h"
+#include <math.h>
+
+#if	defined(GS_USE_ICU)
+#define	NSLOCALE_SUPPORTED	GS_USE_ICU
+#else
+#define	NSLOCALE_SUPPORTED	1 /* Assume Apple support */
+#endif
+
+/* Each expected value is what macOS 15 gives for the same calls. */
+
+static NSNumberFormatter *
+decimalFormatter(void)
+{
+  NSNumberFormatter	*f = [[NSNumberFormatter new] autorelease];
+
+  [f setLocale: [[[NSLocale alloc] initWithLocaleIdentifier: @"en_US"]
+    autorelease]];
+  [f setNumberStyle: NSNumberFormatterDecimalStyle];
+  return f;
+}
+
+static NSString *
+parsed(NSNumberFormatter *f, NSString *s)
+{
+  id		v = nil;
+  NSString	*e = nil;
+  BOOL		ok = [f getObjectValue: &v forString: s errorDescription: &e];
+
+  return [NSString stringWithFormat: @"%d %@ %@", ok, v, e];
+}
+
+static NSArray *
+keysOf(NSDictionary *d)
+{
+  return [[d allKeys] sortedArrayUsingSelector: @selector(compare:)];
+}
+
+static NSDictionary *
+attributesOf(NSAttributedString *s)
+{
+  return [s attributesAtIndex: 0 effectiveRange: NULL];
+}
+
+static NSDictionary *
+one(NSString *key)
+{
+  return [NSDictionary dictionaryWithObject: @"1" forKey: key];
+}
+
+static id
+roundTrip(id o)
+{
+  return [NSKeyedUnarchiver unarchiveObjectWithData:
+    [NSKeyedArchiver archivedDataWithRootObject: o]];
+}
+
+int main()
+{
+  NSAutoreleasePool	*arp = [NSAutoreleasePool new];
+  NSNumberFormatter	*f;
+  NSNumberFormatter	*back;
+  NSDictionary		*def = one(@"default");
+  NSNumber		*inf = [NSNumber numberWithDouble: INFINITY];
+  NSNumber		*ninf = [NSNumber numberWithDouble: -INFINITY];
+
+  START_SET("NSNumberFormatter settings")
+    if (!NSLOCALE_SUPPORTED)
+      SKIP("NSLocale not supported\nThe ICU library was not available when GNUstep-base was built")
+
+    f = decimalFormatter();
+    PASS([f maximumFractionDigits] == 3 && [f usesGroupingSeparator],
+      "the decimal style gives three fraction digits and grouping")
+    [f setUsesGroupingSeparator: NO];
+    [f setLocale: [[[NSLocale alloc] initWithLocaleIdentifier: @"fr_FR"]
+      autorelease]];
+    [f setLocale: [[[NSLocale alloc] initWithLocaleIdentifier: @"en_US"]
+      autorelease]];
+    PASS_EQUAL([f stringFromNumber: [NSNumber numberWithDouble: 12345.6789]],
+      @"12345.679", "turning grouping off survives a change of locale")
+    [f setMaximumFractionDigits: 1];
+    [f setNumberStyle: NSNumberFormatterPercentStyle];
+    PASS_EQUAL([f stringFromNumber: [NSNumber numberWithDouble: 0.12345]],
+      @"12.3%", "a digit count survives a change of style")
+
+    f = decimalFormatter();
+    [f setMinimum: [NSNumber numberWithInt: 0]];
+    [f setMaximum: [NSNumber numberWithInt: 100]];
+    PASS_EQUAL(parsed(f, @"150"), @"0 (null) The value 150 is too large.",
+      "a number over the maximum is refused")
+    PASS_EQUAL(parsed(f, @"-1"), @"0 (null) The value -1 is too small.",
+      "a number under the minimum is refused")
+    PASS_EQUAL(parsed(f, @"50"), @"1 50 (null)", "a number in range is read")
+    PASS([f numberFromString: @"150"] == nil,
+      "-numberFromString: keeps to the range too")
+    [f setAllowsFloats: NO];
+    PASS_EQUAL(parsed(f, @"1.5"), @"0 (null) The value “1.5” is invalid.",
+      "a fraction is refused when floats are not allowed")
+    PASS_EQUAL(parsed(f, @"2"), @"1 2 (null)", "a whole number is read")
+
+    f = decimalFormatter();
+    PASS_EQUAL(parsed(f, @"12abc"),
+      @"0 (null) The value “12abc” is invalid.",
+      "the whole string must be a number")
+    PASS_EQUAL(parsed(f, @" 12 "), @"1 12 (null)",
+      "white space around a number is allowed")
+    PASS_EQUAL(parsed(f, @""), @"1 (null) (null)", "an empty string is nil")
+    {
+      NSRange	r = NSMakeRange(0, 5);
+      id	v = nil;
+      BOOL	ok;
+
+      ok = [f getObjectValue: &v forString: @"12abc" range: &r error: NULL];
+      PASS(ok && [v intValue] == 12 && r.length == 2,
+	"a range is read as far as it is a number")
+    }
+
+    f = decimalFormatter();
+    PASS_EQUAL([f nilSymbol], @"", "the nil symbol is empty")
+    PASS([f zeroSymbol] == nil, "there is no zero symbol")
+    PASS_EQUAL([f notANumberSymbol], @"NaN", "the NaN symbol is NaN")
+    PASS_EQUAL([f stringFromNumber: inf], @"+∞",
+      "positive infinity is +∞")
+    PASS_EQUAL([f stringFromNumber: ninf], @"-∞",
+      "negative infinity is -∞")
+    [f setNilSymbol: @"none"];
+    [f setZeroSymbol: @"zip"];
+    [f setNotANumberSymbol: @"nn"];
+    [f setPositiveInfinitySymbol: @"PI"];
+    [f setNegativeInfinitySymbol: @"NI"];
+    PASS_EQUAL([f stringForObjectValue: nil], @"none", "nil gives its symbol")
+    PASS_EQUAL([f stringFromNumber: [NSNumber numberWithInt: 0]], @"zip",
+      "zero gives its symbol")
+    PASS_EQUAL([f stringFromNumber: [NSNumber numberWithInt: 10]], @"10",
+      "the zero symbol is not a digit")
+    PASS_EQUAL([f stringFromNumber: [NSNumber numberWithDouble: NAN]], @"nn",
+      "NaN gives its symbol")
+    PASS_EQUAL([f stringFromNumber: inf], @"PI",
+      "positive infinity gives its symbol")
+    PASS_EQUAL([f stringFromNumber: ninf], @"NI",
+      "negative infinity gives its own symbol")
+    PASS_EQUAL([[f attributedStringForNil] string], @"none",
+      "the nil symbol is the string for nil")
+    PASS_EQUAL([[f attributedStringForZero] string], @"zip",
+      "the zero symbol is the string for zero")
+    PASS_EQUAL(parsed(f, @"zip"), @"1 0 (null)", "the zero symbol is read")
+    PASS_EQUAL(parsed(f, @"PI"), @"1 inf (null)", "an infinity is read")
+    PASS_EQUAL(parsed(f, @"none"), @"1 (null) (null)",
+      "the nil symbol is read as nil")
+    [f setTextAttributesForZero: one(@"zero")];
+    [f setTextAttributesForNil: one(@"nil")];
+    [f setTextAttributesForNotANumber: one(@"nan")];
+    [f setTextAttributesForPositiveInfinity: one(@"pinf")];
+    [f setTextAttributesForNegativeInfinity: one(@"ninf")];
+    [f setTextAttributesForPositiveValues: one(@"pos")];
+    [f setTextAttributesForNegativeValues: one(@"neg")];
+#define	ATTRIBUTED(v, s, k) \
+    PASS_EQUAL(keysOf(attributesOf([f attributedStringForObjectValue: v \
+      withDefaultAttributes: def])), \
+      ([NSArray arrayWithObjects: @"default", k, nil]), s)
+    ATTRIBUTED([NSNumber numberWithInt: 0], "zero has its attributes", @"zero");
+    ATTRIBUTED(nil, "nil has its attributes", @"nil");
+    ATTRIBUTED([NSNumber numberWithDouble: NAN], "NaN has its attributes", @"nan");
+    ATTRIBUTED(inf, "positive infinity has its attributes", @"pinf");
+    ATTRIBUTED(ninf, "negative infinity has its attributes", @"ninf");
+    ATTRIBUTED([NSNumber numberWithInt: 5], "a positive value has its attributes", @"pos");
+    ATTRIBUTED([NSNumber numberWithInt: -5], "a negative value has its attributes", @"neg");
+    PASS_EQUAL(keysOf(attributesOf([f attributedStringForNil])),
+      [NSArray arrayWithObject: @"nil"],
+      "the string for nil has the attributes for nil")
+
+    f = decimalFormatter();
+    PASS_EQUAL([f roundingIncrement], [NSNumber numberWithInt: 0],
+      "there is no rounding increment")
+    PASS([f multiplier] == nil, "there is no multiplier")
+    [f setRoundingIncrement: [NSNumber numberWithDouble: 0.25]];
+    PASS_EQUAL([f stringFromNumber: [NSNumber numberWithDouble: 1.1]], @"1",
+      "a rounding increment of 0.25 rounds 1.1 to 1")
+    PASS_EQUAL([f stringFromNumber: [NSNumber numberWithDouble: 1.13]], @"1.25",
+      "a rounding increment of 0.25 rounds 1.13 to 1.25")
+    [f setNumberStyle: NSNumberFormatterPercentStyle];
+    [f setNumberStyle: NSNumberFormatterDecimalStyle];
+    PASS_EQUAL([f stringFromNumber: [NSNumber numberWithDouble: 1.13]], @"1.25",
+      "the rounding increment survives a change of style")
+    [f setRoundingIncrement: [NSNumber numberWithInt: 5]];
+    [f setMaximumFractionDigits: 0];
+    PASS_EQUAL([f stringFromNumber: [NSNumber numberWithInt: 12]], @"10",
+      "a whole rounding increment is taken")
+
+    f = decimalFormatter();
+    [f setMultiplier: [NSNumber numberWithInt: 100]];
+    PASS_EQUAL([f stringFromNumber: [NSNumber numberWithDouble: 1.5]], @"150",
+      "a multiplier of 100 is applied in formatting")
+    PASS_EQUAL([f numberFromString: @"150"], [NSNumber numberWithDouble: 1.5],
+      "and undone in parsing")
+    [f setMultiplier: [NSNumber numberWithDouble: 0.5]];
+    PASS_EQUAL([f stringFromNumber: [NSNumber numberWithInt: 4]], @"2",
+      "a multiplier of 0.5 is applied in formatting")
+    PASS_EQUAL([f numberFromString: @"1.5"], [NSNumber numberWithInt: 3],
+      "and undone in parsing")
+    f = decimalFormatter();
+    [f setNumberStyle: NSNumberFormatterPercentStyle];
+    [f setMultiplier: [NSNumber numberWithInt: 10]];
+    PASS_EQUAL([f stringFromNumber: [NSNumber numberWithDouble: 1.5]], @"15%",
+      "a multiplier replaces the percent style's")
+
+    f = decimalFormatter();
+    [f setPositiveFormat: @"0.00 'u'"];
+    PASS_EQUAL([f stringFromNumber: [NSNumber numberWithDouble: 3.14159]],
+      @"3.14 u", "a positive format is applied")
+    PASS([f maximumFractionDigits] == 2, "the format sets the digits")
+    [f setNegativeFormat: @"(0.0)"];
+    PASS_EQUAL([f stringFromNumber: [NSNumber numberWithDouble: -2.25]],
