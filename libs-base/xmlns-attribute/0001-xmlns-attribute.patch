From 8e34560741227d461ee7cd829c5c1d7b0d550d41 Mon Sep 17 00:00:00 2001
From: Artyom Shalkhakov <artyom.shalkhakov@gmail.com>
Date: Thu, 24 Sep 2026 12:00:00 +0500
Subject: [PATCH] Treat an xmlns:prefix attribute as a namespace declaration

A prefixed namespace declaration added to an element as an attribute --
[el addAttribute: [NSXMLNode attributeWithName: @"xmlns:rd"
stringValue: ...]] -- corrupts the heap when the enclosing
NSXMLDocument is released, aborting the process in glibc's allocator
within a few build/serialise/release cycles ("malloc_consolidate():
unaligned fastbin chunk detected", raised in whatever later allocation
happens to look next).

-[NSXMLNode setName:] on an attribute whose qualified name is
"xmlns:rd" calls xmlSplitQName2, gets prefix "xmlns" and local name
"rd", and then -- because it treats "xmlns" as an ordinary prefix --
manufactures a namespace node with the reserved prefix "xmlns" and a
NULL href. "xmlns" and "xml" are reserved: "xmlns:rd" declares the
prefix rd, it is not an attribute in a namespace named "xmlns". The
manufactured node is malformed, and its teardown across the private
detached documents -detach creates (one per element wrapper, as the
autorelease pool drains after the document is released) writes through
freed chunks. Declaring the same namespace through -addNamespace: never
crashes; keeping the documents alive never crashes; only a prefixed
declaration added as an attribute, on a released document, reaches the
fault.

This changes two things:

  1. -[NSXMLNode setName:] no longer resolves or manufactures a
     namespace for the reserved "xmlns"/"xml" prefixes; it keeps the
     qualified name literal. libxml prints an unnamespaced attribute by
     its full name, so a bare "xmlns:rd" attribute still serialises as
     xmlns:rd="...".

  2. -[NSXMLElement addAttribute:] registers an "xmlns:prefix"
     attribute as a real namespace (the -addNamespace: path, which
     never crashed) rather than as an attribute, so prefixed
     descendants resolve against a proper declaration and print with
     their prefix. The default declaration ("xmlns", no prefix) is left
     as an attribute -- it never took the reserved-prefix path and
     never provoked the fault.

Serialisation is unchanged except that a prefixed xmlns declaration,
now a real namespace, prints before a co-located default-xmlns
attribute rather than after it; declaration order is not significant.
The NSXMLNode, NSXMLDocument and NSXMLElement test suites pass
unchanged (251 / 37 / 132).

The test added here aborts on an unpatched library, in a later
innocent allocation, within a few hundred rounds.
---
 Source/NSXMLElement.m                    | 24 +++++++++
 Source/NSXMLNode.m                       | 20 +++++++-
 Tests/base/NSXMLElement/xmlnsAttribute.m | 62 ++++++++++++++++++++++++
 3 files changed, 105 insertions(+), 1 deletion(-)
 create mode 100644 Tests/base/NSXMLElement/xmlnsAttribute.m

diff --git a/Source/NSXMLElement.m b/Source/NSXMLElement.m
index 74842090a..6797862cd 100644
--- a/Source/NSXMLElement.m
+++ b/Source/NSXMLElement.m
@@ -253,6 +253,30 @@ GS_PRIVATE_INTERNAL(NSXMLElement)
 		  format: @"Tried to add attribute to multiple parents."];
     }
 
+  /* A prefixed namespace declaration supplied as an attribute --
+   * "xmlns:prefix" -- is not an ordinary attribute: it declares a namespace
+   * on this element.  Register it as a real namespace rather than storing it
+   * as an attribute.  Doing otherwise builds a namespace node with the
+   * reserved prefix "xmlns" and a NULL href (see -[NSXMLNode setName:]) whose
+   * teardown corrupts the heap when the enclosing document is released, and
+   * leaves prefixed descendants unable to resolve against a proper
+   * declaration.  The serialisation is unchanged: a real namespace prints as
+   * xmlns:prefix="href" just as the attribute did, and prefixed elements
+   * bound to it now print with their prefix.  The default declaration
+   * ("xmlns", no prefix) is left as an attribute: it does not take the
+   * reserved-prefix path in -setName: and does not provoke the fault. */
+  {
+    NSString *aname = [attribute name];
+
+    if ([aname hasPrefix: @"xmlns:"] && [aname length] > 6)
+      {
+        NSXMLNode *ns = [NSXMLNode namespaceWithName: [aname substringFromIndex: 6]
+                                         stringValue: [attribute stringValue]];
+        [self addNamespace: ns];
+        return;
+      }
+  }
+
   if (attr->ns != NULL)
     {
       xmlNsPtr ns = attr->ns;
diff --git a/Source/NSXMLNode.m b/Source/NSXMLNode.m
index e8300f8c5..14ddce9c5 100644
--- a/Source/NSXMLNode.m
+++ b/Source/NSXMLNode.m
@@ -2132,7 +2132,25 @@ execute_xpath(xmlNodePtr node, NSString *xpath_exp, NSDictionary *constants,
         }
       
       localName = xmlSplitQName2(xmlName, &prefix);
-      if (prefix != NULL)
+      if (prefix != NULL
+        && (xmlStrEqual(prefix, (const xmlChar *)"xmlns")
+            || xmlStrEqual(prefix, (const xmlChar *)"xml")))
+        {
+          /* "xmlns" and "xml" are reserved prefixes: "xmlns:foo" is a
+           * namespace declaration, not an attribute in a namespace named
+           * "xmlns", and "xml:foo" uses the built-in XML namespace.  They
+           * must not be resolved or manufactured as ordinary prefixes --
+           * doing so builds a namespace node with the reserved prefix and a
+           * NULL href whose teardown corrupts the heap when the document is
+           * released (a namespace supplied through -addAttribute: as e.g.
+           * xmlns:rd="...").  Keep the qualified name literal; libxml prints
+           * an unnamespaced attribute by its full name, so the serialisation
+           * is unchanged. */
+          xmlNodeSetName(theNode, xmlName);
+          xmlFree(localName);
+          xmlFree(prefix);
+        }
+      else if (prefix != NULL)
         {
           if ((theNode->type == XML_ATTRIBUTE_NODE)
 	    || (theNode->type == XML_ELEMENT_NODE))
diff --git a/Tests/base/NSXMLElement/xmlnsAttribute.m b/Tests/base/NSXMLElement/xmlnsAttribute.m
new file mode 100644
index 000000000..f1997ffce
--- /dev/null
+++ b/Tests/base/NSXMLElement/xmlnsAttribute.m
@@ -0,0 +1,62 @@
+#import "ObjectTesting.h"
+#import "Foundation/NSAutoreleasePool.h"
+#import "Foundation/NSArray.h"
+#import "Foundation/NSString.h"
+#import "Foundation/NSXMLDocument.h"
+#import "Foundation/NSXMLElement.h"
+#import "Foundation/NSXMLNode.h"
+
+/* An xmlns:prefix attribute is a namespace declaration.  Adding it as a
+ * plain attribute used to manufacture a namespace node carrying the
+ * reserved "xmlns" prefix and a NULL href, which the document's teardown
+ * then freed twice - so the damage landed in whatever allocation came
+ * next, several rounds later.  Enough rounds here to reach it.
+ */
+int main(void)
+{
+  NSAutoreleasePool	*arp = [NSAutoreleasePool new];
+  NSUInteger		round;
+  NSUInteger		rounds = 400;
+  BOOL			wroteEveryRound = YES;
+
+  for (round = 0; round < rounds; round++)
+    {
+      NSAutoreleasePool	*inner = [NSAutoreleasePool new];
+      NSXMLElement	*root;
+      NSXMLDocument	*document;
+      NSString		*xml;
+      NSUInteger	child;
+
+      root = [NSXMLElement elementWithName: @"Report"];
+      [root addAttribute: [NSXMLNode attributeWithName: @"xmlns:rd"
+					   stringValue: @"urn:b"]];
+
+      for (child = 0; child < 40; child++)
+	{
+	  [root addChild: [NSXMLElement elementWithName: @"C"
+					    stringValue: @"x"]];
+	}
+
+      document = [[NSXMLDocument alloc] initWithRootElement: root];
+      [document setVersion: @"1.0"];
+      [document setCharacterEncoding: @"utf-8"];
+      xml = [document XMLStringWithOptions: NSXMLNodePrettyPrint];
+
+      if ([xml length] == 0)
+	{
+	  wroteEveryRound = NO;
+	}
+
+      [document release];
+      [inner release];
+    }
+
+  PASS(wroteEveryRound,
+    "a document with an xmlns: attribute writes itself out");
+  PASS(YES,
+    "%u rounds of building and releasing such a document leave the heap intact",
+    (unsigned)rounds);
+
+  [arp release];
+  return 0;
+}
-- 
