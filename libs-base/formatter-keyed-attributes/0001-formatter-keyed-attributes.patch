@@ -276,6 +323,38 @@ static NSDateFormatterBehavior _defaultBehavior = 0;
   NSString	*fmt;
   BOOL		nl;
 
+  if ([aCoder allowsKeyedCoding])
+    {
+      NSDictionary	*attributes;
+
+      attributes = [aCoder decodeObjectForKey: @"NS.attributes"];
+      if (NO == [attributes isKindOfClass: [NSDictionary class]])
+        {
+          attributes = nil;
+        }
+      /* With the 10.4 behaviour NS.format is only what the settings in
+       * NS.attributes give.
