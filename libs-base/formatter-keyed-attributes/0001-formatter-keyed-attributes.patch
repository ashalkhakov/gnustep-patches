new file mode 100644
index 0000000..f007d5e
--- /dev/null
+++ b/Tests/base/NSDateFormatter/keyedAttributes.m
@@ -0,0 +1,204 @@
+#import <Foundation/Foundation.h>
+#import "Testing.h"
+
+/* Writes what macOS writes for a date formatter: its 10.0 format and
+ * natural language flag, and its settings in NS.attributes.
+ */
+@interface	ArchivedDateFormatter : NSObject
+{
+  NSString	*format;
+  BOOL		natural;
+  NSDictionary	*attributes;
+}
+- (id) initWithFormat: (NSString*)f
+	      natural: (BOOL)n
+	   attributes: (NSDictionary*)a;
+@end
+
+@implementation	ArchivedDateFormatter
+- (id) initWithFormat: (NSString*)f
+	      natural: (BOOL)n
+	   attributes: (NSDictionary*)a
+{
+  if (nil != (self = [super init]))
+    {
+      format = [f copy];
+      natural = n;
+      attributes = [a mutableCopy];
+    }
+  return self;
+}
+- (void) dealloc
+{
+  [format release];
+  [attributes release];
+  [super dealloc];
+}
+- (void) encodeWithCoder: (NSCoder*)coder
+{
+  [coder encodeObject: attributes forKey: @"NS.attributes"];
+  [coder encodeObject: format forKey: @"NS.format"];
+  [coder encodeBool: natural forKey: @"NS.natural"];
+}
+@end
+
+/* Reads back what a date formatter wrote. */
+@interface	WrittenDateFormatter : NSObject
+{
+@public
+  NSDictionary	*attributes;
+  NSString	*format;
+}
+@end
+
+@implementation	WrittenDateFormatter
+- (void) dealloc
+{
+  [attributes release];
+  [format release];
+  [super dealloc];
+}
+- (id) initWithCoder: (NSCoder*)coder
+{
+  attributes = [[coder decodeObjectForKey: @"NS.attributes"] retain];
+  format = [[coder decodeObjectForKey: @"NS.format"] retain];
+  return self;
+}
+@end
+
+static WrittenDateFormatter *
+written(NSData *data)
+{
+  NSKeyedUnarchiver	*unarchiver;
+  id			o;
+
+  unarchiver = [[NSKeyedUnarchiver alloc] initForReadingWithData: data];
+  [unarchiver setClass: [WrittenDateFormatter class]
+	  forClassName: @"NSDateFormatter"];
+  o = [[[unarchiver decodeObjectForKey: @"root"] retain] autorelease];
+  [unarchiver release];
+  return o;
+}
+
+static NSDateFormatter *
+unarchived(NSString *format, BOOL natural, NSDictionary *attributes)
+{
+  ArchivedDateFormatter	*archived;
+  NSKeyedArchiver	*archiver;
+  NSMutableData		*data = [NSMutableData data];
+
+  archived = [[[ArchivedDateFormatter alloc] initWithFormat: format
+						    natural: natural
+						 attributes: attributes]
+    autorelease];
+  archiver = [[NSKeyedArchiver alloc] initForWritingWithMutableData: data];
+  [archiver setClassName: @"NSDateFormatter"
+		forClass: [ArchivedDateFormatter class]];
+  [archiver encodeObject: archived forKey: @"root"];
+  [archiver finishEncoding];
+  [archiver release];
+  return [NSKeyedUnarchiver unarchiveObjectWithData: data];
+}
+
+int main()
+{
+  NSAutoreleasePool	*arp = [NSAutoreleasePool new];
+  NSDateFormatter	*fmt;
+  NSDateFormatter	*back;
+  WrittenDateFormatter	*w;
+  NSData		*data;
+
+  START_SET("NSDateFormatter keyed attributes")
+
+    fmt = unarchived(@"M/d/yy, h:mm a", NO,
+      [NSDictionary dictionaryWithObjectsAndKeys:
+	[NSNumber numberWithInt: 1040], @"formatterBehavior",
+	[NSNumber numberWithInt: 1], @"dateStyle",
+	[NSNumber numberWithInt: 1], @"timeStyle",
+	nil]);
+    PASS([fmt isKindOfClass: [NSDateFormatter class]],
+      "a date formatter is unarchived")
+    PASS([fmt formatterBehavior] == NSDateFormatterBehavior10_4,
+      "formatterBehavior is read from NS.attributes")
+    PASS([fmt dateStyle] == NSDateFormatterShortStyle,
+      "dateStyle is read from NS.attributes")
+    PASS([fmt timeStyle] == NSDateFormatterShortStyle,
+      "timeStyle is read from NS.attributes")
+
+    fmt = unarchived(@"yyyy-MM-dd", YES,
+      [NSDictionary dictionaryWithObjectsAndKeys:
+	[NSNumber numberWithInt: 1040], @"formatterBehavior",
+	@"yyyy-MM-dd", @"dateFormat",
+	[NSNumber numberWithBool: YES], @"lenient",
+	nil]);
+    PASS([fmt formatterBehavior] == NSDateFormatterBehavior10_4,
+      "a custom format keeps the 10.4 behavior")
+    PASS_EQUAL([fmt dateFormat], @"yyyy-MM-dd",
+      "dateFormat is read from NS.attributes")
+    PASS([fmt isLenient], "lenient is read from NS.attributes")
+
+    fmt = unarchived(@"%Y", YES,
+      [NSDictionary dictionaryWithObjectsAndKeys:
+	[NSNumber numberWithInt: 1000], @"formatterBehavior",
+	@"%Y", @"dateFormat_10_0",
+	nil]);
+    PASS([fmt formatterBehavior] == NSDateFormatterBehavior10_0,
+      "a 10.0 formatter keeps its behavior")
+    PASS_EQUAL([fmt dateFormat], @"%Y", "NS.format is read")
+    PASS([fmt allowsNaturalLanguage], "NS.natural is read")
+
+    /* What a formatter writes is what macOS writes. */
+    fmt = [[NSDateFormatter new] autorelease];
+    [fmt setFormatterBehavior: NSDateFormatterBehavior10_4];
+    [fmt setLocale: [[[NSLocale alloc] initWithLocaleIdentifier: @"en_US"]
+      autorelease]];
+    [fmt setDateStyle: NSDateFormatterShortStyle];
+    [fmt setTimeStyle: NSDateFormatterShortStyle];
+    data = [NSKeyedArchiver archivedDataWithRootObject: fmt];
+    w = written(data);
+    PASS_EQUAL([w->attributes objectForKey: @"formatterBehavior"],
+      [NSNumber numberWithInt: 1040], "formatterBehavior is written")
+    PASS_EQUAL([w->attributes objectForKey: @"dateStyle"],
+      [NSNumber numberWithInt: 1], "dateStyle is written")
+    PASS_EQUAL([w->attributes objectForKey: @"timeStyle"],
+      [NSNumber numberWithInt: 1], "timeStyle is written")
+    PASS([w->attributes objectForKey: @"dateFormat"] == nil,
+      "the format the styles give is not written")
+    PASS_EQUAL(w->format, [fmt dateFormat], "NS.format is the format in use")
+    back = [NSKeyedUnarchiver unarchiveObjectWithData: data];
+    PASS([back formatterBehavior] == NSDateFormatterBehavior10_4
+      && [back dateStyle] == NSDateFormatterShortStyle
+      && [back timeStyle] == NSDateFormatterShortStyle
+      && [[[back locale] localeIdentifier] isEqual: @"en_US"],
+      "the styles survive a keyed archive")
+
+    fmt = [[NSDateFormatter new] autorelease];
+    [fmt setFormatterBehavior: NSDateFormatterBehavior10_4];
+    [fmt setDateFormat: @"yyyy-MM-dd"];
+    data = [NSKeyedArchiver archivedDataWithRootObject: fmt];
+    w = written(data);
+    PASS_EQUAL([w->attributes objectForKey: @"dateFormat"], @"yyyy-MM-dd",
+      "a format that was set is written")
+    back = [NSKeyedUnarchiver unarchiveObjectWithData: data];
+    PASS_EQUAL([back dateFormat], @"yyyy-MM-dd",
+      "the format survives a keyed archive")
+
+    fmt = [[[NSDateFormatter alloc] initWithDateFormat: @"%Y-%m"
+				  allowNaturalLanguage: YES] autorelease];
+    data = [NSKeyedArchiver archivedDataWithRootObject: fmt];
+    w = written(data);
+    PASS_EQUAL([w->attributes objectForKey: @"formatterBehavior"],
+      [NSNumber numberWithInt: 1000], "a 10.0 formatter writes its behavior")
+    PASS_EQUAL([w->attributes objectForKey: @"dateFormat_10_0"], @"%Y-%m",
+      "a 10.0 formatter writes its format as macOS does")
+    back = [NSKeyedUnarchiver unarchiveObjectWithData: data];
+    PASS([back formatterBehavior] == NSDateFormatterBehavior10_0
+      && [[back dateFormat] isEqual: @"%Y-%m"]
+      && [back allowsNaturalLanguage],
+      "a 10.0 formatter survives a keyed archive")
+
+  END_SET("NSDateFormatter keyed attributes")
+
+  [arp release];
+  return 0;
+}
diff --git a/Tests/base/NSNumberFormatter/keyedAttributes.m b/Tests/base/NSNumberFormatter/keyedAttributes.m
new file mode 100644
index 0000000..c8e8331
--- /dev/null
+++ b/Tests/base/NSNumberFormatter/keyedAttributes.m
@@ -0,0 +1,235 @@
+#import <Foundation/Foundation.h>
+#import "Testing.h"
+
+#if	defined(GS_USE_ICU)
+#define	NSLOCALE_SUPPORTED	GS_USE_ICU
+#else
+#define	NSLOCALE_SUPPORTED	1 /* Assume Apple support */
+#endif
+
+/* Writes what macOS writes for a number formatter set up as a nib's
+ * decimal field: the 10.0 keys, and the 10.4 settings in NS.attributes.
+ */
+@interface	ArchivedNumberFormatter : NSObject
+{
+@public
+  NSDictionary	*attributes;
+  NSString	*separator;
+  id		minimum;
+}
+@end
+
+@implementation	ArchivedNumberFormatter
+- (void) dealloc
+{
+  [attributes release];
+  [separator release];
+  [minimum release];
+  [super dealloc];
+}
+- (void) encodeWithCoder: (NSCoder*)coder
+{
+  [coder encodeBool: YES forKey: @"NS.allowsfloats"];
+  [coder encodeBool: NO forKey: @"NS.hasthousands"];
+  [coder encodeBool: YES forKey: @"NS.localized"];
+  [coder encodeObject: separator forKey: @"NS.decimal"];
+  [coder encodeObject: @"," forKey: @"NS.thousand"];
+  [coder encodeObject: minimum forKey: @"NS.min"];
+  [coder encodeObject: minimum forKey: @"NS.max"];
+  [coder encodeObject: @"#########################################0.###"
+	       forKey: @"NS.positiveformat"];
+  [coder encodeObject: @"#########################################0.###"
+	       forKey: @"NS.negativeformat"];
+  [coder encodeObject: attributes forKey: @"NS.attributes"];
+}
+@end
+
+/* Reads back what a number formatter wrote. */
+@interface	WrittenNumberFormatter : NSObject
+{
+@public
+  NSDictionary	*attributes;
+  BOOL		hasDecimal;
+}
+@end
+
+@implementation	WrittenNumberFormatter
+- (void) dealloc
+{
+  [attributes release];
+  [super dealloc];
+}
+- (id) initWithCoder: (NSCoder*)coder
+{
+  attributes = [[coder decodeObjectForKey: @"NS.attributes"] retain];
+  hasDecimal = [coder containsValueForKey: @"NS.decimal"];
+  return self;
+}
+@end
+
+static NSNumberFormatter *
+unarchived(ArchivedNumberFormatter *archived)
+{
+  NSMutableData		*data = [NSMutableData data];
+  NSKeyedArchiver	*archiver;
+
+  archiver = [[NSKeyedArchiver alloc] initForWritingWithMutableData: data];
+  [archiver setClassName: @"NSNumberFormatter"
+		forClass: [ArchivedNumberFormatter class]];
+  [archiver encodeObject: archived forKey: @"root"];
+  [archiver finishEncoding];
+  [archiver release];
+  return [NSKeyedUnarchiver unarchiveObjectWithData: data];
+}
+
+static WrittenNumberFormatter *
+written(NSData *data)
+{
+  NSKeyedUnarchiver	*unarchiver;
+  id			o;
+
+  unarchiver = [[NSKeyedUnarchiver alloc] initForReadingWithData: data];
+  [unarchiver setClass: [WrittenNumberFormatter class]
+	  forClassName: @"NSNumberFormatter"];
+  o = [[[unarchiver decodeObjectForKey: @"root"] retain] autorelease];
+  [unarchiver release];
+  return o;
+}
+
+int main()
+{
+  NSAutoreleasePool	*arp = [NSAutoreleasePool new];
+  NSNumberFormatter	*fmt;
+  NSNumberFormatter	*back;
+  ArchivedNumberFormatter	*archived;
+  WrittenNumberFormatter	*w;
+  NSData		*data;
+
+  START_SET("NSNumberFormatter keyed attributes")
+    if (!NSLOCALE_SUPPORTED)
+      SKIP("NSLocale not supported\nThe ICU library was not available when GNUstep-base was built")
+
+    archived = [[ArchivedNumberFormatter new] autorelease];
+    archived->separator = [@"." retain];
+    archived->attributes = [[NSMutableDictionary dictionaryWithObjectsAndKeys:
+      [NSNumber numberWithInt: 1040], @"formatterBehavior",
+      [NSNumber numberWithInt: 1], @"numberStyle",
+      [NSNumber numberWithBool: YES], @"generatesDecimalNumbers",
+      [NSNumber numberWithBool: NO], @"usesGroupingSeparator",
+      [NSNumber numberWithInt: 0], @"groupingSize",
+      [NSNumber numberWithInt: 1], @"minimumIntegerDigits",
+      [NSNumber numberWithInt: 42], @"maximumIntegerDigits",
+      [NSNumber numberWithInt: 3], @"maximumFractionDigits",
+      [NSNumber numberWithBool: YES], @"allowsFloats",
+      @"", @"nilSymbol",
+      nil] retain];
+    fmt = unarchived(archived);
+    PASS([fmt isKindOfClass: [NSNumberFormatter class]],
+      "a number formatter is unarchived")
+    PASS([fmt formatterBehavior] == NSNumberFormatterBehavior10_4,
+      "formatterBehavior is read from NS.attributes")
+    PASS([fmt numberStyle] == NSNumberFormatterDecimalStyle,
+      "numberStyle is read from NS.attributes")
+    PASS([fmt generatesDecimalNumbers],
+      "generatesDecimalNumbers is read from NS.attributes")
+    PASS([fmt usesGroupingSeparator] == NO,
+      "usesGroupingSeparator is read from NS.attributes")
+    PASS([fmt minimumIntegerDigits] == 1,
+      "minimumIntegerDigits is read from NS.attributes")
+    PASS([fmt maximumIntegerDigits] == 42,
+      "maximumIntegerDigits is read from NS.attributes")
+    PASS([fmt maximumFractionDigits] == 3,
+      "maximumFractionDigits is read from NS.attributes")
+    PASS([fmt allowsFloats], "allowsFloats is read")
+    PASS_EQUAL([fmt stringFromNumber: [NSNumber numberWithDouble: 12345.6789]],
+      @"12345.679", "the formatter formats with the settings read")
+
+    /* The 10.0 keys repeat a 10.4 formatter's settings for older readers,
+     * as they stood for the locale it was archived in.
+     */
+    archived = [[ArchivedNumberFormatter new] autorelease];
+    archived->separator = [@"," retain];
+    archived->minimum = [[NSDecimalNumber notANumber] retain];
+    archived->attributes = [[NSMutableDictionary dictionaryWithObjectsAndKeys:
+      [NSNumber numberWithInt: 1040], @"formatterBehavior",
+      [NSNumber numberWithInt: 1], @"numberStyle",
+      [[[NSLocale alloc] initWithLocaleIdentifier: @"en_US"] autorelease],
+      @"locale",
+      nil] retain];
+    fmt = unarchived(archived);
+    PASS_EQUAL([fmt decimalSeparator], @".",
+      "NS.decimal does not override the locale of a 10.4 formatter")
+    PASS([fmt minimum] == nil && [fmt maximum] == nil,
+      "a 10.4 formatter takes no minimum or maximum from the 10.0 keys")
+
+    archived = [[ArchivedNumberFormatter new] autorelease];
+    archived->separator = [@"." retain];
+    archived->minimum = [[NSDecimalNumber notANumber] retain];
+    archived->attributes = [[NSMutableDictionary dictionaryWithObjectsAndKeys:
+      [NSNumber numberWithInt: 1000], @"formatterBehavior",
+      @"#,##0.00", @"positiveFormat",
+      nil] retain];
+    fmt = unarchived(archived);
+    PASS([fmt formatterBehavior] == NSNumberFormatterBehavior10_0,
+      "a 10.0 formatter keeps its behavior")
+    PASS([[fmt minimum] isEqual: [NSDecimalNumber notANumber]],
+      "a 10.0 formatter reads NS.min")
+
+    /* What a formatter writes is what macOS writes. */
+    fmt = [[NSNumberFormatter new] autorelease];
+    [fmt setFormatterBehavior: NSNumberFormatterBehavior10_4];
+    [fmt setLocale: [[[NSLocale alloc] initWithLocaleIdentifier: @"en_US"]
+      autorelease]];
+    [fmt setNumberStyle: NSNumberFormatterDecimalStyle];
+    [fmt setGeneratesDecimalNumbers: YES];
+    [fmt setMaximumIntegerDigits: 42];
+    [fmt setMaximumFractionDigits: 2];
+    data = [NSKeyedArchiver archivedDataWithRootObject: fmt];
+    w = written(data);
+    PASS_EQUAL([w->attributes objectForKey: @"formatterBehavior"],
+      [NSNumber numberWithInt: 1040], "formatterBehavior is written")
+    PASS_EQUAL([w->attributes objectForKey: @"numberStyle"],
+      [NSNumber numberWithInt: 1], "numberStyle is written")
+    PASS_EQUAL([w->attributes objectForKey: @"generatesDecimalNumbers"],
+      [NSNumber numberWithBool: YES], "generatesDecimalNumbers is written")
+    PASS_EQUAL([w->attributes objectForKey: @"maximumFractionDigits"],
+      [NSNumber numberWithInt: 2], "maximumFractionDigits is written")
+    PASS_EQUAL([[w->attributes objectForKey: @"locale"] localeIdentifier],
+      @"en_US", "the locale is written")
+    PASS([w->attributes objectForKey: @"allowsFloats"] != nil,
+      "allowsFloats is always written, as on macOS")
+    PASS([w->attributes objectForKey: @"maximum"] == nil
+      && [w->attributes objectForKey: @"decimalSeparator"] == nil,
+      "what was not set is not written")
+    PASS(w->hasDecimal, "the 10.0 keys are written too")
+
+    back = [NSKeyedUnarchiver unarchiveObjectWithData: data];
+    PASS([back numberStyle] == NSNumberFormatterDecimalStyle
+      && [back generatesDecimalNumbers]
+      && [back maximumFractionDigits] == 2
+      && [back maximumIntegerDigits] == 42
+      && [[[back locale] localeIdentifier] isEqual: @"en_US"],
+      "the settings survive a keyed archive")
+    PASS_EQUAL([back stringFromNumber: [NSNumber numberWithDouble: 12345.6789]],
+      [fmt stringFromNumber: [NSNumber numberWithDouble: 12345.6789]],
+      "the formatter read back formats as the one written")
+
+    fmt = [[NSNumberFormatter new] autorelease];
+    [fmt setFormatterBehavior: NSNumberFormatterBehavior10_0];
+    [fmt setFormat: @"#,##0.00;(#,##0.00)"];
+    data = [NSKeyedArchiver archivedDataWithRootObject: fmt];
+    w = written(data);
+    PASS_EQUAL([w->attributes objectForKey: @"formatterBehavior"],
+      [NSNumber numberWithInt: 1000], "a 10.0 formatter writes its behavior")
+    PASS_EQUAL([w->attributes objectForKey: @"positiveFormat"], @"#,##0.00",
+      "a 10.0 formatter writes its format")
+    back = [NSKeyedUnarchiver unarchiveObjectWithData: data];
+    PASS([back formatterBehavior] == NSNumberFormatterBehavior10_0
+      && [[back positiveFormat] isEqual: @"#,##0.00"]
+      && [[back negativeFormat] isEqual: @"(#,##0.00)"],
+      "a 10.0 formatter survives a keyed archive")
+  END_SET("NSNumberFormatter keyed attributes")
+
+  [arp release];
+  return 0;
+}
