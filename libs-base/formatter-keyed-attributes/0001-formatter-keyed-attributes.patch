From aa55845814563cd8e407cfc5b0527a1b97aa8d05 Mon Sep 17 00:00:00 2001
From: Artyom Shalkhakov <artyom.shalkhakov@gmail.com>
Date: Mon, 19 Oct 2026 16:12:48 +0000
Subject: [PATCH] Read a formatter's 10.4 settings from a keyed archive

macOS archives a number or date formatter's settings in an NS.attributes
dictionary keyed by property name (formatterBehavior, numberStyle,
generatesDecimalNumbers, maximumFractionDigits, minimum, locale,
dateStyle, timeStyle, dateFormat and so on), beside the 10.0 keys such as
NS.positiveformat and NS.format.  NSNumberFormatter read only the 10.0
keys, and NSDateFormatter read a keyed archive as though it were not
keyed, so it got no format at all.  A formatter from a nib came out with
the default style and digits: a decimal field that generates decimal
numbers parsed to a double, and a date field lost its styles.

Both now set each property NS.attributes names that they have a setter
for, by key-value coding: the behavior, the locale and the style first,
since a style resets the digits and the format, then the rest in the
order of their names.  NSDateFormatter reads NS.format and NS.natural
from a keyed archive.  Writing NS.attributes is left for later.

The keys and values are those macOS 15 archives.
Tests/base/NSNumberFormatter/keyedAttributes.m and
Tests/base/NSDateFormatter/keyedAttributes.m write archives of that
shape and read them back; 5 of the 10 number checks and 7 of the 10 date
checks fail without the change.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 Source/GSPrivate.h                            |   8 ++
 Source/NSDateFormatter.m                      |  17 +++
 Source/NSFormatter.m                          |  49 ++++++++
 Source/NSNumberFormatter.m                    |  10 ++
 Tests/base/NSDateFormatter/keyedAttributes.m  | 113 ++++++++++++++++++
 .../base/NSNumberFormatter/keyedAttributes.m  |  91 ++++++++++++++
 6 files changed, 288 insertions(+)
 create mode 100644 Tests/base/NSDateFormatter/keyedAttributes.m
 create mode 100644 Tests/base/NSNumberFormatter/keyedAttributes.m

diff --git a/Source/GSPrivate.h b/Source/GSPrivate.h
index bd9a476..7378331 100644
--- a/Source/GSPrivate.h
+++ b/Source/GSPrivate.h
@@ -31,6 +31,7 @@
 @class	_GSInsensitiveDictionary;
 @class	_GSMutableInsensitiveDictionary;
 
+@class	NSFormatter;
 @class	NSNotification;
 @class	NSPointerArray;
 @class	NSRecursiveLock;
@@ -486,6 +487,13 @@ typedef NSRange (*GSRSFunc)(id, id, unsigned, NSRange);
 GSRSFunc
 GSPrivateRangeOfString(NSString *receiver, NSString *target) GS_ATTRIB_PRIVATE;
 
+/* Sets a formatter's properties from the NS.attributes dictionary of a
+ * keyed archive: the keys in first, in that order, then the rest.
+ */
+void
+GSPrivateSetFormatterAttributes(NSFormatter *formatter,
+  NSDictionary *attributes, NSArray *first) GS_ATTRIB_PRIVATE;
+
 /* Function to return the hash value for a small integer (used by NSNumber).
  */
 unsigned
diff --git a/Source/NSDateFormatter.m b/Source/NSDateFormatter.m
index e35ed6c..88f4ae2 100644
--- a/Source/NSDateFormatter.m
+++ b/Source/NSDateFormatter.m
@@ -45,6 +45,7 @@
 #import "Foundation/NSFormatter.h"
 #import "Foundation/NSDateFormatter.h"
 #import "Foundation/NSCoder.h"
+#import "GSPrivate.h"
 
 #if defined(HAVE_UNICODE_UDAT_H) && defined(HAVE_UNICODE_UDATPG_H)
 #define id id_ucal
@@ -276,6 +277,22 @@ static NSDateFormatterBehavior _defaultBehavior = 0;
   NSString	*fmt;
   BOOL		nl;
 
+  if ([aCoder allowsKeyedCoding])
+    {
+      NSDictionary	*attributes;
+
+      fmt = [aCoder decodeObjectForKey: @"NS.format"];
+      nl = [aCoder decodeBoolForKey: @"NS.natural"];
+      self = [self initWithDateFormat: fmt allowNaturalLanguage: nl];
+      attributes = [aCoder decodeObjectForKey: @"NS.attributes"];
+      if (self != nil && [attributes isKindOfClass: [NSDictionary class]])
+        {
+          GSPrivateSetFormatterAttributes(self, attributes,
+            [NSArray arrayWithObjects: @"formatterBehavior", @"locale",
+              @"calendar", @"timeZone", @"dateStyle", @"timeStyle", nil]);
+        }
+      return self;
+    }
   [aCoder decodeValuesOfObjCTypes: "@C", &fmt, &nl];
   return [self initWithDateFormat: AUTORELEASE(fmt) allowNaturalLanguage: nl];
 }
diff --git a/Source/NSFormatter.m b/Source/NSFormatter.m
index 465b472..a20d3ea 100644
--- a/Source/NSFormatter.m
+++ b/Source/NSFormatter.m
@@ -26,6 +26,55 @@
 
 #import "common.h"
 #import "Foundation/NSFormatter.h"
+#import "Foundation/NSArray.h"
+#import "Foundation/NSDictionary.h"
+#import "Foundation/NSKeyValueCoding.h"
+#import "GSPrivate.h"
+
+void
+GSPrivateSetFormatterAttributes(NSFormatter *formatter,
+  NSDictionary *attributes, NSArray *first)
+{
+  NSMutableArray	*keys = [NSMutableArray array];
+  NSArray		*rest;
+  NSEnumerator		*e;
+  NSString		*key;
+
+  e = [first objectEnumerator];
+  while ((key = [e nextObject]) != nil)
+    {
+      if ([attributes objectForKey: key] != nil)
+	{
+	  [keys addObject: key];
+	}
+    }
+  rest = [[attributes allKeys] sortedArrayUsingSelector: @selector(compare:)];
+  e = [rest objectEnumerator];
+  while ((key = [e nextObject]) != nil)
+    {
+      if ([keys containsObject: key] == NO)
+	{
+	  [keys addObject: key];
+	}
+    }
+
+  e = [keys objectEnumerator];
+  while ((key = [e nextObject]) != nil)
+    {
+      NSString	*setter;
+
+      if ([key length] == 0)
+	{
+	  continue;
+	}
+      setter = [NSString stringWithFormat: @"set%@%@:",
+	[[key substringToIndex: 1] uppercaseString], [key substringFromIndex: 1]];
+      if ([formatter respondsToSelector: NSSelectorFromString(setter)])
+	{
+	  [formatter setValue: [attributes objectForKey: key] forKey: key];
+	}
+    }
+}
 
 @implementation NSFormatter
 
diff --git a/Source/NSNumberFormatter.m b/Source/NSNumberFormatter.m
