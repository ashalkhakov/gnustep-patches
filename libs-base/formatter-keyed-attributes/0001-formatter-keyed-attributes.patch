   return [self initWithDateFormat: AUTORELEASE(fmt) allowNaturalLanguage: nl];
 }
diff --git a/Source/NSFormatter.m b/Source/NSFormatter.m
index 465b472..f9e9104 100644
--- a/Source/NSFormatter.m
+++ b/Source/NSFormatter.m
@@ -26,6 +26,120 @@
 
 #import "common.h"
 #import "Foundation/NSFormatter.h"
+#import "Foundation/NSArray.h"
+#import "Foundation/NSDictionary.h"
+#import "Foundation/NSKeyValueCoding.h"
+#import "Foundation/NSMethodSignature.h"
+#import "Foundation/NSValue.h"
+#import "GSPrivate.h"
+
+void
+GSPrivateSetFormatterAttributes(NSFormatter *formatter,
+  NSDictionary *attributes, NSArray *first)
+{
+  NSMutableArray	*keys = [NSMutableArray array];
+  NSArray		*rest;
+  NSEnumerator		*e;
+  NSString		*key;
+
+  e = [first objectEnumerator];
+  while ((key = [e nextObject]) != nil)
+    {
+      if ([attributes objectForKey: key] != nil)
+	{
+	  [keys addObject: key];
+	}
+    }
+  rest = [[attributes allKeys] sortedArrayUsingSelector: @selector(compare:)];
+  e = [rest objectEnumerator];
+  while ((key = [e nextObject]) != nil)
+    {
+      if ([keys containsObject: key] == NO)
+	{
+	  [keys addObject: key];
+	}
+    }
+
+  e = [keys objectEnumerator];
+  while ((key = [e nextObject]) != nil)
+    {
+      NSString	*setter;
+
+      if ([key length] == 0)
+	{
+	  continue;
+	}
+      setter = [NSString stringWithFormat: @"set%@%@:",
+	[[key substringToIndex: 1] uppercaseString], [key substringFromIndex: 1]];
+      if ([formatter respondsToSelector: NSSelectorFromString(setter)])
+	{
+	  [formatter setValue: [attributes objectForKey: key] forKey: key];
+	}
+    }
+}
+
+static id
+attributeValue(NSFormatter *formatter, NSString *key)
+{
+  NSString	*isKey;
+
+  SEL		getter = NSSelectorFromString(key);
+
+  if (NO == [formatter respondsToSelector: getter])
+    {
+      isKey = [NSString stringWithFormat: @"is%@%@",
+	[[key substringToIndex: 1] uppercaseString],
+	[key substringFromIndex: 1]];
+      getter = NSSelectorFromString(isKey);
+      if (NO == [formatter respondsToSelector: getter])
+	{
+	  return nil;
+	}
+    }
+  /* A keyed archive keeps a BOOL as a boolean, as macOS writes it. */
+  if (strcmp([[formatter methodSignatureForSelector: getter]
+    methodReturnType], @encode(BOOL)) == 0)
+    {
+      return [NSNumber numberWithBool:
+	[[formatter valueForKey: key] boolValue]];
+    }
+  return [formatter valueForKey: key];
+}
+
+NSMutableDictionary *
+GSPrivateFormatterAttributes(NSFormatter *formatter, NSFormatter *reference,
+  NSArray *first, NSArray *keys)
+{
+  NSMutableDictionary	*attributes = [NSMutableDictionary dictionary];
+  NSEnumerator		*e;
+  NSString		*key;
+
+  e = [first objectEnumerator];
+  while ((key = [e nextObject]) != nil)
+    {
+      id	value = attributeValue(formatter, key);
+
+      if (value != nil)
+	{
+	  if (NO == [value isEqual: attributeValue(reference, key)])
+	    {
+	      [attributes setObject: value forKey: key];
+	    }
+	  [reference setValue: value forKey: key];
+	}
+    }
+  e = [keys objectEnumerator];
+  while ((key = [e nextObject]) != nil)
+    {
+      id	value = attributeValue(formatter, key);
+
+      if (value != nil && NO == [value isEqual: attributeValue(reference, key)])
+	{
+	  [attributes setObject: value forKey: key];
+	}
+    }
+  return attributes;
+}
 
 @implementation NSFormatter
 
