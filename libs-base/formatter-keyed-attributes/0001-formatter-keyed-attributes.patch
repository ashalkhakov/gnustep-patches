 #import "Foundation/NSAttributedString.h"
 #import "Foundation/NSDecimalNumber.h"
 #import "Foundation/NSDictionary.h"
@@ -767,6 +768,8 @@ static NSUInteger _defaultBehavior = NSNumberFormatterBehavior10_4;
 
 - (id) initWithCoder: (NSCoder*)decoder
 {
+  NSDictionary	*attributes;
+
   /* We can call our -init method to set up default values, then
    * override settings with information from the archive.
    */
@@ -851,6 +854,13 @@ static NSUInteger _defaultBehavior = NSNumberFormatterBehavior10_4;
 	  [self setAttributedStringForZero:
 	    [decoder decodeObjectForKey: @"NS.zero"]];
 	}
+      attributes = [decoder decodeObjectForKey: @"NS.attributes"];
+      if ([attributes isKindOfClass: [NSDictionary class]])
+        {
+          GSPrivateSetFormatterAttributes(self, attributes,
+            [NSArray arrayWithObjects: @"formatterBehavior", @"locale",
+              @"numberStyle", nil]);
+        }
     }
   else
     {
diff --git a/Tests/base/NSDateFormatter/keyedAttributes.m b/Tests/base/NSDateFormatter/keyedAttributes.m
new file mode 100644
index 0000000..a2aefc2
--- /dev/null
+++ b/Tests/base/NSDateFormatter/keyedAttributes.m
@@ -0,0 +1,113 @@
+#import <Foundation/Foundation.h>
+#import "Testing.h"
+
+/* Writes what macOS writes for a date formatter: its 10.0 format and
+ * natural language flag, and its settings in NS.attributes.
+ */
+@interface	ArchivedDateFormatter : NSObject
+{
+  NSString	*format;
+  BOOL		natural;
+  NSDictionary	*attributes;
+}
+- (id) initWithFormat: (NSString*)f
+	      natural: (BOOL)n
+	   attributes: (NSDictionary*)a;
+@end
+
+@implementation	ArchivedDateFormatter
+- (id) initWithFormat: (NSString*)f
+	      natural: (BOOL)n
+	   attributes: (NSDictionary*)a
+{
+  if (nil != (self = [super init]))
+    {
+      format = [f copy];
+      natural = n;
+      attributes = [a copy];
+    }
+  return self;
+}
+- (void) dealloc
+{
+  [format release];
+  [attributes release];
+  [super dealloc];
+}
+- (void) encodeWithCoder: (NSCoder*)coder
+{
+  [coder encodeObject: attributes forKey: @"NS.attributes"];
+  [coder encodeObject: format forKey: @"NS.format"];
+  [coder encodeBool: natural forKey: @"NS.natural"];
+}
+@end
+
+static NSDateFormatter *
+unarchived(NSString *format, BOOL natural, NSDictionary *attributes)
+{
+  ArchivedDateFormatter	*archived;
+  NSKeyedArchiver	*archiver;
+  NSMutableData		*data = [NSMutableData data];
+
+  archived = [[[ArchivedDateFormatter alloc] initWithFormat: format
+						    natural: natural
+						 attributes: attributes]
+    autorelease];
+  archiver = [[NSKeyedArchiver alloc] initForWritingWithMutableData: data];
+  [archiver setClassName: @"NSDateFormatter"
+		forClass: [ArchivedDateFormatter class]];
+  [archiver encodeObject: archived forKey: @"root"];
+  [archiver finishEncoding];
+  [archiver release];
+  return [NSKeyedUnarchiver unarchiveObjectWithData: data];
+}
+
+int main()
+{
+  NSAutoreleasePool	*arp = [NSAutoreleasePool new];
+  NSDateFormatter	*fmt;
+
+  START_SET("NSDateFormatter keyed attributes")
+
+    fmt = unarchived(@"M/d/yy, h:mm a", NO,
+      [NSDictionary dictionaryWithObjectsAndKeys:
+	[NSNumber numberWithInt: 1040], @"formatterBehavior",
+	[NSNumber numberWithInt: 1], @"dateStyle",
+	[NSNumber numberWithInt: 1], @"timeStyle",
+	nil]);
+    PASS([fmt isKindOfClass: [NSDateFormatter class]],
+      "a date formatter is unarchived")
+    PASS([fmt formatterBehavior] == NSDateFormatterBehavior10_4,
+      "formatterBehavior is read from NS.attributes")
+    PASS([fmt dateStyle] == NSDateFormatterShortStyle,
+      "dateStyle is read from NS.attributes")
+    PASS([fmt timeStyle] == NSDateFormatterShortStyle,
+      "timeStyle is read from NS.attributes")
+
+    fmt = unarchived(@"yyyy-MM-dd", YES,
+      [NSDictionary dictionaryWithObjectsAndKeys:
+	[NSNumber numberWithInt: 1040], @"formatterBehavior",
+	@"yyyy-MM-dd", @"dateFormat",
+	[NSNumber numberWithBool: YES], @"lenient",
+	nil]);
+    PASS([fmt formatterBehavior] == NSDateFormatterBehavior10_4,
+      "a custom format keeps the 10.4 behavior")
+    PASS_EQUAL([fmt dateFormat], @"yyyy-MM-dd",
+      "dateFormat is read from NS.attributes")
+    PASS([fmt isLenient], "lenient is read from NS.attributes")
+
+    fmt = unarchived(@"%Y", YES,
+      [NSDictionary dictionaryWithObjectsAndKeys:
+	[NSNumber numberWithInt: 1000], @"formatterBehavior",
+	@"%Y", @"dateFormat_10_0",
+	nil]);
+    PASS([fmt formatterBehavior] == NSDateFormatterBehavior10_0,
+      "a 10.0 formatter keeps its behavior")
+    PASS_EQUAL([fmt dateFormat], @"%Y", "NS.format is read")
+    PASS([fmt allowsNaturalLanguage], "NS.natural is read")
+
+  END_SET("NSDateFormatter keyed attributes")
+
+  [arp release];
+  return 0;
+}
diff --git a/Tests/base/NSNumberFormatter/keyedAttributes.m b/Tests/base/NSNumberFormatter/keyedAttributes.m
new file mode 100644
index 0000000..96aad3f
--- /dev/null
+++ b/Tests/base/NSNumberFormatter/keyedAttributes.m
@@ -0,0 +1,91 @@
+#import <Foundation/Foundation.h>
+#import "Testing.h"
+
+#if	defined(GS_USE_ICU)
+#define	NSLOCALE_SUPPORTED	GS_USE_ICU
+#else
+#define	NSLOCALE_SUPPORTED	1 /* Assume Apple support */
+#endif
+
+/* Writes what macOS writes for a number formatter set up as a nib's
+ * decimal field: the 10.0 keys, and the 10.4 settings in NS.attributes.
+ */
+@interface	ArchivedNumberFormatter : NSObject
+@end
+
+@implementation	ArchivedNumberFormatter
+- (void) encodeWithCoder: (NSCoder*)coder
+{
+  NSDictionary	*attributes;
+
+  attributes = [NSDictionary dictionaryWithObjectsAndKeys:
+    [NSNumber numberWithInt: 1040], @"formatterBehavior",
+    [NSNumber numberWithInt: 1], @"numberStyle",
+    [NSNumber numberWithBool: YES], @"generatesDecimalNumbers",
+    [NSNumber numberWithBool: NO], @"usesGroupingSeparator",
+    [NSNumber numberWithInt: 0], @"groupingSize",
+    [NSNumber numberWithInt: 1], @"minimumIntegerDigits",
+    [NSNumber numberWithInt: 42], @"maximumIntegerDigits",
+    [NSNumber numberWithInt: 3], @"maximumFractionDigits",
+    [NSNumber numberWithBool: YES], @"allowsFloats",
+    @"", @"nilSymbol",
+    nil];
+  [coder encodeBool: YES forKey: @"NS.allowsfloats"];
+  [coder encodeBool: NO forKey: @"NS.hasthousands"];
+  [coder encodeBool: YES forKey: @"NS.localized"];
+  [coder encodeObject: @"." forKey: @"NS.decimal"];
+  [coder encodeObject: @"," forKey: @"NS.thousand"];
+  [coder encodeObject: @"#########################################0.###"
+	       forKey: @"NS.positiveformat"];
+  [coder encodeObject: @"#########################################0.###"
+	       forKey: @"NS.negativeformat"];
+  [coder encodeObject: attributes forKey: @"NS.attributes"];
+}
+@end
+
+int main()
+{
+  NSAutoreleasePool	*arp = [NSAutoreleasePool new];
+  NSKeyedArchiver	*archiver;
+  NSMutableData		*data;
+  NSNumberFormatter	*fmt;
+  ArchivedNumberFormatter	*archived;
+
+  START_SET("NSNumberFormatter keyed attributes")
+    if (!NSLOCALE_SUPPORTED)
+      SKIP("NSLocale not supported\nThe ICU library was not available when GNUstep-base was built")
+
+    data = [NSMutableData data];
+    archiver = [[NSKeyedArchiver alloc] initForWritingWithMutableData: data];
+    [archiver setClassName: @"NSNumberFormatter"
+		  forClass: [ArchivedNumberFormatter class]];
+    archived = [[ArchivedNumberFormatter new] autorelease];
+    [archiver encodeObject: archived forKey: @"root"];
+    [archiver finishEncoding];
+    [archiver release];
+
+    fmt = [NSKeyedUnarchiver unarchiveObjectWithData: data];
+    PASS([fmt isKindOfClass: [NSNumberFormatter class]],
+      "a number formatter is unarchived")
+    PASS([fmt formatterBehavior] == NSNumberFormatterBehavior10_4,
+      "formatterBehavior is read from NS.attributes")
+    PASS([fmt numberStyle] == NSNumberFormatterDecimalStyle,
+      "numberStyle is read from NS.attributes")
+    PASS([fmt generatesDecimalNumbers],
+      "generatesDecimalNumbers is read from NS.attributes")
+    PASS([fmt usesGroupingSeparator] == NO,
+      "usesGroupingSeparator is read from NS.attributes")
+    PASS([fmt minimumIntegerDigits] == 1,
+      "minimumIntegerDigits is read from NS.attributes")
+    PASS([fmt maximumIntegerDigits] == 42,
+      "maximumIntegerDigits is read from NS.attributes")
+    PASS([fmt maximumFractionDigits] == 3,
+      "maximumFractionDigits is read from NS.attributes")
+    PASS([fmt allowsFloats], "allowsFloats is read")
+    PASS_EQUAL([fmt stringFromNumber: [NSNumber numberWithDouble: 12345.6789]],
+      @"12345.679", "the formatter formats with the settings read")
+  END_SET("NSNumberFormatter keyed attributes")
+
+  [arp release];
+  return 0;
+}
