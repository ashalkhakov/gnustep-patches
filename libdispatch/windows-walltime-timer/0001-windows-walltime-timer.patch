+
+#include <dispatch/dispatch.h>
+#include <stdatomic.h>
+#include <stdlib.h>
+#if defined(_WIN32)
+#include <windows.h>
+#else
+#include <unistd.h>
+#endif
+
+#include <bsdtests.h>
+#include "dispatch_test.h"
+
+static _Atomic int fired;
+
+static void
+sleep_ms(unsigned int ms)
+{
+#if defined(_WIN32)
+	Sleep(ms);
+#else
+	usleep(ms * 1000);
+#endif
+}
+
+int
+main(void)
+{
+	dispatch_test_start("Dispatch Wall Clock Timer");
+
+	dispatch_queue_t q = dispatch_queue_create("wall", DISPATCH_QUEUE_SERIAL);
+	dispatch_source_t t = dispatch_source_create(DISPATCH_SOURCE_TYPE_TIMER, 0, 0, q);
+	test_ptr_notnull("dispatch_source_create", t);
+	dispatch_source_set_event_handler(t, ^{
+		atomic_store(&fired, 1);
+		dispatch_source_cancel(t);
+	});
+	// Due in 200 ms by the wall clock.
+	dispatch_source_set_timer(t, dispatch_walltime(NULL, 200 * NSEC_PER_MSEC),
+		DISPATCH_TIME_FOREVER, 5 * NSEC_PER_MSEC);
+	dispatch_resume(t);
+
+	long waited = 0;
+	while (!atomic_load(&fired) && waited < 5000) {
+		sleep_ms(10);
+		waited += 10;
+	}
+	test_long("fired", atomic_load(&fired), 1);
+	test_long_less_than("milliseconds waited", waited, 2000);
+	test_stop();
+	return 0;
+}
