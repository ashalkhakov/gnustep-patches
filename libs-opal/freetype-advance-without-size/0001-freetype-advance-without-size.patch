From f34a30582a16d799c9470e67b80efd8436edc753 Mon Sep 17 00:00:00 2001
From: Artyom Shalkhakov <artyom.shalkhakov@gmail.com>
Date: Fri, 2 Oct 2026 11:24:45 +0000
Subject: [PATCH] Load a glyph's advance in font units without needing a size

-[OPFreeTypeFont advancementForGlyph:] loads the glyph with
FT_LOAD_LINEAR_DESIGN alone, to read linearHoriAdvance in font units,
which REAL_SIZE then scales by the point size. The face is never given a
size, though, and FreeType before 2.13 refuses to load a scalable glyph
from a face without one: FT_Load_Glyph returns FT_Err_Invalid_Size_Handle
(36) and leaves linearHoriAdvance at 0. On those versions -- 2.11, say,
which Ubuntu 22.04 ships -- every advance CTFontGetAdvancesForGlyphs
reports is 0, so a run of glyphs measures as nothing wide and text laid
out from it is drawn on top of itself or not at all.

FT_LOAD_NO_SCALE asks for unscaled metrics, which need no size, and
with FT_LOAD_LINEAR_DESIGN linearHoriAdvance comes back in the same font
units as before. FreeType 2.13, which tolerated the missing size, gives
the same numbers either way (1540 units for DejaVu Sans' H, at 2048 to
the em).

Tests/opal/CTFont/advances.m asks a freshly made font for the advances
of two glyphs. Against FreeType 2.11 it fails without this change -- the
advances are 0 -- and passes with it; against 2.13 it passes either way.
---
 Source/OpalText/FreeType/OPFreeTypeFont.m |  2 +-
 Tests/opal/CTFont/TestInfo                |  0
 Tests/opal/CTFont/advances.m              | 35 +++++++++++++++++++++++
 3 files changed, 36 insertions(+), 1 deletion(-)
 create mode 100644 Tests/opal/CTFont/TestInfo
 create mode 100644 Tests/opal/CTFont/advances.m

diff --git a/Source/OpalText/FreeType/OPFreeTypeFont.m b/Source/OpalText/FreeType/OPFreeTypeFont.m
index 60a9bf1..6a905ed 100644
--- a/Source/OpalText/FreeType/OPFreeTypeFont.m
+++ b/Source/OpalText/FreeType/OPFreeTypeFont.m
@@ -464,7 +464,7 @@ static const NSString *kOPFreeTypeLibrary = @"OPFreeTypeLibrary";
   /* REAL_SIZE scales font units by the point size, so the advance has to
      come back in font units rather than in fractional pixels of a size the
      face was never set to. */
-  FT_Load_Glyph(fontFace, glyph, FT_LOAD_LINEAR_DESIGN);
+  FT_Load_Glyph(fontFace, glyph, FT_LOAD_NO_SCALE | FT_LOAD_LINEAR_DESIGN);
   NSSize size = NSMakeSize(REAL_SIZE(fontFace->glyph->linearHoriAdvance),
     REAL_SIZE(fontFace->glyph->linearVertAdvance));
   [fontFaceLock unlock];
diff --git a/Tests/opal/CTFont/TestInfo b/Tests/opal/CTFont/TestInfo
new file mode 100644
index 0000000..e69de29
diff --git a/Tests/opal/CTFont/advances.m b/Tests/opal/CTFont/advances.m
new file mode 100644
index 0000000..c369737
--- /dev/null
+++ b/Tests/opal/CTFont/advances.m
@@ -0,0 +1,35 @@
+/* A glyph's advance, from a font no one has drawn with yet: the width the
+   font's own metrics give, scaled to the point size, and the same width
+   a line of that glyph reports. */
+#include "Testing.h"
+
+#include <CoreText/CoreText.h>
+
+int main(void)
+{
+  START_SET("advances of a fresh font")
+
+  CTFontRef font = CTFontCreateWithName((CFStringRef)@"Helvetica", 20, NULL);
+  UniChar characters[2] = { 'H', 'i' };
+  CGGlyph glyphs[2] = { 0, 0 };
+  CGSize advances[2] = { { -1, -1 }, { -1, -1 } };
+  double total;
+
+  if (font == NULL || !CTFontGetGlyphsForCharacters(font, characters, glyphs, 2))
+    SKIP("no usable font available")
+
+  total = CTFontGetAdvancesForGlyphs(font, kCTFontOrientationHorizontal,
+                                     glyphs, advances, 2);
+  PASS(advances[0].width > 0 && advances[1].width > 0,
+       "each glyph advances the pen");
+  PASS(advances[0].height == 0 && advances[1].height == 0,
+       "a horizontal advance has no vertical part");
+  PASS(total == advances[0].width + advances[1].width,
+       "the total is the sum of the advances");
+  PASS(advances[0].width < 20, "an advance is scaled to the point size");
+
+  [(id)font release];
+
+  END_SET("advances of a fresh font")
+  return 0;
+}
-- 
