From f4318d6ef237107276871fc3c98d46987d8e7691 Mon Sep 17 00:00:00 2001
From: Artyom Shalkhakov <artyom.shalkhakov@gmail.com>
Date: Thu, 29 Oct 2026 15:41:06 +0500
Subject: [PATCH] gpbs: --auto stops when the last tracked connection goes, not
 any

Started with --auto, as NSPasteboard starts it, the pasteboard server
stops when its connections have closed.  It tracks only those of the
owners of its pasteboards, but asked whether to stop whenever any
connection went, tracked or not: a client that only reads and writes,
owning nothing, going while no owner's connection was tracked stopped the
server, and every other client lost its pasteboards ("method request -
port was invalidated", then "No local object with given target").  It now
stops only when the connection that went was the last of those it tracks.

Tests/gpbs/autoStop.m has a client write to a pasteboard owning nothing,
run itself as another such client that writes and exits, and read its
pasteboard again.  On Linux (x86_64) the read fails without the change
(the server has stopped) and passes with it.

Patch done with help of AI.
---
 Tests/gpbs/GNUmakefile.preamble |  3 ++
 Tests/gpbs/TestInfo             |  0
 Tests/gpbs/autoStop.m           | 75 +++++++++++++++++++++++++++++++++
 Tools/gpbs.m                    | 14 ++++--
 4 files changed, 89 insertions(+), 3 deletions(-)
 create mode 100644 Tests/gpbs/GNUmakefile.preamble
 create mode 100644 Tests/gpbs/TestInfo
 create mode 100644 Tests/gpbs/autoStop.m

diff --git a/Tests/gpbs/GNUmakefile.preamble b/Tests/gpbs/GNUmakefile.preamble
new file mode 100644
index 0000000..1f01673
--- /dev/null
+++ b/Tests/gpbs/GNUmakefile.preamble
@@ -0,0 +1,3 @@
+# The pasteboard server tests drive it through AppKit's NSPasteboard, which
+# starts it (with --auto) when it is not running.
+ADDITIONAL_TOOL_LIBS += -lgnustep-gui
diff --git a/Tests/gpbs/TestInfo b/Tests/gpbs/TestInfo
new file mode 100644
index 0000000..e69de29
diff --git a/Tests/gpbs/autoStop.m b/Tests/gpbs/autoStop.m
new file mode 100644
index 0000000..a6724d7
--- /dev/null
+++ b/Tests/gpbs/autoStop.m
@@ -0,0 +1,75 @@
+/* A pasteboard server started with --auto (as NSPasteboard starts it) stops
+   when the last connection it tracks has gone: those of the owners of its
+   pasteboards.  A client that only reads and writes, owning nothing, is not
+   tracked, so when such a client went, the server had no way to know whether
+   others were still using it, and stopped all the same if it tracked none:
+   every other client lost its pasteboards ("port was invalidated").  On
+   Windows the same happened when a client's connection was dropped while it
+   was still running. */
+#import "Testing.h"
+#import <Foundation/NSAutoreleasePool.h>
+#import <Foundation/NSBundle.h>
+#import <Foundation/NSDate.h>
+#import <Foundation/NSException.h>
+#import <Foundation/NSRunLoop.h>
+#import <Foundation/NSTask.h>
+#import <AppKit/NSApplication.h>
+#import <AppKit/NSPasteboard.h>
+
+int
+main(int argc, char **argv)
+{
+  NSAutoreleasePool	*arp = [NSAutoreleasePool new];
+  NSPasteboard		*pb;
+  NSString		*read = nil;
+  NSTask		*other;
+
+  START_SET("gpbs keeps serving while a client that owns nothing is there")
+
+  NS_DURING
+    [NSApplication sharedApplication];
+  NS_HANDLER
+    if ([[localException name] isEqualToString: NSInternalInconsistencyException])
+      SKIP("It looks like GNUstep backend is not yet installed")
+  NS_ENDHANDLER
+
+  /* Run as the other client: write to a pasteboard of its own, owning
+   * nothing, and go. */
+  if (argc > 1)
+    {
+      pb = [NSPasteboard pasteboardWithName: @"gpbsAutoStopOther"];
+      [pb declareTypes: [NSArray arrayWithObject: NSStringPboardType]
+		 owner: nil];
+      [pb setString: @"other" forType: NSStringPboardType];
+      [arp release];
+      return 0;
+    }
+
+  pb = [NSPasteboard pasteboardWithName: @"gpbsAutoStop"];
+  [pb declareTypes: [NSArray arrayWithObject: NSStringPboardType] owner: nil];
+  PASS([pb setString: @"mine" forType: NSStringPboardType],
+    "a client that owns nothing writes to a pasteboard")
+
+  other = [NSTask launchedTaskWithLaunchPath:
+    [[NSBundle mainBundle] executablePath]
+    arguments: [NSArray arrayWithObject: @"other"]];
+  [other waitUntilExit];
+  PASS([other terminationStatus] == 0, "another such client comes and goes")
+
+  /* Time for the server to see the other client's connection go. */
+  [[NSRunLoop currentRunLoop] runUntilDate:
+    [NSDate dateWithTimeIntervalSinceNow: 2.0]];
+
+  NS_DURING
+    read = [pb stringForType: NSStringPboardType];
+  NS_HANDLER
+    read = nil;
+  NS_ENDHANDLER
+  PASS_EQUAL(read, @"mine",
+    "the first client still reads its pasteboard: the server is still there")
+
+  END_SET("gpbs keeps serving while a client that owns nothing is there")
+
+  [arp release];
+  return 0;
+}
diff --git a/Tools/gpbs.m b/Tools/gpbs.m
index 5cf7251..11cf3a9 100644
--- a/Tools/gpbs.m
+++ b/Tools/gpbs.m
@@ -1012,10 +1012,18 @@ - (id) connectionBecameInvalid: (NSNotification*)notification
 	  [o checkConnection: connection];
 	}
     }
-  [connections removeObjectIdenticalTo: connection];
-  if (auto_stop == YES && [connections count] == 0)
+  /* Only the connections of pasteboard owners are tracked; a client that
+   * owns nothing is not, and may still be using the server.  So a connection
+   * going says that the last client has gone only when it was the last of
+   * those tracked.
+   */
+  if ([connections indexOfObjectIdenticalTo: connection] != NSNotFound)
     {
-      exit(EXIT_SUCCESS);
+      [connections removeObjectIdenticalTo: connection];
+      if (auto_stop == YES && [connections count] == 0)
+	{
+	  exit(EXIT_SUCCESS);
+	}
     }
   return self;
 }
