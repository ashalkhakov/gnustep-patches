diff --git a/Tests/gui/NSSplitView/adjustSubviewsDelegate.m b/Tests/gui/NSSplitView/adjustSubviewsDelegate.m
new file mode 100644
index 000000000..94781877c
--- /dev/null
+++ b/Tests/gui/NSSplitView/adjustSubviewsDelegate.m
@@ -0,0 +1,140 @@
+/* -adjustSubviews asks the delegate's -splitView:shouldAdjustSizeOfSubview:
+   about every subview, the last one included, as Cocoa does: a subview it
+   says not to adjust keeps its size, and those it says to adjust share what
+   is left in proportion to the sizes they had.  So a trailing pane (an
+   inspector, a button bar) can hold its size as the split view grows. */
+#include "Testing.h"
+
+#include <Foundation/NSArray.h>
+#include <Foundation/NSAutoreleasePool.h>
+#include <Foundation/NSIndexSet.h>
+
+#include <AppKit/NSApplication.h>
+#include <AppKit/NSSplitView.h>
+#include <AppKit/NSView.h>
+
+@interface Delegate : NSObject
+{
+@public
+  NSIndexSet *adjusting;
+  NSMutableIndexSet *asked;
+}
+@end
+
+@implementation Delegate
+- (BOOL) splitView: (NSSplitView *)splitView shouldAdjustSizeOfSubview: (NSView *)subview
+{
+  NSUInteger i = [[splitView subviews] indexOfObjectIdenticalTo: subview];
+
+  [asked addIndex: i];
+  return [adjusting containsIndex: i];
+}
+@end
+
+static NSSplitView *
+threePanes(BOOL vertical)
+{
+  NSSplitView *split = AUTORELEASE([[NSSplitView alloc]
+    initWithFrame: NSMakeRect(0, 0, 600, 600)]);
+  int i;
+
+  [split setVertical: vertical];
+  for (i = 0; i < 3; i++)
+    {
+      [split addSubview: AUTORELEASE([[NSView alloc]
+        initWithFrame: NSMakeRect(0, 0, 100, 100)])];
+    }
+  [split adjustSubviews];
+  return split;
+}
+
+static CGFloat
+span(NSSplitView *split, NSUInteger i)
+{
+  NSRect frame = [[[split subviews] objectAtIndex: i] frame];
+
+  return [split isVertical] ? NSWidth(frame) : NSHeight(frame);
+}
+
+int
+main(int argc, const char **argv)
+{
+  START_SET("NSSplitView -adjustSubviews and its delegate")
+
+  NS_DURING
+    [NSApplication sharedApplication];
+  NS_HANDLER
+    if ([[localException name] isEqualToString: NSInternalInconsistencyException])
+      SKIP("It looks like GNUstep backend is not yet installed")
+  NS_ENDHANDLER
+
+  NS_DURING
+    {
+      int orientation;
+
+      for (orientation = 0; orientation < 2; orientation++)
+        {
+          BOOL vertical = (orientation == 0);
+          NSSplitView *split = threePanes(vertical);
+          Delegate *delegate = AUTORELEASE([[Delegate alloc] init]);
+          CGFloat first = span(split, 0);
+          CGFloat last = span(split, 2);
+          CGFloat divider = [split dividerThickness];
+
+          delegate->adjusting = [NSIndexSet indexSetWithIndex: 1];
+          delegate->asked = [NSMutableIndexSet indexSet];
+          [split setDelegate: (id)delegate];
+          [split setFrameSize: NSMakeSize(900, 900)];
+          [split adjustSubviews];
+
+          PASS([delegate->asked containsIndex: 2],
+            "%s: the delegate is asked about the last subview", vertical ? "vertical" : "horizontal");
+          PASS([delegate->asked containsIndex: 0] && [delegate->asked containsIndex: 1],
+            "%s: and about the others", vertical ? "vertical" : "horizontal");
+          PASS(span(split, 0) == first,
+            "%s: the first subview, not to adjust, keeps its size", vertical ? "vertical" : "horizontal");
+          PASS(span(split, 2) == last,
+            "%s: the last subview, not to adjust, keeps its size", vertical ? "vertical" : "horizontal");
+          PASS(span(split, 1) == 900 - first - last - 2 * divider,
+            "%s: the middle subview takes what is left", vertical ? "vertical" : "horizontal");
+
+          /* Only the last adjusts: the others keep their sizes. */
+          first = span(split, 0);
+          {
+            CGFloat middle = span(split, 1);
+
+            delegate->adjusting = [NSIndexSet indexSetWithIndex: 2];
+            [split setFrameSize: NSMakeSize(850, 850)];
+            [split adjustSubviews];
+            PASS(span(split, 0) == first && span(split, 1) == middle,
+              "%s: subviews not to adjust keep their sizes when the last adjusts", vertical ? "vertical" : "horizontal");
+            PASS(span(split, 2) == 850 - first - middle - 2 * divider,
+              "%s: the last takes what is left", vertical ? "vertical" : "horizontal");
+          }
+        }
+
+      /* Without a delegate every subview adjusts, in proportion. */
+      {
+        NSSplitView *split = threePanes(YES);
+        CGFloat divider = [split dividerThickness];
+        CGFloat a = span(split, 0), b = span(split, 1), c = span(split, 2);
+
+        [split setFrameSize: NSMakeSize(900, 600)];
+        [split adjustSubviews];
+        PASS(span(split, 0) + span(split, 1) + span(split, 2) + 2 * divider == 900,
+          "without a delegate the subviews fill the split view");
+        PASS(fabs(span(split, 0) / span(split, 1) - a / b) < 0.02
+          && fabs(span(split, 1) / span(split, 2) - b / c) < 0.02,
+          "in proportion to the sizes they had");
+      }
+    }
+  NS_HANDLER
+    if ([[localException name] isEqualToString: NSInternalInconsistencyException]
+      || [[localException name] isEqualToString: @"NSWindowServerCommunicationException"])
+      SKIP("No display available")
+  NS_ENDHANDLER
+
+  END_SET("NSSplitView -adjustSubviews and its delegate")
+
+  return 0;
+}
