diff --git a/Tests/gui/NSArrayController/equalObjects.m b/Tests/gui/NSArrayController/equalObjects.m
new file mode 100644
index 000000000..8f97b05c4
--- /dev/null
+++ b/Tests/gui/NSArrayController/equalObjects.m
@@ -0,0 +1,178 @@
+/* An array controller's content may hold objects that are equal but not
+   the same.  As on macOS, objects given to select are found by equality,
+   so every equal object is selected, and so is the selection kept across
+   a rearrangement; but what is inserted is selected where it was put, and
+   what is removed by arranged index is the object at that index only. */
+#include "Testing.h"
+
+#include <Foundation/NSArray.h>
+#include <Foundation/NSDictionary.h>
+#include <Foundation/NSException.h>
+#include <Foundation/NSIndexSet.h>
+#include <Foundation/NSPredicate.h>
+#include <Foundation/NSSortDescriptor.h>
+#include <Foundation/NSString.h>
+#include <Foundation/NSValue.h>
+
+#include <AppKit/NSApplication.h>
+#include <AppKit/NSArrayController.h>
+
+/* Equal when their names are; ordered by their order. */
+@interface Item : NSObject
+{
+  NSString	*name;
+  NSInteger	order;
+}
+@end
+
+@implementation Item
++ (Item *) named: (NSString *)n order: (NSInteger)o
+{
+  Item *item = AUTORELEASE([[self alloc] init]);
+
+  item->name = [n copy];
+  item->order = o;
+  return item;
+}
+- (NSString *) name { return name; }
+- (NSInteger) order { return order; }
+- (BOOL) isEqual: (id)other
+{
+  return [other isKindOfClass: [Item class]]
+    && [((Item *)other)->name isEqual: name];
+}
+- (NSUInteger) hash { return [name hash]; }
+@end
+
+static NSIndexSet *
+indexes(NSUInteger first, NSUInteger second)
+{
+  NSMutableIndexSet	*set = [NSMutableIndexSet indexSetWithIndex: first];
+
+  if (second != NSNotFound)
+    {
+      [set addIndex: second];
+    }
+  return set;
+}
+
+static BOOL
+same(NSArray *a, NSArray *b)
+{
+  NSUInteger	i;
+
+  if ([a count] != [b count])
+    return NO;
+  for (i = 0; i < [a count]; i++)
+    if ([a objectAtIndex: i] != [b objectAtIndex: i])
+      return NO;
+  return YES;
+}
+
+int
+main(int argc, const char **argv)
+{
+  NSArrayController	*ac;
+  NSMutableArray	*content;
+  Item			*a1, *b, *a2;
+  NSMutableDictionary	*d1, *d2, *d3, *d4;
+
+  START_SET("NSArrayController with equal objects")
+
+  NS_DURING
+    [NSApplication sharedApplication];
+  NS_HANDLER
+    if ([[localException name] isEqualToString: NSInternalInconsistencyException])
+      SKIP("It looks like GNUstep backend is not yet installed")
+  NS_ENDHANDLER
+
+  a1 = [Item named: @"a" order: 1];
+  b = [Item named: @"b" order: 2];
+  a2 = [Item named: @"a" order: 3];
+  content = [NSMutableArray arrayWithObjects: a1, b, a2, nil];
+  ac = AUTORELEASE([[NSArrayController alloc] initWithContent: content]);
+
+  [ac setSelectedObjects: [NSArray arrayWithObject: a2]];
+  PASS_EQUAL([ac selectionIndexes], indexes(0, 2),
+    "-setSelectedObjects: selects every object equal to one given");
+  [ac setSelectionIndex: 1];
+  [ac setSelectedObjects: [NSArray arrayWithObject: [Item named: @"a" order: 9]]];
+  PASS_EQUAL([ac selectionIndexes], indexes(0, 2),
+    "even when the one given is not in the content");
+  [ac setSelectionIndex: 1];
+  [ac addSelectedObjects: [NSArray arrayWithObject: a1]];
+  PASS_EQUAL([ac selectionIndexes], [NSIndexSet indexSetWithIndexesInRange:
+    NSMakeRange(0, 3)], "-addSelectedObjects: adds every equal object");
+  [ac removeSelectedObjects: [NSArray arrayWithObject: a2]];
+  PASS_EQUAL([ac selectionIndexes], [NSIndexSet indexSetWithIndex: 1],
+    "-removeSelectedObjects: removes every equal object");
+
+  [ac setSelectionIndex: 2];
+  [ac setSortDescriptors: [NSArray arrayWithObject:
+    AUTORELEASE([[NSSortDescriptor alloc] initWithKey: @"order"
+					    ascending: NO])]];
+  PASS(same([ac arrangedObjects], [NSArray arrayWithObjects: a2, b, a1, nil]),
+    "the content is rearranged");
+  PASS_EQUAL([ac selectionIndexes], indexes(0, 2),
+    "the selection kept across it is every object equal to one selected");
+  [ac setSortDescriptors: nil];
+  [ac setSelectionIndex: 0];
+  [ac setFilterPredicate: [NSPredicate predicateWithFormat: @"order != 1"]];
+  PASS_EQUAL([ac selectionIndexes], [NSIndexSet indexSetWithIndex: 1],
+    "filtered, what is equal to the selection stays selected");
+  [ac setFilterPredicate: nil];
+
+  [ac setSelectionIndex: 1];
+  [ac removeObjectAtArrangedObjectIndex: 2];
+  PASS(same([ac arrangedObjects], [NSArray arrayWithObjects: a1, b, nil]),
+    "-removeObjectAtArrangedObjectIndex: removes that object, not the ones equal to it");
+  PASS([[ac content] count] == 2 && [[ac content] indexOfObjectIdenticalTo: a1] != NSNotFound,
+    "from the content too");
+  [ac insertObject: a2 atArrangedObjectIndex: 0];
+  PASS(same([ac arrangedObjects], [NSArray arrayWithObjects: a2, a1, b, nil]),
+    "-insertObject:atArrangedObjectIndex: inserts where asked");
+  PASS_EQUAL([ac selectionIndexes], [NSIndexSet indexSetWithIndex: 0],
+    "and selects the object inserted, not the ones equal to it");
+  [ac setSelectionIndex: 1];
+  [ac removeObjectsAtArrangedObjectIndexes: [NSIndexSet indexSetWithIndex: 1]];
+  PASS(same([ac arrangedObjects], [NSArray arrayWithObjects: a2, b, nil]),
+    "-removeObjectsAtArrangedObjectIndexes: removes those objects only");
+  PASS_EQUAL([ac selectionIndexes], [NSIndexSet indexSetWithIndex: 1],
+    "and the selection goes to the next object, not to one equal to the removed");
+  [ac setSelectionIndex: 0];
+  [ac remove: nil];
+  PASS(same([ac arrangedObjects], [NSArray arrayWithObjects: b, nil]),
+    "so does -remove:");
+  [ac addObject: a1];
+  [ac addObject: a2];
+  PASS_EQUAL([ac selectionIndexes], [NSIndexSet indexSetWithIndex: 2],
+    "-addObject: selects the object added");
+  [ac removeObject: [Item named: @"a" order: 9]];
+  PASS(same([ac arrangedObjects], [NSArray arrayWithObjects: b, nil]),
+    "-removeObject: removes every object equal to the one given");
+
+  d1 = [NSMutableDictionary dictionary];
+  d2 = [NSMutableDictionary dictionary];
+  d3 = [NSMutableDictionary dictionary];
+  content = [NSMutableArray arrayWithObjects: d1, d2, d3, nil];
+  ac = AUTORELEASE([[NSArrayController alloc] initWithContent: content]);
+  [ac setSelectedObjects: [NSArray arrayWithObject: d2]];
+  PASS_EQUAL([ac selectionIndexes], [NSIndexSet indexSetWithIndexesInRange:
+    NSMakeRange(0, 3)], "empty dictionaries are all equal");
+  [ac setSelectionIndex: 1];
+  PASS([[ac selectedObjects] count] == 1
+    && [[ac selectedObjects] objectAtIndex: 0] == d2,
+    "the selected object is the one at the index");
+  d4 = [NSMutableDictionary dictionary];
+  [ac addObject: d4];
+  PASS_EQUAL([ac selectionIndexes], [NSIndexSet indexSetWithIndex: 3],
+    "a new empty dictionary added is the one selected");
+  [ac removeObjectAtArrangedObjectIndex: 3];
+  PASS([[ac arrangedObjects] count] == 3
+    && [[ac arrangedObjects] indexOfObjectIdenticalTo: d4] == NSNotFound,
+    "and removed by its index, it is the only one removed");
+
+  END_SET("NSArrayController with equal objects")
+
+  return 0;
+}
