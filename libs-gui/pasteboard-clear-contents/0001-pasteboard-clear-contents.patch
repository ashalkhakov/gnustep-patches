 {
   id object = [_dataMap objectForKey: type];
diff --git a/Tests/gui/NSPasteboard/clearContents.m b/Tests/gui/NSPasteboard/clearContents.m
new file mode 100644
index 000000000..83c4b98e4
--- /dev/null
+++ b/Tests/gui/NSPasteboard/clearContents.m
@@ -0,0 +1,117 @@
+/* The pasteboard methods of macOS 10.6 and later, as macOS 15 has them:
+ *
+ * - -clearContents empties the pasteboard, tells its owner it has lost it,
+ *   and returns the new change count;
+ * - -writeObjects: writes what objects that adopt NSPasteboardWriting give,
+ *   strings and pasteboard items among them;
+ * - -readObjectsForClasses:options: makes objects of a class that adopts
+ *   NSPasteboardReading from what the pasteboard holds, and
+ *   -canReadObjectForClasses:options: says whether it can;
+ * - -pasteboardItems is an item with the pasteboard's types, or none when
+ *   it holds nothing.
+ *
+ * GNUstep's pasteboard holds one item, so only one object is written or
+ * read where macOS would keep several.
+ */
+#include "Testing.h"
+#include <Foundation/Foundation.h>
+#include <AppKit/NSPasteboard.h>
+#include <AppKit/NSPasteboardItem.h>
+
+@interface PBOwner : NSObject
+{
+@public
+  int lost;
+}
+@end
+
+@implementation PBOwner
+- (void) pasteboardChangedOwner: (NSPasteboard *)sender
+{
+  lost++;
+}
+@end
+
+int
+main(int argc, char **argv)
+{
+  CREATE_AUTORELEASE_POOL(arp);
+  NSPasteboard *pb;
+  PBOwner *owner;
+  NSInteger count;
+  NSArray *read;
+  NSPasteboardItem *item;
+  NSData *html = [@"<b>a</b>" dataUsingEncoding: NSUTF8StringEncoding];
+
+  START_SET("NSPasteboard writing and reading objects")
+
+  NS_DURING
+    {
+      pb = [NSPasteboard pasteboardWithUniqueName];
+    }
+  NS_HANDLER
+    {
+      pb = nil;
+    }
+  NS_ENDHANDLER
+  if (pb == nil)
+    {
+      SKIP("no pasteboard server")
+    }
+
+  owner = AUTORELEASE([PBOwner new]);
+  [pb declareTypes: [NSArray arrayWithObject: NSPasteboardTypeString]
+             owner: owner];
+  count = [pb changeCount];
+  PASS([pb respondsToSelector: @selector(clearContents)],
+    "a pasteboard can be cleared");
+  if ([pb respondsToSelector: @selector(clearContents)])
+    {
+      PASS([pb clearContents] == count + 1 && [pb changeCount] == count + 1,
+        "-clearContents returns the new change count");
+      PASS([[pb types] count] == 0, "a cleared pasteboard has no types");
+      PASS(owner->lost == 1, "its owner is told it has lost it");
+      PASS([[pb pasteboardItems] count] == 0, "nor any item");
+
+      PASS([pb writeObjects: [NSArray arrayWithObject: @"hello"]],
+        "a string can be written as an object");
+      PASS_EQUAL([pb stringForType: NSPasteboardTypeString], @"hello",
+        "it is the pasteboard's string");
+      PASS([pb changeCount] == count + 1, "writing does not change the count");
+      PASS([pb canReadObjectForClasses: [NSArray arrayWithObject: [NSString class]]
+                               options: nil],
+        "a string can be read back");
+      read = [pb readObjectsForClasses: [NSArray arrayWithObject: [NSString class]]
+                               options: nil];
+      PASS([read count] == 1 && [[read objectAtIndex: 0] isEqual: @"hello"],
+        "and it is read back as a string");
+      PASS([[pb pasteboardItems] count] == 1
+        && [[[[pb pasteboardItems] objectAtIndex: 0]
+          stringForType: NSPasteboardTypeString] isEqual: @"hello"],
+        "the pasteboard's item has the string");
+
+      [pb clearContents];
+      item = AUTORELEASE([[NSPasteboardItem alloc] init]);
+      [item setString: @"a" forType: NSPasteboardTypeString];
+      [item setData: html forType: NSPasteboardTypeHTML];
+      PASS([pb writeObjects: [NSArray arrayWithObject: item]],
+        "a pasteboard item can be written");
+      PASS([[pb types] containsObject: NSPasteboardTypeString]
+        && [[pb types] containsObject: NSPasteboardTypeHTML]
+        && [[pb stringForType: NSPasteboardTypeString] isEqual: @"a"]
+        && [[pb dataForType: NSPasteboardTypeHTML] isEqual: html],
+        "with its types and data");
+
+      [pb clearContents];
+      PASS(![pb canReadObjectForClasses: [NSArray arrayWithObject: [NSString class]]
+                                options: nil]
+        && [[pb readObjectsForClasses: [NSArray arrayWithObject: [NSString class]]
+                              options: nil] count] == 0,
+        "nothing is read from an empty pasteboard");
+    }
+
+  [pb releaseGlobally];
+  END_SET("NSPasteboard writing and reading objects")
+  DESTROY(arp);
+  return 0;
+}
