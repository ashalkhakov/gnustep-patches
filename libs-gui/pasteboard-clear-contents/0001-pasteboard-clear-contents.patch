 /*
  * FIXME
@@ -1560,10 +1566,210 @@ - (BOOL) setData: (NSData*)data
   return ok;
 }
 
+/**
+ * Clears the pasteboard, as -declareTypes:owner: with no types and no
+ * owner does, and returns the new change count.
+ */
+- (NSInteger) clearContents
+{
+  return [self declareTypes: [NSArray array] owner: nil];
+}
+
+/**
+ * Writes each object's types, as the NSPasteboardWriting protocol gives
+ * them, after what the pasteboard has.  The pasteboard holds one item: a
+ * type two objects give is written by the first.
+ */
 - (BOOL) writeObjects: (NSArray*)objects
 {
-  // FIXME: not implemented
-  return NO;
+  NSEnumerator *e = [objects objectEnumerator];
+  id object;
+  BOOL ok = YES;
+
+  while ((object = [e nextObject]) != nil)
+    {
+      NSArray *types;
+      NSEnumerator *te;
+      NSString *type;
+
+      if (![object respondsToSelector: @selector(writableTypesForPasteboard:)])
+        {
+          return NO;
+        }
+      types = [object writableTypesForPasteboard: self];
+      te = [types objectEnumerator];
+      while ((type = [te nextObject]) != nil)
+        {
+          id value;
+
+          if ([[self types] containsObject: type])
+            {
+              continue;
+            }
+          if ([object isKindOfClass: [NSPasteboardItem class]])
+            {
+              value = [object _objectForType: type];
+            }
+          else
+            {
+              value = [object pasteboardPropertyListForType: type];
+            }
+          if (value == nil)
+            {
+              continue;
+            }
+          [self addTypes: [NSArray arrayWithObject: type] owner: nil];
+          if ([value isKindOfClass: [NSData class]])
+            {
+              ok = [self setData: value forType: type] && ok;
+            }
+          else if ([value isKindOfClass: [NSString class]])
+            {
+              ok = [self setString: value forType: type] && ok;
+            }
+          else
+            {
+              ok = [self setPropertyList: value forType: type] && ok;
+            }
+        }
+    }
+  return ok;
+}
+
+/* The value for type the way a class that reads it wants it. */
+- (id) _valueForType: (NSString*)type readingClass: (Class)c
+{
+  NSPasteboardReadingOptions options = NSPasteboardReadingAsData;
+
+  if ([c respondsToSelector: @selector(readingOptionsForType:pasteboard:)])
+    {
+      options = [c readingOptionsForType: type pasteboard: self];
+    }
+  if (options & NSPasteboardReadingAsString)
+    {
+      return [self stringForType: type];
+    }
+  if (options & NSPasteboardReadingAsPropertyList)
+    {
+      return [self propertyListForType: type];
+    }
+  if (options & NSPasteboardReadingAsKeyedArchive)
+    {
+      NSData *data = [self dataForType: type];
+
+      return data ? [NSKeyedUnarchiver unarchiveObjectWithData: data] : nil;
+    }
+  return [self dataForType: type];
+}
+
+/* The first of the classes that reads a type the pasteboard has, and that
+   type. */
+- (Class) _readingClassFrom: (NSArray*)classArray type: (NSString**)type
+{
+  NSEnumerator *e = [classArray objectEnumerator];
+  Class c;
+
+  while ((c = [e nextObject]) != Nil)
+    {
+      NSString *t;
+
+      if (![c respondsToSelector: @selector(readableTypesForPasteboard:)])
+        {
+          continue;
+        }
+      t = [self availableTypeFromArray: [c readableTypesForPasteboard: self]];
+      if (t != nil)
+        {
+          *type = t;
+          return c;
+        }
+    }
+  return Nil;
+}
+
+/**
+ * Returns an object of the first of the classes that can read what the
+ * pasteboard holds, made from it, or an empty array.
+ */
+- (NSArray*) readObjectsForClasses: (NSArray*)classArray
+                           options: (NSDictionary*)options
+{
+  NSString *type = nil;
+  Class c = [self _readingClassFrom: classArray type: &type];
+  id value;
+  id object = nil;
+
+  if (c == Nil)
+    {
+      return [NSArray array];
+    }
+  value = [self _valueForType: type readingClass: c];
+  if (value != nil)
+    {
+      if ([c instancesRespondToSelector:
+        @selector(initWithPasteboardPropertyList:ofType:)])
+        {
+          object = AUTORELEASE([[c alloc] initWithPasteboardPropertyList: value
+                                                                  ofType: type]);
+        }
+      else if ([value isKindOfClass: c])
+        {
+          object = value;
+        }
+    }
+  return object ? [NSArray arrayWithObject: object] : [NSArray array];
+}
+
+/**
+ * Whether one of the classes can read what the pasteboard holds.
+ */
+- (BOOL) canReadObjectForClasses: (NSArray*)classArray
+                         options: (NSDictionary*)options
+{
+  NSString *type = nil;
+
+  return [self _readingClassFrom: classArray type: &type] != Nil;
+}
+
+/**
+ * The pasteboard's item, holding its types and their data, or an empty
+ * array when it holds nothing.
+ */
+- (NSArray*) pasteboardItems
+{
+  NSArray *types = [self types];
+  NSPasteboardItem *item;
+  NSEnumerator *e;
+  NSString *type;
+
+  if ([types count] == 0)
+    {
+      return [NSArray array];
+    }
+  item = AUTORELEASE([[NSPasteboardItem alloc] init]);
+  e = [types objectEnumerator];
+  while ((type = [e nextObject]) != nil)
+    {
+      if ([type isEqualToString: NSPasteboardTypeString])
+        {
+          NSString *string = [self stringForType: type];
+
+          if (string != nil)
+            {
+              [item setString: string forType: type];
+            }
+        }
+      else
+        {
+          NSData *data = [self dataForType: type];
+
+          if (data != nil)
+            {
+              [item setData: data forType: type];
+            }
+        }
+    }
+  return [NSArray arrayWithObject: item];
 }
 
 /**
@@ -1912,6 +2118,41 @@ - (NSString*) stringForType: (NSString*)dataType
 
 @end
 
+@implementation NSString (NSPasteboardSupport)
+
+- (NSArray*) writableTypesForPasteboard: (NSPasteboard*)pasteboard
+{
+  return [NSArray arrayWithObject: NSPasteboardTypeString];
+}
+
+- (id) pasteboardPropertyListForType: (NSString*)type
+{
+  return [type isEqualToString: NSPasteboardTypeString] ? self : nil;
+}
+
++ (NSArray*) readableTypesForPasteboard: (NSPasteboard*)pasteboard
+{
+  return [NSArray arrayWithObject: NSPasteboardTypeString];
+}
+
++ (NSPasteboardReadingOptions) readingOptionsForType: (NSString*)type
+                                          pasteboard: (NSPasteboard*)pasteboard
+{
+  return NSPasteboardReadingAsString;
+}
+
+- (id) initWithPasteboardPropertyList: (id)propertyList ofType: (NSString*)type
+{
+  if (![propertyList isKindOfClass: [NSString class]])
+    {
+      DESTROY(self);
+      return nil;
+    }
+  return [self initWithString: propertyList];
+}
+
+@end
+
 @implementation NSPasteboard (Private)
 
