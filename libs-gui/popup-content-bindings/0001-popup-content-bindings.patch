+@implementation GSPopUpButtonBinding
+
+- (id) transformValue: (id)value withOptions: (NSDictionary *)options
+{
+  if (value == nil || value == [NSNull null])
+    {
+      return nil;
+    }
+  if (NSIsControllerMarker(value))
+    {
+      return value;
+    }
+  return [super transformValue: value withOptions: options];
