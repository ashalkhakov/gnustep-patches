+- (void) bind: (NSString *)binding
+     toObject: (id)anObject
+  withKeyPath: (NSString *)keyPath
+      options: (NSDictionary *)options
+{
+  if ([binding isEqual: NSContentBinding]
+    || [binding isEqual: NSContentObjectsBinding]
+    || [binding isEqual: NSContentValuesBinding]
+    || [binding isEqual: NSSelectedObjectBinding]
+    || [binding isEqual: NSSelectedIndexBinding])
+    {
+      GSKeyValueBinding *kvb;
+
+      [self unbind: binding];
+      kvb = [[GSPopUpButtonBinding alloc] initWithBinding: binding
+                                                 withName: binding
+                                                 toObject: anObject
+                                              withKeyPath: keyPath
+                                                  options: options
+                                               fromObject: self];
+      // The binding will be retained in the binding table
+      RELEASE(kvb);
+    }
+  else
+    {
+      [super bind: binding
+         toObject: anObject
+      withKeyPath: keyPath
+          options: options];
+    }
+}
+
+- (BOOL) _hasContentBinding
+{
+  return [GSKeyValueBinding getBinding: NSContentBinding forObject: self] != nil
+    || [GSKeyValueBinding getBinding: NSContentObjectsBinding
+                           forObject: self] != nil
+    || [GSKeyValueBinding getBinding: NSContentValuesBinding
+                           forObject: self] != nil;
+}
+
+- (NSArray *) _contentForBinding: (NSString *)binding
+{
+  id value;
+
+  value = [[GSKeyValueBinding getBinding: binding forObject: self]
+            destinationValue];
+  return [value isKindOfClass: [NSArray class]] ? value : nil;
+}
+
+/* The title of the item NSInsertsNullPlaceholderBindingOption adds, or nil
+ * when there is none.
+ */
+- (NSString *) _nullPlaceholderTitle
+{
+  NSString *names[3] = {NSContentValuesBinding, NSContentBinding,
+                        NSContentObjectsBinding};
+  int i;
+
+  for (i = 0; i < 3; i++)
+    {
+      NSDictionary *options;
+
+      options = [[self infoForBinding: names[i]] objectForKey: NSOptionsKey];
+      if ([[options objectForKey: NSInsertsNullPlaceholderBindingOption]
+            boolValue])
+        {
+          NSString *title;
+
+          title = [options objectForKey: NSNullPlaceholderBindingOption];
+          return title != nil ? title : _(@"No Value");
+        }
+    }
+  return nil;
+}
+
+- (void) _addContentItemWithTitle: (NSString *)title
+                representedObject: (id)object
+{
+  NSMenuItem *item;
+
+  item = [[self menu] addItemWithTitle: title
+                                action: @selector(_popUpItemAction:)
+                         keyEquivalent: @""];
+  [item setTarget: _cell];
+  [item setOnStateImage: nil];
+  [item setMixedStateImage: nil];
+  [item setRepresentedObject: object];
+}
+
+/* Removes the item added for a selected object that is not in the content.
+ */
+- (void) _removeNoValueItem
+{
+  NSInteger last = [self numberOfItems] - 1;
+
+  if (last >= 0 && [self _hasContentBinding]
+    && [[self itemAtIndex: last] representedObject] == nil
+    && (last > 0 || [self _nullPlaceholderTitle] == nil))
+    {
+      [self removeItemAtIndex: last];
+    }
+}
+
+- (void) _removeNoValueItemUnlessSelected
+{
+  NSInteger last = [self numberOfItems] - 1;
+
+  if (last >= 0 && [self indexOfSelectedItem] != last)
+    {
+      [self _removeNoValueItem];
+    }
+}
+
+- (void) _selectObject: (id)object
+{
+  NSInteger index;
+
+  if ([self _hasContentBinding] == NO)
+    {
+      index = object == nil || NSIsControllerMarker(object) ? -1
+        : [self indexOfItemWithRepresentedObject: object];
+      [self selectItemAtIndex: index];
+      return;
+    }
+
+  [self _removeNoValueItem];
+  if (NSIsControllerMarker(object))
+    {
+      [self selectItemAtIndex: -1];
+      return;
+    }
+  if (object == nil)
+    {
+      if ([self _nullPlaceholderTitle] != nil)
+        {
+          [self selectItemAtIndex: 0];
+          return;
+        }
+      [self _addContentItemWithTitle: _(@"No Value") representedObject: nil];
+    }
+  else
+    {
+      index = [self indexOfItemWithRepresentedObject: object];
+      if (index >= 0)
+        {
+          [self selectItemAtIndex: index];
+          return;
+        }
+      [self _addContentItemWithTitle: titleForContentValue(object)
+                   representedObject: nil];
+    }
+  [self selectItemAtIndex: [self numberOfItems] - 1];
+}
+
+- (void) _selectIndex: (id)value
+{
+  NSInteger offset;
+  NSInteger index;
+
+  if ([self _hasContentBinding] == NO)
+    {
+      [self selectItemAtIndex: [value intValue]];
+      return;
+    }
+
+  offset = [self _nullPlaceholderTitle] != nil ? 1 : 0;
+  if (value != nil && NSIsControllerMarker(value) == NO
+    && [value respondsToSelector: @selector(integerValue)])
+    {
+      index = [value integerValue];
+      if (index >= 0 && index + offset < [self numberOfItems])
+        {
+          [self selectItemAtIndex: index + offset];
+          return;
+        }
+    }
+  [self selectItemAtIndex: offset > 0 ? 0 : -1];
+}
+
+- (void) _rebuildContent
+{
+  NSArray *content = [self _contentForBinding: NSContentBinding];
+  NSArray *objects = [self _contentForBinding: NSContentObjectsBinding];
+  NSArray *values = [self _contentForBinding: NSContentValuesBinding];
+  NSArray *primary = content;
+  NSString *placeholder = [self _nullPlaceholderTitle];
+  NSInteger selected = [self indexOfSelectedItem];
+  GSKeyValueBinding *binding;
+  NSUInteger count;
+  NSUInteger i;
+
+  if (primary == nil)
+    {
+      primary = objects != nil ? objects : values;
+    }
+  count = [primary count];
+
+  [self removeAllItems];
+  if (placeholder != nil)
+    {
+      [self _addContentItemWithTitle: placeholder representedObject: nil];
+    }
+  for (i = 0; i < count; i++)
+    {
+      id title = [primary objectAtIndex: i];
+      id object = title;
+
+      if (i < [values count])
+        {
+          title = [values objectAtIndex: i];
+        }
+      if (i < [objects count])
+        {
+          object = [objects objectAtIndex: i];
+        }
+      [self _addContentItemWithTitle: titleForContentValue(title)
+                   representedObject: object];
+    }
+
+  if ((binding = [GSKeyValueBinding getBinding: NSSelectedObjectBinding
+                                     forObject: self]) != nil)
+    {
+      [self _selectObject: [binding destinationValue]];
+    }
+  else if ((binding = [GSKeyValueBinding getBinding: NSSelectedIndexBinding
+                                          forObject: self]) != nil)
+    {
+      [self _selectIndex: [binding destinationValue]];
+    }
+  else if ((binding = [GSKeyValueBinding getBinding: NSSelectedValueBinding
+                                          forObject: self]) != nil)
+    {
+      [self selectItemWithTitle: [binding destinationValue]];
+    }
+  else if (selected >= 0 && selected < [self numberOfItems])
+    {
+      [self selectItemAtIndex: selected];
+    }
+  else
+    {
+      [self selectItemAtIndex: [self numberOfItems] > 0 ? 0 : -1];
+    }
+}
