+/* A pop-up's content bindings, as AppKit has them: content gives the items'
+   represented objects, contentValues their titles and contentObjects what
+   selectedObject is set to; selectedObject and selectedIndex follow the
+   model both ways, and NSInsertsNullPlaceholder adds a first item that
+   stands for nil.  Checked against AppKit on macOS.
+*/
+#include "Testing.h"
+
+#include <Foundation/NSArray.h>
+#include <Foundation/NSAutoreleasePool.h>
+#include <Foundation/NSDictionary.h>
+#include <Foundation/NSString.h>
+#include <Foundation/NSValue.h>
+
+#include <AppKit/NSApplication.h>
+#include <AppKit/NSArrayController.h>
+#include <AppKit/NSKeyValueBinding.h>
+#include <AppKit/NSMenu.h>
+#include <AppKit/NSMenuItem.h>
+#include <AppKit/NSPopUpButton.h>
+#include <AppKit/NSWindow.h>
+
+static NSWindow *window;
+
+/* The cell learns its control view when drawn, as in an application.  */
+static NSPopUpButton *
+newPopUp(void)
+{
+  NSPopUpButton *p;
+
+  p = AUTORELEASE([[NSPopUpButton alloc]
+    initWithFrame: NSMakeRect(0, 0, 100, 20) pullsDown: NO]);
+  [[window contentView] addSubview: p];
+  [p display];
+  return p;
+}
+
+static NSDictionary *
+thing(NSString *name, int ident)
+{
+  return [NSDictionary dictionaryWithObjectsAndKeys: name, @"name",
+    [NSNumber numberWithInt: ident], @"ident", nil];
+}
+
+static NSArray *
+represented(NSPopUpButton *p)
+{
+  NSMutableArray *a = [NSMutableArray array];
+  NSInteger i;
+
+  for (i = 0; i < [p numberOfItems]; i++)
+    {
+      id o = [[p itemAtIndex: i] representedObject];
+
+      [a addObject: o != nil ? o : (id)@"nil"];
+    }
+  return a;
+}
+
+int
+main(int argc, char **argv)
+{
+  START_SET("NSPopUpButton content bindings")
+
+  NS_DURING
+    {
+      [NSApplication sharedApplication];
+    }
+  NS_HANDLER
+    {
+      if ([[localException name] isEqualToString: NSInternalInconsistencyException])
+        SKIP("It looks like GNUstep backend is not yet installed")
+    }
+  NS_ENDHANDLER
+
+  window = [[NSWindow alloc] initWithContentRect: NSMakeRect(0, 0, 200, 200)
+                                       styleMask: NSTitledWindowMask
+                                         backing: NSBackingStoreBuffered
+                                           defer: NO];
+
+  NS_DURING
+    {
+      NSDictionary *a = thing(@"A", 1);
+      NSDictionary *b = thing(@"B", 2);
+      NSDictionary *c = thing(@"C", 3);
+      NSDictionary *d = thing(@"D", 4);
+      NSArray *things = [NSArray arrayWithObjects: a, b, c, nil];
+      NSArrayController *ac;
+      NSMutableDictionary *model;
+      NSDictionary *inserts;
+      NSPopUpButton *p;
+
+      inserts = [NSDictionary dictionaryWithObject: [NSNumber numberWithBool: YES]
+        forKey: NSInsertsNullPlaceholderBindingOption];
+      ac = AUTORELEASE([[NSArrayController alloc]
+        initWithContent: [NSMutableArray arrayWithArray: things]]);
+
+      p = AUTORELEASE([NSPopUpButton new]);
+      PASS([[p exposedBindings] containsObject: NSContentBinding]
+        && [[p exposedBindings] containsObject: NSContentObjectsBinding],
+        "content and contentObjects are exposed");
+
+      model = [NSMutableDictionary dictionary];
+      [model setObject: [NSArray arrayWithObjects: @"x", @"y", nil]
+                forKey: @"strings"];
+      p = newPopUp();
+      [p bind: NSContentBinding toObject: model withKeyPath: @"strings"
+      options: nil];
+      PASS_EQUAL([p itemTitles], ([NSArray arrayWithObjects: @"x", @"y", nil]),
+        "content alone titles its items by description");
+      PASS_EQUAL(represented(p), ([NSArray arrayWithObjects: @"x", @"y", nil]),
+        "content gives the represented objects");
+      PASS([p indexOfSelectedItem] == 0, "the first item is selected");
+
+      p = newPopUp();
+      [p bind: NSContentBinding toObject: ac withKeyPath: @"arrangedObjects"
+      options: nil];
+      [p bind: NSContentValuesBinding toObject: ac
+  withKeyPath: @"arrangedObjects.name" options: nil];
+      PASS_EQUAL([p itemTitles],
+        ([NSArray arrayWithObjects: @"A", @"B", @"C", nil]),
+        "contentValues titles the items");
+      PASS_EQUAL(represented(p), things,
+        "the represented objects are still the content");
+
+      [model setObject: b forKey: @"chosen"];
+      [p bind: NSSelectedObjectBinding toObject: model withKeyPath: @"chosen"
+      options: nil];
+      PASS([p indexOfSelectedItem] == 1, "selectedObject selects its object");
+      [model setObject: c forKey: @"chosen"];
+      PASS([p indexOfSelectedItem] == 2, "and follows the model");
+
+      [model removeObjectForKey: @"chosen"];
+      PASS([p numberOfItems] == 4
+        && [[p titleOfSelectedItem] isEqual: @"No Value"]
+        && [p indexOfSelectedItem] == 3,
+        "nil without a placeholder adds and selects a last item, No Value");
+      [[p menu] performActionForItemAtIndex: 0];
+      PASS([model objectForKey: @"chosen"] == a,
+        "choosing an item sets the model to its object");
+      PASS([p numberOfItems] == 3, "and takes the No Value item away");
+
+      [ac addObject: d];
+      PASS_EQUAL([p itemTitles],
+        ([NSArray arrayWithObjects: @"A", @"B", @"C", @"D", nil]),
+        "the items follow the content");
+      PASS([p indexOfSelectedItem] == 0, "the selection stays");
+
+      [model setObject: thing(@"E", 5) forKey: @"chosen"];
+      PASS([p numberOfItems] == 5 && [p indexOfSelectedItem] == 4
+        && [[p titleOfSelectedItem]
+             isEqual: [[model objectForKey: @"chosen"] description]]
+        && [[p selectedItem] representedObject] == nil,
+        "an object not in the content is shown as an extra last item");
+      [model setObject: b forKey: @"chosen"];
+      PASS([p numberOfItems] == 4 && [p indexOfSelectedItem] == 1,
+        "which goes when the object is in the content again");
+      [ac removeObject: d];
+
+      /* NSInsertsNullPlaceholder */
+      model = [NSMutableDictionary dictionary];
+      p = newPopUp();
+      [p bind: NSContentBinding toObject: ac withKeyPath: @"arrangedObjects"
+      options: inserts];
+      [p bind: NSContentValuesBinding toObject: ac
+  withKeyPath: @"arrangedObjects.name" options: nil];
+      [p bind: NSSelectedObjectBinding toObject: model withKeyPath: @"chosen"
+      options: nil];
+      PASS_EQUAL([p itemTitles],
+        ([NSArray arrayWithObjects: @"No Value", @"A", @"B", @"C", nil]),
+        "the null placeholder is a first item");
+      PASS([[p itemAtIndex: 0] representedObject] == nil,
+        "which stands for no object");
+      PASS([p indexOfSelectedItem] == 0, "nil selects it");
+      [[p menu] performActionForItemAtIndex: 2];
+      PASS([model objectForKey: @"chosen"] == b, "choosing B sets B");
+      [[p menu] performActionForItemAtIndex: 0];
+      PASS([model objectForKey: @"chosen"] == nil,
+        "choosing the placeholder sets nil");
+      [model setObject: c forKey: @"chosen"];
+      PASS([p indexOfSelectedItem] == 3, "a model object selects its item");
+
+      p = newPopUp();
+      [p bind: NSContentBinding toObject: ac withKeyPath: @"arrangedObjects"
+      options: nil];
+      [p bind: NSContentValuesBinding toObject: ac
+  withKeyPath: @"arrangedObjects.name"
+      options: [NSDictionary dictionaryWithObjectsAndKeys:
+        [NSNumber numberWithBool: YES], NSInsertsNullPlaceholderBindingOption,
+        @"None", NSNullPlaceholderBindingOption, nil]];
+      PASS_EQUAL([p itemTitles],
+        ([NSArray arrayWithObjects: @"None", @"A", @"B", @"C", nil]),
+        "the placeholder is titled by its binding's null placeholder");
+
+      /* contentObjects */
+      model = [NSMutableDictionary dictionary];
+      [model setObject: [NSNumber numberWithInt: 2] forKey: @"chosen"];
+      p = newPopUp();
+      [p bind: NSContentBinding toObject: ac withKeyPath: @"arrangedObjects"
+      options: nil];
+      [p bind: NSContentObjectsBinding toObject: ac
+  withKeyPath: @"arrangedObjects.ident" options: nil];
+      [p bind: NSContentValuesBinding toObject: ac
+  withKeyPath: @"arrangedObjects.name" options: nil];
+      [p bind: NSSelectedObjectBinding toObject: model withKeyPath: @"chosen"
+      options: nil];
+      PASS([p indexOfSelectedItem] == 1,
+        "selectedObject is matched against contentObjects");
+      [[p menu] performActionForItemAtIndex: 2];
+      PASS_EQUAL([model objectForKey: @"chosen"], [NSNumber numberWithInt: 3],
+        "and set from them");
+
+      /* selectedIndex counts the content, not the placeholder */
+      model = [NSMutableDictionary dictionary];
+      [model setObject: [NSNumber numberWithInt: 1] forKey: @"index"];
+      p = newPopUp();
+      [p bind: NSContentBinding toObject: ac withKeyPath: @"arrangedObjects"
+      options: inserts];
+      [p bind: NSSelectedIndexBinding toObject: model withKeyPath: @"index"
+      options: nil];
+      PASS([p indexOfSelectedItem] == 2, "selectedIndex 1 selects B");
+      [[p menu] performActionForItemAtIndex: 3];
+      PASS_EQUAL([model objectForKey: @"index"], [NSNumber numberWithInt: 2],
+        "choosing C sets 2");
+      [[p menu] performActionForItemAtIndex: 0];
+      PASS([model objectForKey: @"index"] == nil,
+        "choosing the placeholder sets nil");
+
+      /* titles may repeat */
+      model = [NSMutableDictionary dictionary];
+      [model setObject: [NSArray arrayWithObjects: @"x", @"z", @"x", nil]
+                forKey: @"strings"];
+      p = newPopUp();
+      [p bind: NSContentValuesBinding toObject: model withKeyPath: @"strings"
+      options: nil];
+      PASS_EQUAL([p itemTitles],
+        ([NSArray arrayWithObjects: @"x", @"z", @"x", nil]),
+        "contentValues may repeat a title");
+    }
+  NS_HANDLER
+    {
+      PASS(0, "unexpected exception %s",
+        [[localException description] UTF8String]);
+    }
+  NS_ENDHANDLER
+
+  END_SET("NSPopUpButton content bindings")
+
+  return 0;
+}
diff --git a/Tests/gui/NSPopUpButton/contentValuesKeyPath.m b/Tests/gui/NSPopUpButton/contentValuesKeyPath.m
new file mode 100644
index 000000000..c455c5e70
--- /dev/null
+++ b/Tests/gui/NSPopUpButton/contentValuesKeyPath.m
@@ -0,0 +1,95 @@
+/* contentValues bound through a to-many of the object content is bound to
+   (content to drivers, contentValues to drivers.name) titles the items by
+   each member's value, and follows the to-many and its members, as on
+   AppKit; key-value observing alone cannot observe through the array. */
+#include "Testing.h"
+
+#include <Foundation/NSArray.h>
+#include <Foundation/NSAutoreleasePool.h>
+#include <Foundation/NSDictionary.h>
+#include <Foundation/NSException.h>
+#include <Foundation/NSString.h>
+
+#include <AppKit/NSApplication.h>
+#include <AppKit/NSKeyValueBinding.h>
+#include <AppKit/NSPopUpButton.h>
+
+@interface Vehicle : NSObject
+{
+  NSArray *drivers;
+}
+- (NSArray *) drivers;
+- (void) setDrivers: (NSArray *)a;
+@end
+
+@implementation Vehicle
+- (NSArray *) drivers
+{
+  return drivers;
+}
+- (void) setDrivers: (NSArray *)a
+{
+  ASSIGNCOPY(drivers, a);
+}
+@end
+
+static NSString *
+titles(NSPopUpButton *p)
+{
+  return [[p itemTitles] componentsJoinedByString: @","];
+}
+
+int
+main(int argc, const char **argv)
+{
+  NSMutableDictionary	*ada;
+  NSMutableDictionary	*bob;
+  NSPopUpButton		*popup;
+  Vehicle		*vehicle;
+
+  START_SET("NSPopUpButton contentValues through a to-many")
+
+  NS_DURING
+    [NSApplication sharedApplication];
+  NS_HANDLER
+    if ([[localException name] isEqualToString: NSInternalInconsistencyException])
+      SKIP("It looks like GNUstep backend is not yet installed")
+  NS_ENDHANDLER
+
+  ada = [NSMutableDictionary dictionaryWithObject: @"Ada" forKey: @"name"];
+  bob = [NSMutableDictionary dictionaryWithObject: @"Bob" forKey: @"name"];
+  vehicle = AUTORELEASE([[Vehicle alloc] init]);
+  [vehicle setDrivers: [NSArray arrayWithObjects: ada, bob, nil]];
+  popup = AUTORELEASE([[NSPopUpButton alloc]
+    initWithFrame: NSMakeRect(0, 0, 100, 20) pullsDown: NO]);
+
+  NS_DURING
+    {
+      [popup bind: NSContentBinding toObject: vehicle
+      withKeyPath: @"drivers" options: nil];
+      [popup bind: NSContentValuesBinding toObject: vehicle
+      withKeyPath: @"drivers.name" options: nil];
+      PASS(YES, "contentValues binds through a to-many")
+    }
+  NS_HANDLER
+    PASS(NO, "contentValues binds through a to-many")
+  NS_ENDHANDLER
+  PASS_EQUAL(titles(popup), @"Ada,Bob", "the items are titled by name")
+
+  [ada setObject: @"Cid" forKey: @"name"];
+  PASS_EQUAL(titles(popup), @"Cid,Bob", "a member's new name shows")
+
+  [vehicle setDrivers: [NSArray arrayWithObject: bob]];
+  PASS_EQUAL(titles(popup), @"Bob", "a new to-many shows")
+
+  [ada setObject: @"Dan" forKey: @"name"];
+  [bob setObject: @"Eve" forKey: @"name"];
+  PASS_EQUAL(titles(popup), @"Eve", "only the members now in it are followed")
+
+  [popup unbind: NSContentValuesBinding];
+  [bob setObject: @"Fay" forKey: @"name"];
+  PASS([popup numberOfItems] == 1, "unbinding stops following")
+
+  END_SET("NSPopUpButton contentValues through a to-many")
+  return 0;
+}
