     }
   else if ([aKey isEqual: NSSelectedValueBinding])
     {
       [self selectItemWithTitle: anObject];
     }
+  else if ([aKey isEqual: NSContentBinding]
+    || [aKey isEqual: NSContentObjectsBinding]
+    || ([aKey isEqual: NSContentValuesBinding] && [self _hasContentBinding]))
+    {
+      [self _rebuildContent];
+    }
   else if ([aKey isEqual: NSContentValuesBinding])
     {
       [self removeAllItems];
@@ -594,7 +887,17 @@ this to return nil to indicate that we have no context menu.
 {
   if ([aKey isEqual: NSSelectedIndexBinding])
     {
-      return [NSNumber numberWithInt: [self indexOfSelectedItem]];
+      NSInteger index = [self indexOfSelectedItem];
+
