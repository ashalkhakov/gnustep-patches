 Class _nspopupbuttonCellClass = 0;
 
+@interface NSPopUpButtonCell (CocoaExtensions)
+- (void) _popUpItemAction: (id)sender;
+@end
+
+@interface GSPopUpButtonBinding : GSKeyValueBinding
+{
+  NSString *head;
+  NSString *tail;
+  id members;
+  void *context;
+}
+@end
+
+@implementation GSPopUpButtonBinding
+
+- (void) dealloc
+{
+  DESTROY(head);
+  DESTROY(tail);
+  DESTROY(members);
+  [super dealloc];
+}
+
+- (void) observeMembers
+{
+  NSEnumerator *e;
+  id member;
+  id now;
+
+  e = [members objectEnumerator];
+  while ((member = [e nextObject]) != nil)
+    {
+      [member removeObserver: self forKeyPath: tail];
+    }
+  now = [[self observedObject] valueForKeyPath: head];
+  if ([now isKindOfClass: [NSArray class]] || [now isKindOfClass: [NSSet class]])
+    {
+      ASSIGNCOPY(members, now);
+    }
+  else
+    {
+      DESTROY(members);
+    }
+  e = [members objectEnumerator];
+  while ((member = [e nextObject]) != nil)
+    {
+      [member addObserver: self
+               forKeyPath: tail
+                  options: NSKeyValueObservingOptionNew
+                  context: context];
+    }
+}
+
+/* Key-value observing cannot observe through a to-many, as in
+ * contentValues bound to drivers.name: the to-many is observed, and the
+ * rest of the key path on each of its members.
+ */
+- (void) observe: (NSString *)binding
+{
+  id dest = [self observedObject];
+  NSArray *keys = [[info objectForKey: NSObservedKeyPathKey]
+                    componentsSeparatedByString: @"."];
+  id value = dest;
+  NSUInteger i;
+
+  for (i = 0; i + 1 < [keys count]; i++)
+    {
+      value = [value valueForKey: [keys objectAtIndex: i]];
+      if (([value isKindOfClass: [NSArray class]]
+          || [value isKindOfClass: [NSSet class]])
+        && ![value isKindOfClass: [GSObservableArray class]])
+        {
+          NSRange r = NSMakeRange(0, i + 1);
+
+          ASSIGN(head, [[keys subarrayWithRange: r]
+            componentsJoinedByString: @"."]);
+          r = NSMakeRange(i + 1, [keys count] - i - 1);
+          ASSIGN(tail, [[keys subarrayWithRange: r]
+            componentsJoinedByString: @"."]);
+          context = binding;
+          [dest addObserver: self
+                 forKeyPath: head
+                    options: NSKeyValueObservingOptionNew
+                    context: binding];
+          [self observeMembers];
+          return;
+        }
+    }
+  [super observe: binding];
+}
+
+- (void) stopObserving
+{
+  NSEnumerator *e;
+  id member;
+
+  if (head == nil)
+    {
+      [super stopObserving];
+      return;
+    }
+  e = [members objectEnumerator];
+  while ((member = [e nextObject]) != nil)
+    {
+      [member removeObserver: self forKeyPath: tail];
+    }
+  DESTROY(members);
+  [[self observedObject] removeObserver: self forKeyPath: head];
+}
+
+- (void) observeValueForKeyPath: (NSString *)keyPath
+                       ofObject: (id)object
+                         change: (NSDictionary *)change
+                        context: (void *)ctxt
+{
+  if (head == nil)
+    {
+      [super observeValueForKeyPath: keyPath
+                           ofObject: object
+                             change: change
+                            context: ctxt];
+      return;
+    }
+  if (object == [self observedObject])
+    {
+      [self observeMembers];
+    }
+  [self setValueFor: (NSString *)ctxt];
+}
+
+- (id) transformValue: (id)value withOptions: (NSDictionary *)options
+{
+  if (value == nil || value == [NSNull null])
+    {
+      return nil;
+    }
+  if (NSIsControllerMarker(value))
+    {
+      return value;
+    }
+  return [super transformValue: value withOptions: options];
+}
+
+@end
+
+static NSString *
+titleForContentValue(id value)
+{
+  if (value == nil || value == [NSNull null])
+    {
+      return @"";
+    }
+  if ([value isKindOfClass: [NSString class]])
+    {
+      return value;
+    }
+  return [value description];
+}
