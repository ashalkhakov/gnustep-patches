diff --git a/Tests/gui/NSLayoutManager/shouldSetLineFragmentRect.m b/Tests/gui/NSLayoutManager/shouldSetLineFragmentRect.m
new file mode 100644
index 000000000..577423a6f
--- /dev/null
+++ b/Tests/gui/NSLayoutManager/shouldSetLineFragmentRect.m
@@ -0,0 +1,198 @@
+/* The layout manager's delegate is asked about each line fragment before
+   it is stored, by -layoutManager:shouldSetLineFragmentRect:
+   lineFragmentUsedRect:baselineOffset:inTextContainer:forGlyphRange:.
+   When it answers YES its rects and baseline offset are used: a taller
+   fragment pushes every later one down, in its paragraph and the next,
+   and a larger baseline offset moves the fragment's glyphs down.  When it
+   answers NO, nothing changes.  After an edit, the lines laid out again are
+   asked about again, so a changed answer takes effect below the edit. */
+#include "Testing.h"
+
+#include <math.h>
+
+#include <Foundation/NSAutoreleasePool.h>
+#include <Foundation/NSString.h>
+
+#include <AppKit/NSApplication.h>
+#include <AppKit/NSLayoutManager.h>
+#include <AppKit/NSTextContainer.h>
+#include <AppKit/NSTextStorage.h>
+
+@interface Padder : NSObject
+{
+@public
+  NSUInteger padGlyph;     /* the fragment holding this glyph is padded */
+  CGFloat extra;           /* added to its height */
+  CGFloat shift;           /* added to its baseline offset */
+  BOOL answer;
+  NSUInteger calls;
+  NSUInteger lastAsked;    /* the end of the last glyph range asked about */
+  CGFloat proposedBaseline;
+}
+@end
+
+@implementation Padder
+- (BOOL) layoutManager: (NSLayoutManager *)layoutManager
+  shouldSetLineFragmentRect: (NSRect *)lineFragmentRect
+       lineFragmentUsedRect: (NSRect *)lineFragmentUsedRect
+             baselineOffset: (CGFloat *)baselineOffset
+            inTextContainer: (NSTextContainer *)textContainer
+              forGlyphRange: (NSRange)glyphRange
+{
+  calls++;
+  lastAsked = NSMaxRange(glyphRange);
+  if (NSLocationInRange(padGlyph, glyphRange))
+    {
+      proposedBaseline = *baselineOffset;
+      lineFragmentRect->size.height += extra;
+      lineFragmentUsedRect->size.height += extra;
+      *baselineOffset += shift;
+    }
+  return answer;
+}
+@end
+
+static NSString *text = @"First line\n"
+  @"A second paragraph, long enough to wrap onto two lines or more\n"
+  @"Third\n";
+
+static NSTextStorage *storage;
+static NSLayoutManager *lm;
+static NSTextContainer *tc;
+
+static void
+layOut(Padder *delegate)
+{
+  storage = AUTORELEASE([[NSTextStorage alloc] initWithString: text]);
+  lm = AUTORELEASE([[NSLayoutManager alloc] init]);
+  [lm setDelegate: delegate];
+  tc = AUTORELEASE([[NSTextContainer alloc]
+    initWithContainerSize: NSMakeSize(200, 1e7)]);
+  [lm addTextContainer: tc];
+  [storage addLayoutManager: lm];
+  [lm glyphRangeForTextContainer: tc];
+}
+
+static NSRect
+fragment(NSUInteger glyph)
+{
+  return [lm lineFragmentRectForGlyphAtIndex: glyph effectiveRange: NULL];
+}
+
+static NSRect
+usedFragment(NSUInteger glyph)
+{
+  return [lm lineFragmentUsedRectForGlyphAtIndex: glyph effectiveRange: NULL];
+}
+
+int
+main(int argc, const char **argv)
+{
+  NSAutoreleasePool *pool = [NSAutoreleasePool new];
+  NSUInteger second;     /* the first glyph of the second paragraph */
+  NSUInteger wrapped;    /* the first glyph of its second line */
+  NSUInteger third;      /* the first glyph of the third paragraph */
+  NSRange range;
+  NSRect first0, second0, wrapped0, third0, used0, all0;
+  NSPoint secondAt0, wrappedAt0;
+  Padder *padder;
+
+  START_SET("NSLayoutManager delegate shouldSetLineFragmentRect")
+
+  NS_DURING
+    [NSApplication sharedApplication];
+  NS_HANDLER
+    if ([[localException name] isEqualToString: NSInternalInconsistencyException])
+      SKIP("It looks like GNUstep backend is not yet installed")
+  NS_ENDHANDLER
+
+  second = [text rangeOfString: @"A second"].location;
+  third = [text rangeOfString: @"Third"].location;
+
+  layOut(nil);
+  [lm lineFragmentRectForGlyphAtIndex: second effectiveRange: &range];
+  wrapped = NSMaxRange(range);
+  PASS(wrapped < third, "the second paragraph wraps");
+  first0 = fragment(0);
+  second0 = fragment(second);
+  wrapped0 = fragment(wrapped);
+  third0 = fragment(third);
+  used0 = usedFragment(second);
+  all0 = [lm usedRectForTextContainer: tc];
+  secondAt0 = [lm locationForGlyphAtIndex: second];
+  wrappedAt0 = [lm locationForGlyphAtIndex: wrapped];
+
+  padder = AUTORELEASE([Padder new]);
+  padder->padGlyph = second;
+  padder->extra = 10;
+  padder->answer = YES;
+  layOut(padder);
+  PASS(padder->calls > 0, "the delegate is asked about line fragments");
+  PASS(padder->lastAsked == [lm numberOfGlyphs],
+       "it is asked down to the last glyph");
+  PASS(fabs(padder->proposedBaseline - secondAt0.y) < 0.001,
+       "the proposed baseline offset is the glyphs' height in the fragment"
+       " (%g, glyphs at %g)", padder->proposedBaseline, secondAt0.y);
+  PASS(NSEqualRects(fragment(0), first0),
+       "a fragment above the padded one is unchanged");
+  PASS(NSMinY(fragment(second)) == NSMinY(second0)
+       && NSHeight(fragment(second)) == NSHeight(second0) + 10,
+       "the padded fragment is 10 points taller");
+  PASS(NSHeight(usedFragment(second)) == NSHeight(used0) + 10,
+       "and so is its used rect");
+  PASS(NSMinY(fragment(wrapped)) == NSMinY(wrapped0) + 10,
+       "the next line of the paragraph is 10 points lower");
+  PASS(NSMinY(fragment(third)) == NSMinY(third0) + 10,
+       "and so is the next paragraph");
+  PASS(NSHeight([lm usedRectForTextContainer: tc]) == NSHeight(all0) + 10,
+       "the text is 10 points taller");
+  PASS(NSEqualPoints([lm locationForGlyphAtIndex: second], secondAt0),
+       "the padded fragment's glyphs stay at its top");
+  PASS(NSEqualPoints([lm locationForGlyphAtIndex: wrapped], wrappedAt0),
+       "a lower fragment's glyphs are where they were in it");
+
+  padder = AUTORELEASE([Padder new]);
+  padder->padGlyph = second;
+  padder->extra = 10;
+  padder->shift = 10;
+  padder->answer = YES;
+  layOut(padder);
+  PASS([lm locationForGlyphAtIndex: second].y == secondAt0.y + 10,
+       "a larger baseline offset moves the fragment's glyphs down");
+  PASS(NSMinY(fragment(third)) == NSMinY(third0) + 10,
+       "and the lines below move by the height alone");
+
+  padder = AUTORELEASE([Padder new]);
+  padder->padGlyph = second;
+  padder->extra = 10;
+  padder->shift = 10;
+  padder->answer = NO;
+  layOut(padder);
+  PASS(padder->calls > 0, "a delegate that answers NO is asked");
+  PASS(NSEqualRects(fragment(second), second0)
+       && NSEqualRects(usedFragment(second), used0)
+       && NSEqualRects(fragment(third), third0)
+       && NSEqualPoints([lm locationForGlyphAtIndex: second], secondAt0),
+       "and what it changed is not used");
+
+  padder = AUTORELEASE([Padder new]);
+  padder->padGlyph = second;
+  padder->extra = 10;
+  padder->answer = YES;
+  layOut(padder);
+  padder->calls = 0;
+  padder->lastAsked = 0;
+  padder->extra = 20;
+  padder->padGlyph = second + 1;
+  [storage replaceCharactersInRange: NSMakeRange(0, 0) withString: @"x"];
+  [lm glyphRangeForTextContainer: tc];
+  PASS(padder->calls > 0 && padder->lastAsked == [lm numberOfGlyphs],
+       "after an edit, the lines below it are asked about again");
+  PASS(NSHeight(fragment(second + 1)) == NSHeight(second0) + 20
+       && NSMinY(fragment(third + 1)) == NSMinY(third0) + 20,
+       "and the delegate's new answer is used");
+
+  END_SET("NSLayoutManager delegate shouldSetLineFragmentRect")
+  [pool release];
+  return 0;
+}
-- 
