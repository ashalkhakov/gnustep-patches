 #import "AppKit/NSApplication.h"
 #import "AppKit/NSBox.h"
 #import "AppKit/NSBrowser.h"
@@ -183,6 +186,8 @@ static NSArray      *XmlReferenceAttributes  = nil;
 static NSArray      *XmlConnectionRecordTags  = nil;
 static NSArray      *XmlConstraintRecordTags  = nil;
 static NSArray      *XmlBoolDefaultYes  = nil;
+static NSDictionary *XmlFormatterEnumerations = nil;
+static NSArray      *XmlFormatterNumericKeys = nil;
 
 + (void) initialize
 {
@@ -191,6 +196,8 @@ static NSArray      *XmlBoolDefaultYes  = nil;
       // Only check one since we're going to load all once...
       if (XmlTagToObjectClassMap == nil)
         {
+          NSDictionary *dateStyles;
+
           // These define XML tags (i.e. <objects ...) that should be allocated as the
           // associated class...
           XmlTagToObjectClassMap =
@@ -463,6 +470,7 @@ static NSArray      *XmlBoolDefaultYes  = nil;
                @"decodeDatePickerStyleForElement:", @"NSDatePickerType",
                @"decodeDatePickerModeForElement:", @"NSDatePickerMode",
                @"decodeDatePickerDateValueForElement:", @"NSDateValue",
+               @"decodeFormatterAttributesForElement:", @"NS.attributes",
                  nil];
           RETAIN(XmlKeyToDecoderSelectorMap);
 
@@ -475,6 +483,57 @@ static NSArray      *XmlBoolDefaultYes  = nil;
                                                @"enabled",
                                                @"canPropagateSelectedChildViewControllerTitle",
                                                nil];
+
+          dateStyles = [NSDictionary dictionaryWithObjectsAndKeys:
+            [NSNumber numberWithInt: NSDateFormatterNoStyle], @"none",
+            [NSNumber numberWithInt: NSDateFormatterShortStyle], @"short",
+            [NSNumber numberWithInt: NSDateFormatterMediumStyle], @"medium",
+            [NSNumber numberWithInt: NSDateFormatterLongStyle], @"long",
+            [NSNumber numberWithInt: NSDateFormatterFullStyle], @"full",
+            nil];
+          XmlFormatterEnumerations = [[NSDictionary alloc] initWithObjectsAndKeys:
+            [NSDictionary dictionaryWithObjectsAndKeys:
+              [NSNumber numberWithInt: 1000], @"10_0",
+              [NSNumber numberWithInt: 1040], @"default10_4",
+              [NSNumber numberWithInt: 1040], @"custom10_4",
+              nil], @"formatterBehavior",
+            [NSDictionary dictionaryWithObjectsAndKeys:
+              [NSNumber numberWithInt: NSNumberFormatterNoStyle], @"none",
+              [NSNumber numberWithInt: NSNumberFormatterDecimalStyle], @"decimal",
+              [NSNumber numberWithInt: NSNumberFormatterCurrencyStyle], @"currency",
+              [NSNumber numberWithInt: NSNumberFormatterPercentStyle], @"percent",
+              [NSNumber numberWithInt: NSNumberFormatterScientificStyle], @"scientific",
+              [NSNumber numberWithInt: NSNumberFormatterSpellOutStyle], @"spellOut",
+              [NSNumber numberWithInt: 6], @"ordinal",
+              [NSNumber numberWithInt: 8], @"currencyISOCode",
+              [NSNumber numberWithInt: 9], @"currencyPlural",
+              [NSNumber numberWithInt: 10], @"currencyAccounting",
+              nil], @"numberStyle",
+            [NSDictionary dictionaryWithObjectsAndKeys:
+              [NSNumber numberWithInt: NSNumberFormatterPadBeforePrefix], @"beforePrefix",
+              [NSNumber numberWithInt: NSNumberFormatterPadAfterPrefix], @"afterPrefix",
+              [NSNumber numberWithInt: NSNumberFormatterPadBeforeSuffix], @"beforeSuffix",
+              [NSNumber numberWithInt: NSNumberFormatterPadAfterSuffix], @"afterSuffix",
+              nil], @"paddingPosition",
+            [NSDictionary dictionaryWithObjectsAndKeys:
+              [NSNumber numberWithInt: NSNumberFormatterRoundCeiling], @"ceiling",
+              [NSNumber numberWithInt: NSNumberFormatterRoundFloor], @"floor",
+              [NSNumber numberWithInt: NSNumberFormatterRoundDown], @"down",
+              [NSNumber numberWithInt: NSNumberFormatterRoundUp], @"up",
+              [NSNumber numberWithInt: NSNumberFormatterRoundHalfEven], @"halfEven",
+              [NSNumber numberWithInt: NSNumberFormatterRoundHalfDown], @"halfDown",
+              [NSNumber numberWithInt: NSNumberFormatterRoundHalfUp], @"halfUp",
+              nil], @"roundingMode",
+            dateStyles, @"dateStyle",
+            dateStyles, @"timeStyle",
+            nil];
+
+          XmlFormatterNumericKeys = [[NSArray alloc] initWithObjects:
+            @"formatWidth", @"groupingSize", @"secondaryGroupingSize",
+            @"minimumIntegerDigits", @"maximumIntegerDigits",
+            @"minimumFractionDigits", @"maximumFractionDigits",
+            @"minimumSignificantDigits", @"maximumSignificantDigits",
+            nil];
         }
     }
 }
@@ -2631,6 +2690,66 @@ didStartElement: (NSString*)elementName
   return [self decodeObjectForKey: @"date"];
 }
 
+- (id) decodeFormatterAttributesForElement: (GSXibElement*)element
+{
+  NSMutableDictionary	*attributes = [NSMutableDictionary dictionary];
+  NSDictionary		*xmlAttributes = [element attributes];
+  NSEnumerator		*keys = [xmlAttributes keyEnumerator];
+  NSString		*key;
+
+  while ((key = [keys nextObject]) != nil)
+    {
+      NSString		*value = [xmlAttributes objectForKey: key];
+      NSDictionary	*names = [XmlFormatterEnumerations objectForKey: key];
+      id		object = value;
+
+      if ([key isEqualToString: @"id"] || [key isEqualToString: @"key"]
+	|| [key isEqualToString: @"class"]
+	|| [key isEqualToString: @"customClass"]
+	|| [key isEqualToString: @"userLabel"])
+	{
+	  continue;
+	}
+      if (names != nil)
+	{
+	  object = [names objectForKey: value];
+	}
+      else if ([XmlFormatterNumericKeys containsObject: key])
+	{
+	  object = [NSNumber numberWithInteger: [value integerValue]];
+	}
+      else if ([value isEqualToString: @"YES"] || [value isEqualToString: @"NO"])
+	{
+	  object = [NSNumber numberWithBool: [value boolValue]];
+	}
+      if (object != nil)
+	{
+	  [attributes setObject: object forKey: key];
+	}
+    }
+  /* macOS gives a date formatter from a xib the 10.4 behaviour, whatever
+   * the xib says.
+   */
+  if ([NSClassFromString([element attributeForKey: @"class"])
+    isSubclassOfClass: [NSDateFormatter class]])
+    {
+      [attributes setObject: [NSNumber numberWithInt: 1040]
+		     forKey: @"formatterBehavior"];
+    }
+
+  keys = [[element elements] keyEnumerator];
+  while ((key = [keys nextObject]) != nil)
+    {
+      id	object = [self decodeObjectForKey: key];
+
+      if (object != nil)
+	{
+	  [attributes setObject: object forKey: key];
+	}
+    }
+  return attributes;
+}
+
 - (id) decodeButtonFlags1ForElement: (GSXibElement*)element
 {
   NSNumber *value = nil;
