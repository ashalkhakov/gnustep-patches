diff --git a/Tests/gui/GSXib5KeyedUnarchiver/formatters.m b/Tests/gui/GSXib5KeyedUnarchiver/formatters.m
new file mode 100644
index 0000000..6e0659f
--- /dev/null
+++ b/Tests/gui/GSXib5KeyedUnarchiver/formatters.m
@@ -0,0 +1,123 @@
+#import "ObjectTesting.h"
+
+#import <Foundation/NSData.h>
+#import <Foundation/NSDateFormatter.h>
+#import <Foundation/NSDecimalNumber.h>
+#import <Foundation/NSNumberFormatter.h>
+#import <AppKit/NSApplication.h>
+#import <AppKit/NSTextField.h>
+#import <Additions/GNUstepGUI/GSXibKeyedUnarchiver.h>
+
+/* The values checked here are the ones AppKit gives for Formatters.xib
+ * when it is compiled by ibtool and loaded on macOS.
+ */
+static id
+formatterAt(NSArray *rootObjects, CGFloat y)
+{
+  NSEnumerator	*enumerator = [rootObjects objectEnumerator];
+  id		element;
+
+  while ((element = [enumerator nextObject]) != nil)
+    {
+      if ([element isKindOfClass: [NSTextField class]]
+	&& [element frame].origin.y == y)
+	{
+	  return [element formatter];
+	}
+    }
+  return nil;
+}
+
+int main()
+{
+  START_SET("GSXib5KeyedUnarchiver formatter tests")
+
+  NS_DURING
+    {
+      [NSApplication sharedApplication];
+    }
+  NS_HANDLER
+    {
+      if ([[localException name]
+	isEqualToString: NSInternalInconsistencyException ])
+	{
+	  SKIP("It looks like GNUstep backend is not yet installed")
+	}
+    }
+  NS_ENDHANDLER
+
+  NSData		*data;
+  GSXibKeyedUnarchiver	*unarchiver;
+  NSArray		*rootObjects;
+  NSNumberFormatter	*number;
+  NSDateFormatter	*date;
+
+  data = [NSData dataWithContentsOfFile: @"Formatters.xib"];
+  unarchiver = [GSXibKeyedUnarchiver unarchiverForReadingWithData: data];
+  rootObjects = [unarchiver decodeObjectForKey: @"IBDocument.RootObjects"];
+
+  number = formatterAt(rootObjects, 10);
+  PASS([number isKindOfClass: [NSNumberFormatter class]],
+    "a numberFormatter element is a number formatter")
+  PASS([number formatterBehavior] == NSNumberFormatterBehavior10_4,
+    "formatterBehavior custom10_4 is the 10.4 behavior")
+  PASS([number numberStyle] == NSNumberFormatterDecimalStyle,
+    "numberStyle decimal is the decimal style")
+  PASS([number generatesDecimalNumbers], "generatesDecimalNumbers is read")
+  PASS([number usesGroupingSeparator] == NO, "usesGroupingSeparator is read")
+  PASS([number minimumIntegerDigits] == 1, "minimumIntegerDigits is read")
+  PASS([number maximumIntegerDigits] == 42, "maximumIntegerDigits is read")
+  PASS([number maximumFractionDigits] == 3, "maximumFractionDigits is read")
+  PASS_EQUAL([number stringFromNumber:
+    [NSDecimalNumber decimalNumberWithString: @"12345.6789"]],
+    @"12345.679", "the number formatter formats with its settings")
+
+  number = formatterAt(rootObjects, 50);
+  PASS([number formatterBehavior] == NSNumberFormatterBehavior10_4,
+    "formatterBehavior default10_4 is the 10.4 behavior")
+  PASS([number numberStyle] == NSNumberFormatterPercentStyle,
+    "numberStyle percent is the percent style")
+  PASS([number maximumFractionDigits] == 1,
+    "maximumFractionDigits is read after the style")
+
+  number = formatterAt(rootObjects, 90);
+  PASS([number numberStyle] == NSNumberFormatterDecimalStyle,
+    "a formatter with its symbols spelt out has its style")
+  PASS([number maximumIntegerDigits] == 309, "its maximumIntegerDigits")
+  PASS_EQUAL([number minimum], [NSNumber numberWithInt: 0],
+    "a minimum element is the minimum")
+  PASS_EQUAL([number maximum], [NSNumber numberWithInt: 1000],
+    "a maximum element is the maximum")
+  PASS_EQUAL([number paddingCharacter], @"*", "paddingCharacter is read")
+  PASS_EQUAL([number negativePrefix], @"-", "negativePrefix is read")
+
+  date = formatterAt(rootObjects, 130);
+  PASS([date isKindOfClass: [NSDateFormatter class]],
+    "a dateFormatter element is a date formatter")
+  PASS([date formatterBehavior] == NSDateFormatterBehavior10_4,
+    "formatterBehavior custom10_4 is the 10.4 behavior")
+  PASS([date dateStyle] == NSDateFormatterShortStyle,
+    "dateStyle short is the short style")
+  PASS([date timeStyle] == NSDateFormatterShortStyle,
+    "timeStyle short is the short style")
+
+  date = formatterAt(rootObjects, 170);
+  PASS([date dateStyle] == NSDateFormatterLongStyle,
+    "dateStyle long is the long style")
+  PASS([date timeStyle] == NSDateFormatterNoStyle,
+    "timeStyle none is no style")
+
+  date = formatterAt(rootObjects, 210);
+  PASS([date formatterBehavior] == NSDateFormatterBehavior10_4,
+    "a date formatter with a format has the 10.4 behavior")
+  PASS_EQUAL([date dateFormat], @"yyyy-MM-dd", "dateFormat is read")
+
+  date = formatterAt(rootObjects, 250);
+  PASS([date formatterBehavior] == NSDateFormatterBehavior10_4,
+    "a date formatter has the 10.4 behavior whatever the xib says")
+  PASS_EQUAL([date dateFormat], @"%Y",
+    "the format of a 10.0 date formatter is taken as a 10.4 pattern")
+
+  END_SET("GSXib5KeyedUnarchiver formatter tests")
+  return 0;
+}
