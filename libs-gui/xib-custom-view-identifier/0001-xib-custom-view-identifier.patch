From b1c25ae33fdf42e283453f6363805385da68f6dc Mon Sep 17 00:00:00 2001
From: Artyom Shalkhakov <artyom.shalkhakov@gmail.com>
Date: Thu, 22 Oct 2026 06:23:34 +0000
Subject: [PATCH] Give a xib's custom view its identifier

A custom view of a xib (a customView element, with or without a class of
its own) is made by NSCustomView, which gives the view it makes its frame,
autoresizing, hidden flag, key views and subviews, but not its
identifier.  NSView's own -initWithCoder: decodes NSIdentifier, so every
other view of the xib has the identifier Interface Builder gave it, and a
custom view had none: code that finds its views by identifier (tests,
accessibility) found every view but those.  On macOS a custom view keeps
its identifier.

Decode NSIdentifier with the other flags and set it on the view made.

Tests/gui/GSXib5KeyedUnarchiver/customViewIdentifier.m loads
CustomViewIdentifier.xib, a window holding a custom view of no class and
one of NSControl; both identifier checks fail without the change.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 Source/GSNibLoading.m                         |  4 ++
 .../CustomViewIdentifier.xib                  | 27 ++++++++
 .../customViewIdentifier.m                    | 63 +++++++++++++++++++
 3 files changed, 94 insertions(+)
 create mode 100644 Tests/gui/GSXib5KeyedUnarchiver/CustomViewIdentifier.xib
 create mode 100644 Tests/gui/GSXib5KeyedUnarchiver/customViewIdentifier.m

diff --git a/Source/GSNibLoading.m b/Source/GSNibLoading.m
index 8a42c72d8..3f4e435ee 100644
--- a/Source/GSNibLoading.m
+++ b/Source/GSNibLoading.m
@@ -1159,6 +1159,10 @@ static BOOL _isInInterfaceBuilder = NO;
 	  [_view setAutoresizesSubviews: ((vFlags & 0x100) == 0x100)];
 	  [_view setHidden: ((vFlags & 0x80000000) == 0x80000000)];
 	}
+      if ([coder containsValueForKey: @"NSIdentifier"])
+	{
+	  [_view setIdentifier: [coder decodeObjectForKey: @"NSIdentifier"]];
+	}
       /*
       if ([coder containsValueForKey: @"NSNextResponder"])
 	{
diff --git a/Tests/gui/GSXib5KeyedUnarchiver/CustomViewIdentifier.xib b/Tests/gui/GSXib5KeyedUnarchiver/CustomViewIdentifier.xib
new file mode 100644
index 000000000..7e55f06c9
--- /dev/null
+++ b/Tests/gui/GSXib5KeyedUnarchiver/CustomViewIdentifier.xib
@@ -0,0 +1,27 @@
+<?xml version="1.0" encoding="UTF-8"?>
+<document type="com.apple.InterfaceBuilder3.Cocoa.XIB" version="3.0" toolsVersion="22505" targetRuntime="MacOSX.Cocoa" propertyAccessControl="none" useAutolayout="NO">
+    <dependencies>
+        <plugIn identifier="com.apple.InterfaceBuilder.CocoaPlugin" version="22505"/>
+    </dependencies>
+    <objects>
+        <customObject id="-2" userLabel="File's Owner" customClass="NSObject"/>
+        <customObject id="-1" userLabel="First Responder" customClass="FirstResponder"/>
+        <customObject id="-3" userLabel="Application" customClass="NSObject"/>
+        <window title="Window" allowsToolTipsWhenApplicationIsInactive="NO" autorecalculatesKeyViewLoop="NO" releasedWhenClosed="NO" visibleAtLaunch="NO" animationBehavior="default" id="window">
+            <windowStyleMask key="styleMask" titled="YES"/>
+            <rect key="contentRect" x="0.0" y="0.0" width="100" height="100"/>
+            <rect key="screenRect" x="0.0" y="0.0" width="1024" height="768"/>
+            <view key="contentView" id="content">
+                <rect key="frame" x="0.0" y="0.0" width="100" height="100"/>
+                <subviews>
+                    <customView identifier="plain" id="plain">
+                        <rect key="frame" x="0.0" y="0.0" width="10" height="10"/>
+                    </customView>
+                    <customView identifier="custom" id="custom" customClass="NSControl">
+                        <rect key="frame" x="20" y="0.0" width="10" height="10"/>
+                    </customView>
+                </subviews>
+            </view>
+        </window>
+    </objects>
+</document>
diff --git a/Tests/gui/GSXib5KeyedUnarchiver/customViewIdentifier.m b/Tests/gui/GSXib5KeyedUnarchiver/customViewIdentifier.m
new file mode 100644
index 000000000..0bc1165ca
--- /dev/null
+++ b/Tests/gui/GSXib5KeyedUnarchiver/customViewIdentifier.m
@@ -0,0 +1,63 @@
+/* A custom view of a xib has the identifier the xib gives it, as any
+   other view does, whether or not it is of a class of its own. */
+#import "ObjectTesting.h"
+
+#import <Foundation/NSArray.h>
+#import <Foundation/NSData.h>
+#import <AppKit/NSApplication.h>
+#import <AppKit/NSControl.h>
+#import <AppKit/NSNib.h>
+#import <AppKit/NSView.h>
+#import <AppKit/NSWindow.h>
+
+int main()
+{
+  START_SET("GSXib5KeyedUnarchiver custom view identifier")
+
+  NS_DURING
+    {
+      [NSApplication sharedApplication];
+    }
+  NS_HANDLER
+    {
+      if ([[localException name]
+	isEqualToString: NSInternalInconsistencyException ])
+	{
+	  SKIP("It looks like GNUstep backend is not yet installed")
+	}
+    }
+  NS_ENDHANDLER
+
+  NSData	*data;
+  NSNib		*nib;
+  NSArray	*objects = nil;
+  NSWindow	*window = nil;
+  NSArray	*subviews;
+  NSEnumerator	*e;
+  id		object;
+
+  data = [NSData dataWithContentsOfFile: @"CustomViewIdentifier.xib"];
+  nib = AUTORELEASE([[NSNib alloc] initWithNibData: data bundle: nil]);
+  PASS([nib instantiateWithOwner: NSApp topLevelObjects: &objects],
+    "the xib loads")
+  e = [objects objectEnumerator];
+  while ((object = [e nextObject]) != nil)
+    {
+      if ([object isKindOfClass: [NSWindow class]])
+	window = object;
+    }
+  subviews = [[window contentView] subviews];
+  PASS([subviews count] == 2, "the window holds both custom views")
+  if ([subviews count] == 2)
+    {
+      PASS_EQUAL([[subviews objectAtIndex: 0] identifier], @"plain",
+	"a custom view of no class of its own has its identifier")
+      PASS([[subviews objectAtIndex: 1] isKindOfClass: [NSControl class]],
+	"a custom view of a class is of it")
+      PASS_EQUAL([[subviews objectAtIndex: 1] identifier], @"custom",
+	"a custom view of a class has its identifier")
+    }
+
+  END_SET("GSXib5KeyedUnarchiver custom view identifier")
+  return 0;
+}
