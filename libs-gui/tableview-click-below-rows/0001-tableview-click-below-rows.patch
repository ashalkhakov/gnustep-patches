From 0b43838ec2e8efec48a8fc17c6fa03e1206c55cb Mon Sep 17 00:00:00 2001
From: Artyom Shalkhakov <artyom.shalkhakov@gmail.com>
Date: Thu, 29 Oct 2026 09:01:17 +0000
Subject: [PATCH] NSTableView: fill the clip view, and deselect on a click
 below the rows

On macOS a table view in a scroll view is at least as tall as its clip
view, and a click in it below the last row, on no row, deselects every
row when the table allows an empty selection.  This is how a list is
emptied of its selection, and an editor that shows the selection's
properties, or the whole document's when nothing is selected, relies on
it.

-setFrame: and -setFrameSize: meant to enlarge the table to its clip
view, but measured against -documentVisibleRect, which is the visible
part of the document view, the table itself: a table shorter than the
clip view was never enlarged past its own rows.  And
-viewWillMoveToSuperview: re-applied the frame before the move, against
the old superview.  So the space below the rows belonged to the clip
view, and a click there never reached the table.

Measure against the clip view's bounds, re-apply the frame once the
table is in its new superview, and in -mouseDown:, deselect every row
when a plain click (no Shift or Control) is on no row and an empty
selection is allowed.

The test puts a two-row table in a taller scroll view: it fills the
clip view, a click below its rows deselects, and without empty
selection the row stays selected.
---
 Source/NSTableView.m                   |  20 +++--
 Tests/gui/NSTableView/clickBelowRows.m | 116 +++++++++++++++++++++++++
 2 files changed, 131 insertions(+), 5 deletions(-)
 create mode 100644 Tests/gui/NSTableView/clickBelowRows.m

diff --git a/Source/NSTableView.m b/Source/NSTableView.m
index f1c47dfde..745aeb606 100644
--- a/Source/NSTableView.m
+++ b/Source/NSTableView.m
@@ -3868,6 +3868,16 @@ if (currentRow >= 0 && currentRow < _numberOfRows) \
       oldSelectedRows = [_selectedRows copy];
       lastEvent = theEvent;
 
+      // A click on no row (below the last) deselects, as on macOS
+      if (_clickedRow == -1
+	  && (selectionMode & ALLOWS_EMPTY)
+	  && !(selectionMode & (SHIFT_DOWN | CONTROL_DOWN))
+	  && [_selectedRows count] > 0)
+	{
+	  [self _postSelectionIsChangingNotification];
+	  [self _unselectAllRows];
+	}
+
       while (done != YES)
 	{
 	  /*
@@ -4662,7 +4672,7 @@ This method is deprecated, use -columnIndexesInRect:. */
   if ([_super_view respondsToSelector: @selector(documentVisibleRect)])
     {
 			CGFloat rowsHeight = ([self _rowsHeight] + 1);
-      NSRect docRect = [(NSClipView *)_super_view documentVisibleRect];
+      NSRect docRect = [_super_view bounds];
 
       if (rowsHeight < docRect.size.height)
 	{
@@ -4688,7 +4698,7 @@ This method is deprecated, use -columnIndexesInRect:. */
   if ([_super_view respondsToSelector: @selector(documentVisibleRect)])
     {
 			CGFloat rowsHeight = ([self _rowsHeight] + 1);
-      NSRect docRect = [(NSClipView *)_super_view documentVisibleRect];
+      NSRect docRect = [_super_view bounds];
 
       if (rowsHeight < docRect.size.height)
 	{
@@ -4707,10 +4717,10 @@ This method is deprecated, use -columnIndexesInRect:. */
     }
 }
 
-- (void) viewWillMoveToSuperview:(NSView *)newSuper
+- (void) viewDidMoveToSuperview
 {
-  [super viewWillMoveToSuperview: newSuper];
-  /* need to potentially enlarge to fill the documentRect of the clip view */
+  [super viewDidMoveToSuperview];
+  /* need to potentially enlarge to fill the clip view */
   [self setFrame: _frame];
 }
 
diff --git a/Tests/gui/NSTableView/clickBelowRows.m b/Tests/gui/NSTableView/clickBelowRows.m
new file mode 100644
index 000000000..558fd36cc
--- /dev/null
+++ b/Tests/gui/NSTableView/clickBelowRows.m
@@ -0,0 +1,116 @@
+/* A table view in a scroll view taller than its rows, as on macOS: it fills
+   the clip view, and a click below its last row deselects every row when
+   the table allows an empty selection, and leaves the selection when it
+   does not.  The click is delivered as real events through GSClick, so this
+   needs a window server and keeps the usual START_SET / SKIP guard. */
+#import "Testing.h"
+#import "../GSRenderTest.h"
+
+#import <Foundation/NSAutoreleasePool.h>
+#import <Foundation/NSGeometry.h>
+
+#import <AppKit/NSApplication.h>
+#import <AppKit/NSClipView.h>
+#import <AppKit/NSScrollView.h>
+#import <AppKit/NSTableColumn.h>
+#import <AppKit/NSTableView.h>
+#import <AppKit/NSWindow.h>
+
+@interface Source : NSObject
+@end
+
+@implementation Source
+- (NSInteger) numberOfRowsInTableView: (NSTableView *)tv
+{
+  return 2;
+}
+- (id) tableView: (NSTableView *)tv
+  objectValueForTableColumn: (NSTableColumn *)col
+             row: (NSInteger)row
+{
+  return @"x";
+}
+@end
+
+/* A point in the table, below its last row, inside what the clip view shows. */
+static NSPoint
+belowRows(NSTableView *tv)
+{
+  NSRect last = [tv rectOfRow: [tv numberOfRows] - 1];
+  NSRect shown = [tv visibleRect];
+  CGFloat y = [tv isFlipped] ? NSMaxY(shown) - 5.0 : NSMinY(shown) + 5.0;
+
+  return NSMakePoint(NSMidX(last), y);
+}
+
+int
+main(int argc, const char **argv)
+{
+  Source *ds;
+  NSTableView *tv;
+  NSTableColumn *col;
+  NSScrollView *sv;
+  NSWindow *w;
+
+  START_SET("NSTableView click below rows")
+
+  NS_DURING
+    [NSApplication sharedApplication];
+  NS_HANDLER
+    if ([[localException name] isEqualToString: NSInternalInconsistencyException])
+      SKIP("It looks like GNUstep backend is not yet installed")
+  NS_ENDHANDLER
+
+  NS_DURING
+    {
+      ds = AUTORELEASE([[Source alloc] init]);
+      tv = AUTORELEASE([[NSTableView alloc]
+        initWithFrame: NSMakeRect(0, 0, 180, 40)]);
+      col = AUTORELEASE([[NSTableColumn alloc] initWithIdentifier: @"c"]);
+      [col setWidth: 160.0];
+      [tv addTableColumn: col];
+      [tv setDataSource: ds];
+      [tv setRowHeight: 18.0];
+      [tv setHeaderView: nil];
+      [tv reloadData];
+
+      w = AUTORELEASE([[NSWindow alloc]
+        initWithContentRect: NSMakeRect(0, 0, 200, 240)
+                  styleMask: NSTitledWindowMask
+                    backing: NSBackingStoreBuffered
+                      defer: NO]);
+      sv = AUTORELEASE([[NSScrollView alloc]
+        initWithFrame: NSMakeRect(0, 100, 200, 140)]);
+      [sv setHasVerticalScroller: YES];
+      [sv setDocumentView: tv];
+      [[w contentView] addSubview: sv];
+
+      PASS(NSHeight([tv frame]) >= NSHeight([[sv contentView] bounds]),
+        "a table shorter than its clip view fills it");
+      [sv setFrame: NSMakeRect(0, 0, 200, 240)];
+      PASS(NSHeight([tv frame]) >= NSHeight([[sv contentView] bounds]),
+        "and still does when the scroll view grows");
+
+      [tv selectRowIndexes: [NSIndexSet indexSetWithIndex: 1]
+        byExtendingSelection: NO];
+      GSClick(w, tv, belowRows(tv));
+      PASS([tv numberOfSelectedRows] == 0 && [tv selectedRow] == -1,
+        "a click below the last row deselects every row");
+
+      [tv setAllowsEmptySelection: NO];
+      [tv selectRowIndexes: [NSIndexSet indexSetWithIndex: 1]
+        byExtendingSelection: NO];
+      GSClick(w, tv, belowRows(tv));
+      PASS([tv selectedRow] == 1 && [tv numberOfSelectedRows] == 1,
+        "without empty selection the row stays selected");
+    }
+  NS_HANDLER
+    if ([[localException name] isEqualToString: NSInternalInconsistencyException]
+      || [[localException name] isEqualToString: @"NSWindowServerCommunicationException"])
+      SKIP("No display available")
+  NS_ENDHANDLER
+
+  END_SET("NSTableView click below rows")
+
+  return 0;
+}
-- 
