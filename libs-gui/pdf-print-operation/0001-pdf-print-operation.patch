From 3e009d2abbc69fe29bf5e782f337073f3d05553a Mon Sep 17 00:00:00 2001
From: Artyom Shalkhakov <artyom.shalkhakov@gmail.com>
Date: Thu, 24 Sep 2026 12:00:00 +0500
Subject: [PATCH] Inherit NSPrintOperation's -_print in GSPDFPrintOperation

A PDF made with +[NSPrintOperation
PDFOperationWithView:insideRect:toData:printInfo:] comes out mirrored
top to bottom -- the glyphs are upside down and the first line of the
document sits at the foot of the page -- and a view that paginates
itself arrives as a single tall sheet.

GSPDFPrintOperation overrides -_print with a copy of
GSEPSPrintOperation's, which draws the operation's whole rect as one
sheet. That is right for EPS, which is single-sheet by definition, and
wrong for PDF, which is not. It never asks the view for
-knowsPageRange: or -rectForPage:, so a paginating view is drawn as one
sheet; and because it applies no transform, it never reaches the flip
that -_displayPageInRect:withInfo:knowsPageRange: applies for a flipped
view -- the cause of the upside-down output its own trailing FIXME
recorded. Locking focus still calls GSWSetViewIsFlipped(ctxt, YES), so
the backend compensates for a flip that is not in the CTM, which
mirrors the glyphs as well as the layout.

Delete the override. NSPrintOperation's own -_print needs nothing from
this subclass: -_runOperation has already made -createContext's context
current, and -_printPaginateWithInfo:knowsRange: sets
NSPrintSheetBounds itself. The inherited implementation paginates,
honours -knowsPageRange:/-rectForPage: and applies the transform, so
both the page count and the orientation come out right.

A reproduction program accompanies this patch: a flipped view that
paginates itself, printed to PDF, whose page objects are counted. It
reports one page per page of the view with the change and a single sheet
without it, on a system whose printing produces PDF page objects at
all.
---
 Source/GSPDFPrintOperation.m | 21 ---------------------
 1 file changed, 21 deletions(-)

diff --git a/Source/GSPDFPrintOperation.m b/Source/GSPDFPrintOperation.m
index df9ab2e28..e3b0003e0 100644
--- a/Source/GSPDFPrintOperation.m
+++ b/Source/GSPDFPrintOperation.m
@@ -115,27 +115,6 @@
   return _context;
 }
 
-- (void) _print
-{
-  // TODO: Copied-and-pasted from GSEPSPrintOperation. Factor out.
-
-  /* Save this for the view to look at. Seems like there should
-     be a better way to pass it to beginDocument */
-  [[[self printInfo] dictionary] setObject: [NSValue valueWithRect: _rect]
-                                 forKey: @"NSPrintSheetBounds"];
-
-  [_view beginDocument];
-  [_view beginPageInRect: _rect
-             atPlacement: NSMakePoint(0,0)];
-
-  [_view displayRectIgnoringOpacity: _rect inContext: [self context]];
-
-  [_view endPage];
-  [_view endDocument];
-
-  // FIXME: Output comes out up-side-down
-}
-
 - (BOOL)deliverResult
 {
   if (_data != nil && _path != nil)
-- 
