+/** <p>The undo manager of the field editor's typing: one of this
+    editing's own, not the window's, which keeps the window's undo free of
+    the typing as Cocoa's cells do.  It goes when editing ends.</p>
+ */
+- (NSUndoManager *) undoManagerForTextView: (NSTextView *)textView
+{
+  NSUndoManager *undo;
+
+  if (![textView isFieldEditor])
+    {
+      return nil;
+    }
+  undo = NSMapGet(editingUndoManagers, self);
+  if (undo == nil)
+    {
+      undo = [[NSUndoManager alloc] init];
+      NSMapInsert(editingUndoManagers, self, undo);
+      RELEASE(undo);
+    }
+  return undo;
+}
+
 - (void) textDidBeginEditing: (NSNotification *)aNotification
 {
   NSMutableDictionary *dict;
@@ -661,6 +689,7 @@ static NSNotificationCenter *nc;
       object: self
       userInfo: dict];
   RELEASE(dict);
+  NSMapRemove(editingUndoManagers, self);
 }
 
