diff --git a/Tests/gui/GSXib5KeyedUnarchiver/cellUndo.m b/Tests/gui/GSXib5KeyedUnarchiver/cellUndo.m
new file mode 100644
index 000000000..d98cc8950
--- /dev/null
+++ b/Tests/gui/GSXib5KeyedUnarchiver/cellUndo.m
@@ -0,0 +1,58 @@
+#import "ObjectTesting.h"
+
+#import <Foundation/NSData.h>
+#import <AppKit/NSApplication.h>
+#import <AppKit/NSTextField.h>
+#import <Additions/GNUstepGUI/GSXibKeyedUnarchiver.h>
+
+/* A xib's cell allows undo unless the xib says allowsUndo="NO". */
+int main()
+{
+  START_SET("GSXib5KeyedUnarchiver cell allowsUndo")
+
+  NS_DURING
+    {
+      [NSApplication sharedApplication];
+    }
+  NS_HANDLER
+    {
+      if ([[localException name]
+	isEqualToString: NSInternalInconsistencyException ])
+	{
+	  SKIP("It looks like GNUstep backend is not yet installed")
+	}
+    }
+  NS_ENDHANDLER
+
+  NSData		*data;
+  GSXibKeyedUnarchiver	*unarchiver;
+  NSArray		*rootObjects;
+  NSEnumerator		*enumerator;
+  NSTextField		*undoing = nil;
+  NSTextField		*notUndoing = nil;
+  id			element;
+
+  data = [NSData dataWithContentsOfFile: @"CellUndo.xib"];
+  unarchiver = [GSXibKeyedUnarchiver unarchiverForReadingWithData: data];
+  rootObjects = [unarchiver decodeObjectForKey: @"IBDocument.RootObjects"];
+
+  enumerator = [rootObjects objectEnumerator];
+  while ((element = [enumerator nextObject]) != nil)
+    {
+      if ([element isKindOfClass: [NSTextField class]])
+	{
+          if ([[element stringValue] isEqualToString: @"undoing"])
+            undoing = element;
+          else
+            notUndoing = element;
+	}
+    }
+
+  PASS(undoing != nil && notUndoing != nil, "the two text fields were found")
+  PASS([[undoing cell] allowsUndo], "a cell allows undo when the xib says nothing")
+  PASS([[notUndoing cell] allowsUndo] == NO, "and not when it says allowsUndo=\"NO\"")
+
+  END_SET("GSXib5KeyedUnarchiver cell allowsUndo")
+
+  return 0;
+}
diff --git a/Tests/gui/NSCell/allowsUndo.m b/Tests/gui/NSCell/allowsUndo.m
new file mode 100644
index 000000000..015fc1eea
--- /dev/null
+++ b/Tests/gui/NSCell/allowsUndo.m
@@ -0,0 +1,49 @@
+/* A cell allows undo unless told not to, as Cocoa's cells do, and keeps
+   what it was told through keyed archiving. */
+#include "Testing.h"
+
+#include <Foundation/NSAutoreleasePool.h>
+#include <Foundation/NSKeyedArchiver.h>
+
+#include <AppKit/NSApplication.h>
+#include <AppKit/NSButtonCell.h>
+#include <AppKit/NSCell.h>
+#include <AppKit/NSImage.h>
+#include <AppKit/NSTextFieldCell.h>
+
+static NSCell *
+roundTrip(NSCell *cell)
+{
+  return [NSKeyedUnarchiver unarchiveObjectWithData:
+    [NSKeyedArchiver archivedDataWithRootObject: cell]];
+}
+
+int
+main(int argc, const char **argv)
+{
+  NSCell *cell;
+
+  START_SET("NSCell allowsUndo")
+
+  NS_DURING
+    [NSApplication sharedApplication];
+  NS_HANDLER
+    if ([[localException name] isEqualToString: NSInternalInconsistencyException])
+      SKIP("It looks like GNUstep backend is not yet installed")
+  NS_ENDHANDLER
+
+  PASS([AUTORELEASE([[NSCell alloc] init]) allowsUndo], "a cell allows undo");
+  PASS([AUTORELEASE([[NSTextFieldCell alloc] initTextCell: @"x"]) allowsUndo],
+    "a text field cell allows undo");
+  PASS([AUTORELEASE([[NSButtonCell alloc] initImageCell: nil]) allowsUndo],
+    "an image cell allows undo");
+
+  cell = AUTORELEASE([[NSTextFieldCell alloc] initTextCell: @"x"]);
+  PASS([roundTrip(cell) allowsUndo], "a cell that allows undo still does after keyed archiving");
+  [cell setAllowsUndo: NO];
+  PASS([roundTrip(cell) allowsUndo] == NO, "a cell that does not still does not");
+
+  END_SET("NSCell allowsUndo")
+
+  return 0;
+}
diff --git a/Tests/gui/NSControl/editingUndo.m b/Tests/gui/NSControl/editingUndo.m
new file mode 100644
index 000000000..487f161d0
--- /dev/null
+++ b/Tests/gui/NSControl/editingUndo.m
@@ -0,0 +1,112 @@
+/* What is typed into a control can be undone, on an undo manager of the
+   editing's own, as with Cocoa's cells, not on the window's: the window's
+   undo manager, usually a document's, gets no typing (one that groups
+   only when told to would raise on it), Undo in the field undoes the
+   typing, and the next editing starts with nothing to undo.  A window
+   and a field editor are needed, so the set keeps the usual backend skip
+   guard. */
+#include "Testing.h"
+
+#include <Foundation/NSAutoreleasePool.h>
+#include <Foundation/NSUndoManager.h>
+
+#include <AppKit/NSApplication.h>
+#include <AppKit/NSTextField.h>
+#include <AppKit/NSTextView.h>
+#include <AppKit/NSWindow.h>
+
+@interface Owner : NSObject
+{
+@public
+  NSUndoManager *undoManager;
+}
+@end
+
+@implementation Owner
+- (NSUndoManager *) windowWillReturnUndoManager: (NSWindow *)window
+{
+  return undoManager;
+}
+@end
+
+int
+main(int argc, const char **argv)
+{
+  Owner *owner;
+  NSWindow *win;
+  NSTextField *field;
+  NSTextField *other;
+  NSTextView *editor;
+  NSUndoManager *typing;
+  BOOL raised;
+
+  START_SET("NSControl undo while editing")
+
+  NS_DURING
+    [NSApplication sharedApplication];
+  NS_HANDLER
+    if ([[localException name] isEqualToString: NSInternalInconsistencyException])
+      SKIP("It looks like GNUstep backend is not yet installed")
+  NS_ENDHANDLER
+
+  NS_DURING
+    {
+      owner = AUTORELEASE([[Owner alloc] init]);
+      owner->undoManager = AUTORELEASE([[NSUndoManager alloc] init]);
+      /* a document's, grouping only when told to */
+      [owner->undoManager setGroupsByEvent: NO];
+
+      win = AUTORELEASE([[NSWindow alloc]
+        initWithContentRect: NSMakeRect(0, 0, 200, 80)
+                  styleMask: NSTitledWindowMask
+                    backing: NSBackingStoreBuffered
+                      defer: NO]);
+      [win setDelegate: (id)owner];
+      [win makeKeyAndOrderFront: nil];
+      field = AUTORELEASE([[NSTextField alloc]
+        initWithFrame: NSMakeRect(10, 10, 180, 22)]);
+      other = AUTORELEASE([[NSTextField alloc]
+        initWithFrame: NSMakeRect(10, 40, 180, 22)]);
+      [[win contentView] addSubview: field];
+      [[win contentView] addSubview: other];
+
+      [win makeFirstResponder: field];
+      editor = (NSTextView *)[field currentEditor];
+      if (editor == nil)
+        {
+          SKIP("the text field did not get a field editor")
+        }
+      PASS([editor allowsUndo], "the window's field editor allows undo");
+      typing = [editor undoManager];
+      PASS(typing != nil && typing != owner->undoManager,
+        "the field editor undoes on a manager that is not the window's");
+
+      raised = NO;
+      NS_DURING
+        [editor insertText: @"abc"];
+      NS_HANDLER
+        raised = YES;
+      NS_ENDHANDLER
+      PASS(raised == NO, "typing does not raise on a window's manager that groups explicitly");
+      PASS_EQUAL([editor string], @"abc", "the typing is there");
+      PASS([owner->undoManager canUndo] == NO, "the window's undo manager has no typing");
+      PASS([typing canUndo], "the editing's has");
+      [typing undo];
+      PASS_EQUAL([editor string], @"", "undo in the field undoes the typing");
+
+      [editor insertText: @"abc"];
+      PASS([win makeFirstResponder: other], "the next field is edited");
+      PASS([[[other currentEditor] undoManager] canUndo] == NO,
+        "and starts with nothing to undo");
+      PASS_EQUAL([field stringValue], @"abc", "the first field keeps what was typed");
+    }
+  NS_HANDLER
+    if ([[localException name] isEqualToString: NSInternalInconsistencyException]
+      || [[localException name] isEqualToString: @"NSWindowServerCommunicationException"])
+      SKIP("No display available")
+  NS_ENDHANDLER
+
+  END_SET("NSControl undo while editing")
+
+  return 0;
+}
