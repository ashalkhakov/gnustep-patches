From 02e35ecbb7f1eb4979cdb6302d2e07b832ad5ac6 Mon Sep 17 00:00:00 2001
From: Artyom Shalkhakov <artyom.shalkhakov@gmail.com>
Date: Mon, 12 Oct 2026 17:03:16 +0500
Subject: [PATCH] NSAttributedString: substitute a font by its name, not its
 family
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

-fixFontAttributeInRange: looks for a font that has a character the
assigned font lacks.  When no preferred font has it, it asks fontconfig
for a matching descriptor and then converts the assigned font to that
descriptor's NSFontFamilyAttribute with -convertFont:toFace:.  A face
is a font name ("DejaVuSans"), not a family ("DejaVu Sans"), so the
conversion finds nothing and returns the assigned font unchanged: the
character is never substituted, and is drawn missing.

The family is also remembered as the last substitute, so every later
character it covers goes through the same failing conversion.  With a
theme that resolves an unknown font name by matching descriptors, that
is a fontconfig sort over every installed font, once for each such
character drawn.  Menus showing key equivalents as symbols (⌘, ⇧, ⌥)
in a font without them were slow to open on a desktop with many
fonts.

Use the descriptor's NSFontNameAttribute, falling back to the family
when it has none.  The test finds an installed font lacking one of a
few symbols another installed font has, and checks the symbol is given
a font that covers it.
---
 Source/NSAttributedString.m                   |  8 +-
 .../gui/NSAttributedString/fontSubstitution.m | 78 +++++++++++++++++++
 2 files changed, 84 insertions(+), 2 deletions(-)
 create mode 100644 Tests/gui/NSAttributedString/fontSubstitution.m

diff --git a/Source/NSAttributedString.m b/Source/NSAttributedString.m
index 58d460f..9c95e80 100644
--- a/Source/NSAttributedString.m
+++ b/Source/NSAttributedString.m
@@ -1608,8 +1608,12 @@ - (NSFont*)_substituteFontFor: (unichar)uchar font: (NSFont*)baseFont
       NSCharacterSet *newSet = [descriptor objectForKey: NSFontCharacterSetAttribute];
       if ([newSet characterIsMember: uchar])
         {
-          NSString *fName = [descriptor objectForKey: NSFontFamilyAttribute];
- 
+          NSString *fName = [descriptor objectForKey: NSFontNameAttribute];
+
+          if (fName == nil)
+            {
+              fName = [descriptor objectForKey: NSFontFamilyAttribute];
+            }
           ASSIGN(lastFont, fName);
           ASSIGN(lastSet, newSet);
           return [self _substituteFontWithName: fName font: baseFont];
diff --git a/Tests/gui/NSAttributedString/fontSubstitution.m b/Tests/gui/NSAttributedString/fontSubstitution.m
new file mode 100644
index 0000000..cbdb620
--- /dev/null
+++ b/Tests/gui/NSAttributedString/fontSubstitution.m
@@ -0,0 +1,78 @@
+#include "Testing.h"
+
+#include <Foundation/NSAutoreleasePool.h>
+#include <Foundation/NSSet.h>
+#include <AppKit/NSApplication.h>
+#include <AppKit/NSAttributedString.h>
+#include <AppKit/NSFont.h>
+#include <AppKit/NSFontDescriptor.h>
+#include <AppKit/NSFontManager.h>
+
+int main(int argc, char **argv)
+{
+  CREATE_AUTORELEASE_POOL(arp);
+  NSFont *font = nil;
+  NSArray *names;
+  unichar candidates[] = { 0x2318, 0x21E7, 0x2325, 0x2713 };
+  unichar missing = 0;
+  NSUInteger i;
+
+  START_SET("NSAttributedString font substitution")
+
+  NS_DURING
+    [NSApplication sharedApplication];
+  NS_HANDLER
+    if ([[localException name] isEqualToString: NSInternalInconsistencyException])
+      SKIP("It looks like GNUstep backend is not yet installed")
+  NS_ENDHANDLER
+
+  /* A font that lacks a character an installed font has. */
+  names = [[NSFontManager sharedFontManager] availableFonts];
+  for (i = 0; i < sizeof(candidates) / sizeof(candidates[0]) && missing == 0; i++)
+    {
+      NSString *chars = [NSString stringWithCharacters: &candidates[i] length: 1];
+      NSCharacterSet *set = [NSCharacterSet characterSetWithCharactersInString: chars];
+      NSFontDescriptor *fd = [NSFontDescriptor fontDescriptorWithFontAttributes:
+        [NSDictionary dictionaryWithObject: set forKey: NSFontCharacterSetAttribute]];
+      NSFontDescriptor *match = [fd matchingFontDescriptorWithMandatoryKeys:
+        [NSSet setWithObject: NSFontCharacterSetAttribute]];
+
+      NSUInteger j;
+
+      if (![[match objectForKey: NSFontCharacterSetAttribute] characterIsMember: candidates[i]])
+        continue;
+      for (j = 0; j < [names count] && j < 200 && missing == 0; j++)
+        {
+          NSFont *f = [NSFont fontWithName: [names objectAtIndex: j] size: 12];
+
+          if (f != nil && [f coveredCharacterSet] != nil
+            && ![[f coveredCharacterSet] characterIsMember: candidates[i]])
+            {
+              font = f;
+              missing = candidates[i];
+            }
+        }
+    }
+  if (missing == 0)
+    SKIP("No installed font lacks a character another one has")
+
+  {
+    NSString *text = [@"A" stringByAppendingString: [NSString stringWithCharacters: &missing length: 1]];
+    NSMutableAttributedString *s;
+    NSFont *substituted;
+
+    s = AUTORELEASE([[NSMutableAttributedString alloc] initWithString: text
+      attributes: [NSDictionary dictionaryWithObject: font forKey: NSFontAttributeName]]);
+    [s fixFontAttributeInRange: NSMakeRange(0, [s length])];
+    substituted = [s attribute: NSFontAttributeName atIndex: 1 effectiveRange: NULL];
+    PASS([[substituted coveredCharacterSet] characterIsMember: missing],
+      "a character the font lacks is given a font that has it");
+    PASS_EQUAL([s attribute: NSFontAttributeName atIndex: 0 effectiveRange: NULL], font,
+      "a character the font has keeps it");
+  }
+
+  END_SET("NSAttributedString font substitution")
+
+  DESTROY(arp);
+  return 0;
+}
-- 
