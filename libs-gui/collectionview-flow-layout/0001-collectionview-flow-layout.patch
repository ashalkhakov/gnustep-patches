diff --git a/Source/NSCollectionViewFlowLayout.m b/Source/NSCollectionViewFlowLayout.m
index c019802..640a790 100644
--- a/Source/NSCollectionViewFlowLayout.m
+++ b/Source/NSCollectionViewFlowLayout.m
@@ -82,6 +82,7 @@
 
