+++ b/Headers/AppKit/NSCollectionViewFlowLayout.h
@@ -99,6 +99,7 @@ APPKIT_EXPORT_CLASS
 @end
 
 @protocol NSCollectionViewDelegateFlowLayout <NSCollectionViewDelegate>
