diff --git a/Tests/gui/NSScrollView/nibDocumentOrigin.m b/Tests/gui/NSScrollView/nibDocumentOrigin.m
new file mode 100644
index 000000000..e686c7569
--- /dev/null
+++ b/Tests/gui/NSScrollView/nibDocumentOrigin.m
@@ -0,0 +1,95 @@
+/* A scroll view loaded from a nib shows its document view from the
+   document's frame origin, as Cocoa's does: the clip view's bounds origin is
+   the document's frame origin once loading is done, whatever the decoding
+   did to their sizes.  Checked against AppKit with DocumentOrigin.xib. */
+#import "Testing.h"
+#import <Foundation/NSArray.h>
+#import <Foundation/NSAutoreleasePool.h>
+#import <Foundation/NSURL.h>
+#import <AppKit/NSApplication.h>
+#import <AppKit/NSClipView.h>
+#import <AppKit/NSNib.h>
+#import <AppKit/NSScrollView.h>
+#import <AppKit/NSWindow.h>
+
+@interface FlippedDocument : NSView
+@end
+
+@implementation FlippedDocument
+- (BOOL) isFlipped
+{
+  return YES;
+}
+@end
+
+static NSScrollView *
+scrollViewAt(NSWindow *window, NSUInteger index)
+{
+  return [[[window contentView] subviews] objectAtIndex: index];
+}
+
+int
+main(int argc, const char **argv)
+{
+  CREATE_AUTORELEASE_POOL(arp);
+
+  START_SET("NSScrollView document origin after nib loading")
+
+  NS_DURING
+    [NSApplication sharedApplication];
+  NS_HANDLER
+    if ([[localException name] isEqualToString: NSInternalInconsistencyException])
+      SKIP("It looks like GNUstep backend is not yet installed")
+  NS_ENDHANDLER
+
+  NS_DURING
+    {
+      NSNib *nib;
+      NSArray *objects = nil;
+      NSWindow *window = nil;
+      NSEnumerator *e;
+      id o;
+      NSUInteger i;
+
+      nib = AUTORELEASE([[NSNib alloc] initWithContentsOfURL:
+        [NSURL fileURLWithPath: @"DocumentOrigin.xib"]]);
+      PASS(nib != nil, "DocumentOrigin.xib is read");
+      PASS([nib instantiateWithOwner: AUTORELEASE([NSObject new])
+                     topLevelObjects: &objects],
+        "DocumentOrigin.xib is instantiated");
+      e = [objects objectEnumerator];
+      while ((o = [e nextObject]) != nil)
+        {
+          if ([o isKindOfClass: [NSWindow class]])
+            window = o;
+        }
+      PASS(window != nil, "the window is a top-level object");
+
+      for (i = 0; i < 2; i++)
+        {
+          NSScrollView *sv = scrollViewAt(window, i);
+          NSView *doc = [sv documentView];
+          NSRect visible = [sv documentVisibleRect];
+
+          PASS(NSEqualPoints([[sv contentView] bounds].origin,
+                             [doc frame].origin),
+            "%s document: the clip view is scrolled to the document's origin",
+            [doc isFlipped] ? "flipped" : "unflipped");
+          PASS(NSEqualPoints(visible.origin, NSZeroPoint),
+            "%s document: the visible rect starts at the document's origin",
+            [doc isFlipped] ? "flipped" : "unflipped");
+        }
+    }
+  NS_HANDLER
+    if ([[localException name] isEqualToString: NSInternalInconsistencyException]
+      || [[localException name] isEqualToString: @"NSWindowServerCommunicationException"])
+      SKIP("No display available")
+    else
+      [localException raise];
+  NS_ENDHANDLER
+
+  END_SET("NSScrollView document origin after nib loading")
+
+  DESTROY(arp);
+  return 0;
+}
