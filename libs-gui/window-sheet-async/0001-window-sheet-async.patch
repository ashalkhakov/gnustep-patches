From c3c6e4413a330d093b68812ca881b15dfeaf577c Mon Sep 17 00:00:00 2001
From: Artyom Shalkhakov <artyom.shalkhakov@gmail.com>
Date: Sun, 22 Nov 2026 15:54:50 +0000
Subject: [PATCH] NSWindow: -beginSheet:completionHandler: returns at once, as
 on macOS

GNUstep ran a sheet begun with -beginSheet:completionHandler: as a modal
session, and the method returned only once the sheet had ended. On macOS
it returns at once with the sheet up: the window's -attachedSheet and
-sheets have it, its -sheetParent is the window, the handler not yet
called; -endSheet:returnCode: (or NSApp's) calls the handler with the code
while the sheet is still up and attached, then orders it out and detaches
it (checked on macOS 15). Code written for that, which goes on after
beginning a sheet (fills its fields, or begins a step that ends it), stopped
there: an application's self-test that opens a sheet and then fills it
never got past the click that opened it.

The sheet is now shown over its window, made key, and the method returns;
its handler is kept until -endSheet:returnCode:, -endSheet: or NSApp's
-endSheet: and -endSheet:returnCode: end it. While a sheet is up, its
window takes no clicks or keys: they bring the sheet forward, as a
document-modal sheet does on macOS. A second sheet begun on a window with
one up is not queued behind it as macOS queues it.

NSApp's -beginSheet:modalForWindow:modalDelegate:didEndSelector:contextInfo:
is unchanged, and so are NSAlert's sheets: -beginSheetModalForWindow:
completionHandler: now goes through it, so its buttons, which end a modal
session, still end it, and the handler is called with their code.

Tests/gui/NSWindow/sheetAPI.m now checks the sheet as macOS has it (its
checks but the click and the alert pass on macOS 15 too), that a window
with a sheet up takes no click, and that an alert's sheet still ends with
its handler told. Without the change 6 of its 14 checks fail: a
watchdog aborts each modal session the old method runs, after 4 seconds,
so that the test fails rather than hangs.

Patch done with help of AI.
---
 Source/NSAlert.m              |  19 ++-
 Source/NSApplication.m        |  12 ++
 Source/NSWindow.m             |  83 ++++++++++---
 Tests/gui/NSWindow/sheetAPI.m | 218 ++++++++++++++++++++++------------
 4 files changed, 240 insertions(+), 92 deletions(-)

diff --git a/Source/NSAlert.m b/Source/NSAlert.m
index 70f8cf9..a493846 100644
--- a/Source/NSAlert.m
+++ b/Source/NSAlert.m
@@ -2200,11 +2200,26 @@ NSRunAlertPanelRelativeToWindow(NSString *title,
     {
       [self _setupPanel];
     }
-  [sheet beginSheet: _window
-  completionHandler: handler];
+  /* As the other sheet of an alert, in a modal session its buttons end. */
+  [NSApp beginSheet: _window
+     modalForWindow: sheet
+      modalDelegate: self
+     didEndSelector: @selector(_alertDidEnd:handlerCode:handler:)
+        contextInfo: (handler != NULL) ? (void *)[(id)handler copy] : NULL];
   DESTROY(_window);
 }
 
+- (void) _alertDidEnd: (NSWindow *)sheet
+          handlerCode: (NSInteger)returnCode
+              handler: (void *)handler
+{
+  if (handler != NULL)
+    {
+      CALL_BLOCK(((GSNSWindowDidEndSheetCallbackBlock)handler), returnCode);
+      RELEASE((id)handler);
+    }
+}
+
 - (void) _alertDidEnd: (NSWindow *)sheet
            returnCode: (NSInteger)returnCode
 	  contextInfo: (void *)contextInfo
