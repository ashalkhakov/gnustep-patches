+
+  begin();
+  [window endSheet: sheet];
+  PASS(calls == 1 && code == NSModalResponseStop, "-endSheet: ends it with the stop code");
+  PASS(gone(), "and it is gone");
+
+  begin();
+  [NSApp endSheet: sheet returnCode: 7];
+  PASS(calls == 1 && code == 7, "NSApp's -endSheet:returnCode: ends a window's sheet");
+  PASS(gone(), "and it is gone");
+
+  begin();
+  [NSApp endSheet: sheet];
+  PASS(calls == 1 && code == NSModalResponseStop, "NSApp's -endSheet: ends it with the stop code");
+
+  {
+    Clicked *view = AUTORELEASE([[Clicked alloc] initWithFrame: NSMakeRect(0, 0, 400, 300)]);
+    NSEvent *click;
+
+    [window setContentView: view];
+    click = [NSEvent mouseEventWithType: NSLeftMouseDown
