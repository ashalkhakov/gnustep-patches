index 0ae4fcf..0b898d3 100644
--- a/Source/NSApplication.m
+++ b/Source/NSApplication.m
@@ -397,6 +397,8 @@ struct _NSModalSession {
 
 @interface NSWindow (ApplicationPrivate)
