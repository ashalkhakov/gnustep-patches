+                          modifierFlags: 0
+                              timestamp: 0
+                           windowNumber: [window windowNumber]
+                                context: nil
+                            eventNumber: 0
+                             clickCount: 1
+                               pressure: 1.0];
+    begin();
+    [window sendEvent: click];
+    PASS(!view->clicked, "while a sheet is up, its window takes no click");
+    [window endSheet: sheet];
+    [window sendEvent: click];
+    PASS(view->clicked, "once it is gone, it does");
+  }
 
-  runSheet(1);
-  PASS(code == NSModalResponseStop, "-endSheet: ends it with the stop code");
+  {
+    NSAlert *alert = AUTORELEASE([[NSAlert alloc] init]);
+    __block NSModalResponse answered = 0;
 
-  runSheet(2);
-  PASS(code == 7, "NSApp's -endSheet:returnCode: ends a window's sheet");
+    [alert setMessageText: @"Sure?"];
+    [alert addButtonWithTitle: @"Yes"];
+    [alert addButtonWithTitle: @"No"];
+    [[NSRunLoop currentRunLoop] addTimer:
+      [NSTimer timerWithTimeInterval: 0.2
+                              target: AUTORELEASE([AlertEnder new])
+                            selector: @selector(end:)
+                            userInfo: nil
