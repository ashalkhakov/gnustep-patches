From f0eefa976e9448d9774355dd82394847227fda06 Mon Sep 17 00:00:00 2001
From: Artyom Shalkhakov <artyom.shalkhakov@gmail.com>
Date: Sat, 17 Oct 2026 08:58:01 +0000
Subject: [PATCH] NSTableView: make each view from a prototype whole, not by
 -copy

-makeViewWithIdentifier:owner: and the view a column falls back on made
a view from its registered prototype with -copy, which for a view is
shallow: the new view has none of the prototype's subviews, and its
outlets still point into the prototype.  Every row of a view-based
table therefore showed nothing, and text set through a cell view's
textField went to the prototype's field, which no row shows.  The copy
was also never released.

Make each view the way AppKit does, as a new instance of the prototype:
archive it and unarchive the result, which brings its subviews along
and connects its outlets to them, and give it the prototype's
identifier, which -[NSView encodeWithCoder:] does not keep.

The objects outside the prototype that its controls send their actions
to (in a xib, the File's Owner) stay as they are: a keyed archive
encodes a cell's target outright, so archiving one would make each new
view's target a fresh copy of the owner, which nothing retains, and a
row's controls would message a freed object.  While a view is made,
each such target is archived as a stand-in that the unarchiver's
delegate swaps back for the target itself.

Tests/gui/NSTableView/makeViewWithIdentifier.m registers a cell view
with a text field, whose target is an object outside it, as a column's
prototype and makes two views from it.  Without the change five of its
seven checks fail (no identifier, no subviews, the prototype's text
field); with only the archiving, the target check fails; with both
they pass.
---
 Source/NSTableView.m                          | 128 +++++++++++++++++-
 .../gui/NSTableView/makeViewWithIdentifier.m  |  73 ++++++++++
 2 files changed, 198 insertions(+), 3 deletions(-)
 create mode 100644 Tests/gui/NSTableView/makeViewWithIdentifier.m

diff --git a/Source/NSTableView.m b/Source/NSTableView.m
index f1c47dfde..d0ffc8820 100644
--- a/Source/NSTableView.m
+++ b/Source/NSTableView.m
@@ -51,6 +51,7 @@
 #import "AppKit/NSCell.h"
 #import "AppKit/NSClipView.h"
 #import "AppKit/NSColor.h"
+#import "AppKit/NSControl.h"
 #import "AppKit/NSEvent.h"
 #import "AppKit/NSImage.h"
 #import "AppKit/NSGraphics.h"
@@ -2026,6 +2027,128 @@ static void computeNewSelection
 @end
 
 
+/* Stands in, in a prototype's archive, for an object outside it. */
+@interface GSPrototypeOutsideObject : NSObject <NSCoding>
+{
+@public
+  NSUInteger	index;
+}
+@end
+
+@implementation GSPrototypeOutsideObject
+- (void) encodeWithCoder: (NSCoder *)aCoder
+{
+  [aCoder encodeInteger: index forKey: @"GSIndex"];
+}
+
+- (id) initWithCoder: (NSCoder *)aDecoder
+{
+  index = [aDecoder decodeIntegerForKey: @"GSIndex"];
+  return self;
+}
+@end
+
+@interface GSPrototypeCopier : NSObject
+{
+@public
+  NSMutableArray	*outside;
+}
+@end
+
+@implementation GSPrototypeCopier
+- (id) init
+{
+  if ((self = [super init]) != nil)
+    {
+      outside = [NSMutableArray new];
+    }
+  return self;
+}
+
+- (void) dealloc
+{
+  RELEASE(outside);
+  [super dealloc];
+}
+
+- (void) addOutsideObjectsOf: (NSView *)view in: (NSView *)prototype
+{
+  NSEnumerator	*en = [[view subviews] objectEnumerator];
+  NSView	*subview;
+
+  if ([view isKindOfClass: [NSControl class]])
+    {
+      id	target = [(NSControl *)view target];
+
+      if (target != nil
+	&& !([target isKindOfClass: [NSView class]]
+	  && [target isDescendantOf: prototype])
+	&& [outside indexOfObjectIdenticalTo: target] == NSNotFound)
+	{
+	  [outside addObject: target];
+	}
+    }
+  while ((subview = [en nextObject]) != nil)
+    {
+      [self addOutsideObjectsOf: subview in: prototype];
+    }
+}
+
+- (id) archiver: (NSKeyedArchiver *)archiver willEncodeObject: (id)object
+{
+  NSUInteger			i = [outside indexOfObjectIdenticalTo: object];
+  GSPrototypeOutsideObject	*stand;
+
+  if (i == NSNotFound)
+    {
+      return object;
+    }
+  stand = AUTORELEASE([GSPrototypeOutsideObject new]);
+  stand->index = i;
+  return stand;
+}
+
+- (id) unarchiver: (NSKeyedUnarchiver *)unarchiver
+  didDecodeObject: (id)object
+{
+  if ([object isKindOfClass: [GSPrototypeOutsideObject class]])
+    {
+      return [outside objectAtIndex:
+	((GSPrototypeOutsideObject *)object)->index];
+    }
+  return object;
+}
+@end
+
+/* A new view made from a prototype, with its subviews and the outlets
+ * among them, which -copy does not make; its controls' targets outside
+ * it are the prototype's own.
+ */
+static NSView *
+viewFromPrototype(NSView *prototype)
+{
+  GSPrototypeCopier	*copier = AUTORELEASE([GSPrototypeCopier new]);
+  NSMutableData		*data = [NSMutableData data];
+  NSKeyedArchiver	*archiver;
+  NSKeyedUnarchiver	*unarchiver;
+  NSView		*view;
+
+  [copier addOutsideObjectsOf: prototype in: prototype];
+  archiver = AUTORELEASE([[NSKeyedArchiver alloc]
+    initForWritingWithMutableData: data]);
+  [archiver setDelegate: copier];
+  [archiver encodeObject: prototype forKey: @"root"];
+  [archiver finishEncoding];
+  unarchiver = AUTORELEASE([[NSKeyedUnarchiver alloc]
+    initForReadingWithData: data]);
+  [unarchiver setDelegate: copier];
+  view = [unarchiver decodeObjectForKey: @"root"];
+  [unarchiver finishDecoding];
+
+  [view setIdentifier: [prototype identifier]];
+  return view;
+}
+
 @implementation NSTableView
 
 + (void) initialize
@@ -7301,7 +7424,7 @@ For a more detailed explanation, -setSortDescriptors:. */
 
   if (view != nil)
     {
-      view = [view copy];
+      view = viewFromPrototype(view);
       [view awakeFromNib];
       [owner awakeFromNib];
     }
@@ -7346,8 +7469,7 @@ For a more detailed explanation, -setSortDescriptors:. */
   // it seems there is always one prototype...
   if ([protoCellViews count] > 0)
     {
-      view = [protoCellViews objectAtIndex: 0];
-      view = [view copy]; // instantiate the prototype...
+      view = viewFromPrototype([protoCellViews objectAtIndex: 0]);
     }
 
   return view;
diff --git a/Tests/gui/NSTableView/makeViewWithIdentifier.m b/Tests/gui/NSTableView/makeViewWithIdentifier.m
new file mode 100644
index 000000000..46ff1f8e3
--- /dev/null
+++ b/Tests/gui/NSTableView/makeViewWithIdentifier.m
@@ -0,0 +1,73 @@
+/* -makeViewWithIdentifier:owner: makes each view from a registered
+   prototype as a whole new view, subviews and outlets included: the text
+   field a row's cell view shows is its own, not the prototype's, and
+   its target is the prototype's, not a copy.  The prototype is
+   registered through its column in code, as one from a xib is. */
+#import "Testing.h"
+#import <Foundation/Foundation.h>
+#import <AppKit/AppKit.h>
+
+int main()
+{
+  START_SET("NSTableView makeViewWithIdentifier:owner:")
+
+  NS_DURING
+    [NSApplication sharedApplication];
+  NS_HANDLER
+    if ([[localException name]
+      isEqualToString: NSInternalInconsistencyException])
+      SKIP("It looks like GNUstep backend is not yet installed")
+  NS_ENDHANDLER
+
+  NSTableView           *table;
+  NSTableColumn         *column;
+  NSTableCellView       *prototype;
+  NSTextField           *field;
+  NSTableCellView       *first;
+  NSTableCellView       *second;
+  NSResponder           *owner;
+
+  prototype = AUTORELEASE([[NSTableCellView alloc]
+    initWithFrame: NSMakeRect(0, 0, 100, 17)]);
+  [prototype setIdentifier: @"Cell"];
+  field = AUTORELEASE([[NSTextField alloc]
+    initWithFrame: NSMakeRect(0, 0, 100, 17)]);
+  [prototype addSubview: field];
+  [prototype setTextField: field];
+  owner = AUTORELEASE([NSResponder new]);
+  [field setTarget: owner];
+  [field setAction: @selector(description)];
+
+  column = AUTORELEASE([[NSTableColumn alloc] initWithIdentifier: @"Column"]);
+  [column setValue: [NSArray arrayWithObject: prototype]
+            forKey: @"prototypeCellViews"];
+  table = AUTORELEASE([[NSTableView alloc]
+    initWithFrame: NSMakeRect(0, 0, 100, 100)]);
+  [table addTableColumn: column];
+
+  first = (NSTableCellView *)[table makeViewWithIdentifier: @"Cell"
+                                                     owner: nil];
+  second = (NSTableCellView *)[table makeViewWithIdentifier: @"Cell"
+                                                      owner: nil];
+
+  PASS(first != nil && first != prototype,
+    "a view is made from the prototype")
+  PASS_EQUAL([first identifier], @"Cell", "with the prototype's identifier")
+  PASS([[first subviews] count] == 1, "with the prototype's subviews")
+  PASS([first textField] != nil && [first textField] != field
+    && [[first subviews] containsObject: [first textField]],
+    "and its outlets connected to its own subviews")
+  PASS([first textField] != [second textField],
+    "each view made has a text field of its own")
+
+  PASS([[first textField] target] == owner
+    && sel_isEqual([[first textField] action], @selector(description)),
+    "and its controls' targets are the prototype's own, not copies")
+
+  [[first textField] setStringValue: @"first"];
+  PASS_EQUAL([field stringValue], @"",
+    "and setting it leaves the prototype alone")
+
+  END_SET("NSTableView makeViewWithIdentifier:owner:")
+  return 0;
+}
-- 
