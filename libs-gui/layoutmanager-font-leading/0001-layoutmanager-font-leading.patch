diff --git a/Tests/gui/NSLayoutManager/fontLeading.m b/Tests/gui/NSLayoutManager/fontLeading.m
new file mode 100644
index 000000000..11962034a
--- /dev/null
+++ b/Tests/gui/NSLayoutManager/fontLeading.m
@@ -0,0 +1,186 @@
+/* Line heights as macOS lays them out (TextKit 1, NSLayoutManager on macOS
+ * 15), with whatever fonts are installed:
+ *
+ * - a line is the font's ascender and descender, each rounded to a whole
+ *   point, and its baseline is the rounded ascender below its top;
+ * - the font's leading goes below that when -usesFontLeading is YES, the
+ *   default, and not when it is NO;
+ * - -defaultLineHeightForFont: is the same sum, with the leading rounded;
+ * - lineHeightMultiple scales the rounded height and puts the extra above
+ *   the baseline;
+ * - lineSpacing replaces the leading when it is larger, except under the
+ *   last line;
+ * - string drawing adds the leading only with
+ *   NSStringDrawingUsesFontLeading.
+ *
+ * For Arial at 10 points (ascender 9.05, descender 2.12, leading 0.33)
+ * that is lines of 11.33, or 11 without the leading, and a baseline at 9.
+ */
+#import "Testing.h"
+#import <Foundation/Foundation.h>
+#import <AppKit/AppKit.h>
+#include <math.h>
+
+@interface NSLayoutManager (FontLeading)
+- (BOOL) usesFontLeading;
+- (void) setUsesFontLeading: (BOOL)flag;
+@end
+
+#define CLOSE(a, b) (fabs((double)(a) - (double)(b)) < 0.001)
+
+static NSLayoutManager *
+laidOut(NSString *text, NSFont *font, NSParagraphStyle *style, BOOL leading,
+  CGFloat width)
+{
+  NSMutableDictionary *attrs = [NSMutableDictionary dictionary];
+  NSTextStorage *storage;
+  NSLayoutManager *lm = AUTORELEASE([[NSLayoutManager alloc] init]);
+  NSTextContainer *tc;
+
+  [attrs setObject: font forKey: NSFontAttributeName];
+  if (style != nil)
+    [attrs setObject: style forKey: NSParagraphStyleAttributeName];
+  storage = AUTORELEASE([[NSTextStorage alloc] initWithString: text
+                                                   attributes: attrs]);
+  if ([lm respondsToSelector: @selector(setUsesFontLeading:)])
+    [lm setUsesFontLeading: leading];
+  tc = AUTORELEASE([[NSTextContainer alloc]
+    initWithContainerSize: NSMakeSize(width, 1e6)]);
+  [tc setLineFragmentPadding: 0];
+  [lm addTextContainer: tc];
+  [storage addLayoutManager: lm];
+  [lm glyphRangeForTextContainer: tc];
+  return lm;
+}
+
+static NSRect
+lineRect(NSLayoutManager *lm, NSUInteger line)
+{
+  NSUInteger glyph = 0;
+  NSUInteger count = [lm numberOfGlyphs];
+  NSRange range;
+  NSRect rect = NSZeroRect;
+
+  while (glyph < count)
+    {
+      rect = [lm lineFragmentRectForGlyphAtIndex: glyph effectiveRange: &range];
+      if (line-- == 0)
+        break;
+      glyph = NSMaxRange(range);
+    }
+  return rect;
+}
+
+static void
+check(NSFont *f)
+{
+  NSString *name = [NSString stringWithFormat: @"%@ %g", [f fontName],
+    [f pointSize]];
+  CGFloat asc = floor([f ascender] + 0.5);
+  CGFloat desc = floor(-[f descender] + 0.5);
+  CGFloat lead = [f leading];
+  NSLayoutManager *lm;
+  NSMutableParagraphStyle *ps;
+  NSString *three = @"one\ntwo\nthree";
+  NSDictionary *attrs;
+  NSRect r;
+
+  PASS(lead >= 0, "%s: the leading is not negative", [name UTF8String]);
+
+  lm = AUTORELEASE([[NSLayoutManager alloc] init]);
+  PASS([lm respondsToSelector: @selector(usesFontLeading)]
+    && [lm usesFontLeading], "a layout manager uses the font leading at first");
+  PASS(CLOSE([lm defaultLineHeightForFont: f], asc + desc + floor(lead + 0.5)),
+    "%s: the default line height is rounded, with the leading",
+    [name UTF8String]);
+  if ([lm respondsToSelector: @selector(setUsesFontLeading:)])
+    [lm setUsesFontLeading: NO];
+  PASS(CLOSE([lm defaultLineHeightForFont: f], asc + desc),
+    "%s: the default line height is rounded, without the leading",
+    [name UTF8String]);
+
+  lm = laidOut(three, f, nil, YES, 1000);
+  PASS(CLOSE(NSHeight(lineRect(lm, 0)), asc + desc + lead)
+    && CLOSE(NSMinY(lineRect(lm, 2)), 2 * (asc + desc + lead)),
+    "%s: a line is the rounded ascender and descender and the leading",
+    [name UTF8String]);
+  PASS(CLOSE([lm locationForGlyphAtIndex: 0].y, asc),
+    "%s: the baseline is the rounded ascender below the top", [name UTF8String]);
+
+  lm = laidOut(three, f, nil, NO, 1000);
+  PASS(CLOSE(NSHeight(lineRect(lm, 0)), asc + desc)
+    && CLOSE(NSHeight([lm usedRectForTextContainer:
+      [[lm textContainers] objectAtIndex: 0]]), 3 * (asc + desc)),
+    "%s: without the leading a line is the rounded ascender and descender",
+    [name UTF8String]);
+
+  ps = AUTORELEASE([[NSMutableParagraphStyle alloc] init]);
+  [ps setLineHeightMultiple: 1.5];
+  lm = laidOut(three, f, ps, NO, 1000);
+  PASS(CLOSE(NSHeight(lineRect(lm, 0)), 1.5 * (asc + desc))
+    && CLOSE([lm locationForGlyphAtIndex: 0].y, asc + 0.5 * (asc + desc)),
+    "%s: a line height multiple scales the line, the extra above the baseline",
+    [name UTF8String]);
+
+  ps = AUTORELEASE([[NSMutableParagraphStyle alloc] init]);
+  [ps setLineSpacing: lead + 2];
+  lm = laidOut(three, f, ps, YES, 1000);
+  PASS(CLOSE(NSHeight(lineRect(lm, 0)), asc + desc + lead + 2)
+    && CLOSE(NSHeight(lineRect(lm, 2)), asc + desc + lead),
+    "%s: line spacing larger than the leading replaces it, but not under the last line",
+    [name UTF8String]);
+
+  attrs = [NSDictionary dictionaryWithObject: f forKey: NSFontAttributeName];
+  r = [@"one\ntwo" boundingRectWithSize: NSMakeSize(1000, 1000)
+                                options: NSStringDrawingUsesLineFragmentOrigin
+                             attributes: attrs];
+  PASS(CLOSE(NSHeight(r), 2 * (asc + desc)),
+    "%s: string drawing leaves the leading out", [name UTF8String]);
+  r = [@"one\ntwo" boundingRectWithSize: NSMakeSize(1000, 1000)
+                                options: NSStringDrawingUsesLineFragmentOrigin
+                                         | NSStringDrawingUsesFontLeading
+                             attributes: attrs];
+  PASS(CLOSE(NSHeight(r), 2 * (asc + desc + lead)),
+    "%s: string drawing adds the leading when asked", [name UTF8String]);
+}
+
+int
+main(int argc, char **argv)
+{
+  CREATE_AUTORELEASE_POOL(arp);
+  START_SET("font leading and line heights")
+
+  NSEnumerator *e;
+  NSString *name;
+
+  NS_DURING
+    {
+      [NSApplication sharedApplication];
+    }
+  NS_HANDLER
+    {
+      if ([[localException name]
+        isEqualToString: NSInternalInconsistencyException])
+        SKIP("It looks like GNUstep backend is not yet installed")
+    }
+  NS_ENDHANDLER
+
+    {
+      check([NSFont userFontOfSize: 10]);
+      check([NSFont userFontOfSize: 13]);
+      /* Fonts with a leading of their own, where installed. */
+      e = [[NSArray arrayWithObjects: @"ArialMT", @"LiberationSans",
+        @"TimesNewRomanPSMT", @"LiberationSerif", nil] objectEnumerator];
+      while ((name = [e nextObject]) != nil)
+        {
+          NSFont *f = [NSFont fontWithName: name size: 12];
+
+          if (f != nil)
+            check(f);
+        }
+    }
+
+  END_SET("font leading and line heights")
+  DESTROY(arp);
+  return 0;
+}
