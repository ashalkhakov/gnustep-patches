+@implementation NSObject (NSPlaceholder)
+
++ (id) defaultPlaceholderForMarker: (id)marker
+                       withBinding: (NSString *)binding
+{
+  Class c;
+  id placeholder = nil;
+
+  [GSKeyValueBinding class];
+  [bindingLock lock];
+  for (c = self; c != Nil && placeholder == nil; c = [c superclass])
+    {
+      placeholder = [[[placeholders objectForKey: NSStringFromClass(c)]
+        objectForKey: binding] objectForKey: marker];
+    }
+  RETAIN(placeholder);
+  [bindingLock unlock];
+  return AUTORELEASE(placeholder);
+}
+
++ (void) setDefaultPlaceholder: (id)placeholder
+                     forMarker: (id)marker
+                   withBinding: (NSString *)binding
+{
+  NSString *key = NSStringFromClass(self);
+  NSMutableDictionary *forClass;
+  NSMutableDictionary *forBinding;
+
+  [GSKeyValueBinding class];
+  [bindingLock lock];
+  forClass = [placeholders objectForKey: key];
+  if (forClass == nil)
+    {
+      forClass = [NSMutableDictionary dictionary];
+      [placeholders setObject: forClass forKey: key];
+    }
+  forBinding = [forClass objectForKey: binding];
+  if (forBinding == nil)
+    {
+      forBinding = [NSMutableDictionary dictionary];
+      [forClass setObject: forBinding forKey: binding];
+    }
+  if (placeholder == nil)
+    {
+      [forBinding removeObjectForKey: marker];
+    }
+  else
+    {
+      [forBinding setObject: placeholder forKey: marker];
+    }
+  [bindingLock unlock];
+}
+
+@end
+
