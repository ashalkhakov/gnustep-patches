+
+/* An observation of the selection through -selection, for the objects
+   that were selected when it was made. */
+@interface GSSelectionObservation : NSObject
+{
+@public
+  NSObject *observer;
+  NSString *keyPath;
+  void *context;
+  NSArray *objects;
+}
+@end
+
+@implementation GSSelectionObservation
+- (void) dealloc
+{
+  RELEASE(keyPath);
+  RELEASE(objects);
+  [super dealloc];
+}
+@end
+
+static NSMapTable *proxies = NULL;
+
+@implementation GSControllerSelectionProxy
+
++ (id) proxyForController: (NSObjectController *)controller
+{
+  GSControllerSelectionProxy *proxy;
+
+  if (proxies == NULL)
+    {
+      proxies = NSCreateMapTable(NSNonOwnedPointerMapKeyCallBacks,
+	NSObjectMapValueCallBacks, 0);
+    }
+  proxy = NSMapGet(proxies, controller);
+  if (proxy == nil)
+    {
+      proxy = [[self alloc] initWithController: controller];
+      NSMapInsert(proxies, controller, proxy);
+      RELEASE(proxy);
+    }
+  return proxy;
+}
+
++ (void) forgetController: (NSObjectController *)controller
+{
+  if (proxies != NULL)
+    {
+      NSMapRemove(proxies, controller);
+    }
+}
+
+- (id) initWithController: (NSObjectController *)controller
+{
+  if ((self = [super init]) != nil)
+    {
+      _controller = controller;
+      _observations = [[NSMutableArray alloc] init];
+    }
+  return self;
+}
+
+- (void) dealloc
+{
+  RELEASE(_observations);
+  [super dealloc];
+}
+
+- (id) _valueForKeyPath: (NSString *)keyPath
+{
+  NSArray *objects = [_controller selectedObjects];
+  NSUInteger count = [objects count];
+  NSUInteger i;
+  id value = nil;
+
+  if (count == 0)
+    {
+      return NSNoSelectionMarker;
+    }
+  if (count > 1 && [_controller isKindOfClass: [NSArrayController class]]
+    && [(NSArrayController *)_controller alwaysUsesMultipleValuesMarker])
+    {
+      return NSMultipleValuesMarker;
+    }
+  NS_DURING
+    {
+      value = [[objects objectAtIndex: 0] valueForKeyPath: keyPath];
+      for (i = 1; i < count && value != NSMultipleValuesMarker; i++)
+	{
+	  id other = [[objects objectAtIndex: i] valueForKeyPath: keyPath];
+
+	  if (other != value && [other isEqual: value] == NO)
+	    {
+	      value = NSMultipleValuesMarker;
+	    }
+	}
+    }
+  NS_HANDLER
+    {
+      if ([[localException name] isEqualToString: NSUndefinedKeyException])
+	{
+	  value = NSNotApplicableMarker;
+	}
+      else
+	{
+	  [localException raise];
+	}
+    }
+  NS_ENDHANDLER
+  return value;
+}
+
+- (id) valueForKey: (NSString *)key
+{
+  return [self _valueForKeyPath: key];
+}
+
+- (id) valueForKeyPath: (NSString *)keyPath
+{
+  return [self _valueForKeyPath: keyPath];
+}
+
+- (void) setValue: (id)value forKey: (NSString *)key
+{
+  [self setValue: value forKeyPath: key];
+}
+
+- (void) setValue: (id)value forKeyPath: (NSString *)keyPath
+{
+  NSEnumerator *e = [[_controller selectedObjects] objectEnumerator];
+  id object;
+
+  while ((object = [e nextObject]) != nil)
+    {
+      [object setValue: value forKeyPath: keyPath];
+    }
+}
+
+- (void) addObserver: (NSObject *)observer
+	  forKeyPath: (NSString *)keyPath
+	     options: (NSKeyValueObservingOptions)options
+	     context: (void *)context
+{
+  GSSelectionObservation *observation = [GSSelectionObservation new];
+  NSEnumerator *e;
+  id object;
+
+  observation->observer = observer;
+  observation->keyPath = [keyPath copy];
+  observation->context = context;
+  observation->objects = RETAIN([_controller selectedObjects]);
+  [_observations addObject: observation];
+  RELEASE(observation);
+  e = [observation->objects objectEnumerator];
+  while ((object = [e nextObject]) != nil)
+    {
+      [object addObserver: self
+	       forKeyPath: keyPath
+		  options: 0
+		  context: observation];
+    }
+}
+
+- (void) removeObserver: (NSObject *)observer
+	     forKeyPath: (NSString *)keyPath
+{
+  NSUInteger i = [_observations count];
+
+  while (i-- > 0)
+    {
+      GSSelectionObservation *observation = [_observations objectAtIndex: i];
+
+      if (observation->observer == observer
+	&& [observation->keyPath isEqualToString: keyPath])
+	{
+	  NSEnumerator *e = [observation->objects objectEnumerator];
+	  id object;
+
+	  while ((object = [e nextObject]) != nil)
+	    {
+	      [object removeObserver: self forKeyPath: keyPath];
+	    }
+	  [_observations removeObjectAtIndex: i];
+	  return;
+	}
+    }
+}
+
+- (void) observeValueForKeyPath: (NSString *)keyPath
+		       ofObject: (id)object
+			 change: (NSDictionary *)change
+			context: (void *)context
+{
+  GSSelectionObservation *observation = context;
+  NSDictionary *setting;
+
+  if ([_observations indexOfObjectIdenticalTo: observation] == NSNotFound)
+    {
+      return;
+    }
+  setting = [NSDictionary dictionaryWithObject:
+    [NSNumber numberWithInt: NSKeyValueChangeSetting]
+					forKey: NSKeyValueChangeKindKey];
+  [observation->observer observeValueForKeyPath: observation->keyPath
+				       ofObject: self
+					 change: setting
+					context: observation->context];
+}
+
+@end
+
