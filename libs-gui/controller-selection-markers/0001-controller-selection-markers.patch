diff --git a/Tests/gui/NSObjectController/selectionMarkers.m b/Tests/gui/NSObjectController/selectionMarkers.m
new file mode 100644
index 000000000..bb2c47ff7
--- /dev/null
+++ b/Tests/gui/NSObjectController/selectionMarkers.m
@@ -0,0 +1,134 @@
+/* A controller's selection answers for the selected objects as AppKit's
+   does: the marker for no selection when nothing is selected, the
+   selected objects' value when they agree on it, the marker for multiple
+   values when they do not (or always, with alwaysUsesMultipleValuesMarker),
+   and the marker for not applicable when the key is not theirs.  Observers
+   of selection.<key> hear when that value changes, whether the selection
+   changes or a selected object does. */
+#include "Testing.h"
+
+#include <Foundation/NSArray.h>
+#include <Foundation/NSAutoreleasePool.h>
+#include <Foundation/NSDictionary.h>
+#include <Foundation/NSIndexSet.h>
+#include <Foundation/NSKeyValueObserving.h>
+#include <Foundation/NSString.h>
+
+#include <AppKit/NSApplication.h>
+#include <AppKit/NSArrayController.h>
+#include <AppKit/NSKeyValueBinding.h>
+#include <AppKit/NSObjectController.h>
+
+@interface SelectionReader : NSObject
+{
+@public
+  int	count;
+  id	last;
+}
+@end
+
+@implementation SelectionReader
+- (void) observeValueForKeyPath: (NSString *)keyPath
+                       ofObject: (id)object
+                         change: (NSDictionary *)change
+                        context: (void *)context
+{
+  count++;
+  last = [object valueForKeyPath: keyPath];
+}
+@end
+
+static NSMutableDictionary *
+person(NSString *name, NSString *city)
+{
+  return [NSMutableDictionary dictionaryWithObjectsAndKeys:
+    name, @"name", city, @"city", nil];
+}
+
+int
+main(int argc, const char **argv)
+{
+  SelectionReader	*reader;
+  NSArrayController	*ac;
+  NSObjectController	*oc;
+  NSMutableDictionary	*ada;
+  NSMutableDictionary	*bob;
+  NSIndexSet		*both;
+  int			before;
+
+  START_SET("NSObjectController selection markers")
+
+  NS_DURING
+    [NSApplication sharedApplication];
+  NS_HANDLER
+    if ([[localException name] isEqualToString: NSInternalInconsistencyException])
+      SKIP("It looks like GNUstep backend is not yet installed")
+  NS_ENDHANDLER
+
+  ada = person(@"Ada", @"London");
+  bob = person(@"Bob", @"London");
+  both = [NSIndexSet indexSetWithIndexesInRange: NSMakeRange(0, 2)];
+  ac = AUTORELEASE([[NSArrayController alloc] init]);
+  [ac setContent: [NSMutableArray arrayWithObjects: ada, bob, nil]];
+  reader = AUTORELEASE([[SelectionReader alloc] init]);
+  [ac addObserver: reader forKeyPath: @"selection.name"
+	  options: NSKeyValueObservingOptionNew context: NULL];
+
+  [ac setSelectionIndexes: [NSIndexSet indexSet]];
+  PASS([ac selection] != nil, "-selection answers something with no selection")
+  PASS([ac valueForKeyPath: @"selection.name"] == NSNoSelectionMarker,
+    "nothing selected answers the no-selection marker")
+  PASS(reader->last == NSNoSelectionMarker,
+    "observers hear that nothing is selected")
+
+  [ac setSelectionIndexes: [NSIndexSet indexSetWithIndex: 0]];
+  PASS_EQUAL([ac valueForKeyPath: @"selection.name"], @"Ada",
+    "one object selected answers its value")
+  PASS_EQUAL(reader->last, @"Ada", "observers hear the selected value")
+  before = reader->count;
+  [ada setObject: @"Ada L" forKey: @"name"];
+  PASS(reader->count == before + 1,
+    "observers hear when the selected object's value changes")
+  PASS_EQUAL(reader->last, @"Ada L", "and read its new value")
+  [bob setObject: @"Bobby" forKey: @"name"];
+  PASS(reader->count == before + 1,
+    "observers do not hear of objects that are not selected")
+
+  [ac setSelectionIndexes: both];
+  PASS([ac valueForKeyPath: @"selection.name"] == NSMultipleValuesMarker,
+    "objects with different values answer the multiple-values marker")
+  PASS(reader->last == NSMultipleValuesMarker,
+    "observers hear of multiple values")
+  PASS_EQUAL([ac valueForKeyPath: @"selection.city"], @"London",
+    "objects agreeing on a value answer it")
+  [ac setAlwaysUsesMultipleValuesMarker: YES];
+  PASS([ac valueForKeyPath: @"selection.city"] == NSMultipleValuesMarker,
+    "alwaysUsesMultipleValuesMarker answers the marker for any selection of several")
+  [ac setAlwaysUsesMultipleValuesMarker: NO];
+  [[ac selection] setValue: @"Paris" forKey: @"city"];
+  PASS([[ada objectForKey: @"city"] isEqual: @"Paris"]
+    && [[bob objectForKey: @"city"] isEqual: @"Paris"],
+    "a value set through the selection is set on every selected object")
+  before = reader->count;
+  [bob setObject: @"Ada L" forKey: @"name"];
+  PASS(reader->count == before + 1 && [reader->last isEqual: @"Ada L"],
+    "observers hear when the selected objects come to agree")
+  [ac removeObserver: reader forKeyPath: @"selection.name"];
+
+  ac = AUTORELEASE([[NSArrayController alloc] init]);
+  [ac setContent: [NSMutableArray arrayWithObjects: @"one", @"two", nil]];
+  [ac setSelectionIndexes: [NSIndexSet indexSetWithIndex: 0]];
+  PASS([ac valueForKeyPath: @"selection.city"] == NSNotApplicableMarker,
+    "a key the selected objects do not have answers the not-applicable marker")
+
+  oc = AUTORELEASE([[NSObjectController alloc] initWithContent: ada]);
+  PASS_EQUAL([oc valueForKeyPath: @"selection.name"], @"Ada L",
+    "an object controller's selection answers for its content")
+  [oc setContent: nil];
+  PASS([oc valueForKeyPath: @"selection.name"] == NSNoSelectionMarker,
+    "an object controller without content answers the no-selection marker")
+
+  END_SET("NSObjectController selection markers")
+
+  return 0;
+}
