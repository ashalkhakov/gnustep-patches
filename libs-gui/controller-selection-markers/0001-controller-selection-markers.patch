@@ -0,0 +1,212 @@
+/* A marker read through a controller's selection reaches a binding as the
+   placeholder for it: the binding's option when it has one, otherwise the
+   default placeholder of the bound object's class for that binding, which
+   is nil but for a text field's value.  So content bound through
+   selection.<key> is empty with no selection or multiple values, as on
+   AppKit, rather than the marker. */
+#include "Testing.h"
+
+#include <Foundation/NSArray.h>
+#include <Foundation/NSAutoreleasePool.h>
+#include <Foundation/NSDictionary.h>
+#include <Foundation/NSException.h>
+#include <Foundation/NSIndexSet.h>
+#include <Foundation/NSSet.h>
+#include <Foundation/NSString.h>
+
+#include <AppKit/NSApplication.h>
+#include <AppKit/NSArrayController.h>
+#include <AppKit/NSKeyValueBinding.h>
+#include <AppKit/NSObjectController.h>
+#include <AppKit/NSPopUpButton.h>
+#include <AppKit/NSTableColumn.h>
+#include <AppKit/NSTableView.h>
+#include <AppKit/NSTextField.h>
+#include <AppKit/NSTextFieldCell.h>
+
+@interface DefaultingController : NSArrayController
+@end
+
+@implementation DefaultingController
+@end
+
+static NSMutableDictionary *
+vehicle(NSString *name, NSArray *records)
+{
+  return [NSMutableDictionary dictionaryWithObjectsAndKeys:
+    name, @"name",
+    [NSMutableSet setWithArray: records], @"records",
+    [NSMutableArray arrayWithArray: records], @"list",
+    [NSMutableDictionary dictionaryWithObject: name forKey: @"name"], @"owner",
+    nil];
+}
+
+int
+main(int argc, const char **argv)
+{
+  NSArrayController	*vehicles;
+  NSArrayController	*bySet;
+  NSArrayController	*byArray;
+  NSArrayController	*withOptions;
+  DefaultingController	*defaulting;
+  NSObjectController	*byObject;
+  NSPopUpButton		*popup;
+  NSTableView		*table;
+  NSTextField		*field;
+  NSIndexSet		*both;
+  NSArray		*none;
+  NSArray		*several;
+  id			placeholder;
+
+  START_SET("NSObjectController marker placeholders")
+
+  NS_DURING
+    [NSApplication sharedApplication];
+  NS_HANDLER
+    if ([[localException name] isEqualToString: NSInternalInconsistencyException])
+      SKIP("It looks like GNUstep backend is not yet installed")
+  NS_ENDHANDLER
+
+  none = [NSArray arrayWithObject: @"none"];
+  several = [NSArray arrayWithObject: @"several"];
+
+  vehicles = AUTORELEASE([[NSArrayController alloc] init]);
+  [vehicles setAvoidsEmptySelection: NO];
+  [vehicles setContent: [NSMutableArray arrayWithObjects:
+    vehicle(@"car", [NSArray arrayWithObjects: @"r1", @"r2", nil]),
+    vehicle(@"van", [NSArray arrayWithObject: @"r3"]), nil]];
+  [vehicles setSelectionIndexes: [NSIndexSet indexSet]];
+  both = [NSIndexSet indexSetWithIndexesInRange: NSMakeRange(0, 2)];
+
+  bySet = AUTORELEASE([[NSArrayController alloc] init]);
+  byArray = AUTORELEASE([[NSArrayController alloc] init]);
+  byObject = AUTORELEASE([[NSObjectController alloc] init]);
+  withOptions = AUTORELEASE([[NSArrayController alloc] init]);
+  popup = AUTORELEASE([[NSPopUpButton alloc]
+    initWithFrame: NSMakeRect(0, 0, 100, 20) pullsDown: NO]);
+  table = AUTORELEASE([[NSTableView alloc]
+    initWithFrame: NSMakeRect(0, 0, 100, 100)]);
+  [table addTableColumn: AUTORELEASE([[NSTableColumn alloc]
+    initWithIdentifier: @"record"])];
+  field = AUTORELEASE([[NSTextField alloc]
+    initWithFrame: NSMakeRect(0, 0, 100, 20)]);
+
+  NS_DURING
+    {
+      [bySet bind: NSContentSetBinding toObject: vehicles
+      withKeyPath: @"selection.records" options: nil];
+      [byArray bind: NSContentArrayBinding toObject: vehicles
+	withKeyPath: @"selection.list" options: nil];
+      [byObject bind: NSContentObjectBinding toObject: vehicles
+	 withKeyPath: @"selection.owner" options: nil];
+      [withOptions bind: NSContentArrayBinding toObject: vehicles
+	    withKeyPath: @"selection.list"
+		options: [NSDictionary dictionaryWithObjectsAndKeys:
+	several, NSMultipleValuesPlaceholderBindingOption,
+	none, NSNoSelectionPlaceholderBindingOption, nil]];
+      [popup bind: NSContentBinding toObject: vehicles
+      withKeyPath: @"selection.list" options: nil];
+      [table bind: NSContentBinding toObject: vehicles
+      withKeyPath: @"selection.list" options: nil];
+      [field bind: NSValueBinding toObject: vehicles
+      withKeyPath: @"selection.name" options: nil];
+      PASS(YES, "content binds through a selection with nothing selected")
+    }
+  NS_HANDLER
+    PASS(NO, "content binds through a selection with nothing selected")
+  NS_ENDHANDLER
+
+  PASS([[bySet arrangedObjects] count] == 0,
+    "contentSet through no selection is empty")
+  PASS([[byArray arrangedObjects] count] == 0,
+    "contentArray through no selection is empty")
+  PASS([byObject content] == nil,
+    "contentObject through no selection is nil")
+  PASS_EQUAL([withOptions content], none,
+    "contentArray through no selection is its no-selection placeholder")
+  PASS([popup numberOfItems] == 0, "a popup's content through no selection is empty")
+  PASS([table numberOfRows] == 0, "a table's content through no selection is empty")
+  PASS_EQUAL([[field cell] placeholderString], @"No Selection",
+    "a text field shows No Selection")
+
+  [vehicles setSelectionIndexes: [NSIndexSet indexSetWithIndex: 0]];
+  PASS([[bySet arrangedObjects] count] == 2,
+    "contentSet through one selected is its records")
+  PASS([[byArray arrangedObjects] count] == 2,
+    "contentArray through one selected is its records")
+  PASS_EQUAL([byObject valueForKeyPath: @"content.name"], @"car",
+    "contentObject through one selected is its owner")
+  PASS([popup numberOfItems] == 2, "a popup's content through one selected")
+  PASS([table numberOfRows] == 2, "a table's content through one selected")
+
+  [vehicles setSelectionIndexes: both];
+  PASS([[bySet arrangedObjects] count] == 0,
+    "contentSet through multiple values is empty")
+  PASS([[byArray arrangedObjects] count] == 0,
+    "contentArray through multiple values is empty")
+  PASS([byObject content] == nil,
+    "contentObject through multiple values is nil")
+  PASS_EQUAL([withOptions content], several,
+    "contentArray through multiple values is its multiple-values placeholder")
+  PASS([popup numberOfItems] == 0, "a popup's content through multiple values is empty")
+  PASS([table numberOfRows] == 0, "a table's content through multiple values is empty")
+  PASS_EQUAL([[field cell] placeholderString], @"Multiple Values",
+    "a text field shows Multiple Values")
+
+  [vehicles setSelectionIndexes: [NSIndexSet indexSet]];
+  PASS([[bySet arrangedObjects] count] == 0,
+    "contentSet is empty again when nothing is selected")
+
+  END_SET("NSObjectController marker placeholders")
+
+  START_SET("NSObjectController default placeholders")
+
+  NS_DURING
+    [NSApplication sharedApplication];
+  NS_HANDLER
+    if ([[localException name] isEqualToString: NSInternalInconsistencyException])
+      SKIP("It looks like GNUstep backend is not yet installed")
+  NS_ENDHANDLER
+
+  PASS([NSObject defaultPlaceholderForMarker: NSNoSelectionMarker
+				 withBinding: NSValueBinding] == nil,
+    "an object has no default placeholder")
+  PASS([NSArrayController defaultPlaceholderForMarker: NSMultipleValuesMarker
+				  withBinding: NSContentArrayBinding] == nil,
+    "an array controller's content has no default placeholder")
+  placeholder = [NSTextField defaultPlaceholderForMarker: NSNoSelectionMarker
+					     withBinding: NSValueBinding];
+  PASS_EQUAL(placeholder, @"No Selection",
+    "a text field's value shows No Selection")
+  placeholder = [NSTextField defaultPlaceholderForMarker: NSMultipleValuesMarker
+					     withBinding: NSValueBinding];
+  PASS_EQUAL(placeholder, @"Multiple Values",
+    "a text field's value shows Multiple Values")
+  placeholder = [NSTextField defaultPlaceholderForMarker: NSNotApplicableMarker
+					     withBinding: NSValueBinding];
+  PASS_EQUAL(placeholder, @"Not Applicable",
+    "a text field's value shows Not Applicable")
+
+  none = [NSArray arrayWithObject: @"none"];
+  [DefaultingController setDefaultPlaceholder: none
+				    forMarker: NSNoSelectionMarker
+				  withBinding: NSContentArrayBinding];
+  vehicles = AUTORELEASE([[NSArrayController alloc] init]);
+  [vehicles setAvoidsEmptySelection: NO];
+  [vehicles setContent: [NSMutableArray arrayWithObjects:
+    vehicle(@"car", [NSArray arrayWithObject: @"r1"]),
+    vehicle(@"van", [NSArray arrayWithObject: @"r3"]), nil]];
+  [vehicles setSelectionIndexes: [NSIndexSet indexSet]];
+  defaulting = AUTORELEASE([[DefaultingController alloc] init]);
+  [defaulting bind: NSContentArrayBinding toObject: vehicles
+       withKeyPath: @"selection.list" options: nil];
+  PASS_EQUAL([defaulting content], none,
+    "contentArray through no selection is its class's default placeholder")
+  [vehicles setSelectionIndexes:
+    [NSIndexSet indexSetWithIndexesInRange: NSMakeRange(0, 2)]];
+  PASS([[defaulting arrangedObjects] count] == 0,
+    "a default placeholder is for its marker only")
+
+  END_SET("NSObjectController default placeholders")
+  return 0;
+}
diff --git a/Tests/gui/NSObjectController/selectionMarkers.m b/Tests/gui/NSObjectController/selectionMarkers.m
new file mode 100644
index 000000000..bb2c47ff7
--- /dev/null
+++ b/Tests/gui/NSObjectController/selectionMarkers.m
@@ -0,0 +1,134 @@
+/* A controller's selection answers for the selected objects as AppKit's
+   does: the marker for no selection when nothing is selected, the
+   selected objects' value when they agree on it, the marker for multiple
+   values when they do not (or always, with alwaysUsesMultipleValuesMarker),
+   and the marker for not applicable when the key is not theirs.  Observers
+   of selection.<key> hear when that value changes, whether the selection
+   changes or a selected object does. */
+#include "Testing.h"
+
+#include <Foundation/NSArray.h>
+#include <Foundation/NSAutoreleasePool.h>
+#include <Foundation/NSDictionary.h>
+#include <Foundation/NSIndexSet.h>
+#include <Foundation/NSKeyValueObserving.h>
+#include <Foundation/NSString.h>
+
+#include <AppKit/NSApplication.h>
+#include <AppKit/NSArrayController.h>
+#include <AppKit/NSKeyValueBinding.h>
+#include <AppKit/NSObjectController.h>
+
+@interface SelectionReader : NSObject
+{
+@public
+  int	count;
+  id	last;
+}
+@end
+
+@implementation SelectionReader
+- (void) observeValueForKeyPath: (NSString *)keyPath
+                       ofObject: (id)object
+                         change: (NSDictionary *)change
+                        context: (void *)context
+{
+  count++;
+  last = [object valueForKeyPath: keyPath];
+}
+@end
+
+static NSMutableDictionary *
+person(NSString *name, NSString *city)
+{
+  return [NSMutableDictionary dictionaryWithObjectsAndKeys:
+    name, @"name", city, @"city", nil];
+}
+
+int
+main(int argc, const char **argv)
+{
+  SelectionReader	*reader;
+  NSArrayController	*ac;
+  NSObjectController	*oc;
+  NSMutableDictionary	*ada;
+  NSMutableDictionary	*bob;
+  NSIndexSet		*both;
+  int			before;
+
+  START_SET("NSObjectController selection markers")
+
+  NS_DURING
+    [NSApplication sharedApplication];
+  NS_HANDLER
+    if ([[localException name] isEqualToString: NSInternalInconsistencyException])
+      SKIP("It looks like GNUstep backend is not yet installed")
+  NS_ENDHANDLER
+
+  ada = person(@"Ada", @"London");
+  bob = person(@"Bob", @"London");
+  both = [NSIndexSet indexSetWithIndexesInRange: NSMakeRange(0, 2)];
+  ac = AUTORELEASE([[NSArrayController alloc] init]);
+  [ac setContent: [NSMutableArray arrayWithObjects: ada, bob, nil]];
+  reader = AUTORELEASE([[SelectionReader alloc] init]);
+  [ac addObserver: reader forKeyPath: @"selection.name"
+	  options: NSKeyValueObservingOptionNew context: NULL];
+
+  [ac setSelectionIndexes: [NSIndexSet indexSet]];
+  PASS([ac selection] != nil, "-selection answers something with no selection")
+  PASS([ac valueForKeyPath: @"selection.name"] == NSNoSelectionMarker,
+    "nothing selected answers the no-selection marker")
+  PASS(reader->last == NSNoSelectionMarker,
+    "observers hear that nothing is selected")
+
+  [ac setSelectionIndexes: [NSIndexSet indexSetWithIndex: 0]];
+  PASS_EQUAL([ac valueForKeyPath: @"selection.name"], @"Ada",
+    "one object selected answers its value")
+  PASS_EQUAL(reader->last, @"Ada", "observers hear the selected value")
+  before = reader->count;
+  [ada setObject: @"Ada L" forKey: @"name"];
+  PASS(reader->count == before + 1,
+    "observers hear when the selected object's value changes")
+  PASS_EQUAL(reader->last, @"Ada L", "and read its new value")
+  [bob setObject: @"Bobby" forKey: @"name"];
+  PASS(reader->count == before + 1,
+    "observers do not hear of objects that are not selected")
+
+  [ac setSelectionIndexes: both];
+  PASS([ac valueForKeyPath: @"selection.name"] == NSMultipleValuesMarker,
+    "objects with different values answer the multiple-values marker")
+  PASS(reader->last == NSMultipleValuesMarker,
+    "observers hear of multiple values")
+  PASS_EQUAL([ac valueForKeyPath: @"selection.city"], @"London",
+    "objects agreeing on a value answer it")
+  [ac setAlwaysUsesMultipleValuesMarker: YES];
+  PASS([ac valueForKeyPath: @"selection.city"] == NSMultipleValuesMarker,
+    "alwaysUsesMultipleValuesMarker answers the marker for any selection of several")
+  [ac setAlwaysUsesMultipleValuesMarker: NO];
+  [[ac selection] setValue: @"Paris" forKey: @"city"];
+  PASS([[ada objectForKey: @"city"] isEqual: @"Paris"]
+    && [[bob objectForKey: @"city"] isEqual: @"Paris"],
+    "a value set through the selection is set on every selected object")
+  before = reader->count;
+  [bob setObject: @"Ada L" forKey: @"name"];
+  PASS(reader->count == before + 1 && [reader->last isEqual: @"Ada L"],
+    "observers hear when the selected objects come to agree")
+  [ac removeObserver: reader forKeyPath: @"selection.name"];
+
+  ac = AUTORELEASE([[NSArrayController alloc] init]);
+  [ac setContent: [NSMutableArray arrayWithObjects: @"one", @"two", nil]];
+  [ac setSelectionIndexes: [NSIndexSet indexSetWithIndex: 0]];
+  PASS([ac valueForKeyPath: @"selection.city"] == NSNotApplicableMarker,
+    "a key the selected objects do not have answers the not-applicable marker")
+
+  oc = AUTORELEASE([[NSObjectController alloc] initWithContent: ada]);
+  PASS_EQUAL([oc valueForKeyPath: @"selection.name"], @"Ada L",
+    "an object controller's selection answers for its content")
+  [oc setContent: nil];
+  PASS([oc valueForKeyPath: @"selection.name"] == NSNoSelectionMarker,
+    "an object controller without content answers the no-selection marker")
+
+  END_SET("NSObjectController selection markers")
+
+  return 0;
+}
