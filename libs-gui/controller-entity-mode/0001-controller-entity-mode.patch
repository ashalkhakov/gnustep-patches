+    </dependencies>
+    <objects>
+        <customObject id="-2" userLabel="File's Owner" customClass="Owner"/>
+        <customObject id="-1" userLabel="First Responder" customClass="FirstResponder"/>
+        <customObject id="-3" userLabel="Application" customClass="NSObject"/>
+        <arrayController mode="entity" entityName="Vehicle" automaticallyPreparesContent="YES" id="vehicles">
+            <connections>
+                <binding destination="-2" name="managedObjectContext" keyPath="context" id="vehiclesContext"/>
+            </connections>
+        </arrayController>
+        <arrayController automaticallyPreparesContent="YES" id="prepared"/>
+    </objects>
+</document>
diff --git a/Tests/gui/NSArrayController/entityMode.m b/Tests/gui/NSArrayController/entityMode.m
new file mode 100644
index 000000000..d51db48db
--- /dev/null
+++ b/Tests/gui/NSArrayController/entityMode.m
@@ -0,0 +1,512 @@
+/* A controller in entity mode works on a managed object context: it
+   fetches the entity's objects from it, makes new objects in it and
+   deletes what it removes from it, follows what the context says has
+   changed once it has fetched, and a xib can give it its context by
+   binding.  gnustep-gui does not link Core Data and reaches it at run time
+   by class name, so the classes it uses are stood in for here by ones of
+   the same names that keep their objects in an array. */
+#include "Testing.h"
+
+#include <Foundation/NSArray.h>
+#include <Foundation/NSAutoreleasePool.h>
+#include <Foundation/NSData.h>
+#include <Foundation/NSDate.h>
+#include <Foundation/NSDictionary.h>
+#include <Foundation/NSIndexSet.h>
+#include <Foundation/NSNotification.h>
+#include <Foundation/NSSet.h>
+#include <Foundation/NSPredicate.h>
+#include <Foundation/NSRunLoop.h>
+#include <Foundation/NSSortDescriptor.h>
+#include <Foundation/NSString.h>
+
+#include <AppKit/NSApplication.h>
+#include <AppKit/NSArrayController.h>
+#include <AppKit/NSKeyValueBinding.h>
+#include <AppKit/NSNib.h>
+#include <AppKit/NSObjectController.h>
+
+@class Context;
+
+@interface NSEntityDescription : NSObject
+{
+@public
+  NSString		*name;
+  NSEntityDescription	*superentity;
+}
++ (id) entityForName: (NSString *)n inManagedObjectContext: (id)context;
+- (BOOL) isKindOfEntity: (NSEntityDescription *)e;
++ (id) insertNewObjectForEntityForName: (NSString *)n
+		inManagedObjectContext: (id)context;
+- (NSString *) name;
+@end
+
+@interface NSFetchRequest : NSObject
+{
+@public
+  id		entity;
+  NSPredicate	*predicate;
+  NSArray	*sortDescriptors;
+}
+- (void) setEntity: (id)e;
+- (void) setPredicate: (NSPredicate *)p;
+- (void) setSortDescriptors: (NSArray *)s;
+@end
+
+@interface Managed : NSObject
+{
+@public
+  NSEntityDescription	*entity;
+  Context		*context;
+  NSString		*name;
+}
+- (id) managedObjectContext;
+- (NSEntityDescription *) entity;
+- (NSString *) name;
+@end
+
+@interface Context : NSObject
+{
+@public
+  NSMutableDictionary	*entities;
+  NSMutableArray	*objects;
+  NSMutableArray	*deleted;
+  int			fetches;
+  NSFetchRequest	*lastRequest;
+}
+- (Managed *) insert: (NSString *)entityName named: (NSString *)n;
+- (NSArray *) executeFetchRequest: (id)request error: (NSError **)error;
+- (void) deleteObject: (id)object;
+@end
+
+@implementation NSEntityDescription
++ (id) entityForName: (NSString *)n inManagedObjectContext: (id)context
+{
+  return [((Context *)context)->entities objectForKey: n];
+}
++ (id) insertNewObjectForEntityForName: (NSString *)n
+		inManagedObjectContext: (id)context
+{
+  return [(Context *)context insert: n named: nil];
+}
+- (NSString *) name
+{
+  return name;
+}
+- (BOOL) isKindOfEntity: (NSEntityDescription *)e
+{
+  NSEntityDescription	*check = self;
+
+  while (check != nil && check != e)
+    check = check->superentity;
+  return check != nil;
+}
+@end
+
+@implementation NSFetchRequest
+- (void) setEntity: (id)e
+{
+  ASSIGN(entity, e);
+}
+- (void) setPredicate: (NSPredicate *)p
+{
+  ASSIGN(predicate, p);
+}
+- (void) setSortDescriptors: (NSArray *)s
+{
+  ASSIGN(sortDescriptors, s);
+}
+@end
+
+@implementation Managed
+- (id) managedObjectContext
+{
+  return context;
+}
+- (NSEntityDescription *) entity
+{
+  return entity;
+}
+- (NSString *) name
+{
+  return name;
+}
+@end
+
+@implementation Context
+- (id) initWithEntities: (NSArray *)names
+{
+  NSEnumerator	*e = [names objectEnumerator];
+  NSString	*n;
+
+  entities = [NSMutableDictionary new];
+  objects = [NSMutableArray new];
+  deleted = [NSMutableArray new];
+  while ((n = [e nextObject]) != nil)
+    {
+      NSEntityDescription *entity = [NSEntityDescription new];
+
+      entity->name = [n copy];
+      [entities setObject: entity forKey: n];
+      RELEASE(entity);
+    }
+  return self;
+}
+- (Managed *) insert: (NSString *)entityName named: (NSString *)n
+{
+  Managed *object = AUTORELEASE([Managed new]);
+
+  object->entity = [entities objectForKey: entityName];
+  object->context = self;
+  object->name = [n copy];
+  [objects addObject: object];
+  return object;
+}
+- (NSArray *) executeFetchRequest: (id)request error: (NSError **)error
+{
+  NSFetchRequest	*r = request;
+  NSMutableArray	*found = [NSMutableArray array];
+  NSEnumerator		*e = [objects objectEnumerator];
+  Managed		*object;
+
+  fetches++;
+  ASSIGN(lastRequest, r);
+  while ((object = [e nextObject]) != nil)
+    {
+      if (object->entity == r->entity
+	&& (r->predicate == nil || [r->predicate evaluateWithObject: object]))
+	{
+	  [found addObject: object];
+	}
+    }
+  return [found sortedArrayUsingDescriptors: r->sortDescriptors];
+}
+- (void) deleteObject: (id)object
+{
+  [deleted addObject: object];
+  [objects removeObject: object];
+}
+@end
+
+@interface Owner : NSObject
+{
+@public
+  id	context;
+}
+- (id) context;
+@end
+
+@implementation Owner
+- (id) context
+{
+  return context;
+}
+@end
+
+static void
+spin(void)
+{
+  [[NSRunLoop currentRunLoop] runUntilDate:
+    [NSDate dateWithTimeIntervalSinceNow: 0.1]];
+}
+
+static NSString *
+names(NSArray *objects)
+{
+  return [[objects valueForKey: @"name"] componentsJoinedByString: @","];
+}
+
+/* What Core Data posts when a context's objects change: its
+   NSManagedObjectContextObjectsDidChangeNotification, by value. */
+static void
+changed(Context *context, NSString *key, NSArray *objects)
+{
+  [[NSNotificationCenter defaultCenter]
+    postNotificationName: @"NSObjectsChangedInManagingContextNotification"
+		  object: context
+		userInfo: [NSDictionary dictionaryWithObject:
+		  objects == nil ? (id)[NSNull null] : [NSSet setWithArray: objects]
+							forKey: key]];
+}
+
+int
+main(int argc, const char **argv)
+{
+  Context		*context;
+  NSArrayController	*ac;
+  NSArrayController	*bound;
+  NSObjectController	*oc;
+  NSMutableDictionary	*holder;
+  Owner			*owner;
+  NSNib			*nib;
+  NSArray		*objects = nil;
+  NSEnumerator		*e;
+  id			object;
+  id			made;
+  NSError		*error = nil;
+  NSArrayController	*fromXib = nil;
+  NSArrayController	*prepared = nil;
+  Context		*other;
+  NSArrayController	*follower;
+  NSArrayController	*idle;
+  id			van, bus, vw, vcar, trip;
+
+  START_SET("NSObjectController entity mode")
+
+  NS_DURING
+    [NSApplication sharedApplication];
+  NS_HANDLER
+    if ([[localException name] isEqualToString: NSInternalInconsistencyException])
+      SKIP("It looks like GNUstep backend is not yet installed")
+  NS_ENDHANDLER
+
+  context = [[Context alloc] initWithEntities:
+    [NSArray arrayWithObjects: @"Vehicle", @"Trip", nil]];
+  AUTORELEASE(context);
+  [context insert: @"Vehicle" named: @"van"];
+  [context insert: @"Vehicle" named: @"car"];
+  [context insert: @"Trip" named: @"trip"];
+  holder = [NSMutableDictionary dictionaryWithObject: context
+					      forKey: @"context"];
+
+  ac = AUTORELEASE([[NSArrayController alloc] init]);
+  PASS([[ac exposedBindings] containsObject: NSManagedObjectContextBinding],
+    "an array controller exposes a managedObjectContext binding")
+  [ac bind: NSManagedObjectContextBinding toObject: holder
+       withKeyPath: @"context" options: nil];
+  PASS([ac managedObjectContext] == (id)context,
+    "the managedObjectContext binding gives the controller its context")
+  [ac setEntityName: @"Vehicle"];
+  PASS_EQUAL([ac entityName], @"Vehicle", "-entityName is what was set")
+
+  PASS(([ac fetchWithRequest: nil merge: NO error: &error]),
+    "-fetchWithRequest:merge:error: fetches with the default request")
+  PASS_EQUAL(names([ac arrangedObjects]), @"van,car",
+    "the entity's objects are the content")
+  PASS_EQUAL([context->lastRequest->entity name], @"Vehicle",
+    "the default request is for the entity")
+
+  [ac setSortDescriptors: [NSArray arrayWithObject:
+    AUTORELEASE([[NSSortDescriptor alloc] initWithKey: @"name"
+					    ascending: YES])]];
+  [ac setFetchPredicate: [NSPredicate predicateWithFormat: @"name == 'van'"]];
+  PASS_EQUAL(names([ac arrangedObjects]), @"car,van",
+    "-setFetchPredicate: fetches later, not at once")
+  spin();
+  PASS_EQUAL(names([ac arrangedObjects]), @"van",
+    "-setFetchPredicate: fetches with the predicate")
+  PASS_EQUAL(context->lastRequest->sortDescriptors, [ac sortDescriptors],
+    "an array controller's default request has its sort descriptors")
+
+  [ac setFetchPredicate: nil];
+  spin();
+  made = AUTORELEASE([ac newObject]);
+  PASS([made isKindOfClass: [Managed class]]
+    && [context->objects containsObject: made],
+    "-newObject inserts a new object into the context")
+  PASS_EQUAL([((Managed *)made)->entity name], @"Vehicle",
+    "-newObject makes an object of the entity")
+
+  object = RETAIN([[ac arrangedObjects] objectAtIndex: 0]);
+  [ac removeObjectsAtArrangedObjectIndexes: [NSIndexSet indexSetWithIndex: 0]];
+  PASS([context->deleted containsObject: object]
+    && ![[ac arrangedObjects] containsObject: object],
+    "-removeObjectsAtArrangedObjectIndexes: deletes what it removes")
+  RELEASE(object);
+  object = [[ac arrangedObjects] lastObject];
+  [ac removeObject: object];
+  PASS([context->deleted containsObject: object],
+    "-removeObject: deletes what it removes from the context")
+
+  made = AUTORELEASE([Managed new]);
+  ((Managed *)made)->name = @"stray";
+  [ac setContent: [NSMutableArray arrayWithObject: made]];
+  objects = [context executeFetchRequest: [ac defaultFetchRequest] error: NULL];
+  PASS(([ac fetchWithRequest: nil merge: YES error: &error])
+    && [[ac content] containsObject: made]
+    && [[ac content] count] == 1 + [objects count],
+    "a merging fetch adds what it fetches to what the content has")
+  objects = nil;
+
+  bound = AUTORELEASE([[NSArrayController alloc] init]);
+  [bound setEntityName: @"Vehicle"];
+  [bound setManagedObjectContext: (id)context];
+  [holder setObject: [NSMutableArray arrayWithArray: context->objects]
+	     forKey: @"list"];
+  [bound bind: NSContentArrayBinding toObject: holder
+	  withKeyPath: @"list" options: nil];
+  object = [[bound arrangedObjects] objectAtIndex: 0];
+  [bound removeObject: object];
+  PASS(![context->deleted containsObject: object],
+    "a controller whose content is bound deletes nothing it removes")
+
+  oc = AUTORELEASE([[NSObjectController alloc] init]);
+  [oc setEntityName: @"Trip"];
+  [oc setManagedObjectContext: (id)context];
+  [oc fetch: nil];
+  spin();
+  PASS_EQUAL([[oc content] name], @"trip",
+    "an object controller's content is the first object fetched")
+  object = RETAIN([oc content]);
+  [oc remove: nil];
+  PASS([context->deleted containsObject: object] && [oc content] == nil,
+    "an object controller's remove: deletes its content")
+  RELEASE(object);
+
+  owner = AUTORELEASE([Owner new]);
+  owner->context = context;
+  nib = AUTORELEASE([[NSNib alloc] initWithNibData:
+    [NSData dataWithContentsOfFile: @"EntityMode.xib"] bundle: nil]);
+  PASS(([nib instantiateWithOwner: owner topLevelObjects: &objects]),
+    "a xib with controllers in entity mode loads")
+  e = [objects objectEnumerator];
+  while ((object = [e nextObject]) != nil)
+    {
+      if ([object isKindOfClass: [NSArrayController class]])
+	{
+	  if ([object entityName] != nil)
+	    fromXib = object;
+	  else
+	    prepared = object;
+	}
+    }
+  PASS_EQUAL([fromXib entityName], @"Vehicle",
+    "a xib's controller has its entity name")
+  PASS([fromXib automaticallyPreparesContent],
+    "a xib's controller prepares its content")
+  PASS([fromXib managedObjectContext] == (id)context,
+    "a xib's managedObjectContext binding gives it its context")
+  spin();
+  PASS([[fromXib arrangedObjects] count] > 0
+    && [[fromXib arrangedObjects] isEqual:
+      ([context executeFetchRequest: [fromXib defaultFetchRequest]
+			      error: NULL])],
+    "a xib's controller in entity mode fetches its content once loaded")
+  PASS([[prepared content] count] == 1,
+    "a xib's controller in class mode prepares content of one new object")
+
+  /* Following the context, as macOS 15's controllers do: inserted objects
+     of the entity (or a subentity) that match the fetch predicate are
+     added, deleted and invalidated ones dropped, updated ones added or
+     dropped as they now match or not, refreshed ones left alone, and
+     invalidatedAll empties the content; then the content is rearranged
+     and the selection kept. */
+  context = [[Context alloc] initWithEntities:
+    [NSArray arrayWithObjects: @"Vehicle", @"Car", @"Trip", nil]];
+  AUTORELEASE(context);
+  ((NSEntityDescription *)[context->entities objectForKey: @"Car"])->superentity
+    = [context->entities objectForKey: @"Vehicle"];
+  van = [context insert: @"Vehicle" named: @"van"];
+  bus = [context insert: @"Vehicle" named: @"bus"];
+  trip = [context insert: @"Trip" named: @"trip"];
+
+  idle = AUTORELEASE([[NSArrayController alloc] init]);
+  [idle setEntityName: @"Vehicle"];
+  [idle setManagedObjectContext: (id)context];
+  [idle setContent: [NSMutableArray array]];
+  vw = [context insert: @"Vehicle" named: @"vw"];
+  changed(context, @"inserted", [NSArray arrayWithObject: vw]);
+  PASS([[idle content] count] == 0,
+    "a controller that has not fetched does not follow its context")
+
+  follower = AUTORELEASE([[NSArrayController alloc] init]);
+  [follower setEntityName: @"Vehicle"];
+  [follower setManagedObjectContext: (id)context];
+  [follower setSortDescriptors: [NSArray arrayWithObject:
+    AUTORELEASE([[NSSortDescriptor alloc] initWithKey: @"name"
+					    ascending: YES])]];
+  [follower setFetchPredicate:
+    [NSPredicate predicateWithFormat: @"name BEGINSWITH 'v'"]];
+  spin();
+  PASS_EQUAL(names([follower arrangedObjects]), @"van,vw",
+    "the follower has fetched")
+  [follower setSelectedObjects: [NSArray arrayWithObject: vw]];
+
+  vcar = [context insert: @"Car" named: @"vcar"];
+  changed(context, @"inserted", [NSArray arrayWithObjects: vcar,
+    [context insert: @"Vehicle" named: @"bike"],
+    [context insert: @"Trip" named: @"voyage"], van, nil]);
+  PASS_EQUAL(names([follower arrangedObjects]), @"van,vcar,vw",
+    "inserted objects of the entity that match the predicate are added")
+  PASS_EQUAL([follower selectedObjects], [NSArray arrayWithObject: vw],
+    "the selection is kept when objects are added")
+
+  ((Managed *)bus)->name = @"vbus";
+  ((Managed *)vw)->name = @"xw";
+  changed(context, @"updated", [NSArray arrayWithObjects: bus, vw, nil]);
+  PASS_EQUAL(names([follower arrangedObjects]), @"van,vbus,vcar",
+    "updated objects are added or dropped as they now match")
+
+  ((Managed *)vcar)->name = @"car";
+  changed(context, @"refreshed", [NSArray arrayWithObject: vcar]);
+  PASS([[follower arrangedObjects] containsObject: vcar],
+    "refreshed objects are left alone")
+  ((Managed *)vcar)->name = @"vcar";
+
+  [follower setSelectedObjects: [NSArray arrayWithObject: van]];
+  changed(context, @"deleted", [NSArray arrayWithObject: van]);
+  PASS_EQUAL(names([follower arrangedObjects]), @"vbus,vcar",
+    "deleted objects are dropped")
+  PASS([follower selectionIndex] == 0,
+    "a deleted selected object leaves the first selected")
+  changed(context, @"invalidated", [NSArray arrayWithObject: bus]);
+  PASS_EQUAL(names([follower arrangedObjects]), @"vcar",
+    "invalidated objects are dropped")
+
+  other = AUTORELEASE([[Context alloc] initWithEntities:
+    [NSArray arrayWithObject: @"Vehicle"]]);
+  changed(other, @"inserted", [NSArray arrayWithObject:
+    [other insert: @"Vehicle" named: @"vother"]]);
+  PASS_EQUAL(names([follower arrangedObjects]), @"vcar",
+    "another context's changes are not followed")
+
+  made = AUTORELEASE([follower newObject]);
+  ((Managed *)made)->name = @"vnew";
+  [follower addObject: made];
+  changed(context, @"inserted", [NSArray arrayWithObject: made]);
+  PASS_EQUAL(names([follower arrangedObjects]), @"vcar,vnew",
+    "an object the controller added is not added again")
+
+  changed(context, @"invalidatedAll", nil);
+  PASS([[follower content] count] == 0,
+    "invalidatedAll empties the content")
+  changed(context, @"inserted", [NSArray arrayWithObject: van]);
+  PASS_EQUAL(names([follower arrangedObjects]), @"van",
+    "the context is still followed afterwards")
+
+  [follower setManagedObjectContext: (id)other];
+  changed(context, @"inserted", [NSArray arrayWithObject: vcar]);
+  changed(other, @"inserted", [NSArray arrayWithObject:
+    [other insert: @"Vehicle" named: @"vee"]]);
+  PASS_EQUAL(names([follower arrangedObjects]), @"van,vee",
+    "a new context is followed in place of the old one")
+
+  oc = AUTORELEASE([[NSObjectController alloc] init]);
+  [oc setEntityName: @"Trip"];
+  [oc setManagedObjectContext: (id)context];
+  [oc fetch: nil];
+  spin();
+  object = [context insert: @"Trip" named: @"journey"];
+  changed(context, @"inserted", [NSArray arrayWithObject: object]);
+  PASS([oc content] == trip,
+    "an object controller keeps its content when others are inserted")
+  changed(context, @"deleted", [NSArray arrayWithObject: trip]);
+  PASS([oc content] == nil,
+    "an object controller's deleted content is dropped")
+  changed(context, @"inserted", [NSArray arrayWithObject: object]);
+  PASS([oc content] == object,
+    "an object controller without content takes an inserted object")
+
+  follower = [[NSArrayController alloc] init];
+  [follower setEntityName: @"Vehicle"];
+  [follower setManagedObjectContext: (id)context];
+  [follower fetchWithRequest: nil merge: NO error: NULL];
+  RELEASE(follower);
+  changed(context, @"inserted", [NSArray arrayWithObject:
+    [context insert: @"Vehicle" named: @"vlast"]]);
+  PASS(YES, "a released controller no longer follows its context")
+
+  END_SET("NSObjectController entity mode")
+
+  return 0;
+}
-- 
