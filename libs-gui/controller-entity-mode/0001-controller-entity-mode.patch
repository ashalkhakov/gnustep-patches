+- (void) _setFetchedObjects: (NSArray*)objects merge: (BOOL)merge
+{
+  NSMutableArray *content = [NSMutableArray arrayWithArray: objects];
+
+  if (merge && _content != nil)
+    {
+      NSEnumerator *e = [objects objectEnumerator];
+      id object;
+
