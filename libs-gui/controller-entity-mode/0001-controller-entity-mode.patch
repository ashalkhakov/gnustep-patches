+- (NSFetchRequest*) defaultFetchRequest
+{
+  Class requestClass = NSClassFromString(@"NSFetchRequest");
+  Class entityClass = NSClassFromString(@"NSEntityDescription");
+  id<GSControllerFetchRequest> request;
+  id entity;
+
+  if (_entity_name_key == nil || _managed_object_context == nil
+    || requestClass == Nil || entityClass == Nil)
+    {
+      return nil;
+    }
+  entity = [(id)entityClass entityForName: _entity_name_key
+		   inManagedObjectContext: _managed_object_context];
+  if (entity == nil)
+    {
+      return nil;
+    }
+  request = AUTORELEASE([[requestClass alloc] init]);
+  [request setEntity: entity];
+  [request setPredicate: _fetch_predicate];
+  return (NSFetchRequest*)request;
+}
+
+- (void) _setFetchedObjects: (NSArray*)objects merge: (BOOL)merge
+{
+  if (merge == NO || [self content] == nil)
+    {
+      [self setContent: [objects count] > 0 ? [objects objectAtIndex: 0] : nil];
+    }
 }
 
 - (BOOL) fetchWithRequest: (NSFetchRequest*)fetchRequest
                     merge: (BOOL)merge
                     error: (NSError**)error
 {
-  // TODO
-  //[_managed_object_context executeFetchRequest: fetchRequest error: error];
-  return NO;
+  id<GSControllerManagedObjectContext> context;
+  NSArray *objects;
+
+  context = (id<GSControllerManagedObjectContext>)_managed_object_context;
+  if (fetchRequest == nil)
+    {
+      fetchRequest = [self defaultFetchRequest];
+    }
+  if (context == nil || fetchRequest == nil)
+    {
+      return NO;
+    }
+  objects = [context executeFetchRequest: fetchRequest error: error];
+  if (objects == nil)
+    {
+      return NO;
+    }
+  [self _setFetchedObjects: objects merge: merge];
+  return YES;
 }
 
 - (NSManagedObjectContext*) managedObjectContext
@@ -427,7 +550,37 @@
 
 - (void) setManagedObjectContext: (NSManagedObjectContext*)managedObjectContext
 {
-  _managed_object_context = managedObjectContext;
+  ASSIGN(_managed_object_context, managedObjectContext);
+}
+
+- (BOOL) _contentIsBound
+{
+  return [GSKeyValueBinding getBinding: NSContentObjectBinding forObject: self]
+    || [GSKeyValueBinding getBinding: NSContentArrayBinding forObject: self]
+    || [GSKeyValueBinding getBinding: NSContentSetBinding forObject: self];
+}
+
+- (void) _deleteObjects: (NSArray*)objects
+{
+  id<GSControllerManagedObjectContext> context;
+  NSEnumerator *e;
+  id object;
+
+  context = (id<GSControllerManagedObjectContext>)_managed_object_context;
+  if (_entity_name_key == nil || context == nil || [self _contentIsBound])
+    {
+      return;
+    }
+  e = [objects objectEnumerator];
+  while ((object = [e nextObject]) != nil)
+    {
+      if ([object respondsToSelector: @selector(managedObjectContext)]
+	&& [(id<GSControllerManagedObject>)object managedObjectContext]
+	== context)
+	{
+	  [context deleteObject: object];
+	}
+    }
 }
 
 @end
