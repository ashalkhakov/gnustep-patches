+
+- (NSFetchRequest*) defaultFetchRequest
+{
+  NSFetchRequest *request = [super defaultFetchRequest];
+
+  [(id<GSControllerFetchRequest>)request setSortDescriptors: _sort_descriptors];
+  return request;
+}
+
+- (void) _setFetchedObjects: (NSArray*)objects merge: (BOOL)merge
+{
+  NSMutableArray *content = [NSMutableArray arrayWithArray: objects];
+
+  if (merge && _content != nil)
+    {
+      NSEnumerator *e = [objects objectEnumerator];
+      id object;
+
+      [content setArray: _content];
+      while ((object = [e nextObject]) != nil)
+	{
+	  if ([content indexOfObjectIdenticalTo: object] == NSNotFound)
+	    {
+	      [content addObject: object];
+	    }
+	}
+    }
+  [self setContent: content];
+}
+
+- (NSArray*) _followedObjects
+{
+  return _content != nil ? (NSArray*)_content : [NSArray array];
+}
+
+- (void) _followAdding: (NSArray*)added removing: (NSArray*)removed
+{
+  NSMutableArray *content = [NSMutableArray arrayWithArray: _content];
+  NSEnumerator *e = [removed objectEnumerator];
+  id object;
+
+  while ((object = [e nextObject]) != nil)
+    {
+      [content removeObjectIdenticalTo: object];
+    }
+  [content addObjectsFromArray: added];
+  [self willChangeValueForKey: NSContentBinding];
+  ASSIGN(_content, content);
+  [self didChangeValueForKey: NSContentBinding];
+  [self rearrangeObjects];
+}
+
 - (void) insert: (id)sender
 {
   id new = [self newObject];
