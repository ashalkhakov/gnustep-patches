+
+- (BOOL) _contentIsBound
+{
+  return [GSKeyValueBinding getBinding: NSContentObjectBinding forObject: self]
+    || [GSKeyValueBinding getBinding: NSContentArrayBinding forObject: self]
+    || [GSKeyValueBinding getBinding: NSContentSetBinding forObject: self];
+}
+
+- (void) _deleteObjects: (NSArray*)objects
+{
+  id<GSControllerManagedObjectContext> context;
+  NSEnumerator *e;
+  id object;
+
+  context = (id<GSControllerManagedObjectContext>)_managed_object_context;
+  if (_entity_name_key == nil || context == nil || [self _contentIsBound])
+    {
+      return;
+    }
+  e = [objects objectEnumerator];
+  while ((object = [e nextObject]) != nil)
+    {
+      if ([object respondsToSelector: @selector(managedObjectContext)]
+	&& [(id<GSControllerManagedObject>)object managedObjectContext]
+	== context)
+	{
+	  [context deleteObject: object];
+	}
+    }
+}
+
+- (void) _followContext: (id)context
+{
+  NSNotificationCenter *nc = [NSNotificationCenter defaultCenter];
+
+  [nc removeObserver: self
+		name: GSObjectsChangedInManagingContextNotification
+	      object: nil];
+  if (context != nil)
+    {
+      [nc addObserver: self
+	     selector: @selector(_objectsChangedInContext:)
+		 name: GSObjectsChangedInManagingContextNotification
+	       object: context];
+    }
+}
+
+- (NSArray*) _followedObjects
+{
+  return _content != nil ? [NSArray arrayWithObject: _content] : [NSArray array];
+}
+
+- (void) _followAdding: (NSArray*)added removing: (NSArray*)removed
+{
+  id content = _content;
+
+  if (content != nil && [removed indexOfObjectIdenticalTo: content] != NSNotFound)
+    {
+      content = nil;
+    }
+  if (content == nil && [added count] > 0)
+    {
+      content = [added objectAtIndex: 0];
+    }
+  if (content != _content)
+    {
+      [self setContent: content];
+    }
+}
+
+- (BOOL) _isFollowedEntity: (id)entity object: (id)object
+{
+  return [object respondsToSelector: @selector(entity)]
+    && [[(id<GSControllerManagedObject>)object entity] isKindOfEntity: entity]
+    && (_fetch_predicate == nil
+      || [_fetch_predicate evaluateWithObject: object]);
+}
+
+- (void) _objectsChangedInContext: (NSNotification*)notification
+{
+  NSDictionary *info = [notification userInfo];
+  NSArray *members = [self _followedObjects];
+  NSMutableArray *added = [NSMutableArray array];
+  NSMutableArray *removed = [NSMutableArray array];
+  Class entityClass = NSClassFromString(@"NSEntityDescription");
+  id entity;
+  NSEnumerator *e;
+  id object;
+
+  if ([self _contentIsBound] || _entity_name_key == nil)
+    {
+      return;
+    }
+  if ([info objectForKey: @"invalidatedAll"] != nil)
+    {
+      [self _followAdding: nil removing: members];
+      return;
+    }
+  entity = [(id)entityClass entityForName: _entity_name_key
+		   inManagedObjectContext: [notification object]];
+
+  e = [[info objectForKey: @"inserted"] objectEnumerator];
+  while ((object = [e nextObject]) != nil)
+    {
+      if ([members indexOfObjectIdenticalTo: object] == NSNotFound
+	&& [self _isFollowedEntity: entity object: object])
+	{
+	  [added addObject: object];
+	}
+    }
+  e = [[info objectForKey: @"updated"] objectEnumerator];
+  while ((object = [e nextObject]) != nil)
+    {
+      BOOL member = [members indexOfObjectIdenticalTo: object] != NSNotFound;
+
+      if (member != [self _isFollowedEntity: entity object: object])
+	{
+	  [(member ? removed : added) addObject: object];
+	}
+    }
+  e = [[info objectForKey: @"deleted"] objectEnumerator];
+  while ((object = [e nextObject]) != nil)
+    {
+      if ([members indexOfObjectIdenticalTo: object] != NSNotFound)
+	{
+	  [removed addObject: object];
+	}
+    }
+  e = [[info objectForKey: @"invalidated"] objectEnumerator];
+  while ((object = [e nextObject]) != nil)
+    {
+      if ([members indexOfObjectIdenticalTo: object] != NSNotFound)
+	{
+	  [removed addObject: object];
+	}
+    }
+  if ([added count] > 0 || [removed count] > 0)
+    {
+      [self _followAdding: added removing: removed];
+    }
 }
 
 @end
