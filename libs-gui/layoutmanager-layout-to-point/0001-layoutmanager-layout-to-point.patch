 /**
  * Temporary attributes are implemented using an NSMutableAttributedString
  * stored in the _temporaryAttributes ivar. We only care about this attributed
diff --git a/Tests/gui/NSLayoutManager/layoutToPoint.m b/Tests/gui/NSLayoutManager/layoutToPoint.m
new file mode 100644
index 000000000..536b312ef
--- /dev/null
+++ b/Tests/gui/NSLayoutManager/layoutToPoint.m
@@ -0,0 +1,125 @@
+/* Asking for the glyphs in a rectangle lays the text out down to the
+   rectangle, not to its end: the first lines of a long text are found with
+   the rest of it still unlaid, and are the lines found once all of it has
+   been laid out.  The layout manager used to lay out every text container
+   whole for any point it was asked about, so a text view showing the start
+   of a long text laid all of it out before it drew.  Laid out a part at a
+   time to its end, a text of many attribute runs (every other word in
+   another colour) still costs time in proportion to its length. */
+#include "Testing.h"
+
+#include <Foundation/NSAutoreleasePool.h>
+#include <Foundation/NSDate.h>
+#include <Foundation/NSString.h>
+
+#include <AppKit/NSApplication.h>
+#include <AppKit/NSAttributedString.h>
+#include <AppKit/NSColor.h>
+#include <AppKit/NSLayoutManager.h>
+#include <AppKit/NSTextContainer.h>
+#include <AppKit/NSTextStorage.h>
+
+/* Lays out a text of lines lines to its last glyph, as asking for that
+   glyph's line fragment does: a part at a time. */
+static NSTimeInterval
+layOutToEnd(NSUInteger lines)
+{
+  NSAutoreleasePool *pool = [NSAutoreleasePool new];
+  NSMutableString *text = [NSMutableString string];
+  NSTextStorage *storage;
+  NSLayoutManager *lm;
+  NSTextContainer *tc;
+  NSDate *start;
+  NSTimeInterval elapsed;
+  NSUInteger i;
+
+  for (i = 0; i < lines; i++)
+    {
+      [text appendFormat: @"line %lu of a long text\n", (unsigned long)i];
+    }
+  storage = AUTORELEASE([[NSTextStorage alloc] initWithString: text]);
+  [storage beginEditing];
+  for (i = 0; i + 8 <= [text length]; i += 10)
+    {
+      [storage addAttribute: NSForegroundColorAttributeName
+                      value: [NSColor redColor]
+                      range: NSMakeRange(i, 5)];
+    }
+  [storage endEditing];
+  lm = AUTORELEASE([[NSLayoutManager alloc] init]);
+  tc = AUTORELEASE([[NSTextContainer alloc]
+    initWithContainerSize: NSMakeSize(400, 1e7)]);
+  [lm addTextContainer: tc];
+  [storage addLayoutManager: lm];
+
+  start = [NSDate date];
+  [lm lineFragmentRectForGlyphAtIndex: [lm numberOfGlyphs] - 1
+                       effectiveRange: NULL];
+  elapsed = -[start timeIntervalSinceNow];
+  [pool release];
+  return elapsed;
+}
+
+int
+main(int argc, const char **argv)
+{
+  NSTimeInterval small;
+  NSTimeInterval large;
+  NSMutableString *text;
+  NSTextStorage *storage;
+  NSLayoutManager *lm;
+  NSTextContainer *tc;
+  NSRange top;
+  NSRange again;
+  NSUInteger glyphs;
+  NSUInteger i;
+
+  START_SET("NSLayoutManager layout to a point")
+
+  NS_DURING
+    [NSApplication sharedApplication];
+  NS_HANDLER
+    if ([[localException name] isEqualToString: NSInternalInconsistencyException])
+      SKIP("It looks like GNUstep backend is not yet installed")
+  NS_ENDHANDLER
+
+  text = [NSMutableString string];
+  for (i = 0; i < 10000; i++)
+    {
+      [text appendFormat: @"line %lu of a long text\n", (unsigned long)i];
+    }
+  storage = AUTORELEASE([[NSTextStorage alloc] initWithString: text]);
+  lm = AUTORELEASE([[NSLayoutManager alloc] init]);
+  tc = AUTORELEASE([[NSTextContainer alloc]
+    initWithContainerSize: NSMakeSize(400, 1e7)]);
+  [lm addTextContainer: tc];
+  [storage addLayoutManager: lm];
+  glyphs = [lm numberOfGlyphs];
+
+  top = [lm glyphRangeForBoundingRect: NSMakeRect(0, 0, 400, 100)
+                      inTextContainer: tc];
+  PASS(top.location == 0 && top.length > 0,
+       "the first lines are found");
+  PASS(NSMaxRange(top) < glyphs / 10,
+       "and they are a few of the text's lines");
+  PASS([lm firstUnlaidGlyphIndex] < glyphs / 10,
+       "the rest of the text is not laid out");
+
+  [lm glyphRangeForTextContainer: tc];
+  PASS([lm firstUnlaidGlyphIndex] == glyphs,
+       "laid out to its end, the text is laid out whole");
+  again = [lm glyphRangeForBoundingRect: NSMakeRect(0, 0, 400, 100)
+                        inTextContainer: tc];
+  PASS(NSEqualRanges(top, again),
+       "the first lines are the same once all of it is laid out");
+
+  layOutToEnd(250);
+  small = layOutToEnd(2000);
+  large = layOutToEnd(16000);
+  PASS(large < small * 24,
+       "laid out a part at a time, a text 8x as long takes less than 24x"
+       " as long (%.3fs, then %.3fs)", small, large);
+
+  END_SET("NSLayoutManager layout to a point")
+  return 0;
+}
