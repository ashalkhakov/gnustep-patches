+/* A pop-up item shared by the templates that have it there, or a view. */
+@interface GSPredicateEditorCriterion : NSObject
+{
+@public
+  NSString       *title;	// nil for a view
+  NSUInteger      level;
+  NSMutableArray *children;
+  NSMutableArray *templates;	// the templates it belongs to
+  NSMutableArray *indexes;	// for each, its item in that template's pop-up
+}
+- (NSUInteger) indexForTemplate: (id)template;
+@end
+
+@implementation GSPredicateEditorCriterion
+
+- (id) init
+{
+  if ((self = [super init]) != nil)
+    {
+      children = [NSMutableArray new];
+      templates = [NSMutableArray new];
+      indexes = [NSMutableArray new];
+    }
+  return self;
+}
+
+- (void) dealloc
+{
+  RELEASE(title);
+  RELEASE(children);
+  RELEASE(templates);
+  RELEASE(indexes);
+  [super dealloc];
+}
+
+- (NSUInteger) indexForTemplate: (id)template
+{
+  NSUInteger i = [templates indexOfObjectIdenticalTo: template];
+
+  if (i == NSNotFound)
+    {
+      return NSNotFound;
+    }
+
+  return [[indexes objectAtIndex: i] unsignedIntegerValue];
+}
+
+- (NSString *) description
+{
+  return title != nil ? title : @"";
+}
+
+@end
+
