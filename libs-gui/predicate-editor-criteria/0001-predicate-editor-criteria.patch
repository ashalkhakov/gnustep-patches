+#import <AppKit/NSTextField.h>
+#import <Additions/GNUstepGUI/GSXibKeyedUnarchiver.h>
+
+/* The values checked here are the ones AppKit gives for PredicateEditor.xib
+ * when it is compiled by ibtool and loaded on macOS.
+ */
+static NSPredicateEditor *
+editorAt(NSArray *rootObjects, CGFloat y)
+{
+  NSEnumerator	*enumerator = [rootObjects objectEnumerator];
+  id		element;
+
+  while ((element = [enumerator nextObject]) != nil)
+    {
+      if ([element isKindOfClass: [NSPredicateEditor class]]
+	&& [element frame].origin.y == y)
+	{
+	  return element;
+	}
+    }
+  return nil;
+}
+
+static NSArray *
+keyPaths(NSArray *expressions)
+{
+  NSMutableArray	*paths = [NSMutableArray array];
+  NSEnumerator		*enumerator = [expressions objectEnumerator];
+  NSExpression		*expression;
+
+  while ((expression = [enumerator nextObject]) != nil)
+    {
+      [paths addObject: [expression keyPath]];
+    }
+  return paths;
+}
+
+static NSArray *
+numbers(NSUInteger count, ...)
+{
+  NSMutableArray	*array = [NSMutableArray array];
+  va_list		ap;
+  NSUInteger		i;
+
+  va_start(ap, count);
+  for (i = 0; i < count; i++)
+    {
+      [array addObject: [NSNumber numberWithUnsignedInteger:
+	va_arg(ap, NSUInteger)]];
+    }
+  va_end(ap);
+  return array;
+}
+
+int main()
+{
+  START_SET("GSXib5KeyedUnarchiver NSPredicateEditor tests")
+
+  NS_DURING
+    {
+      [NSApplication sharedApplication];
+    }
+  NS_HANDLER
+    {
+      if ([[localException name]
+	isEqualToString: NSInternalInconsistencyException ])
+	{
+	  SKIP("It looks like GNUstep backend is not yet installed")
+	}
+    }
+  NS_ENDHANDLER
+
+  NSData			*data;
+  GSXibKeyedUnarchiver		*unarchiver;
+  NSArray			*rootObjects;
+  NSPredicateEditor		*editor;
+  NSPredicateEditorRowTemplate	*compound;
+  NSPredicateEditorRowTemplate	*comparison;
+
+  data = [NSData dataWithContentsOfFile: @"PredicateEditor.xib"];
+  unarchiver = [GSXibKeyedUnarchiver unarchiverForReadingWithData: data];
+  rootObjects = [unarchiver decodeObjectForKey: @"IBDocument.RootObjects"];
+
+  editor = editorAt(rootObjects, 0);
+  PASS(editor != nil, "the fetch request's predicate editor was found")
+  PASS([editor nestingMode] == NSRuleEditorNestingModeCompound,
+    "nestingMode compound is compound nesting")
+  PASS([editor rowHeight] == 32.0, "rowHeight is the row height")
+  PASS([editor canRemoveAllRows], "canRemoveAllRows YES lets all rows go")
+  PASS([editor isEditable], "an editor is editable unless it says otherwise")
+  PASS([[editor rowTemplates] count] == 2, "both templates were read")
+
+  compound = [[editor rowTemplates] objectAtIndex: 0];
+  comparison = [[editor rowTemplates] objectAtIndex: 1];
+  PASS_EQUAL([compound compoundTypes], numbers(2, NSOrPredicateType,
+    NSAndPredicateType), "a compound template's types are its items' objects")
+  PASS_EQUAL([[[compound templateViews] objectAtIndex: 0] itemTitles],
+    ([NSArray arrayWithObjects: @"Any", @"All", nil]),
+    "and it shows the titles of its menu")
+  PASS([compound leftExpressions] == nil, "it has no left expressions")
+
+  PASS_EQUAL(keyPaths([comparison leftExpressions]),
+    ([NSArray arrayWithObjects: @"name", @"address", @"sign", nil]),
+    "a comparison template's left expressions are its first menu's objects")
+  PASS_EQUAL([comparison operators], numbers(5,
+    NSContainsPredicateOperatorType, NSBeginsWithPredicateOperatorType,
+    NSEndsWithPredicateOperatorType, NSEqualToPredicateOperatorType,
+    NSNotEqualToPredicateOperatorType),
+    "its operators are its second menu's objects")
+  PASS([comparison rightExpressionAttributeType] == NSStringAttributeType,
+    "the right expression object is the type of what is typed in")
+  PASS([comparison rightExpressions] == nil, "there is nothing to choose from")
+  PASS([[comparison templateViews] count] == 3
+    && [[[comparison templateViews] objectAtIndex: 2]
+	 isKindOfClass: [NSTextField class]],
+    "a field is made to type it in")
+  PASS_EQUAL([[[comparison templateViews] objectAtIndex: 1] itemTitles],
+    ([NSArray arrayWithObjects: @"contains", @"begins with", @"ends with",
+      @"is", @"is not", nil]),
+    "the operators show the titles of their menu")
+
+  [editor setObjectValue:
+    [NSPredicate predicateWithFormat: @"name CONTAINS 'a' OR sign == 'b'"]];
+  PASS([editor numberOfRows] == 3, "the editor shows a predicate")
+  PASS_EQUAL([[editor displayValuesForRow: 0] objectAtIndex: 0], @"Any",
+    "in the titles of the xib")
+  PASS_EQUAL([[editor predicate] predicateFormat],
+    [[NSPredicate predicateWithFormat: @"name CONTAINS 'a' OR sign == 'b'"]
+      predicateFormat],
+    "and reads it back")
+
+  editor = editorAt(rootObjects, 200);
+  PASS(editor != nil, "the other predicate editor was found")
+  PASS([editor nestingMode] == NSRuleEditorNestingModeList,
+    "nestingMode list is list nesting")
+  PASS([editor rowHeight] == 32.0, "no rowHeight is the usual height")
+  PASS(![editor canRemoveAllRows], "no canRemoveAllRows keeps a row")
+  comparison = [[editor rowTemplates] objectAtIndex: 0];
+  PASS([comparison rightExpressionAttributeType] == NSInteger32AttributeType,
+    "an integer right expression object is that type")
+  PASS_EQUAL([comparison operators], numbers(1, NSLessThanPredicateOperatorType),
+    "an operator of value 0 is less than")
+
+  END_SET("GSXib5KeyedUnarchiver NSPredicateEditor tests")
+  return 0;
+}
diff --git a/Tests/gui/NSPredicateEditor/criteria.m b/Tests/gui/NSPredicateEditor/criteria.m
new file mode 100644
index 000000000..964694b9c
--- /dev/null
+++ b/Tests/gui/NSPredicateEditor/criteria.m
@@ -0,0 +1,402 @@
+#include "Testing.h"
+
+#include <Foundation/NSArray.h>
+#include <Foundation/NSAutoreleasePool.h>
+#include <Foundation/NSExpression.h>
+#include <Foundation/NSNotification.h>
+#include <Foundation/NSPredicate.h>
+#include <Foundation/NSString.h>
+#include <Foundation/NSValue.h>
+#include <AppKit/NSApplication.h>
+#include <AppKit/NSButton.h>
+#include <AppKit/NSPopUpButton.h>
+#include <AppKit/NSPredicateEditor.h>
+#include <AppKit/NSPredicateEditorRowTemplate.h>
+#include <AppKit/NSTextField.h>
+
+/* What is checked here is what OS X 15 does with the same templates and
+ * the same steps.
+ */
+
+@interface Target : NSObject
+{
+@public
+  int fired;
+}
+- (void) changed: (id)sender;
+@end
+
+@implementation Target
+- (void) changed: (id)sender
+{
+  fired++;
+}
+@end
+
+static void
+collect(NSView *view, Class class, NSMutableArray *found)
+{
+  NSEnumerator *e = [[view subviews] objectEnumerator];
+  NSView *sub;
+
+  if ([view isKindOfClass: class])
+    {
+      [found addObject: view];
+    }
+  while ((sub = [e nextObject]) != nil)
+    {
+      collect(sub, class, found);
+    }
+}
+
+/* The pop-up of the row, at the place of the row, that offers the title. */
+static NSPopUpButton *
+popUpOffering(NSPredicateEditor *editor, NSInteger row, NSString *title)
+{
+  NSMutableArray *found = [NSMutableArray array];
+  NSEnumerator *e;
+  NSPopUpButton *popUp;
+
+  collect(editor, [NSPopUpButton class], found);
+  e = [found objectEnumerator];
+  while ((popUp = [e nextObject]) != nil)
+    {
+      NSRect frame = [popUp convertRect: [popUp bounds] toView: editor];
+
+      if ([popUp indexOfItemWithTitle: title] >= 0
+        && NSMinY(frame) >= row * [editor rowHeight]
+        && NSMinY(frame) < (row + 1) * [editor rowHeight])
+        {
+          return popUp;
+        }
+    }
+  return nil;
+}
+
+static NSButton *
+buttonOfRow(NSPredicateEditor *editor, NSInteger row, BOOL add)
+{
+  NSMutableArray *found = [NSMutableArray array];
+  NSEnumerator *e;
+  NSButton *button;
+
+  collect(editor, [NSButton class], found);
+  e = [found objectEnumerator];
+  while ((button = [e nextObject]) != nil)
+    {
+      NSRect frame = [button convertRect: [button bounds] toView: editor];
+
+      if (![button isKindOfClass: [NSPopUpButton class]]
+        && [button action] != NULL
+        && NSMinY(frame) >= row * [editor rowHeight]
+        && NSMinY(frame) < (row + 1) * [editor rowHeight]
+        && ([NSStringFromSelector([button action]) rangeOfString:
+              add ? @"add" : @"remove"].location != NSNotFound))
+        {
+          return button;
+        }
+    }
+  return nil;
+}
+
+static void
+choose(NSPopUpButton *popUp, NSString *title)
+{
+  [popUp selectItemWithTitle: title];
+  [popUp sendAction: [popUp action] to: [popUp target]];
+}
+
+static NSString *
+format(NSString *string)
+{
+  return [[NSPredicate predicateWithFormat: string] predicateFormat];
+}
+
+int
+main(int argc, char **argv)
+{
+  NSAutoreleasePool *pool = [NSAutoreleasePool new];
+  NSPredicateEditor *editor;
+  NSPredicateEditorRowTemplate *strings;
+  NSPredicateEditorRowTemplate *others;
+  NSPredicateEditorRowTemplate *numbers;
+  NSPredicateEditorRowTemplate *compound;
+  NSPopUpButton *popUp;
+  NSTextField *field;
+  Target *target;
+
+  START_SET("NSPredicateEditor criteria")
+
+  NS_DURING
+    {
+      [NSApplication sharedApplication];
+    }
+  NS_HANDLER
+    {
+      if ([[localException name] isEqualToString:
+        NSInternalInconsistencyException])
+        SKIP("It looks like GNUstep backend is not yet installed")
+    }
+  NS_ENDHANDLER
+
+  strings = AUTORELEASE([[NSPredicateEditorRowTemplate alloc]
+    initWithLeftExpressions: ([NSArray arrayWithObjects:
+                               [NSExpression expressionForKeyPath: @"name"],
+                               [NSExpression expressionForKeyPath: @"nick"],
+                               nil])
+rightExpressionAttributeType: NSStringAttributeType
+                   modifier: NSDirectPredicateModifier
+                  operators: ([NSArray arrayWithObjects:
+                               [NSNumber numberWithUnsignedInteger:
+                                 NSEqualToPredicateOperatorType],
+                               [NSNumber numberWithUnsignedInteger:
+                                 NSContainsPredicateOperatorType], nil])
+                    options: NSCaseInsensitivePredicateOption]);
+  numbers = AUTORELEASE([[NSPredicateEditorRowTemplate alloc]
+    initWithLeftExpressions: [NSArray arrayWithObject:
+                               [NSExpression expressionForKeyPath: @"age"]]
+rightExpressionAttributeType: NSInteger32AttributeType
+                   modifier: NSDirectPredicateModifier
+                  operators: ([NSArray arrayWithObjects:
+                               [NSNumber numberWithUnsignedInteger:
+                                 NSLessThanPredicateOperatorType],
+                               [NSNumber numberWithUnsignedInteger:
+                                 NSEqualToPredicateOperatorType], nil])
+                    options: 0]);
+  compound = AUTORELEASE([[NSPredicateEditorRowTemplate alloc]
+    initWithCompoundTypes: ([NSArray arrayWithObjects:
+      [NSNumber numberWithUnsignedInteger: NSAndPredicateType],
+      [NSNumber numberWithUnsignedInteger: NSOrPredicateType],
+      [NSNumber numberWithUnsignedInteger: NSNotPredicateType], nil])]);
+
+  editor = AUTORELEASE([[NSPredicateEditor alloc]
+    initWithFrame: NSMakeRect(0.0, 0.0, 700.0, 400.0)]);
+  [editor setRowTemplates:
+    [NSArray arrayWithObjects: compound, strings, numbers, nil]];
+  target = AUTORELEASE([[Target alloc] init]);
+  [editor setTarget: target];
+  [editor setAction: @selector(changed:)];
+
+  PASS([editor isFlipped], "a predicate editor is flipped");
+  PASS([editor delegate] == nil, "a predicate editor has no delegate");
+
+  [editor setObjectValue:
+    [NSPredicate predicateWithFormat: @"name ==[c] 'Ada' AND age < 3"]];
+  PASS(target->fired == 0, "setting a predicate does not send the action");
+  PASS([editor numberOfRows] == 3, "the predicate takes three rows");
+  PASS(NSHeight([editor frame]) == 3 * [editor rowHeight],
+       "the editor is as tall as its rows");
+  PASS_EQUAL([editor displayValuesForRow: 0],
+             ([NSArray arrayWithObjects: @"All",
+                @"of the following are true", nil]),
+             "a compound row shows the titles of its criteria");
+  PASS_EQUAL([[editor displayValuesForRow: 1] subarrayWithRange:
+               NSMakeRange(0, 2)],
+             ([NSArray arrayWithObjects: @"name", @"is", nil]),
+             "a comparison row shows the titles of its criteria");
+  field = [[editor displayValuesForRow: 1] objectAtIndex: 2];
+  PASS([field isKindOfClass: [NSTextField class]]
+       && [[field stringValue] isEqual: @"Ada"],
+       "and the field its value is typed in");
+  PASS_EQUAL([[editor predicate] predicateFormat],
+             format(@"name ==[c] 'Ada' AND age < 3"),
+             "the predicate is read back");
+
+  popUp = popUpOffering(editor, 1, @"age");
+  PASS(popUp != nil && [[popUp itemTitles] isEqual:
+         ([NSArray arrayWithObjects: @"name", @"nick", @"age", nil])],
+       "the left pop-up offers the left expressions of every template");
+  PASS_EQUAL([popUp titleOfSelectedItem], @"name",
+             "and shows the one of the row");
+  popUp = popUpOffering(editor, 1, @"contains");
+  PASS(popUp != nil && [[popUp itemTitles] isEqual:
+         ([NSArray arrayWithObjects: @"is", @"contains", nil])],
+       "the operator pop-up offers the operators of the row's template");
+  popUp = popUpOffering(editor, 0, @"Any");
+  PASS(popUp != nil && [[popUp itemTitles] isEqual:
+         ([NSArray arrayWithObjects: @"All", @"Any", @"None", nil])],
+       "the compound pop-up offers the compound types");
+
+  /* Choosing a left expression of another template switches the row. */
+  choose(popUpOffering(editor, 1, @"age"), @"age");
+  PASS(target->fired == 1, "choosing a criterion sends the action");
+  PASS_EQUAL([[editor displayValuesForRow: 1] subarrayWithRange:
+               NSMakeRange(0, 2)],
+             ([NSArray arrayWithObjects: @"age", @"is", nil]),
+             "the row keeps the operator the other template has too");
+  PASS_EQUAL([[[editor displayValuesForRow: 1] objectAtIndex: 2] stringValue],
+             @"", "and an empty value");
+  PASS_EQUAL([[editor predicate] predicateFormat],
+             format(@"age == 0 AND age < 3"),
+             "the predicate follows the template the row switched to");
+
+  choose(popUpOffering(editor, 1, @"is less than"), @"is less than");
+  PASS(target->fired == 2, "choosing an operator sends the action");
+  PASS_EQUAL([[editor predicate] predicateFormat],
+             format(@"age < 0 AND age < 3"), "the operator is the one chosen");
+  choose(popUpOffering(editor, 1, @"is less than"), @"is");
+
+  /* Typing in a row. */
+  field = [[editor displayValuesForRow: 1] objectAtIndex: 2];
+  [field setStringValue: @"7"];
+  [[NSNotificationCenter defaultCenter]
+    postNotificationName: NSControlTextDidChangeNotification object: field];
+  PASS(target->fired == 4, "typing in a row sends the action");
+  PASS_EQUAL([[editor predicate] predicateFormat],
+             format(@"age == 7 AND age < 3"), "what is typed is the value");
+
+  choose(popUpOffering(editor, 0, @"Any"), @"Any");
+  PASS(target->fired == 5, "choosing a compound type sends the action");
+  PASS_EQUAL([[editor predicate] predicateFormat],
+             format(@"age == 7 OR age < 3"), "the rows are joined by it");
+  choose(popUpOffering(editor, 0, @"Any"), @"All");
+
+  /* The buttons. */
+  PASS(buttonOfRow(editor, 0, YES) != nil && buttonOfRow(editor, 0, NO) != nil,
+       "a row has a button to add a row and one to remove it");
+  [buttonOfRow(editor, 0, YES) performClick: nil];
+  PASS(target->fired == 7, "adding a row sends the action");
+  PASS([editor numberOfRows] == 4
+       && [editor parentRowForRow: 1] == 0,
+       "the plus of a compound row adds a row beneath it");
+  PASS_EQUAL([[editor predicate] predicateFormat],
+             ([[NSPredicate predicateWithFormat: @"name ==[c] %@ AND age == 7 AND age < 3", @""] predicateFormat]),
+             "as its first, made of the first criteria");
+
+  [buttonOfRow(editor, 2, YES) performClick: nil];
+  PASS([editor numberOfRows] == 5 && [editor parentRowForRow: 3] == 0,
+       "the plus of a simple row adds one after it");
+  PASS_EQUAL([[editor predicate] predicateFormat],
+             ([[NSPredicate predicateWithFormat:
+               @"name ==[c] %@ AND age == 7 AND name ==[c] %@ AND age < 3",
+               @"", @""] predicateFormat]),
+             "alongside it");
+
+  [buttonOfRow(editor, 3, NO) performClick: nil];
+  [buttonOfRow(editor, 1, NO) performClick: nil];
+  PASS([editor numberOfRows] == 3, "the minus removes its row");
+  PASS_EQUAL([[editor predicate] predicateFormat],
+             format(@"age == 7 AND age < 3"),
+             "and the rest stays as it was");
+  PASS(NSHeight([editor frame]) == 3 * [editor rowHeight],
+       "the editor is as tall as its rows again");
+
+  [buttonOfRow(editor, 0, NO) performClick: nil];
+  PASS([editor numberOfRows] == 0 && [editor predicate] == nil,
+       "the minus of the compound row removes it with its rows");
+  PASS(NSHeight([editor frame]) == 0.0, "an empty editor has no height");
+
+  [editor setObjectValue: [NSPredicate predicateWithFormat: @"name == 'x'"]];
+  [editor setCanRemoveAllRows: NO];
+  PASS(![buttonOfRow(editor, 0, NO) isEnabled],
+       "the last row cannot be removed when all rows may not be");
+  [editor setCanRemoveAllRows: YES];
+  PASS([buttonOfRow(editor, 0, NO) isEnabled],
+       "and can when they may");
+
+  /* Templates with the same left expression share it. */
+  others = AUTORELEASE([[NSPredicateEditorRowTemplate alloc]
+    initWithLeftExpressions: [NSArray arrayWithObject:
+                               [NSExpression expressionForKeyPath: @"name"]]
+rightExpressionAttributeType: NSStringAttributeType
+                   modifier: NSDirectPredicateModifier
+                  operators: ([NSArray arrayWithObjects:
+                               [NSNumber numberWithUnsignedInteger:
+                                 NSBeginsWithPredicateOperatorType],
+                               [NSNumber numberWithUnsignedInteger:
+                                 NSEqualToPredicateOperatorType], nil])
+                    options: 0]);
+  [editor setRowTemplates:
+    [NSArray arrayWithObjects: compound, strings, others, nil]];
+  PASS([editor numberOfRows] == 1, "new templates keep the rows");
+  PASS_EQUAL([[editor predicate] predicateFormat], format(@"name ==[c] 'x'"),
+             "that they can show, as the template shows them");
+  [editor setObjectValue: [NSPredicate predicateWithFormat:
+    @"name ==[c] 'Ada' AND name BEGINSWITH 'B'"]];
+  popUp = popUpOffering(editor, 1, @"begins with");
+  PASS(popUp != nil && [[popUp itemTitles] isEqual:
+         ([NSArray arrayWithObjects: @"is", @"contains", @"begins with", nil])],
+       "the operators of templates sharing a left expression are offered together");
+  choose(popUp, @"begins with");
+  PASS_EQUAL([[editor predicate] predicateFormat],
+             ([[NSPredicate predicateWithFormat:
+               @"name BEGINSWITH %@ AND name BEGINSWITH 'B'", @""] predicateFormat]),
+             "an operator of the other template switches the row to it");
+
+  /* What no template can show. */
+  PASS_EXCEPTION([editor setObjectValue:
+                   [NSPredicate predicateWithFormat: @"weight > 3"]],
+                 NSInvalidArgumentException,
+                 "a predicate no template can show is refused");
+  PASS([editor numberOfRows] == 3, "and the rows stay as they were");
+
+  /* Parts no template can show are left out. */
+  {
+    NSPredicateEditor *parts;
+    NSPredicate *p;
+
+    parts = AUTORELEASE([[NSPredicateEditor alloc]
+      initWithFrame: NSMakeRect(0.0, 0.0, 700.0, 400.0)]);
+    [parts setRowTemplates: [NSArray arrayWithObjects: compound, numbers, nil]];
+
+    [parts setObjectValue:
+      [NSPredicate predicateWithFormat: @"age < 3 AND weight > 1"]];
+    PASS([parts numberOfRows] == 2, "a part no template can show is left out");
+    PASS_EQUAL([[parts predicate] predicateFormat], format(@"age < 3"),
+               "and the rest is shown");
+
+    [parts setObjectValue:
+      [NSPredicate predicateWithFormat: @"weight > 1 AND height > 2"]];
+    PASS([parts numberOfRows] == 1
+         && [[parts predicate] evaluateWithObject: nil],
+         "with none of its parts shown, an All has no rows, and holds");
+
+    [parts setObjectValue:
+      [NSPredicate predicateWithFormat: @"age < 3 AND (weight > 1 OR height > 2)"]];
+    PASS([parts numberOfRows] == 3, "an Any with none of its parts keeps its row");
+    p = [[(NSCompoundPredicate *)[parts predicate] subpredicates] lastObject];
+    PASS([p isKindOfClass: [NSCompoundPredicate class]]
+         && [[(NSCompoundPredicate *)p subpredicates] count] == 0
+         && ![p evaluateWithObject: nil],
+         "and holds for nothing");
+
+    [parts setObjectValue:
+      [NSPredicate predicateWithFormat: @"age < 3 AND (age == 1 OR weight > 2)"]];
+    PASS([parts numberOfRows] == 4 && [parts parentRowForRow: 3] == 2,
+         "a part within a part is left out too");
+    p = [[(NSCompoundPredicate *)[parts predicate] subpredicates] lastObject];
+    PASS([p isKindOfClass: [NSCompoundPredicate class]]
+         && [[(NSCompoundPredicate *)p subpredicates] count] == 1,
+         "an Any of one row is a compound of one");
+
+    PASS_EXCEPTION([parts setObjectValue:
+                     [NSPredicate predicateWithFormat: @"NOT weight > 1"]],
+                   NSInvalidArgumentException,
+                   "a NOT is not shown without its part");
+  }
+
+  [editor setObjectValue: [NSPredicate predicateWithFormat: @"nick == 'x'"]];
+  PASS([editor numberOfRows] == 1
+       && [editor rowTypeForRow: 0] == NSRuleEditorRowTypeSimple,
+       "a comparison alone takes one simple row");
+
+  [editor setObjectValue: [NSPredicate predicateWithFormat:
+    @"NOT (name == 'a' OR nick CONTAINS[c] 'x')"]];
+  PASS([editor numberOfRows] == 4, "a not of an or takes four rows");
+  PASS_EQUAL([[editor displayValuesForRow: 0] objectAtIndex: 0], @"None",
+             "the not is shown as none");
+  PASS_EQUAL([[editor predicate] predicateFormat],
+             format(@"NOT (name == 'a' OR nick CONTAINS[c] 'x')"),
+             "and it is read back");
+
+  [editor setObjectValue: nil];
+  [editor addRow: nil];
+  PASS([editor numberOfRows] == 2, "adding to an empty editor adds two rows");
+  PASS_EQUAL([[editor predicate] predicateFormat], ([[NSPredicate predicateWithFormat: @"name ==[c] %@", @""] predicateFormat]),
+             "a compound row with one row is that row");
+
+  END_SET("NSPredicateEditor criteria")
+
+  [pool release];
+  return 0;
+}
diff --git a/Tests/gui/NSPredicateEditorRowTemplate/keyPaths.m b/Tests/gui/NSPredicateEditorRowTemplate/keyPaths.m
new file mode 100644
index 000000000..28a54ca80
--- /dev/null
+++ b/Tests/gui/NSPredicateEditorRowTemplate/keyPaths.m
@@ -0,0 +1,335 @@
+#include "Testing.h"
+
+#include <Foundation/NSArray.h>
+#include <Foundation/NSAutoreleasePool.h>
+#include <Foundation/NSDictionary.h>
+#include <Foundation/NSExpression.h>
+#include <Foundation/NSKeyedArchiver.h>
+#include <Foundation/NSPredicate.h>
+#include <Foundation/NSString.h>
+#include <Foundation/NSValue.h>
+#include <AppKit/NSApplication.h>
+#include <AppKit/NSDatePicker.h>
+#include <AppKit/NSMenuItem.h>
+#include <AppKit/NSPopUpButton.h>
+#include <AppKit/NSPredicateEditorRowTemplate.h>
+#include <AppKit/NSTextField.h>
+
+/* What is checked here is what OS X 15 does: CoreData's entity and
+ * attribute descriptions are stood in for by objects that answer the same
+ * messages, since GNUstep has no CoreData of its own.
+ */
+
+@interface Attribute : NSObject
+{
+  NSAttributeType type;
+}
++ (id) attributeOfType: (NSAttributeType)aType;
+- (NSAttributeType) attributeType;
+@end
+
+@implementation Attribute
++ (id) attributeOfType: (NSAttributeType)aType
+{
+  Attribute *a = AUTORELEASE([[self alloc] init]);
+
+  a->type = aType;
+  return a;
+}
+- (NSAttributeType) attributeType
+{
+  return type;
+}
+@end
+
+@interface Entity : NSObject
+{
+@public
+  NSDictionary *attributes;
+  NSDictionary *relationships;
+}
+- (NSDictionary *) attributesByName;
+- (NSDictionary *) relationshipsByName;
+- (NSString *) name;
+@end
+
+@implementation Entity
+- (NSDictionary *) attributesByName
+{
+  return attributes;
+}
+- (NSDictionary *) relationshipsByName
+{
+  return relationships;
+}
+- (NSString *) name
+{
+  return @"Person";
+}
+@end
+
+@interface Relationship : NSObject
+{
+@public
+  Entity *destination;
+}
+- (id) destinationEntity;
+@end
+
+@implementation Relationship
+- (id) destinationEntity
+{
+  return destination;
+}
+@end
+
+static NSArray *
+operators(NSPredicateOperatorType *types, NSUInteger count)
+{
+  NSMutableArray *a = [NSMutableArray array];
+  NSUInteger i;
+
+  for (i = 0; i < count; i++)
+    {
+      [a addObject: [NSNumber numberWithUnsignedInteger: types[i]]];
+    }
+  return a;
+}
+
+static NSArray *
+representedObjects(NSPopUpButton *popUp)
+{
+  NSMutableArray *a = [NSMutableArray array];
+  NSInteger i;
+
+  for (i = 0; i < [popUp numberOfItems]; i++)
+    {
+      id o = [[popUp itemAtIndex: i] representedObject];
+
+      if (o != nil)
+        {
+          [a addObject: o];
+        }
+    }
+  return a;
+}
+
+int
+main(int argc, char **argv)
+{
+  NSAutoreleasePool *pool = [NSAutoreleasePool new];
+  NSPredicateOperatorType ordered[] = {
+    NSEqualToPredicateOperatorType, NSNotEqualToPredicateOperatorType,
+    NSLessThanPredicateOperatorType, NSGreaterThanPredicateOperatorType,
+    NSLessThanOrEqualToPredicateOperatorType,
+    NSGreaterThanOrEqualToPredicateOperatorType };
+  NSPredicateOperatorType strings[] = {
+    NSContainsPredicateOperatorType, NSEqualToPredicateOperatorType,
+    NSNotEqualToPredicateOperatorType, NSBeginsWithPredicateOperatorType,
+    NSEndsWithPredicateOperatorType };
+  Entity *person;
+  Entity *place;
+  Relationship *home;
+  NSArray *templates;
+  NSPredicateEditorRowTemplate *template;
+  NSPredicateEditorRowTemplate *compound;
+  NSPredicate *a;
+  NSPredicate *b;
+
+  START_SET("NSPredicateEditorRowTemplate key paths")
+
+  NS_DURING
+    {
+      [NSApplication sharedApplication];
+    }
+  NS_HANDLER
+    {
+      if ([[localException name] isEqualToString:
+        NSInternalInconsistencyException])
+        SKIP("It looks like GNUstep backend is not yet installed")
+    }
+  NS_ENDHANDLER
+
+  place = AUTORELEASE([[Entity alloc] init]);
+  place->attributes = [[NSDictionary alloc] initWithObjectsAndKeys:
+    [Attribute attributeOfType: NSStringAttributeType], @"city", nil];
+  home = AUTORELEASE([[Relationship alloc] init]);
+  home->destination = place;
+  person = AUTORELEASE([[Entity alloc] init]);
+  person->attributes = [[NSDictionary alloc] initWithObjectsAndKeys:
+    [Attribute attributeOfType: NSStringAttributeType], @"name",
+    [Attribute attributeOfType: NSInteger16AttributeType], @"age",
+    [Attribute attributeOfType: NSDoubleAttributeType], @"weight",
+    [Attribute attributeOfType: NSBooleanAttributeType], @"flag",
+    [Attribute attributeOfType: NSDateAttributeType], @"born",
+    [Attribute attributeOfType: NSBinaryDataAttributeType], @"blob", nil];
+  person->relationships = [[NSDictionary alloc] initWithObjectsAndKeys:
+    home, @"home", nil];
+
+  templates = [NSPredicateEditorRowTemplate
+    templatesWithAttributeKeyPaths: ([NSArray arrayWithObjects: @"name",
+      @"age", @"weight", @"flag", @"born", @"home.city", nil])
+               inEntityDescription: (NSEntityDescription *)person];
+  PASS([templates count] == 6, "there is a template for each key path");
+
+  template = [templates objectAtIndex: 0];
+  PASS_EQUAL([template leftExpressions],
+             [NSArray arrayWithObject: [NSExpression expressionForKeyPath: @"name"]],
+             "a template's left expression is its key path");
+  PASS_EQUAL([template operators], operators(strings, 5),
+             "a string is offered contains, is, is not, begins and ends with");
+  PASS([template rightExpressionAttributeType] == NSStringAttributeType
+       && [template options] == 0
+       && [template modifier] == NSDirectPredicateModifier,
+       "with the type of the attribute, no options, and no modifier");
+  PASS([[[template templateViews] objectAtIndex: 2]
+         isKindOfClass: [NSTextField class]],
+       "and a field to type the value in");
+
+  PASS_EQUAL([[templates objectAtIndex: 1] operators], operators(ordered, 6),
+             "an integer is offered the six orderings");
+  PASS_EQUAL([[templates objectAtIndex: 2] operators], operators(ordered, 6),
+             "so is a double");
+  PASS_EQUAL([[templates objectAtIndex: 3] operators], operators(ordered, 2),
+             "a boolean is offered is and is not");
+  PASS([[[[templates objectAtIndex: 3] templateViews] objectAtIndex: 2]
+         isKindOfClass: [NSTextField class]],
+       "with a field to type it in");
+  PASS_EQUAL([[templates objectAtIndex: 4] operators], operators(ordered, 6),
+             "a date is offered the six orderings");
+  PASS([[[[templates objectAtIndex: 4] templateViews] objectAtIndex: 2]
+         isKindOfClass: [NSDatePicker class]],
+       "with a date picker");
+  PASS([[templates objectAtIndex: 5] rightExpressionAttributeType]
+         == NSStringAttributeType,
+       "a key path through a relationship ends at its attribute");
+
+  templates = [NSPredicateEditorRowTemplate
+    templatesWithAttributeKeyPaths: ([NSArray arrayWithObjects: @"name",
+      @"home.city", @"age", @"name", @"name", nil])
+               inEntityDescription: (NSEntityDescription *)person];
+  PASS([templates count] == 3,
+       "key paths of the same type, one after another, share a template");
+  PASS_EQUAL([[templates objectAtIndex: 0] leftExpressions],
+             ([NSArray arrayWithObjects:
+                [NSExpression expressionForKeyPath: @"name"],
+                [NSExpression expressionForKeyPath: @"home.city"], nil]),
+             "in their order");
+  PASS([[[templates objectAtIndex: 2] leftExpressions] count] == 2,
+       "a key path given twice is there twice");
+
+  PASS_EXCEPTION([NSPredicateEditorRowTemplate
+                   templatesWithAttributeKeyPaths: [NSArray arrayWithObject: @"blob"]
+                              inEntityDescription: (NSEntityDescription *)person],
+                 NSInvalidArgumentException,
+                 "there are no operators for binary data");
+  PASS_EXCEPTION([NSPredicateEditorRowTemplate
+                   templatesWithAttributeKeyPaths: [NSArray arrayWithObject: @"missing"]
+                              inEntityDescription: (NSEntityDescription *)person],
+                 NSInvalidArgumentException,
+                 "a key the entity has no attribute for is refused");
+
+  /* The items of the pop-ups stand for what they offer. */
+  template = [templates objectAtIndex: 0];
+  PASS_EQUAL(representedObjects([[template templateViews] objectAtIndex: 0]),
+             [template leftExpressions],
+             "the items of the left pop-up stand for the left expressions");
+  PASS_EQUAL(representedObjects([[template templateViews] objectAtIndex: 1]),
+             [template operators],
+             "those of the operator pop-up for the operators");
+
+  /* Compound rows. */
+  compound = AUTORELEASE([[NSPredicateEditorRowTemplate alloc]
+    initWithCompoundTypes: ([NSArray arrayWithObjects:
+      [NSNumber numberWithUnsignedInteger: NSAndPredicateType],
+      [NSNumber numberWithUnsignedInteger: NSOrPredicateType],
+      [NSNumber numberWithUnsignedInteger: NSNotPredicateType], nil])]);
+  PASS_EQUAL(representedObjects([[compound templateViews] objectAtIndex: 0]),
+             [compound compoundTypes],
+             "the items of the compound pop-up stand for the compound types");
+  a = [NSPredicate predicateWithFormat: @"a == 1"];
+  b = [NSPredicate predicateWithFormat: @"b == 2"];
+  {
+    NSPredicate *p = [compound predicateWithSubpredicates:
+      [NSArray arrayWithObject: a]];
+
+    PASS([p isKindOfClass: [NSCompoundPredicate class]]
+         && [(NSCompoundPredicate *)p compoundPredicateType] == NSAndPredicateType
+         && [[(NSCompoundPredicate *)p subpredicates] isEqual:
+           [NSArray arrayWithObject: a]],
+         "all of one row is an AND of that row");
+    PASS([[compound predicateWithSubpredicates: [NSArray array]]
+           evaluateWithObject: nil],
+         "all of no rows holds for anything");
+    [compound setPredicate: [NSCompoundPredicate orPredicateWithSubpredicates:
+      [NSArray arrayWithObject: a]]];
+    PASS(![[compound predicateWithSubpredicates: [NSArray array]]
+            evaluateWithObject: nil],
+         "any of no rows holds for nothing");
+  }
+  [compound setPredicate: [NSCompoundPredicate notPredicateWithSubpredicate: a]];
+  PASS_EQUAL([[compound predicateWithSubpredicates: [NSArray arrayWithObject: a]]
+               predicateFormat],
+             [[NSPredicate predicateWithFormat: @"NOT a == 1"] predicateFormat],
+             "none of one row is not that row");
+  PASS_EQUAL([[compound predicateWithSubpredicates:
+                 ([NSArray arrayWithObjects: a, b, nil])] predicateFormat],
+             [[NSPredicate predicateWithFormat: @"NOT (a == 1 OR b == 2)"]
+               predicateFormat],
+             "none of several rows is not any of them");
+
+  /* Keyed archives keep a template as its views, as OS X does. */
+  {
+    NSPredicateEditorRowTemplate *choices;
+    NSPredicateEditorRowTemplate *back;
+    NSData *data;
+
+    template = AUTORELEASE([[NSPredicateEditorRowTemplate alloc]
+      initWithLeftExpressions: ([NSArray arrayWithObjects:
+                                 [NSExpression expressionForKeyPath: @"name"],
+                                 [NSExpression expressionForKeyPath: @"nick"],
+                                 nil])
+  rightExpressionAttributeType: NSStringAttributeType
+                     modifier: NSAnyPredicateModifier
+                    operators: operators(strings, 2)
+                      options: NSCaseInsensitivePredicateOption]);
+    data = [NSKeyedArchiver archivedDataWithRootObject: template];
+    back = [NSKeyedUnarchiver unarchiveObjectWithData: data];
+    PASS_EQUAL([back leftExpressions], [template leftExpressions],
+               "an archived template keeps its left expressions");
+    PASS_EQUAL([back operators], [template operators],
+               "its operators");
+    PASS([back rightExpressionAttributeType] == NSStringAttributeType
+         && [back rightExpressions] == nil,
+         "the type of what is typed in");
+    PASS([back options] == NSCaseInsensitivePredicateOption
+         && [back modifier] == NSAnyPredicateModifier,
+         "its options and its modifier");
+    PASS([[back templateViews] count] == 3, "and its views");
+
+    choices = AUTORELEASE([[NSPredicateEditorRowTemplate alloc]
+      initWithLeftExpressions: [NSArray arrayWithObject:
+                                 [NSExpression expressionForKeyPath: @"kind"]]
+             rightExpressions: ([NSArray arrayWithObjects:
+                                 [NSExpression expressionForConstantValue: @"a"],
+                                 [NSExpression expressionForConstantValue: @"b"],
+                                 nil])
+                     modifier: NSDirectPredicateModifier
+                    operators: operators(ordered, 1)
+                      options: 0]);
+    back = [NSKeyedUnarchiver unarchiveObjectWithData:
+      [NSKeyedArchiver archivedDataWithRootObject: choices]];
+    PASS_EQUAL([back rightExpressions], [choices rightExpressions],
+               "an archived template keeps the expressions to choose from");
+
+    back = [NSKeyedUnarchiver unarchiveObjectWithData:
+      [NSKeyedArchiver archivedDataWithRootObject: compound]];
+    PASS_EQUAL([back compoundTypes], [compound compoundTypes],
+               "an archived compound template keeps its compound types");
+  }
+
+  END_SET("NSPredicateEditorRowTemplate key paths")
+
+  [pool release];
+  return 0;
+}
diff --git a/Tests/gui/NSRuleEditor/rows.m b/Tests/gui/NSRuleEditor/rows.m
new file mode 100644
index 000000000..91eb2f007
--- /dev/null
+++ b/Tests/gui/NSRuleEditor/rows.m
@@ -0,0 +1,320 @@
+#include "Testing.h"
+
+#include <Foundation/NSArray.h>
+#include <Foundation/NSAutoreleasePool.h>
+#include <Foundation/NSDictionary.h>
+#include <Foundation/NSKeyedArchiver.h>
+#include <Foundation/NSString.h>
+#include <AppKit/NSApplication.h>
+#include <AppKit/NSButton.h>
+#include <AppKit/NSPopUpButton.h>
+#include <AppKit/NSRuleEditor.h>
+#include <AppKit/NSTextField.h>
+
+/* A rule editor shows each criterion of a row as OS X does: a pop-up of the
+ * criterion and its brothers when it has any, a label when it has none, and
+ * the view the delegate gives, as it is.
+ */
+
+@interface Tree : NSObject
+{
+@public
+  NSDictionary *children;
+  int fired;
+}
+@end
+
+@implementation Tree
+
+- (id) init
+{
+  if ((self = [super init]) != nil)
+    {
+      children = [[NSDictionary alloc] initWithObjectsAndKeys:
+        [NSArray arrayWithObjects: @"name", @"age", nil], @"",
+        [NSArray arrayWithObjects: @"is", @"contains", nil], @"name",
+        [NSArray arrayWithObjects: @"is", nil], @"age",
+        [NSArray arrayWithObjects: @"value", nil], @"is",
+        [NSArray arrayWithObjects: @"value", nil], @"contains",
+        [NSArray arrayWithObjects: @"All", @"Any", nil], @"compound",
+        [NSArray arrayWithObjects: @"of these", nil], @"All",
+        [NSArray arrayWithObjects: @"of these", nil], @"Any",
+        nil];
+    }
+  return self;
+}
+
+- (void) dealloc
+{
+  RELEASE(children);
+  [super dealloc];
+}
+
+- (NSArray *) childrenOf: (id)criterion type: (NSRuleEditorRowType)type
+{
+  if (criterion == nil)
+    {
+      criterion = (type == NSRuleEditorRowTypeCompound ? @"compound" : @"");
+    }
+  return [children objectForKey: criterion];
+}
+
+- (NSInteger) ruleEditor: (NSRuleEditor *)editor
+numberOfChildrenForCriterion: (id)criterion
+             withRowType: (NSRuleEditorRowType)type
+{
+  return [[self childrenOf: criterion type: type] count];
+}
+
+- (id) ruleEditor: (NSRuleEditor *)editor
+            child: (NSInteger)index
+     forCriterion: (id)criterion
+      withRowType: (NSRuleEditorRowType)type
+{
+  return [[self childrenOf: criterion type: type] objectAtIndex: index];
+}
+
+- (id) ruleEditor: (NSRuleEditor *)editor
+displayValueForCriterion: (id)criterion
+            inRow: (NSInteger)row
+{
+  if ([criterion isEqual: @"value"])
+    {
+      return AUTORELEASE([[NSTextField alloc]
+        initWithFrame: NSMakeRect(0.0, 0.0, 80.0, 22.0)]);
+    }
+  return criterion;
+}
+
+- (void) changed: (id)sender
+{
+  fired++;
+}
+
+@end
+
+static void
+collect(NSView *view, Class class, NSMutableArray *found)
+{
+  NSEnumerator *e = [[view subviews] objectEnumerator];
+  NSView *sub;
+
+  if ([view isKindOfClass: class])
+    {
+      [found addObject: view];
+    }
+  while ((sub = [e nextObject]) != nil)
+    {
+      collect(sub, class, found);
+    }
+}
+
+/* The views of the row, as they are laid out from the left. */
+static NSArray *
+viewsOfRow(NSRuleEditor *editor, NSInteger row, Class class)
+{
+  NSMutableArray *found = [NSMutableArray array];
+  NSMutableArray *inRow = [NSMutableArray array];
+  NSEnumerator *e;
+  NSView *view;
+
+  collect(editor, class, found);
+  e = [found objectEnumerator];
+  while ((view = [e nextObject]) != nil)
+    {
+      NSRect frame = [view convertRect: [view bounds] toView: editor];
+
+      if (NSMinY(frame) >= row * [editor rowHeight]
+        && NSMinY(frame) < (row + 1) * [editor rowHeight])
+        {
+          NSUInteger i = 0;
+
+          while (i < [inRow count]
+            && NSMinX([[inRow objectAtIndex: i] frame]) < NSMinX([view frame]))
+            {
+              i++;
+            }
+          [inRow insertObject: view atIndex: i];
+        }
+    }
+  return inRow;
+}
+
+static NSButton *
+button(NSRuleEditor *editor, NSInteger row, NSString *name)
+{
+  NSEnumerator *e = [viewsOfRow(editor, row, [NSButton class]) objectEnumerator];
+  NSButton *b;
+
+  while ((b = [e nextObject]) != nil)
+    {
+      if (![b isKindOfClass: [NSPopUpButton class]]
+        && [NSStringFromSelector([b action]) rangeOfString: name].location
+          != NSNotFound)
+        {
+          return b;
+        }
+    }
+  return nil;
+}
+
+int
+main(int argc, char **argv)
+{
+  NSAutoreleasePool *pool = [NSAutoreleasePool new];
+  NSRuleEditor *editor;
+  NSArray *views;
+  NSPopUpButton *popUp;
+  Tree *tree;
+
+  START_SET("NSRuleEditor rows")
+
+  NS_DURING
+    {
+      [NSApplication sharedApplication];
+    }
+  NS_HANDLER
+    {
+      if ([[localException name] isEqualToString:
+        NSInternalInconsistencyException])
+        SKIP("It looks like GNUstep backend is not yet installed")
+    }
+  NS_ENDHANDLER
+
+  tree = AUTORELEASE([[Tree alloc] init]);
+  editor = AUTORELEASE([[NSRuleEditor alloc]
+    initWithFrame: NSMakeRect(0.0, 0.0, 500.0, 300.0)]);
+  [editor setDelegate: tree];
+  [editor setTarget: tree];
+  [editor setAction: @selector(changed:)];
+
+  PASS([editor isFlipped], "a rule editor is flipped");
+
+  [editor addRow: nil];
+  PASS(tree->fired == 0, "adding a row from code does not send the action");
+  PASS(NSHeight([editor frame]) == 2 * [editor rowHeight],
+       "the editor is as tall as its rows");
+
+  views = viewsOfRow(editor, 0, [NSView class]);
+  popUp = nil;
+  {
+    NSEnumerator *e = [views objectEnumerator];
+    id v;
+
+    while ((v = [e nextObject]) != nil)
+      {
+        if ([v isKindOfClass: [NSPopUpButton class]])
+          {
+            popUp = v;
+            break;
+          }
+      }
+  }
+  PASS(popUp != nil && [[popUp itemTitles] isEqual:
+         ([NSArray arrayWithObjects: @"All", @"Any", nil])],
+       "a criterion with brothers is shown in a pop-up of them all");
+  {
+    NSArray *labels = viewsOfRow(editor, 0, [NSTextField class]);
+
+    PASS([labels count] == 1
+         && [[[labels objectAtIndex: 0] stringValue] isEqual: @"of these"]
+         && ![[labels objectAtIndex: 0] isEditable],
+         "a criterion with no brothers is shown as a label");
+  }
+
+  views = viewsOfRow(editor, 1, [NSPopUpButton class]);
+  PASS([views count] == 2
+       && [[[views objectAtIndex: 0] itemTitles] isEqual:
+         ([NSArray arrayWithObjects: @"name", @"age", nil])]
+       && [[[views objectAtIndex: 1] itemTitles] isEqual:
+         ([NSArray arrayWithObjects: @"is", @"contains", nil])],
+       "each level of a row has a pop-up of its own");
+  PASS([[[editor displayValuesForRow: 1] objectAtIndex: 2]
+         isKindOfClass: [NSTextField class]]
+       && [viewsOfRow(editor, 1, [NSTextField class]) containsObject:
+         [[editor displayValuesForRow: 1] objectAtIndex: 2]],
+       "a view the delegate gives is shown as it is");
+  PASS([viewsOfRow(editor, 1, [NSView class]) count] > 0
+       && NSMinX([[views objectAtIndex: 0] convertRect:
+         [[views objectAtIndex: 0] bounds] toView: editor])
+       > NSMinX([popUp convertRect: [popUp bounds] toView: editor]),
+       "a subrow is indented below the row it belongs to");
+
+  /* Choosing walks the row on from what was chosen. */
+  popUp = [viewsOfRow(editor, 1, [NSPopUpButton class]) objectAtIndex: 1];
+  [popUp selectItemWithTitle: @"contains"];
+  [popUp sendAction: [popUp action] to: [popUp target]];
+  PASS(tree->fired == 1, "choosing a criterion sends the action");
+  PASS_EQUAL([editor criteriaForRow: 1],
+             ([NSArray arrayWithObjects: @"name", @"contains", @"value", nil]),
+             "and gives the row what follows from it");
+
+  popUp = [viewsOfRow(editor, 1, [NSPopUpButton class]) objectAtIndex: 0];
+  [popUp selectItemWithTitle: @"age"];
+  [popUp sendAction: [popUp action] to: [popUp target]];
+  PASS_EQUAL([editor criteriaForRow: 1],
+             ([NSArray arrayWithObjects: @"age", @"is", @"value", nil]),
+             "a row takes the first of what it cannot keep");
+  views = viewsOfRow(editor, 1, [NSTextField class]);
+  PASS([views count] == 2,
+       "a lone criterion after a choice is shown as a label");
+
+  popUp = [viewsOfRow(editor, 1, [NSPopUpButton class]) objectAtIndex: 0];
+  [popUp selectItemWithTitle: @"name"];
+  [popUp sendAction: [popUp action] to: [popUp target]];
+  PASS_EQUAL([editor criteriaForRow: 1],
+             ([NSArray arrayWithObjects: @"name", @"is", @"value", nil]),
+             "and keeps what it can");
+
+  /* The buttons. */
+  [button(editor, 1, @"add") performClick: nil];
+  PASS([editor numberOfRows] == 3 && [editor parentRowForRow: 2] == 0,
+       "the plus of a simple row adds a row alongside it");
+  PASS(tree->fired == 4, "and sends the action");
+  [button(editor, 0, @"add") performClick: nil];
+  PASS([editor numberOfRows] == 4 && [editor parentRowForRow: 1] == 0
+       && [editor rowTypeForRow: 1] == NSRuleEditorRowTypeSimple,
+       "the plus of a compound row adds the first row beneath it");
+  [button(editor, 1, @"remove") performClick: nil];
+  PASS([editor numberOfRows] == 3, "the minus removes its row");
+  PASS(tree->fired == 6, "and sends the action");
+
+  [editor setCanRemoveAllRows: NO];
+  PASS(![button(editor, 0, @"remove") isEnabled],
+       "the last row at the top stays when all rows may not go");
+  PASS([button(editor, 1, @"remove") isEnabled],
+       "rows beneath it may still go");
+  [button(editor, 0, @"remove") performClick: nil];
+  PASS([editor numberOfRows] == 3, "a minus that is off removes nothing");
+  [editor setCanRemoveAllRows: YES];
+
+  [editor setEditable: NO];
+  PASS(button(editor, 0, @"add") == nil && button(editor, 0, @"remove") == nil,
+       "an editor that is not editable has no buttons");
+  PASS(![[viewsOfRow(editor, 1, [NSPopUpButton class]) objectAtIndex: 0]
+          isEnabled],
+       "and its pop-ups are off");
+  [editor setEditable: YES];
+
+  /* A keyed archive keeps the settings, as on OS X. */
+  {
+    NSRuleEditor *back;
+
+    [editor setNestingMode: NSRuleEditorNestingModeList];
+    [editor setRowHeight: 27.0];
+    [editor setCanRemoveAllRows: NO];
+    [editor setEditable: NO];
+    back = [NSKeyedUnarchiver unarchiveObjectWithData:
+      [NSKeyedArchiver archivedDataWithRootObject: editor]];
+    PASS([back nestingMode] == NSRuleEditorNestingModeList,
+         "an archived editor keeps its nesting mode");
+    PASS([back rowHeight] == 27.0, "its row height");
+    PASS(![back canRemoveAllRows] && ![back isEditable],
+         "and whether rows can go and it can be edited");
+  }
+
+  END_SET("NSRuleEditor rows")
+
+  [pool release];
+  return 0;
+}
diff --git a/Tests/gui/NSRuleEditor/targetAction.m b/Tests/gui/NSRuleEditor/targetAction.m
new file mode 100644
index 000000000..6c9d9cf86
--- /dev/null
+++ b/Tests/gui/NSRuleEditor/targetAction.m
@@ -0,0 +1,102 @@
+/* A rule editor (and so a predicate editor) has a target and an action of
+   its own, as on macOS: setting them keeps them rather than handing them
+   to its cell, which raised; a xib connecting the editor's action to an
+   object could not be loaded.  Giving it a predicate does not send it. */
+#include "Testing.h"
+
+#include <Foundation/NSArray.h>
+#include <Foundation/NSAutoreleasePool.h>
+#include <Foundation/NSExpression.h>
+#include <Foundation/NSPredicate.h>
+#include <Foundation/NSValue.h>
+
+#include <AppKit/NSApplication.h>
+#include <AppKit/NSPredicateEditor.h>
+#include <AppKit/NSPredicateEditorRowTemplate.h>
+#include <AppKit/NSRuleEditor.h>
+
+@interface Target : NSObject
+{
+@public
+  int fired;
+}
+- (void) changed: (id)sender;
+@end
+
+@implementation Target
+- (void) changed: (id)sender
+{
+  fired++;
+}
+@end
+
+int
+main(int argc, const char **argv)
+{
+  START_SET("NSRuleEditor target and action")
+
+  NS_DURING
+    [NSApplication sharedApplication];
+  NS_HANDLER
+    if ([[localException name] isEqualToString: NSInternalInconsistencyException])
+      SKIP("It looks like GNUstep backend is not yet installed")
+  NS_ENDHANDLER
+
+  NS_DURING
+    {
+      Target *target = AUTORELEASE([[Target alloc] init]);
+      NSRuleEditor *rules = AUTORELEASE([[NSRuleEditor alloc]
+        initWithFrame: NSMakeRect(0, 0, 400, 100)]);
+      NSPredicateEditor *editor = AUTORELEASE([[NSPredicateEditor alloc]
+        initWithFrame: NSMakeRect(0, 0, 400, 100)]);
+      NSPredicateEditorRowTemplate *template;
+      BOOL raised = NO;
+
+      NS_DURING
+        {
+          [rules setTarget: target];
+          [rules setAction: @selector(changed:)];
+        }
+      NS_HANDLER
+        raised = YES;
+      NS_ENDHANDLER
+      PASS(raised == NO, "a rule editor takes a target and an action");
+      PASS([rules target] == target, "and keeps its target");
+      PASS(sel_isEqual([rules action], @selector(changed:)), "and its action");
+
+      template = AUTORELEASE([[NSPredicateEditorRowTemplate alloc]
+        initWithLeftExpressions: [NSArray arrayWithObject:
+          [NSExpression expressionForKeyPath: @"name"]]
+        rightExpressionAttributeType: NSStringAttributeType
+                            modifier: NSDirectPredicateModifier
+                           operators: [NSArray arrayWithObject:
+          [NSNumber numberWithUnsignedInteger: NSEqualToPredicateOperatorType]]
+                             options: 0]);
+      [editor setRowTemplates: [NSArray arrayWithObject: template]];
+      raised = NO;
+      NS_DURING
+        {
+          [editor setTarget: target];
+          [editor setAction: @selector(changed:)];
+        }
+      NS_HANDLER
+        raised = YES;
+      NS_ENDHANDLER
+      PASS(raised == NO && [editor target] == target
+        && sel_isEqual([editor action], @selector(changed:)),
+        "so does a predicate editor");
+      [editor setObjectValue: [NSPredicate predicateWithFormat: @"name == 'Ada'"]];
+      PASS(target->fired == 0, "giving it a predicate does not send its action");
+      PASS([editor sendAction: [editor action] to: [editor target]]
+        && target->fired == 1, "its action is sent to its target");
+    }
+  NS_HANDLER
+    if ([[localException name] isEqualToString: NSInternalInconsistencyException]
+      || [[localException name] isEqualToString: @"NSWindowServerCommunicationException"])
+      SKIP("No display available")
+  NS_ENDHANDLER
+
+  END_SET("NSRuleEditor target and action")
+
+  return 0;
+}
-- 
2.43.0

