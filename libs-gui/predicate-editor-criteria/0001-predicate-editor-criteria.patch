+- (id) decodeRuleEditorNestingModeForElement: (GSXibElement*)element
+{
+  NSString *mode = [element attributeForKey: @"nestingMode"];
+  NSUInteger value = NSRuleEditorNestingModeCompound;
+
+  if ([@"single" isEqualToString: mode])
+    value = NSRuleEditorNestingModeSingle;
+  else if ([@"list" isEqualToString: mode])
+    value = NSRuleEditorNestingModeList;
+  else if ([@"simple" isEqualToString: mode])
+    value = NSRuleEditorNestingModeSimple;
+  return [NSNumber numberWithUnsignedInteger: value];
+}
+
+- (id) decodeRuleEditorDisallowEmptyForElement: (GSXibElement*)element
+{
+  return [NSNumber numberWithBool:
+    ![[element attributeForKey: @"canRemoveAllRows"] boolValue]];
+}
+
+- (id) decodePredicateTemplateTypeForElement: (GSXibElement*)element
+{
+  /* The archived types: 1 for a comparison, 2 for a compound row. */
+  return [NSNumber numberWithInteger:
+    [@"compound" isEqualToString: [element attributeForKey: @"rowType"]]
+      ? 2 : 1];
+}
+
+/* A xib keeps the menus of a template's pop-ups; an archive, the pop-ups. */
+- (id) decodePredicateTemplateViewsForElement: (GSXibElement*)element
+{
+  GSXibElement *menusElement = (GSXibElement*)[element elementForKey: @"popUpMenus"];
+  NSArray *menus = [self objectForXib: menusElement];
+  NSMutableArray *views = [NSMutableArray array];
+  NSEnumerator *e = [menus objectEnumerator];
+  NSMenu *menu;
+
+  while ((menu = [e nextObject]) != nil)
+    {
+      NSPopUpButton *popUp = [[NSPopUpButton alloc]
+        initWithFrame: NSMakeRect(0.0, 0.0, 100.0, 22.0) pullsDown: NO];
+
+      [popUp setMenu: menu];
+      if ([popUp numberOfItems] > 0)
+        {
+          [popUp selectItemAtIndex: 0];
+        }
+      [views addObject: popUp];
+      RELEASE(popUp);
+    }
+
+  return views;
+}
+
+- (GSXibElement*) _rightExpressionElementOf: (GSXibElement*)element
+{
+  return (GSXibElement*)[element elementForKey: @"rightExpressionObject"];
+}
+
+- (id) decodePredicateTemplateRightAttributeTypeForElement: (GSXibElement*)element
+{
+  GSXibElement *right = [self _rightExpressionElementOf: element];
+
+  if ([@"integer" isEqualToString: [right type]])
+    {
+      return [NSNumber numberWithInteger:
+        [[right attributeForKey: @"value"] integerValue]];
+    }
+  return [NSNumber numberWithInteger: 0];
+}
+
+- (id) decodePredicateTemplateRightIsWildcardForElement: (GSXibElement*)element
+{
+  GSXibElement *right = [self _rightExpressionElementOf: element];
+
+  return [NSNumber numberWithBool:
+    (right == nil || [@"integer" isEqualToString: [right type]])];
+}
+
+- (id) decodeExpressionForElement: (GSXibElement*)element
+{
+  NSString *type = [element attributeForKey: @"type"];
+
+  if ([@"keyPath" isEqualToString: type])
+    {
+      return [NSExpression expressionForKeyPath:
+        [self objectForXib: (GSXibElement*)[element elementForKey: @"keyPath"]]];
+    }
+  else if ([@"constant" isEqualToString: type])
+    {
+      return [NSExpression expressionForConstantValue:
+        [self objectForXib: (GSXibElement*)[element elementForKey: @"constantValue"]]];
+    }
+  else if ([@"variable" isEqualToString: type])
+    {
+      return [NSExpression expressionForVariable:
+        [self objectForXib: (GSXibElement*)[element elementForKey: @"variable"]]];
+    }
+  else if ([@"evaluatedObject" isEqualToString: type])
+    {
+      return [NSExpression expressionForEvaluatedObject];
+    }
+
+  NSWarnMLog(@"no expression of type %@", type);
+  return nil;
+}
