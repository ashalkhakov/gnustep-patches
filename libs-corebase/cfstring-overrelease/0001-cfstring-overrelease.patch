From e7aee45807767900a2a291ea8baf3ec20290cf89 Mon Sep 17 00:00:00 2001
From: Artyom Shalkhakov <artyom.shalkhakov@gmail.com>
Date: Thu, 24 Sep 2026 12:00:00 +0500
Subject: [PATCH] Do not release autoreleased results in CFString case
 functions

CFStringCapitalize(), CFStringLowercase(), CFStringUppercase() and
CFStringFold() over-release their intermediate result when the string
they are given is a toll-free bridged ObjC object. On that path each
one calls the corresponding ObjC convenience method --
-capitalizedString, -lowercaseString, -uppercaseString,
-stringByFoldingWithOptions:locale: -- applies the result with
-setString:, and then calls CFRelease on it.

Those methods follow the Get rule: the string they return is
autoreleased, and the caller owns no reference to it. Releasing it
frees the string while it is still registered in the autorelease pool,
and the pool drain then releases freed memory -- a use-after-free, and
heap corruption, in any application that calls one of these functions
on a bridged NSMutableString.

Drop the CFRelease calls.
---
 Source/CFString.c | 7 -------
 1 file changed, 7 deletions(-)

diff --git a/Source/CFString.c b/Source/CFString.c
index 3873f9e..ac1a403 100644
--- a/Source/CFString.c
+++ b/Source/CFString.c
@@ -1648,8 +1648,6 @@ CFStringCapitalize (CFMutableStringRef str, CFLocaleRef locale)
       CFStringRef mod;
       CF_OBJC_CALLV (CFStringRef, mod, str, "capitalizedString");
       CF_OBJC_VOIDCALLV (str, "setString:", mod);
-
-      CFRelease (mod);
     }
   else
     CFStringCaseMap (str, locale, 0, _kCFStringCapitalize);
@@ -1663,8 +1661,6 @@ CFStringLowercase (CFMutableStringRef str, CFLocaleRef locale)
       CFStringRef mod;
       CF_OBJC_CALLV (CFStringRef, mod, str, "lowercaseString");
       CF_OBJC_VOIDCALLV (str, "setString:", mod);
-
-      CFRelease (mod);
     }
   else
     CFStringCaseMap (str, locale, 0, _kCFStringLowercase);
@@ -1678,8 +1674,6 @@ CFStringUppercase (CFMutableStringRef str, CFLocaleRef locale)
       CFStringRef mod;
       CF_OBJC_CALLV (CFStringRef, mod, str, "uppercaseString");
       CF_OBJC_VOIDCALLV (str, "setString:", mod);
-
-      CFRelease (mod);
     }
   else
     CFStringCaseMap (str, locale, 0, _kCFStringUppercase);
@@ -1699,7 +1693,6 @@ CFStringFold (CFMutableStringRef str, CFOptionFlags flags, CFLocaleRef locale)
                      "stringByFoldingWithOptions:locale:", flags, locale);
 
       CF_OBJC_VOIDCALLV (str, "setString:", mod);
-      CFRelease (mod);
     }
   else
     CFStringCaseMap (str, locale, flags, _kCFStringFold);
-- 
